index 0000000..b5b5e7b
--- /dev/null
+++ b/tests/test_shipments_daily_structure.py
@@ -0,0 +1,22 @@
+"""shipments_daily: schedule and task order."""
+
+from datetime import datetime, timezone
+
+
+def test_runs_at_0730_utc_weekdays_only(dagbag, upcoming_runs):
+    dag = dagbag.dags["shipments_daily"]
+    # two full weeks starting Monday 2026-03-02
+    runs = upcoming_runs(dag, datetime(2026, 3, 2, tzinfo=timezone.utc), 10)
+    assert len(runs) == 10
+    assert {r.weekday() for r in runs} == {0, 1, 2, 3, 4}, runs
+    assert all((r.hour, r.minute, r.second) == (7, 30, 0) for r in runs), runs
+    assert all(r.utcoffset().total_seconds() == 0 for r in runs), runs
+    # exactly one run per weekday: nothing extra on the same day
+    assert len({r.date() for r in runs}) == 10
+
+
+def test_report_is_built_only_after_extract(dagbag):
+    dag = dagbag.dags["shipments_daily"]
+    report = dag.get_task("build_report")
+    assert "extract_shipments" in report.get_flat_relative_ids(upstream=True)
+    assert "build_report" not in dag.get_task("extract_shipments").get_flat_relative_ids(upstream=True)
