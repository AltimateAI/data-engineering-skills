+++ b/tests/test_shipments_daily_e2e.py
@@ -0,0 +1,37 @@
+"""Runs shipments_daily end to end on data/shipments.csv for 2026-03-03."""
+
+import csv
+from datetime import datetime, timezone
+
+RUN_DATE = "2026-03-03"
+
+
+def test_shipments_daily_end_to_end(dagbag, airflow_db, task_global, tmp_path):
+    dag = dagbag.dags["shipments_daily"]
+    # keep the report out of the repo's output/ folder; input is the real sample data
+    task_global(dag, "build_report", "OUTPUT_DIR", tmp_path)
+
+    dr = dag.test(execution_date=datetime(2026, 3, 3, 7, 30, tzinfo=timezone.utc))
+
+    states = {ti.task_id: ti.state for ti in dr.get_task_instances()}
+    assert dr.state == "success", states  # dag.test() does not raise when a task fails
+    assert set(states.values()) == {"success"}, states
+
+    report = tmp_path / f"{RUN_DATE}.csv"
+    assert report.exists(), list(tmp_path.iterdir())
+    with report.open(newline="") as fh:
+        reader = csv.DictReader(fh)
+        assert reader.fieldnames == ["shipment_id", "carrier", "promised_date", "delivered_date", "days_late"]
+        rows = list(reader)
+
+    # worked out by hand from data/shipments.csv:
+    #   SH-1009 open, promised 02-26 -> 5; SH-1003 open, promised 02-28 -> 3
+    #   SH-1007 delivered 03-03, promised 03-01 -> 2; SH-1001 delivered 03-03, promised 03-02 -> 1
+    #   not late: SH-1002 (on time), SH-1004 (due today), SH-1005 (delivered 03-02),
+    #             SH-1006 (due 03-06), SH-1008 (early)
+    assert [(r["shipment_id"], int(r["days_late"])) for r in rows] == [
+        ("SH-1009", 5), ("SH-1003", 3), ("SH-1007", 2), ("SH-1001", 1),
+    ]
+    assert {r["shipment_id"]: r["delivered_date"] for r in rows} == {
+        "SH-1009": "", "SH-1003": "", "SH-1007": RUN_DATE, "SH-1001": RUN_DATE,
+    }
diff --git a/tests/test_shipments_daily_structure.py b/tests/test_shipments_daily_structure.py
