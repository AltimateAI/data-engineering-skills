@@ -0,0 +1,26 @@
+"""Every DAG file imports, and repo-wide task settings."""
+
+EXPECTED_DAGS = {"shipments_daily", "carrier_rates_weekly"}
+
+
+def test_no_import_errors(dagbag):
+    assert dagbag.import_errors == {}, "\n\n".join(f"{f}:\n{e}" for f, e in dagbag.import_errors.items())
+
+
+def test_expected_dags_are_defined(dagbag):
+    # a file that imports but stops defining its DAG would otherwise pass silently
+    assert EXPECTED_DAGS <= set(dagbag.dags)
+
+
+def test_every_dag_file_defines_a_dag(dagbag):
+    from conftest import DAGS
+
+    files_with_dags = {dag.fileloc for dag in dagbag.dags.values()}
+    missing = [p.name for p in DAGS.glob("*.py") if str(p) not in files_with_dags]
+    assert not missing, f"DAG files that define no DAG: {missing}"
+
+
+def test_every_task_has_at_least_two_retries(dagbag):
+    # task.retries already reflects default_args and any task-level override
+    bad = [(d.dag_id, t.task_id, t.retries) for d in dagbag.dags.values() for t in d.tasks if t.retries < 2]
+    assert not bad, f"tasks with fewer than 2 retries: {bad}"
diff --git a/tests/test_late_shipment_rules.py b/tests/test_late_shipment_rules.py
new file mode 100644
index 0000000..c4e74f1
--- /dev/null
+++ b/tests/test_late_shipment_rules.py
@@ -0,0 +1,76 @@
+"""shipments_daily.find_late_shipments on hand-built rows."""
+
+import pytest
+
+AS_OF = "2026-03-03"
+
+
+def row(sid, promised, delivered="", ship="2026-02-20", carrier="DHL"):
+    return {"shipment_id": sid, "ship_date": ship, "carrier": carrier,
+            "promised_date": promised, "delivered_date": delivered}
+
+
+def find_late_shipments(rows, as_of):
+    # imported here so a broken DAG file fails these tests one by one, not the whole module
+    from shipments_daily import find_late_shipments as fn
+
+    return fn(rows, as_of)
+
+
+def late_ids(rows, as_of=AS_OF):
+    return {r["shipment_id"]: r["days_late"] for r in find_late_shipments(rows, as_of)}
+
+
+@pytest.mark.parametrize(
+    "promised, delivered, expected",
+    [
+        # delivered on the run date
+        ("2026-03-02", AS_OF, 1),         # after promise -> late by 1 day
+        ("2026-02-25", AS_OF, 6),         # late by several days
+        (AS_OF, AS_OF, None),             # on the promised day -> not late
+        ("2026-03-05", AS_OF, None),      # early -> not late
+        # delivered on another day: not in this run's report even if it was late
+        ("2026-02-24", "2026-03-02", None),
+        ("2026-02-24", "2026-03-04", None),
+        # still open
+        ("2026-03-02", "", 1),            # promise the day before the run date -> late, counted to run date
+        ("2026-02-26", "", 5),
+        (AS_OF, "", None),                # promised today -> not yet late
+        ("2026-03-04", "", None),         # promised in the future
+    ],
+)
+def test_single_shipment(promised, delivered, expected):
+    got = late_ids([row("S1", promised, delivered)])
+    assert got == ({} if expected is None else {"S1": expected})
+
+
+def test_days_late_crosses_month_end():
+    # 2026 is not a leap year: Feb 28 -> Mar 3 is 3 days
+    assert late_ids([row("S1", "2026-02-28")]) == {"S1": 3}
+    assert late_ids([row("S2", "2026-02-27", AS_OF)]) == {"S2": 4}
+
+
+def test_missing_delivered_value_counts_as_open():
+    r = row("S1", "2026-03-01")
+    r["delivered_date"] = None
+    assert late_ids([r]) == {"S1": 2}
+
+
+def test_mixed_rows_and_output_fields():
+    rows = [
+        row("A", "2026-03-02", AS_OF, carrier="UPS"),
+        row("B", AS_OF, AS_OF),
+        row("C", "2026-02-26"),
+        row("D", AS_OF),
+        row("E", "2026-02-24", "2026-03-02"),
+    ]
+    out = find_late_shipments(rows, AS_OF)
+    assert [(r["shipment_id"], r["days_late"]) for r in out] == [("C", 5), ("A", 1)]
+    a = out[1]
+    assert (a["carrier"], a["promised_date"], a["delivered_date"]) == ("UPS", "2026-03-02", AS_OF)
+
+
+def test_input_rows_are_not_modified():
+    rows = [row("A", "2026-03-02", AS_OF)]
+    find_late_shipments(rows, AS_OF)
+    assert "days_late" not in rows[0]
diff --git a/tests/test_shipments_daily_e2e.py b/tests/test_shipments_daily_e2e.py
