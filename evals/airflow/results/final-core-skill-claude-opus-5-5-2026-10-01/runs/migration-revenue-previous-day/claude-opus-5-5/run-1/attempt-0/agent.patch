+def business_window(dag_run):
+    """[start, end) of the business day a run reports on.
+
+    Scheduled runs use their data interval (the UTC day that closed at 04:15).
+    Manual runs on Airflow 3 have no data interval, so use the latest closed
+    interval before the trigger time, as Airflow 2 did.
+    """
+    if dag_run.data_interval_start is not None:
+        return pendulum.instance(dag_run.data_interval_start), pendulum.instance(dag_run.data_interval_end)
+    interval = CoreCronDataIntervalTimetable(SCHEDULE_CRON, timezone=SCHEDULE_TZ).infer_manual_data_interval(
+        run_after=pendulum.instance(dag_run.run_after)
+    )
+    return interval.start, interval.end
+
+
+def business_date(dag_run):
+    return business_window(dag_run)[0].to_date_string()
+
+
+def business_end_date(dag_run):
+    return business_window(dag_run)[1].to_date_string()
+
+
+def logical_ts(dag_run):
+    return str(pendulum.instance(dag_run.logical_date or dag_run.run_after))
+
