+import duckdb
+con=duckdb.connect("warehouse/analytics.duckdb",read_only=True)
+exp=dict((d,(n,s)) for d,n,s in con.sql("select cast(order_ts as date) d,count(*),sum(cast(amount_usd as decimal(12,2))) from read_csv_auto('data/orders.csv') where status<>'cancelled' group by d").fetchall())
+o=dict((d,(n,nd,s)) for d,n,nd,s in con.sql("select order_date,count(*),count(distinct order_id),sum(amount_usd) from orders group by 1").fetchall())
+r={}
+for d,c,s in con.sql("select * from daily_revenue").fetchall(): r.setdefault(d,[]).append((c,s))
+for d in sorted(set(o)|set(r)):
+    n,nd,s=o.get(d,(0,0,None))
+    ok=(n,s)==exp[d] and n==nd and r.get(d)==[(n,s)]
+    print(d,"orders",n,"distinct",nd,s,"rollup",r.get(d),"OK" if ok else "MISMATCH")
