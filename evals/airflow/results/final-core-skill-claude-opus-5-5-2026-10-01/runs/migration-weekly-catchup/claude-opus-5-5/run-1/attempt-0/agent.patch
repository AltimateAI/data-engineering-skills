+def week_interval(data_interval_start, data_interval_end, dag_run):
+    """Scheduled runs use their interval; manual runs (no interval on Airflow 3)
+    get the latest closed Mon-Sun week, as Airflow 2 inferred for them."""
+    if data_interval_start is not None:
+        return data_interval_start, data_interval_end
+    iv = CoreCronDataIntervalTimetable(SCHEDULE_CRON, timezone="UTC").infer_manual_data_interval(
+        run_after=pendulum.instance(dag_run.run_after)
+    )
+    return iv.start, iv.end
 
 
