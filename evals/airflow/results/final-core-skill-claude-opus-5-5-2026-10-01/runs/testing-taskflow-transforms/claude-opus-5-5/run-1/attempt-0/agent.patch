+++ b/tests/test_transforms.py
@@ -0,0 +1,143 @@
+"""Unit tests of the task callables on small hand-built inputs."""
+
+import pytest
+
+import orders_enrichment as oe
+from conftest import read_csv, write_csv
+
+
+def order(order_id, updated_at="2026-03-02T08:00:00", currency="USD", amount="10.00", customer_id="C-1"):
+    return {
+        "order_id": order_id,
+        "order_date": "2026-03-02",
+        "updated_at": updated_at,
+        "customer_id": customer_id,
+        "currency": currency,
+        "amount": amount,
+    }
+
+
+# --- dedupe: only the latest version (by updated_at) of each order is kept ---------------------
+
+def test_dedupe_keeps_latest_version_regardless_of_input_order():
+    rows = [
+        order("A", "2026-03-02T09:00:00", amount="2.00"),
+        order("A", "2026-03-02T11:00:00", amount="3.00"),  # latest
+        order("A", "2026-03-02T07:00:00", amount="1.00"),  # older version exported after the latest
+        order("B", "2026-03-02T08:00:00", amount="5.00"),
+    ]
+    out = oe.dedupe_orders.function(rows)
+    assert [(r["order_id"], r["amount"]) for r in out] == [("A", "3.00"), ("B", "5.00")]
+
+
+def test_dedupe_latest_first_in_input_is_not_overwritten_by_older():
+    rows = [order("A", "2026-03-02T11:47:00", amount="120.00"), order("A", "2026-03-02T08:05:00", amount="100.00")]
+    assert [r["amount"] for r in oe.dedupe_orders.function(rows)] == ["120.00"]
+
+
+def test_dedupe_keeps_every_distinct_order_once():
+    rows = [order("C"), order("A"), order("B"), order("A", "2026-03-02T09:00:00")]
+    out = oe.dedupe_orders.function(rows)
+    assert sorted(r["order_id"] for r in out) == ["A", "B", "C"]
+    assert len(out) == 3
+
+
+def test_dedupe_compares_timestamps_not_just_dates():
+    rows = [order("A", "2026-03-02T23:59:00", amount="9.00"), order("A", "2026-03-02T00:01:00", amount="1.00")]
+    assert oe.dedupe_orders.function(rows)[0]["amount"] == "9.00"
+
+
+def test_dedupe_empty():
+    assert oe.dedupe_orders.function([]) == []
+
+
+# --- conversion: amount * usd_per_unit, rounded half-up to cents ------------------------------
+
+@pytest.mark.parametrize(
+    "amount, rate, expected",
+    [
+        ("120.00", "1.0850", "130.20"),
+        ("40.50", "1.2700", "51.44"),   # 51.435 -> half-up
+        ("1.25", "0.5", "0.63"),        # 0.625 -> 0.63 half-up (half-even would give 0.62)
+        ("0.125", "1", "0.13"),         # 0.125 -> 0.13 half-up (half-even would give 0.12)
+        ("10.00", "1.23444", "12.34"),  # 12.3444 -> rounds down
+        ("2.01", "1.0812", "2.17"),     # 2.173212
+        ("9.99", "1", "9.99"),
+    ],
+)
+def test_convert_amount_times_rate_rounded_half_up(amount, rate, expected):
+    out = oe.convert_to_usd.function([order("A", currency="EUR", amount=amount)], {"EUR": rate})
+    assert out[0]["amount_usd"] == expected
+
+
+def test_convert_uses_each_rows_own_currency_and_keeps_fields():
+    rows = [order("A", currency="EUR", amount="100.00"), order("B", currency="GBP", amount="100.00")]
+    out = oe.convert_to_usd.function(rows, {"USD": "1", "EUR": "1.0850", "GBP": "1.2700"})
+    assert [r["amount_usd"] for r in out] == ["108.50", "127.00"]
+    assert out[0]["customer_id"] == "C-1" and out[0]["amount"] == "100.00"
+
+
+def test_convert_missing_rate_raises_instead_of_guessing():
+    rows = [order("A", currency="EUR", amount="1.00"), order("B", currency="JPY", amount="500")]
+    with pytest.raises(ValueError, match="JPY"):
+        oe.convert_to_usd.function(rows, {"USD": "1", "EUR": "1.08"})
+
+
+# --- FX rates are taken for the run date only -------------------------------------------------
+
+@pytest.fixture
+def data_dir(tmp_path, monkeypatch):
+    monkeypatch.setattr(oe, "DATA_DIR", tmp_path)
+    return tmp_path
+
+
+def test_load_fx_rates_only_uses_the_run_date(data_dir):
+    write_csv(data_dir / "fx_rates.csv", [
+        {"rate_date": "2026-03-01", "currency": "EUR", "usd_per_unit": "1.0812"},
+        {"rate_date": "2026-03-02", "currency": "EUR", "usd_per_unit": "1.0850"},
+        {"rate_date": "2026-03-03", "currency": "GBP", "usd_per_unit": "1.2690"},
+    ])
+    assert oe.load_fx_rates.function(ds="2026-03-02") == {"USD": "1", "EUR": "1.0850"}
+
+
+def test_rate_from_another_day_is_not_used_so_conversion_fails(data_dir):
+    write_csv(data_dir / "fx_rates.csv", [
+        {"rate_date": "2026-03-01", "currency": "GBP", "usd_per_unit": "1.2655"},
+        {"rate_date": "2026-03-03", "currency": "GBP", "usd_per_unit": "1.2690"},
+    ])
+    rates = oe.load_fx_rates.function(ds="2026-03-02")
+    with pytest.raises(ValueError, match="GBP"):
+        oe.convert_to_usd.function([order("A", currency="GBP")], rates)
+
+
+def test_extract_orders_only_the_run_date(data_dir):
+    rows = [order("A"), {**order("B"), "order_date": "2026-03-01"}, order("A", "2026-03-02T09:00:00")]
+    write_csv(data_dir / "orders.csv", rows)
+    out = oe.extract_orders.function(ds="2026-03-02")
+    assert [(r["order_id"], r["updated_at"]) for r in out] == [
+        ("A", "2026-03-02T08:00:00"), ("A", "2026-03-02T09:00:00")]
+
+
+# --- validation -----------------------------------------------------------------------------------
+
+def enriched(order_id, amount_usd="1.00", customer_id="C-1"):
+    return {**order(order_id, customer_id=customer_id), "amount_usd": amount_usd}
+
+
+def test_validate_passes_good_rows_through():
+    rows = [enriched("A", "0.00"), enriched("B", "12.34")]
+    assert oe.validate_totals.function(rows) == rows
+
+
+@pytest.mark.parametrize("bad", [enriched("X", customer_id=""), enriched("X", amount_usd="-0.01")])
+def test_validate_rejects_bad_rows(bad):
+    with pytest.raises(ValueError, match="X"):
+        oe.validate_totals.function([enriched("A"), bad])
+
+
+def test_load_enriched_writes_expected_columns(tmp_path, monkeypatch):
+    monkeypatch.setattr(oe, "OUTPUT_DIR", tmp_path)
+    path = oe.load_enriched.function([enriched("A", "1.23")], ds="2026-03-02")
+    assert path == str(tmp_path / "2026-03-02.csv")
+    assert read_csv(tmp_path / "2026-03-02.csv") == [
+        {"order_id": "A", "customer_id": "C-1", "currency": "USD", "amount": "10.00", "amount_usd": "1.23"}]
