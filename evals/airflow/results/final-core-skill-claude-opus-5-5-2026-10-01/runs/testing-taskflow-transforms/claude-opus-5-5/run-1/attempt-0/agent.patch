@@ -0,0 +1,39 @@
+"""DAG integrity, dependencies (publish only after validation) and schedule."""
+from datetime import datetime, timezone
+
+DAG_ID = "orders_enrichment"
+
+
+def test_no_import_errors(dagbag):
+    assert dagbag.import_errors == {}, "\n\n".join(f"{f}:\n{e}" for f, e in dagbag.import_errors.items())
+    assert DAG_ID in dagbag.dags
+
+
+def test_task_dependencies(dagbag):
+    dag = dagbag.dags[DAG_ID]
+    expected = {
+        "extract_orders": set(),
+        "load_fx_rates": set(),
+        "dedupe_orders": {"extract_orders"},
+        "convert_to_usd": {"dedupe_orders", "load_fx_rates"},
+        "validate_totals": {"convert_to_usd"},
+        "load_enriched": {"validate_totals"},
+    }
+    assert {t.task_id: t.upstream_task_ids for t in dag.tasks} == expected
+
+
+def test_write_only_after_validate_succeeded(dagbag):
+    load = dagbag.dags[DAG_ID].get_task("load_enriched")
+    assert load.upstream_task_ids == {"validate_totals"}
+    assert load.trigger_rule == "all_success"
+
+
+def test_runs_daily_at_0600_utc(dagbag, upcoming_runs):
+    runs = upcoming_runs(dagbag.dags[DAG_ID], datetime(2026, 3, 1, tzinfo=timezone.utc), 14)
+    assert len(runs) == 14
+    fire = [r.run_after for r in runs]
+    assert all((t.hour, t.minute, t.second, t.utcoffset().total_seconds()) == (6, 0, 0, 0) for t in fire)
+    # exactly once per day, every day of the week, no gaps
+    assert [t.date().toordinal() for t in fire] == list(range(fire[0].date().toordinal(), fire[0].date().toordinal() + 14))
+    # the run that fires on day D processes day D (ds == D)
+    assert all(r.logical_date.date() == r.run_after.date() for r in runs)
diff --git a/tests/test_end_to_end.py b/tests/test_end_to_end.py
new file mode 100644
index 0000000..8794f02
--- /dev/null
+++ b/tests/test_end_to_end.py
@@ -0,0 +1,89 @@
+"""Full DAG runs with dag.test(): on the sample data in data/, and failure paths on temp data."""
+from datetime import date, datetime, timezone
+from decimal import ROUND_HALF_UP, Decimal
+
+from conftest import REPO, read_csv, write_csv
+
+DAG_ID = "orders_enrichment"
+
+
+def run(dag, day):
+    """One dag.test() run firing at 06:00 UTC on `day`; each test uses its own day (one metadata DB)."""
+    dr = dag.test(logical_date=datetime(day.year, day.month, day.day, 6, 0, tzinfo=timezone.utc))
+    return dr, {ti.task_id: ti.state for ti in dr.get_task_instances()}
+
+
+def no_retries(dag, monkeypatch):
+    # the DAG retries failed tasks twice after 10 minutes; failure-path tests should fail at once
+    for t in dag.tasks:
+        monkeypatch.setattr(t, "retries", 0)
+
+
+def test_sample_data_2026_03_02(dagbag, airflow_db, task_global, tmp_path):
+    dag = dagbag.dags[DAG_ID]
+    task_global(dag, "load_enriched", "OUTPUT_DIR", tmp_path)
+
+    dr, states = run(dag, date(2026, 3, 2))
+    assert dr.state == "success", states
+
+    rows = read_csv(tmp_path / "2026-03-02.csv")
+    # hand-checked against data/: S-102 and S-103 were exported twice, the later version wins
+    assert rows == [
+        {"order_id": "S-102", "customer_id": "C-7", "currency": "EUR", "amount": "120.00", "amount_usd": "130.20"},
+        {"order_id": "S-103", "customer_id": "C-9", "currency": "GBP", "amount": "40.50", "amount_usd": "51.44"},
+        {"order_id": "S-104", "customer_id": "C-10", "currency": "USD", "amount": "9.99", "amount_usd": "9.99"},
+        {"order_id": "S-105", "customer_id": "C-8", "currency": "EUR", "amount": "0.35", "amount_usd": "0.38"},
+    ]
+    # cross-check every row against the rule using the day's rates from data/fx_rates.csv
+    rates = {"USD": "1"} | {r["currency"]: r["usd_per_unit"] for r in read_csv(REPO / "data" / "fx_rates.csv")
+                            if r["rate_date"] == "2026-03-02"}
+    for r in rows:
+        want = (Decimal(r["amount"]) * Decimal(rates[r["currency"]])).quantize(Decimal("0.01"), ROUND_HALF_UP)
+        assert r["amount_usd"] == str(want)
+
+
+def _temp_data(dag, task_global, tmp_path, orders, rates):
+    data = tmp_path / "data"
+    write_csv(data / "orders.csv", orders)
+    write_csv(data / "fx_rates.csv", rates)
+    task_global(dag, "extract_orders", "DATA_DIR", data)  # one module: all tasks share these globals
+    out = tmp_path / "out"
+    task_global(dag, "load_enriched", "OUTPUT_DIR", out)
+    return out
+
+
+def _order(day, order_id, currency, customer_id="C-1", amount="10.00"):
+    return {"order_id": order_id, "order_date": str(day), "updated_at": f"{day}T08:00:00",
+            "customer_id": customer_id, "currency": currency, "amount": amount}
+
+
+def _rates(day):
+    # EUR has a rate for the day; JPY only for the day before
+    return [{"rate_date": str(day), "currency": "EUR", "usd_per_unit": "1.0850"},
+            {"rate_date": str(date.fromordinal(day.toordinal() - 1)), "currency": "JPY", "usd_per_unit": "0.0067"}]
+
+
+def test_currency_without_rate_for_the_day_fails_run_and_writes_nothing(
+        dagbag, airflow_db, task_global, tmp_path, monkeypatch):
+    dag, day = dagbag.dags[DAG_ID], date(2026, 3, 10)
+    no_retries(dag, monkeypatch)
+    out = _temp_data(dag, task_global, tmp_path, [_order(day, "A", "EUR"), _order(day, "B", "JPY")], _rates(day))
+
+    dr, states = run(dag, day)
+    assert dr.state == "failed", states
+    assert states["convert_to_usd"] == "failed"
+    assert states["load_enriched"] != "success"
+    assert not out.exists() or not any(out.iterdir())
+
+
+def test_failed_validation_writes_nothing(dagbag, airflow_db, task_global, tmp_path, monkeypatch):
+    dag, day = dagbag.dags[DAG_ID], date(2026, 3, 11)
+    no_retries(dag, monkeypatch)
+    out = _temp_data(dag, task_global, tmp_path,
+                     [_order(day, "A", "EUR"), _order(day, "B", "EUR", customer_id="")], _rates(day))
+
+    dr, states = run(dag, day)
+    assert dr.state == "failed", states
+    assert states["validate_totals"] == "failed"
+    assert states["load_enriched"] != "success"
+    assert not out.exists() or not any(out.iterdir())
diff --git a/tests/test_transforms.py b/tests/test_transforms.py
new file mode 100644
index 0000000..092f855
