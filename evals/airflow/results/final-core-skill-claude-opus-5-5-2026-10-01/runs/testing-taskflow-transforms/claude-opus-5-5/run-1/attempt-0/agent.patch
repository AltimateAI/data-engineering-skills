@@ -0,0 +1,82 @@
+import csv
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# Airflow reads its config once, on first import, so set everything before any airflow import.
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)  # dag.test() requires the DAG to live here
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"  # throwaway DB
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+sys.path.insert(0, str(DAGS))  # lets tests import the DAG module directly
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    try:
+        from airflow.dag_processing.dagbag import DagBag  # Airflow >= 3.2
+    except ImportError:
+        from airflow.models.dagbag import DagBag
+    return DagBag(dag_folder=str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrates the throwaway metadata DB. Only dag.test() tests need it."""
+    subprocess.run([sys.executable, "-m", "airflow", "db", "migrate"], check=True, capture_output=True)
+
+
+@pytest.fixture(scope="session")
+def upcoming_runs():
+    """upcoming_runs(dag, after, n) -> the next n times the scheduler would start a run."""
+    from airflow.serialization.encoders import coerce_to_core_timetable
+    from airflow.timetables.base import TimeRestriction
+
+    def _runs(dag, after, n):
+        tt = coerce_to_core_timetable(dag.timetable)
+        restriction = TimeRestriction(earliest=after, latest=None, catchup=True)
+        last, runs = None, []
+        for _ in range(n):
+            info = tt.next_dagrun_info(last_automated_data_interval=last, restriction=restriction)
+            if info is None:
+                break
+            runs.append(info)
+            last = info.data_interval
+        return runs
+
+    return _runs
+
+
+@pytest.fixture
+def task_global(monkeypatch):
+    """task_global(dag, task_id, NAME, value): patch a module global that the task's code reads.
+
+    DagBag loads the DAG file as its own private module, so patching an imported copy
+    would not affect dag.test(); patch the globals the task callable actually sees.
+    """
+    def _set(dag, task_id, name, value):
+        g = dag.get_task(task_id).python_callable.__globals__
+        assert name in g, f"{task_id} does not read a global named {name}"
+        monkeypatch.setitem(g, name, value)
+    return _set
+
+
+def write_csv(path, rows):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w", newline="") as fh:
+        writer = csv.DictWriter(fh, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def read_csv(path):
+    with path.open(newline="") as fh:
+        return list(csv.DictReader(fh))
