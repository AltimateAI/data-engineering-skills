+"""orders_ingest must run extract_orders -> validate_orders -> load_orders -> publish_summary."""
+
+import pytest
+
+DAG_ID = "orders_ingest"
+PIPELINE = ["extract_orders", "validate_orders", "load_orders", "publish_summary"]
+
+
+@pytest.fixture
+def dag(dagbag):
+    assert DAG_ID in dagbag.dags, f"{DAG_ID} not loaded; import errors: {dagbag.import_errors}"
+    return dagbag.dags[DAG_ID]
+
+
+def test_pipeline_tasks_exist(dag):
+    missing = [t for t in PIPELINE if t not in dag.task_ids]
+    assert not missing, f"missing tasks: {missing}"
+
+
+@pytest.mark.parametrize("position", range(len(PIPELINE)))
+def test_pipeline_order(dag, position):
+    task_id = PIPELINE[position]
+    expected_upstream = {PIPELINE[position - 1]} if position else set()
+    expected_downstream = {PIPELINE[position + 1]} if position + 1 < len(PIPELINE) else set()
+    task = dag.get_task(task_id)
+    assert set(task.upstream_task_ids) == expected_upstream
+    assert set(task.downstream_task_ids) == expected_downstream
