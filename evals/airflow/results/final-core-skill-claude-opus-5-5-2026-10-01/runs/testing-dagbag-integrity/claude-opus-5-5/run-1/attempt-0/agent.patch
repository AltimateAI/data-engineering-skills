@@ -0,0 +1,25 @@
+"""Every file in dags/ must parse into the DAGs we expect."""
+
+from pathlib import Path
+
+DAGS = Path(__file__).resolve().parents[1] / "dags"
+
+# Update this set when a DAG is added or removed on purpose.
+EXPECTED_DAG_IDS = {"customer_snapshot", "marketing_spend", "orders_ingest"}
+
+
+def test_no_import_errors(dagbag):
+    # Import errors, cycles and invalid DAG definitions all land here.
+    errors = "\n\n".join(f"{path}:\n{err}" for path, err in dagbag.import_errors.items())
+    assert not dagbag.import_errors, f"DAG files failed to load:\n{errors}"
+
+
+def test_expected_dags_present(dagbag):
+    assert set(dagbag.dags) == EXPECTED_DAG_IDS
+
+
+def test_every_dag_file_defines_a_dag(dagbag):
+    loaded_files = {Path(dag.fileloc).resolve() for dag in dagbag.dags.values()}
+    dag_files = {p.resolve() for p in DAGS.glob("*.py") if not p.name.startswith("_")}
+    missing = sorted(p.name for p in dag_files - loaded_files)
+    assert not missing, f"these files in dags/ produced no DAG: {missing}"
diff --git a/tests/test_dag_policy.py b/tests/test_dag_policy.py
new file mode 100644
index 0000000..5aacac7
--- /dev/null
+++ b/tests/test_dag_policy.py
@@ -0,0 +1,41 @@
+"""Team policy: tags + catchup off on every DAG; real owner and >= 2 retries on every task."""
+
+MIN_RETRIES = 2
+DEFAULT_OWNER = "airflow"
+
+
+def _dags(dagbag):
+    assert dagbag.dags, "no DAGs loaded"
+    return sorted(dagbag.dags.values(), key=lambda d: d.dag_id)
+
+
+def _tasks(dagbag):
+    return [(dag.dag_id, task) for dag in _dags(dagbag) for task in dag.tasks]
+
+
+def test_every_dag_has_a_tag(dagbag):
+    untagged = [dag.dag_id for dag in _dags(dagbag) if not dag.tags]
+    assert not untagged, f"DAGs without tags: {untagged}"
+
+
+def test_every_dag_has_catchup_off(dagbag):
+    catching_up = [dag.dag_id for dag in _dags(dagbag) if dag.catchup is not False]
+    assert not catching_up, f"DAGs with catchup enabled: {catching_up}"
+
+
+def test_every_task_has_a_real_owner(dagbag):
+    bad = [
+        f"{dag_id}.{task.task_id} (owner={task.owner!r})"
+        for dag_id, task in _tasks(dagbag)
+        if not (task.owner or "").strip() or task.owner.strip().lower() == DEFAULT_OWNER
+    ]
+    assert not bad, f"tasks without a real owner: {bad}"
+
+
+def test_every_task_has_enough_retries(dagbag):
+    bad = [
+        f"{dag_id}.{task.task_id} (retries={task.retries})"
+        for dag_id, task in _tasks(dagbag)
+        if (task.retries or 0) < MIN_RETRIES
+    ]
+    assert not bad, f"tasks with fewer than {MIN_RETRIES} retries: {bad}"
