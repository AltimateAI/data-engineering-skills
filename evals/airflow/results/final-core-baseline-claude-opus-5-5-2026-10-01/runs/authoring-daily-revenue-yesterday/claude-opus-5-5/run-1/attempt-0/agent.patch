+"""Publish per-store revenue for the previous UTC calendar day, every day at 03:00 UTC.
+
+Stores upload late orders until about 02:00 UTC the next morning, so the run
+that starts at 03:00 on day D reports on day D-1 (00:00 to 24:00 UTC).
+"""
+
+from __future__ import annotations
+
+import csv
+import os
+from collections import defaultdict
+from datetime import date, datetime, timedelta
+from decimal import ROUND_HALF_UP, Decimal
+from pathlib import Path
+
+import pendulum
+from airflow.sdk import dag, get_current_context, task
+from airflow.timetables.trigger import CronTriggerTimetable
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+
+
+def report_day_for(logical_date: datetime) -> date:
+    """The run at 03:00 UTC on day D reports on day D-1."""
+    return pendulum.instance(logical_date).in_timezone("UTC").date() - timedelta(days=1)
+
+
+def build_report(orders_path: Path, out_dir: Path, day: date) -> Path:
+    start = datetime(day.year, day.month, day.day)
+    end = start + timedelta(days=1)
+
+    counts: dict[str, int] = defaultdict(int)
+    revenue: dict[str, Decimal] = defaultdict(Decimal)
+    with orders_path.open(newline="") as f:
+        for row in csv.DictReader(f):
+            ts = datetime.fromisoformat(row["order_ts"])
+            if start <= ts < end:
+                counts[row["store_id"]] += 1
+                revenue[row["store_id"]] += Decimal(row["amount"])
+
+    out_dir.mkdir(parents=True, exist_ok=True)
+    out = out_dir / f"{day.isoformat()}.csv"
+    tmp = out.with_suffix(".csv.tmp")
+    with tmp.open("w", newline="") as f:
+        writer = csv.writer(f, lineterminator="\n")
+        writer.writerow(["store_id", "orders", "revenue"])
+        for store_id in sorted(counts):
+            amount = revenue[store_id].quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+            writer.writerow([store_id, counts[store_id], f"{amount:.2f}"])
+    os.replace(tmp, out)
+    return out
+
+
+@dag(
+    # CronTriggerTimetable: logical_date is the 03:00 UTC run time itself.
+    schedule=CronTriggerTimetable("0 3 * * *", timezone="UTC"),
+    # First run (2026-09-02 03:00) reports on 2026-09-01.
+    start_date=pendulum.datetime(2026, 9, 2, tz="UTC"),
+    catchup=False,
+    max_active_runs=1,
+    tags=["finance", "revenue"],
+)
+def daily_revenue():
+    @task
+    def publish() -> str:
+        day = report_day_for(get_current_context()["logical_date"])
+        out = build_report(
+            PROJECT_ROOT / "data" / "orders.csv",
+            PROJECT_ROOT / "output" / "daily_revenue",
+            day,
+        )
+        return str(out)
+
+    publish()
+
+
+daily_revenue()
