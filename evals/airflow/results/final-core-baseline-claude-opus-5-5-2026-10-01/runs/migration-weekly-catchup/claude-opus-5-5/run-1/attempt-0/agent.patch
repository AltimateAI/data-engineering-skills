diff --git a/plugins/marketing_alerts.py b/plugins/marketing_alerts.py
new file mode 100644
index 0000000..b14de1f
--- /dev/null
+++ b/plugins/marketing_alerts.py
@@ -0,0 +1,22 @@
+"""Alert callbacks for the marketing DAGs.
+
+Lives in the plugins folder (not dags/) because deadline callbacks are imported by
+dotted path on the triggerer, which only has the plugins folder on ``sys.path``.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta
+
+
+async def notify_growth_oncall(context, **kwargs):
+    """Deadline-miss callback: page the on-call analyst when the Monday report is late."""
+    dag_run = context["dag_run"]
+    due = datetime.fromisoformat(dag_run["data_interval_end"])
+    queued_at = dag_run.get("queued_at")
+    # Season re-runs create runs for weeks that are long past their deadline; only the
+    # current Monday's report should page.
+    if queued_at and datetime.fromisoformat(queued_at) - due >= timedelta(days=7):
+        print(f"Skipping page for catch-up run {dag_run['dag_run_id']} of {dag_run['dag_id']}")
+        return
+    print(f"Deadline missed for {dag_run['dag_run_id']} in {dag_run['dag_id']}")
