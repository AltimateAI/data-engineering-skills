+def previous_business_day(run_time: pendulum.DateTime) -> str:
+    """The New York weekday (Mon-Fri) before ``run_time``, as YYYY-MM-DD."""
+    day = run_time.in_timezone(NY_TZ).date().subtract(days=1)
+    while day.weekday() >= 5:  # Saturday / Sunday
+        day = day.subtract(days=1)
+    return day.isoformat()
 
 
