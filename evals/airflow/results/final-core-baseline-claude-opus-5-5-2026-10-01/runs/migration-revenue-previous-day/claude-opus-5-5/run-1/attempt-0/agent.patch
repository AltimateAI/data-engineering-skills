+def test_daily_revenue_reports_previous_business_day(dagbag):
+    """The 04:15 UTC run on day D+1 must have logical date (ds) D, as on Airflow 2."""
+    dag = dagbag.dags.get("daily_revenue")
+    info = dag.timetable.next_dagrun_info(
+        last_automated_data_interval=None,
+        restriction=TimeRestriction(
+            earliest=pendulum.datetime(2026, 3, 4, 4, 15, tz="UTC"), latest=None, catchup=True
+        ),
+    )
+    assert info.run_after == pendulum.datetime(2026, 3, 5, 4, 15, tz="UTC")
