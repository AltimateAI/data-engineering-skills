@@ -0,0 +1,16 @@
+"""orders_ingest must run extract -> validate -> load -> publish, in that order."""
+
+from __future__ import annotations
+
+EXPECTED_CHAIN = ["extract_orders", "validate_orders", "load_orders", "publish_summary"]
+
+
+def test_orders_ingest_pipeline_order(dagbag):
+    dag = dagbag.dags.get("orders_ingest")
+    assert dag is not None, "orders_ingest DAG not loaded"
+
+    assert set(dag.task_ids) == set(EXPECTED_CHAIN)
+
+    expected_edges = set(zip(EXPECTED_CHAIN, EXPECTED_CHAIN[1:]))
+    actual_edges = {(t.task_id, d) for t in dag.tasks for d in t.downstream_task_ids}
+    assert actual_edges == expected_edges
