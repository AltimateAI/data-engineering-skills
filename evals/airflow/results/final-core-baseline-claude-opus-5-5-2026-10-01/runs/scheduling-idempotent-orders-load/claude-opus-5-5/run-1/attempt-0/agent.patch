+def _interval_day(data_interval_start: pendulum.DateTime) -> date:
+    """The calendar day (UTC) this run is responsible for."""
+    return data_interval_start.in_timezone("UTC").date()
+
+
+def _replace_day(con: duckdb.DuckDBPyConnection, statements: list[tuple[str, list]]) -> None:
+    """Run the given statements atomically: all of them commit, or none do."""
+    con.begin()
+    try:
+        for sql, params in statements:
+            con.execute(sql, params)
+        con.commit()
+    except Exception:
+        con.rollback()
+        raise
+
