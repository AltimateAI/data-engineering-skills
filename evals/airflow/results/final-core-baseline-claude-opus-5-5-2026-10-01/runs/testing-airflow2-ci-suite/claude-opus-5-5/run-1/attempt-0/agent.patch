+"""Shared pytest setup.
+
+Airflow reads its configuration when it is first imported, so the environment
+below has to be in place before any test module imports airflow. Everything
+points at a throwaway AIRFLOW_HOME so the suite never touches a developer's
+~/airflow (or CI's) config or metadata DB.
+"""
+
+from __future__ import annotations
+
+import atexit
+import os
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DAGS_DIR = REPO_ROOT / "dags"
+DATA_DIR = REPO_ROOT / "data"
+
+_AIRFLOW_HOME = Path(tempfile.mkdtemp(prefix="airflow-tests-"))
+atexit.register(shutil.rmtree, _AIRFLOW_HOME, ignore_errors=True)
+
+os.environ.update(
+    {
+        "AIRFLOW_HOME": str(_AIRFLOW_HOME),
+        "AIRFLOW__CORE__DAGS_FOLDER": str(DAGS_DIR),
+        "AIRFLOW__CORE__LOAD_EXAMPLES": "False",
+        "AIRFLOW__CORE__DEFAULT_TIMEZONE": "utc",
+        "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN": f"sqlite:///{_AIRFLOW_HOME / 'airflow.db'}",
+        "AIRFLOW__DATABASE__LOAD_DEFAULT_CONNECTIONS": "False",
+    }
+)
+
+# Airflow puts the dags folder on sys.path; do the same so tests can import
+# DAG modules (e.g. `import shipments_daily`) to unit test their helpers.
+sys.path.insert(0, str(DAGS_DIR))
+
+if "airflow" in sys.modules:  # pragma: no cover - guards against plugin import order
+    raise RuntimeError("airflow was imported before tests/conftest.py could configure it")
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    from airflow.models import DagBag
+
+    bag = DagBag(dag_folder=str(DAGS_DIR), include_examples=False, safe_mode=False)
+    assert not bag.import_errors, f"DAG import errors: {bag.import_errors}"
+    return bag
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """A freshly initialised SQLite metadata DB, only for tests that run DAGs."""
+    from airflow.utils import db
+
+    db.initdb()
+    yield
