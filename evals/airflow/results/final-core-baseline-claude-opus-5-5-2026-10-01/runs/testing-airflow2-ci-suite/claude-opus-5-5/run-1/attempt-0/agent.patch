+"""Structural checks that apply to every DAG in dags/."""
+
+from __future__ import annotations
+
+import pytest
+
+from conftest import DAGS_DIR
+
+DAG_FILES = sorted(p for p in DAGS_DIR.rglob("*.py") if p.name != "__init__.py")
+
+
+def test_dag_files_found():
+    assert DAG_FILES, f"no DAG files found in {DAGS_DIR}"
+
+
+@pytest.mark.parametrize("dag_file", DAG_FILES, ids=lambda p: str(p.relative_to(DAGS_DIR)))
+def test_dag_file_imports(dag_file):
+    from airflow.models import DagBag
+
+    # safe_mode=False: parse every .py file, not just ones that mention "airflow" and "dag".
+    bag = DagBag(dag_folder=str(dag_file), include_examples=False, safe_mode=False)
+    assert not bag.import_errors, bag.import_errors[str(dag_file)]
+
+
+def test_expected_dags_present(dagbag):
+    assert {"shipments_daily", "carrier_rates_weekly"} <= set(dagbag.dag_ids)
+
+
+def test_every_task_has_at_least_two_retries(dagbag):
+    too_few = [
+        f"{dag_id}.{task.task_id} (retries={task.retries})"
+        for dag_id, dag in sorted(dagbag.dags.items())
+        for task in dag.tasks
+        if task.retries < 2
+    ]
+    assert not too_few, f"tasks with fewer than 2 retries: {too_few}"
