+"""shipments_daily: schedule, task wiring, late-shipment rules, end-to-end run."""
+
+from __future__ import annotations
+
+import csv
+from datetime import datetime, timezone
+
+import pytest
+
+DAG_ID = "shipments_daily"
+
+
+@pytest.fixture(scope="module")
+def dag(dagbag):
+    return dagbag.dags[DAG_ID]
+
+
+# --- schedule ---------------------------------------------------------------
+
+
+def test_schedule_is_weekdays_0730_utc(dag):
+    assert dag.timezone.name == "UTC"
+
+    # Two full weeks starting Monday 2026-03-02.
+    runs = [
+        info.logical_date
+        for info in dag.iter_dagrun_infos_between(
+            datetime(2026, 3, 2, tzinfo=timezone.utc),
+            datetime(2026, 3, 15, 23, 59, tzinfo=timezone.utc),
+        )
+    ]
+    expected = [
+        datetime(2026, 3, day, 7, 30, tzinfo=timezone.utc)
+        for day in (2, 3, 4, 5, 6, 9, 10, 11, 12, 13)
+    ]
+    assert runs == expected
+
+
+# --- dependencies -----------------------------------------------------------
+
+
+def test_report_only_built_after_extract(dag):
+    from airflow.utils.trigger_rule import TriggerRule
+
+    extract = dag.get_task("extract_shipments")
+    report = dag.get_task("build_report")
+    assert extract.task_id in report.get_flat_relative_ids(upstream=True)
+
+    # Every task on a path from extract to report must wait for its upstreams to
+    # succeed; otherwise the report could run after a failed/skipped extract.
+    between = (
+        extract.get_flat_relative_ids(upstream=False) & report.get_flat_relative_ids(upstream=True)
+    ) | {report.task_id}
+    loose = {t: dag.get_task(t).trigger_rule for t in between}
+    assert all(rule == TriggerRule.ALL_SUCCESS for rule in loose.values()), loose
+
+
+# --- late-shipment rules ----------------------------------------------------
+
+RUN_DATE = "2026-03-03"
+
+
+def find_late_shipments(rows, as_of):
+    # Imported lazily so a broken DAG file shows up as a failing import test
+    # rather than aborting collection of the whole suite.
+    from shipments_daily import find_late_shipments as impl
+
+    return impl(rows, as_of=as_of)
+
+
+def shipment(shipment_id, promised, delivered="", ship_date="2026-02-20", carrier="DHL"):
+    return {
+        "shipment_id": shipment_id,
+        "ship_date": ship_date,
+        "carrier": carrier,
+        "promised_date": promised,
+        "delivered_date": delivered,
+    }
+
+
+def late_days(rows, as_of=RUN_DATE):
+    return {r["shipment_id"]: r["days_late"] for r in find_late_shipments(rows, as_of=as_of)}
+
+
+@pytest.mark.parametrize(
+    "promised, delivered, expected_days",
+    [
+        # delivered on the run date
+        pytest.param("2026-03-02", RUN_DATE, 1, id="delivered-today-1-day-late"),
+        pytest.param("2026-02-26", RUN_DATE, 5, id="delivered-today-late-across-month-end"),
+        pytest.param(RUN_DATE, RUN_DATE, None, id="delivered-today-on-promised-date"),
+        pytest.param("2026-03-05", RUN_DATE, None, id="delivered-today-early"),
+        # delivered some other day: not part of this run's report
+        pytest.param("2026-02-24", "2026-03-02", None, id="delivered-late-yesterday"),
+        pytest.param("2026-02-24", "2026-02-24", None, id="delivered-on-time-earlier"),
+        # still open
+        pytest.param("2026-03-02", "", 1, id="open-promised-yesterday"),
+        pytest.param("2026-02-26", "", 5, id="open-promised-across-month-end"),
+        pytest.param(RUN_DATE, "", None, id="open-promised-today"),
+        pytest.param("2026-03-06", "", None, id="open-promised-future"),
+    ],
+)
+def test_late_rules(promised, delivered, expected_days):
+    result = late_days([shipment("SH-1", promised, delivered)])
+    if expected_days is None:
+        assert result == {}
+    else:
+        assert result == {"SH-1": expected_days}
+
+
+def test_late_rules_mixed_batch_keeps_input_fields():
+    rows = [
+        shipment("A", "2026-03-01", RUN_DATE, carrier="UPS"),
+        shipment("B", "2026-02-28", "", carrier="FedEx"),
+        shipment("C", RUN_DATE, RUN_DATE),
+        shipment("D", "2026-03-04", ""),
+    ]
+    late = {r["shipment_id"]: r for r in find_late_shipments(rows, as_of=RUN_DATE)}
+    assert set(late) == {"A", "B"}
+    assert late["A"] == {**rows[0], "days_late": 2}
+    assert late["B"] == {**rows[1], "days_late": 3}
+
+
+def test_late_rules_empty_input():
+    assert find_late_shipments([], as_of=RUN_DATE) == []
+
+
+# --- end to end -------------------------------------------------------------
+
+
+@pytest.mark.usefixtures("airflow_db")
+def test_end_to_end_on_sample_data(dag, tmp_path, monkeypatch):
+    from airflow.utils.state import DagRunState, TaskInstanceState
+    from shipments_daily import REPORT_COLUMNS
+
+    # The DAG writes to <repo>/output/; redirect it so the test neither pollutes
+    # the checkout nor passes on a stale file from an earlier run.
+    report_globals = dag.get_task("build_report").python_callable.__globals__
+    monkeypatch.setitem(report_globals, "OUTPUT_DIR", tmp_path)
+
+    dag_run = dag.test(execution_date=datetime(2026, 3, 3, tzinfo=timezone.utc))
+
+    states = {ti.task_id: ti.state for ti in dag_run.get_task_instances()}
+    assert states == {t: TaskInstanceState.SUCCESS for t in dag.task_ids}
+    assert dag_run.state == DagRunState.SUCCESS
+
+    with (tmp_path / "2026-03-03.csv").open(newline="") as fh:
+        reader = csv.reader(fh)
+        header, *rows = list(reader)
+
+    assert header == REPORT_COLUMNS
+    assert rows == [
+        ["SH-1009", "DHL", "2026-02-26", "", "5"],
+        ["SH-1003", "FedEx", "2026-02-28", "", "3"],
+        ["SH-1007", "UPS", "2026-03-01", "2026-03-03", "2"],
+        ["SH-1001", "DHL", "2026-03-02", "2026-03-03", "1"],
+    ]
