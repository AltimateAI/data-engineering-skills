+++ b/tests/test_structure.py
@@ -0,0 +1,29 @@
+EXPECTED_DAGS = {"shipments_daily", "carrier_rates_weekly"}
+
+
+def test_no_import_errors(dagbag):
+    assert dagbag.import_errors == {}, "\n\n".join(
+        f"{f}:\n{e}" for f, e in dagbag.import_errors.items()
+    )
+
+
+def test_expected_dags_load(dagbag):
+    assert EXPECTED_DAGS <= set(dagbag.dags)
+
+
+def test_every_task_has_at_least_two_retries(dagbag):
+    assert dagbag.dags, "no DAGs loaded"
+    bad = [
+        (d.dag_id, t.task_id, t.retries)
+        for d in dagbag.dags.values()
+        for t in d.tasks
+        if t.retries < 2
+    ]
+    assert not bad, bad
+
+
+def test_shipments_report_runs_after_extract(dagbag):
+    dag = dagbag.dags["shipments_daily"]
+    assert "extract_shipments" in dag.get_task("build_report").get_flat_relative_ids(upstream=True)
+    # and not the other way round
+    assert "build_report" not in dag.get_task("extract_shipments").get_flat_relative_ids(upstream=True)
