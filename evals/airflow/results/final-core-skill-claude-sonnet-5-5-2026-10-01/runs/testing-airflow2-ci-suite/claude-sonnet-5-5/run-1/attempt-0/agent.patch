+++ b/tests/test_schedule.py
@@ -0,0 +1,13 @@
+from datetime import datetime, timezone
+
+
+def test_shipments_daily_weekdays_0730_utc(dagbag, upcoming_runs):
+    dag = dagbag.dags["shipments_daily"]
+    # three weeks, so every weekday and a weekend are crossed several times
+    runs = upcoming_runs(dag, datetime(2026, 3, 2, tzinfo=timezone.utc), 15)
+    assert len(runs) == 15
+    fire_times = [r for r, _ in runs]
+    assert {r.weekday() for r in fire_times} == {0, 1, 2, 3, 4}
+    assert all((r.hour, r.minute, r.utcoffset().total_seconds()) == (7, 30, 0) for r in fire_times)
+    # five runs per calendar week: none skipped
+    assert len({r.date() for r in fire_times}) == 15
