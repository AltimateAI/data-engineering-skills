@@ -0,0 +1,25 @@
+import csv
+from datetime import datetime, timezone
+
+import pytest
+
+RUN_DATE = "2026-03-03"
+
+
+def test_shipments_daily_end_to_end(dagbag, airflow_db, task_global, tmp_path):
+    dag = dagbag.dags["shipments_daily"]
+    task_global(dag, "build_report", "OUTPUT_DIR", tmp_path)  # keep the repo's output/ clean
+
+    dr = dag.test(execution_date=datetime(2026, 3, 3, tzinfo=timezone.utc))
+    states = {ti.task_id: ti.state for ti in dr.get_task_instances()}
+    assert dr.state == "success", states
+
+    out = tmp_path / f"{RUN_DATE}.csv"
+    assert out.exists()
+    with out.open(newline="") as fh:
+        rows = list(csv.DictReader(fh))
+    got = {r["shipment_id"]: int(r["days_late"]) for r in rows}
+
+    # worked out by hand from data/shipments.csv for 2026-03-03
+    assert got == {"SH-1009": 5, "SH-1003": 3, "SH-1007": 2, "SH-1001": 1}
+    assert [r["shipment_id"] for r in rows] == ["SH-1009", "SH-1003", "SH-1007", "SH-1001"]
diff --git a/tests/test_shipments_rules.py b/tests/test_shipments_rules.py
new file mode 100644
index 0000000..79d540b
--- /dev/null
+++ b/tests/test_shipments_rules.py
@@ -0,0 +1,69 @@
+import pytest
+
+from shipments_daily import find_late_shipments
+
+
+def ship(sid, promised, delivered="", ship_date="2026-02-01"):
+    return {
+        "shipment_id": sid,
+        "ship_date": ship_date,
+        "carrier": "X",
+        "promised_date": promised,
+        "delivered_date": delivered,
+    }
+
+
+AS_OF = "2026-03-10"
+
+
+def result(rows):
+    return {r["shipment_id"]: r["days_late"] for r in find_late_shipments(rows, AS_OF)}
+
+
+def test_delivered_today_after_promise_is_late():
+    assert result([ship("a", "2026-03-08", "2026-03-10")]) == {"a": 2}
+
+
+def test_delivered_today_one_day_after_promise():
+    assert result([ship("a", "2026-03-09", "2026-03-10")]) == {"a": 1}
+
+
+def test_delivered_today_on_promised_date_is_not_late():
+    assert result([ship("a", "2026-03-10", "2026-03-10")]) == {}
+
+
+def test_delivered_today_before_promise_is_not_late():
+    assert result([ship("a", "2026-03-12", "2026-03-10")]) == {}
+
+
+def test_delivered_on_another_day_is_not_reported_today():
+    # late when delivered, but that was reported on its own run date
+    assert result([ship("a", "2026-03-05", "2026-03-08")]) == {}
+    assert result([ship("a", "2026-03-05", "2026-03-11")]) == {}
+
+
+def test_undelivered_with_past_promise_is_late_counting_to_run_date():
+    assert result([ship("a", "2026-03-09"), ship("b", "2026-03-05")]) == {"a": 1, "b": 5}
+
+
+def test_undelivered_promised_today_or_later_is_not_late():
+    assert result([ship("a", "2026-03-10"), ship("b", "2026-03-11")]) == {}
+
+
+def test_days_late_counts_across_month_boundary():
+    assert result([ship("a", "2026-02-27")]) == {"a": 11}
+
+
+def test_each_branch_together_and_sorted_worst_first():
+    rows = [
+        ship("d", "2026-03-10", "2026-03-10"),  # on time
+        ship("c", "2026-03-09", "2026-03-10"),  # 1
+        ship("b", "2026-03-01"),  # 9
+        ship("a", "2026-03-01", "2026-03-10"),  # 9, ties by id
+    ]
+    out = find_late_shipments(rows, AS_OF)
+    assert [(r["shipment_id"], r["days_late"]) for r in out] == [("a", 9), ("b", 9), ("c", 1)]
+
+
+def test_empty_input():
+    assert find_late_shipments([], AS_OF) == []
