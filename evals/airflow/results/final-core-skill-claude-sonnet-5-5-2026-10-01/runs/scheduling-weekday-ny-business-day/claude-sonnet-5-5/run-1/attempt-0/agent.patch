+def previous_business_day(run_time) -> str:
+    """Previous Mon-Fri before the New York calendar day of ``run_time``."""
+    day = pendulum.instance(run_time).in_tz(NY).date()
+    day = day.subtract(days=1)
+    while day.weekday() >= 5:
+        day = day.subtract(days=1)
+    return day.to_date_string()
 
 
