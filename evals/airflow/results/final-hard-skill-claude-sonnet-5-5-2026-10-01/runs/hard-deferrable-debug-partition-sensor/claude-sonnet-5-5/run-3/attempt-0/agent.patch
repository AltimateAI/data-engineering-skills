+    def _anchor(self, context) -> float:
+        """Epoch second at which this task first started waiting in this DAG run (kept across retries)."""
+        store = context["task_state_store"]
+        started = store.get("wait_started")
+        if started is None:
+            started = time.time()
+            store.set("wait_started", started)
+        return float(started)
+
+    def _is_last_try(self, context) -> bool:
+        return context["ti"].try_number > self.retries
+
+    def _timed_out(self, context):
+        context["task_state_store"].delete("wait_started")
+        msg = f"{self.table}/{self.partition} was not published within {self.timeout}s"
+        if self.soft_fail:
+            raise AirflowSkipException(msg)
+        raise AirflowSensorTimeout(msg)
+
     def execute(self, context) -> Any:
         if not self.deferrable:
             return super().execute(context)
+        deadline = self._anchor(context) + self.timeout
+        remaining = deadline - time.time()
+        if remaining <= 0:
+            self._timed_out(context)
         self.defer(
             trigger=PartitionPublishedTrigger(
                 table=self.table,
                 partition=self.partition,
-                timeout=self.timeout,
+                deadline=deadline,
                 lake_conn_id=self.lake_conn_id,
                 poll_interval=self.poke_interval,
             ),
             method_name="execute_complete",
+            timeout=timedelta(seconds=remaining + 30),
         )
 
     def execute_complete(self, context, event: dict[str, Any]) -> list[str]:
-        if event["status"] == "timeout":
-            raise AirflowException(f"{self.table}/{self.partition} was not published within {self.timeout}s")
-        files = event.get("files", [])
+        status = event["status"]
+        if status == "timeout":
+            self._timed_out(context)
+        if status == "error":
+            if self._is_last_try(context):
+                context["task_state_store"].delete("wait_started")
+            # not an AirflowException: fails this try (retried), even under soft_fail
+            raise LakeApiError(event["message"])
+        context["task_state_store"].delete("wait_started")
+        files = event["files"]
         self.log.info("%s/%s published with %d files", self.table, self.partition, len(files))
         return files
