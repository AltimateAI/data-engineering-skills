+def load_fleet() -> dict:
+    wanted = get_parsing_context().dag_id
+    paths = sorted(CONFIG_DIR.glob("*.yaml"))
+    if wanted:
+        # a worker needs one DAG: the config is named after its dag_id
+        direct = CONFIG_DIR / f"{wanted}.yaml"
+        if direct in paths:
+            paths = [direct]
+    dags = {}
+    for path in paths:
+        try:
+            cfg = parse_config(path)
+            if wanted and cfg["name"] != wanted:
+                continue
+            dag = build_dag(path, cfg)
+        except Exception as exc:  # one broken config must not take out the others
+            log.error("Skipping pipeline config %s: %s: %s", path, type(exc).__name__, exc)
+            continue
+        if dag.dag_id in dags:
+            log.error("Skipping pipeline config %s: duplicate dag_id %r", path, dag.dag_id)
+            continue
+        dags[dag.dag_id] = dag
+    return dags
+
+
+globals().update(load_fleet())
