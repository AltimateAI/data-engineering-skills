+for config_path in _config_paths():
+    try:
+        _built = build_dag(config_path)
+    except Exception as exc:  # a broken config only takes out its own DAG
+        log.error("Skipping pipeline config %s: %s: %s", config_path, type(exc).__name__, exc)
+        continue
+    globals()[_built.dag_id] = _built
