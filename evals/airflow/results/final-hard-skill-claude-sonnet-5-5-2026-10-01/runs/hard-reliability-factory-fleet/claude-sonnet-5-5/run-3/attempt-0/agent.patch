+def config_paths() -> list[Path]:
+    wanted = get_parsing_context().dag_id
+    if wanted:
+        # A worker only needs the DAG its task belongs to; configs are named after their dag_id.
+        path = CONFIG_DIR / f"{wanted}.yaml"
+        if path.is_file():
+            return [path]
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+def build_fleet() -> dict[str, DAG]:
+    paths = config_paths()
+    if not paths:
+        return {}
+    registry = load_yaml(REGISTRY)
+    wanted = get_parsing_context().dag_id
+    dags: dict[str, DAG] = {}
+    for path in paths:
+        try:
+            dag = build_dag(path, registry)
+        except Exception as exc:  # a broken config only takes out its own DAG
+            log.error("Skipping pipeline config %s: %s: %s", path, type(exc).__name__, exc)
+            continue
+        if wanted and dag.dag_id != wanted:
+            continue
+        if dag.dag_id in dags:
+            log.error("Skipping pipeline config %s: duplicate dag_id %r", path, dag.dag_id)
+            continue
+        dags[dag.dag_id] = dag
+    return dags
+
+
