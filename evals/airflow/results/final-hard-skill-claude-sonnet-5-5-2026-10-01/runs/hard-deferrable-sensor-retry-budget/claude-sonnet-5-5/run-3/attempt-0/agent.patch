diff --git a/dags/partners/triggers.py b/dags/partners/triggers.py
new file mode 100644
index 0000000..758ab7d
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,72 @@
+"""Trigger that waits for a partner's daily manifest."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator
+from datetime import datetime, timezone
+from typing import Any
+
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestApiError, ManifestHook
+
+
+class ManifestPublishedTrigger(BaseTrigger):
+    """Poll the manifest API until published or until the absolute ``deadline``.
+
+    Events: ``{"status": "published", "files": [...]}``, ``{"status": "timeout"}``,
+    ``{"status": "error", "message": ...}`` (API error: the sensor fails the try and retries).
+    """
+
+    def __init__(
+        self,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        deadline: datetime,
+        poll_interval: float,
+        request_timeout: float = 20.0,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.deadline = deadline
+        self.poll_interval = poll_interval
+        self.request_timeout = request_timeout
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "deadline": self.deadline,
+                "poll_interval": self.poll_interval,
+                "request_timeout": self.request_timeout,
+            },
+        )
+
+    def _remaining(self) -> float:
+        return (self.deadline - datetime.now(timezone.utc)).total_seconds()
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id, self.request_timeout)
+        while True:
+            remaining = self._remaining()
+            if remaining <= 0:
+                yield TriggerEvent({"status": "timeout"})
+                return
+            try:
+                manifest = await hook.aget_manifest(
+                    self.partner, self.ds, timeout=min(self.request_timeout, remaining)
+                )
+            except ManifestApiError as exc:
+                yield TriggerEvent({"status": "error", "message": str(exc)})
+                return
+            if manifest.get("status") == "PUBLISHED":
+                yield TriggerEvent({"status": "published", "files": manifest["files"]})
+                return
+            await asyncio.sleep(max(0.0, min(self.poll_interval, self._remaining())))
