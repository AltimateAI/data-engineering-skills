@@ -26,12 +35,64 @@ class PartnerManifestSensor(BaseSensorOperator):
         partner: str,
         ds: str = "{{ ds }}",
         manifest_conn_id: str = ManifestHook.default_conn_name,
+        deferrable: bool = True,
         **kwargs: Any,
     ) -> None:
         super().__init__(**kwargs)
         self.partner = partner
         self.ds = ds
         self.manifest_conn_id = manifest_conn_id
+        self.deferrable = deferrable
+
+    def _end_of_budget(self, message: str):
+        if self.soft_fail:
+            raise AirflowSkipException(message)
+        raise AirflowSensorTimeout(message)
+
+    def execute(self, context):
+        if not self.deferrable:
+            return super().execute(context)
+        store = context.get("task_state_store")
+        if store is None:
+            raise AirflowFailException("task_state_store unavailable: cannot keep the timeout across retries")
+        now = datetime.now(timezone.utc)
+        started = store.get(ANCHOR_KEY)
+        if started is None:
+            store.set(ANCHOR_KEY, now.isoformat())
+            anchor = now
+        else:
+            anchor = datetime.fromisoformat(started)
+        deadline = anchor + timedelta(seconds=self.timeout)
+        if now >= deadline:
+            store.delete(ANCHOR_KEY)
+            self._end_of_budget(f"Manifest for {self.partner}/{self.ds} not published within {self.timeout}s")
+        self.defer(
+            trigger=ManifestPublishedTrigger(
+                partner=self.partner,
+                ds=self.ds,
+                manifest_conn_id=self.manifest_conn_id,
+                deadline=deadline,
+                poll_interval=self.poke_interval,
+            ),
+            method_name="execute_complete",
+            timeout=deadline - now + DEFER_TIMEOUT_SLACK,
+        )
+
+    def execute_complete(self, context, event: dict[str, Any] | None = None, **_):
+        store = context.get("task_state_store")
+        status = (event or {}).get("status")
+        ti = context["ti"]
+        if status == "error" and ti.try_number <= ti.max_tries:
+            # Keep the anchor: the retry continues the same budget.
+            raise ManifestApiError(event["message"])
+        if store is not None:
+            store.delete(ANCHOR_KEY)
+        if status == "published":
+            return event["files"]
+        if status == "timeout":
+            self._end_of_budget(f"Manifest for {self.partner}/{self.ds} not published within {self.timeout}s")
+        # not an AirflowException: fails the try (retries apply), also under soft_fail
+        raise ManifestApiError((event or {}).get("message", f"unexpected event {event!r}"))
 
     def poke(self, context) -> PokeReturnValue | bool:
