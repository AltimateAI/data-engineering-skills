 from __future__ import annotations
 
+import httpx
 import requests
 from airflow.sdk import BaseHook
 
@@ -43,3 +44,16 @@ class ManifestHook(BaseHook):
         if resp.status_code != 200:
             raise ManifestApiError(f"GET {url} -> HTTP {resp.status_code}")
         return resp.json()
+
+    async def aget_manifest(self, partner: str, ds: str, timeout: float | None = None) -> dict:
+        """Async twin of :meth:`get_manifest` for triggers; never blocks the event loop."""
+        conn = await BaseHook.aget_connection(self.manifest_conn_id)
+        url, headers = self.url_and_headers(conn, partner, ds)
+        try:
+            async with httpx.AsyncClient(timeout=timeout or self.request_timeout) as client:
+                resp = await client.get(url, headers=headers)
+            if resp.status_code != 200:
+                raise ManifestApiError(f"GET {url} -> HTTP {resp.status_code}")
+            return resp.json()
+        except (httpx.HTTPError, ValueError) as exc:
+            raise ManifestApiError(f"GET {url} failed: {exc!r}") from exc
