+                partner=self.partner,
+                ds=self.ds,
+                manifest_conn_id=self.manifest_conn_id,
+                deadline=deadline,
+                poll_interval=self.poke_interval,
+            ),
+            method_name="execute_complete",
+            timeout=deadline - now + _DEFER_SLACK,
+        )
+
+    def execute_complete(self, context, event: dict[str, Any] | None = None, **_: Any) -> Any:
+        status = (event or {}).get("status")
+        if status == "published":
+            self._clear_anchor(context)
+            return event["files"]
+        if status == "timeout":
+            self._clear_anchor(context)
+            raise AirflowSensorTimeout(f"No manifest for {self.partner}/{self.ds} within {self.timeout}s")
+        # API error: keep the anchor so the retry continues the same budget, except on the last try.
+        ti = context["ti"]
+        if ti.try_number > ti.max_tries:
+            self._clear_anchor(context)
+        # Deliberately not an AirflowException: soft_fail would turn that into a skip.
+        raise ManifestApiError((event or {}).get("message", f"unexpected trigger event {event!r}"))
+
+    def resume_execution(self, next_method, next_kwargs, context):
+        try:
+            return super().resume_execution(next_method, next_kwargs, context)
+        except (AirflowSensorTimeout, AirflowSkipException):
+            self._clear_anchor(context)  # e.g. deferral timeout backstop
+            raise
+
+    @staticmethod
+    def _clear_anchor(context) -> None:
+        store = context.get("task_state_store")
+        if store is not None:
+            store.delete(_ANCHOR_KEY)
diff --git a/dags/partners/triggers.py b/dags/partners/triggers.py
new file mode 100644
index 0000000..1731eda
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,71 @@
+"""Trigger that waits for a partner's daily manifest without blocking the triggerer."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator
+from datetime import datetime, timezone
+from typing import Any
+
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestHook
+
+
+class PartnerManifestTrigger(BaseTrigger):
+    """Poll the manifest API until PUBLISHED or until the absolute ``deadline``.
+
+    Events: ``{"status": "published", "files": [...]}``, ``{"status": "timeout"}``,
+    ``{"status": "error", "message": ...}``. Errors are reported as events, not raised, so the
+    sensor decides how the try ends.
+    """
+
+    def __init__(
+        self,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        deadline: datetime,
+        poll_interval: float,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.deadline = deadline
+        self.poll_interval = poll_interval
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "deadline": self.deadline,
+                "poll_interval": self.poll_interval,
+            },
+        )
+
+    def _remaining(self) -> float:
+        return (self.deadline - datetime.now(timezone.utc)).total_seconds()
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id)
+        while True:
+            remaining = self._remaining()
+            if remaining <= 0:
+                yield TriggerEvent({"status": "timeout"})
+                return
+            try:
+                manifest = await asyncio.wait_for(hook.aget_manifest(self.partner, self.ds), remaining)
+            except asyncio.TimeoutError:
+                yield TriggerEvent({"status": "timeout"})
+                return
+            except Exception as exc:  # any failure fails the try; never crash the trigger
+                yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
+                return
+            if manifest.get("status") == "PUBLISHED":
+                yield TriggerEvent({"status": "published", "files": manifest["files"]})
+                return
+            await asyncio.sleep(max(0.0, min(self.poll_interval, self._remaining())))
