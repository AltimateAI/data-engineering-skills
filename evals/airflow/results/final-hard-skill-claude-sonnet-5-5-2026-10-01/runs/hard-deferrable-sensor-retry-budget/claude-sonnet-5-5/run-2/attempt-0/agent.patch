+_DEFER_SLACK = timedelta(seconds=30)
 
 
 class PartnerManifestSensor(BaseSensorOperator):
     """Wait until the partner has published the manifest for ``ds`` and return its file list.
 
+    With ``deferrable=True`` (default) the wait happens in the triggerer. ``timeout`` is then the
+    total wait in the DAG run: the moment the sensor first started waiting is kept in the task
+    state store (it survives retries and triggerer restarts) and the trigger gets the absolute
+    deadline. API errors fail the try (retries apply, also with ``soft_fail``).
+
     :param partner: partner key, e.g. ``acme``
     :param ds: manifest date (templated, usually ``{{ ds }}``)
