+        deferrable: bool = True,
         **kwargs: Any,
     ) -> None:
         super().__init__(**kwargs)
         self.partner = partner
         self.ds = ds
         self.manifest_conn_id = manifest_conn_id
+        self.deferrable = deferrable
 
     def poke(self, context) -> PokeReturnValue | bool:
         manifest = ManifestHook(self.manifest_conn_id).get_manifest(self.partner, self.ds)
         if manifest["status"] == "PUBLISHED":
             return PokeReturnValue(is_done=True, xcom_value=manifest["files"])
         return False
+
+    def execute(self, context) -> Any:
+        if not self.deferrable:
+            return super().execute(context)
+
+        now = datetime.now(timezone.utc)
+        store = context.get("task_state_store")
+        anchor = None
+        if store is not None and (raw := store.get(_ANCHOR_KEY)):
+            anchor = datetime.fromisoformat(raw)
+        if anchor is None:
+            anchor = now
+            if store is not None:
+                retention = timedelta(seconds=self.timeout, days=1)
+                store.set(_ANCHOR_KEY, anchor.isoformat(), retention=retention)
+        deadline = anchor + timedelta(seconds=self.timeout)
+
+        if now >= deadline:
+            self._clear_anchor(context)
+            msg = f"No manifest for {self.partner}/{self.ds} within {self.timeout}s"
+            if self.soft_fail or self.never_fail:
+                raise AirflowSkipException(msg)
+            raise AirflowSensorTimeout(msg)
