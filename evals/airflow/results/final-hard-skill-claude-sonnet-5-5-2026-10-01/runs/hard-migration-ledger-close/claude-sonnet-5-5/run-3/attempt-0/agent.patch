+def run_interval(dag_run) -> tuple[pendulum.DateTime, pendulum.DateTime]:
+    """Business day a run covers. Manual runs have no data interval on Airflow 3:
+    use the latest weekday that has ended, as the timetable did on 2.x."""
+    start, end = dag_run.data_interval_start, dag_run.data_interval_end
+    if start is None or end is None:
+        interval = WorkdayTimetable().infer_manual_data_interval(run_after=pendulum.instance(dag_run.run_after))
+        return interval.start, interval.end
+    return pendulum.instance(start), pendulum.instance(end)
+
