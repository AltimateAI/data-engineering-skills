+            # (also the server-side deferral timeout, which the base class turns into one), a
+            # skip, a hard failure, or an error on the last try. A stale anchor would make a later
+            # manual re-run time out at once.
+            if isinstance(exc, (AirflowSensorTimeout, AirflowSkipException, AirflowFailException)) or self._is_last_try(context):
