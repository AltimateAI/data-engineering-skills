+        ti = context.get("ti")
+        try_number = getattr(ti, "try_number", None)
+        max_tries = getattr(ti, "max_tries", None)
+        if try_number is None or max_tries is None:
+            return True
+        return try_number > max_tries
+
+    _ANCHOR_KEY = "lake_partition_wait_started_at"
+
+    def _anchor_variable_key(self, context) -> str:
+        ti = context["ti"]
+        return f"lake_wait_started:{ti.dag_id}:{ti.run_id}:{ti.task_id}:{getattr(ti, 'map_index', -1)}"
