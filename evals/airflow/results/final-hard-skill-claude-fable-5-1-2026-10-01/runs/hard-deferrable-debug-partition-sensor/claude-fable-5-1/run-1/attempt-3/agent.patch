+    def _wait_started_at(self, context, now: float) -> float:
+        """Epoch time this task first started waiting in this DAG run; recorded on the first try.
+
+        Kept in the task state store (Airflow 3.3+, scoped to the DAG run, task and map index and
+        preserved across retries), or in a Variable keyed by run and task where the store is not
+        available. XComs cannot be used: a retry clears them before the task runs.
+        """
+        store = context.get("task_state_store")
+        if store is not None:
+            raw = store.get(self._ANCHOR_KEY)
+            if raw is None:
+                store.set(self._ANCHOR_KEY, now)
+                return now
+            return float(raw)
+        key = self._anchor_variable_key(context)
+        raw = Variable.get(key, default=None)
+        if raw is None:
+            Variable.set(key, str(now))  # the 3.x Task SDK accepts only str values
+            return now
+        return float(raw)
+
+    def _forget_wait(self, context) -> None:
+        try:
+            store = context.get("task_state_store")
+            if store is not None:
+                store.delete(self._ANCHOR_KEY)
+            else:
+                Variable.delete(self._anchor_variable_key(context))
+        except Exception:  # never let bookkeeping mask the real outcome
+            self.log.warning("could not clear the wait anchor for %s/%s", self.table, self.partition, exc_info=True)
