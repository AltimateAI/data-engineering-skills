+    def execute_complete(self, context, event: dict[str, Any] | None = None) -> list[str]:
+        status = event.get("status") if isinstance(event, dict) else None
+        if status == "published":
+            self._forget_wait(context)
+            files = list(event.get("files") or [])
+            self.log.info("%s/%s published with %d files", self.table, self.partition, len(files))
+            return files
+        if status == "timeout":
+            now = time.time()
+            started = self._wait_started_at(context, now)
+            self._forget_wait(context)
+            self._timed_out(now - started)
+        if status == "error":
+            raise LakeApiError(f"catalog API error while waiting for {self.table}/{self.partition}: {event.get('message')}")
