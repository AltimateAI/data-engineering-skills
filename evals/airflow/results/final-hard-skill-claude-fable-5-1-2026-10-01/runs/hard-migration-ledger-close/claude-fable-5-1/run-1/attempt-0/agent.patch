--- a/plugins/ledger_lib/workdays.py
+++ b/plugins/ledger_lib/workdays.py
@@ -52,3 +52,18 @@ class WorkdayTimetable(Timetable):
         if restriction.latest is not None and start > restriction.latest:
             return None
         return DagRunInfo.interval(start=start, end=start.add(days=1))
+
+
+def close_interval(dag_run) -> DataInterval:
+    """The business day (UTC) a ``daily_close`` run closes.
+
+    A scheduled run carries it as its data interval. A manual trigger
+    (``airflow dags trigger daily_close``) has no logical date or data interval on
+    Airflow 3, so it is inferred from the trigger time the way Airflow 2 did: the
+    latest weekday that has fully ended.
+    """
+    start, end = dag_run.data_interval_start, dag_run.data_interval_end
+    if start is not None and end is not None:
+        return DataInterval(start=pendulum.instance(start).in_tz("UTC"),
+                            end=pendulum.instance(end).in_tz("UTC"))
+    return WorkdayTimetable().infer_manual_data_interval(run_after=pendulum.instance(dag_run.run_after))
