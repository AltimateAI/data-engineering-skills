+def close_interval(dag_run) -> DataInterval:
+    """Business day closed by this ``daily_close`` run, as [start, end).
+
+    Scheduled runs carry their data interval. A plain ``airflow dags trigger``
+    (the ops runbook) has no logical date and no data interval on Airflow 3;
+    Airflow 2 inferred one from the trigger time, so do the same here: the latest
+    weekday that has fully ended before the trigger.
+    """
+    start, end = dag_run.data_interval_start, dag_run.data_interval_end
+    if start is not None and end is not None:
+        return DataInterval(start=pendulum.instance(start), end=pendulum.instance(end))
+    run_after = getattr(dag_run, "run_after", None) or dag_run.logical_date
+    return WorkdayTimetable().infer_manual_data_interval(run_after=pendulum.instance(run_after))
+
+
