diff --git a/plugins/ledger_lib/runs.py b/plugins/ledger_lib/runs.py
new file mode 100644
index 0000000..1ebccbf
--- /dev/null
+++ b/plugins/ledger_lib/runs.py
@@ -0,0 +1,38 @@
+"""What a DAG run covers, for scheduled and manually triggered runs alike.
+
+On Airflow 2 a plain ``airflow dags trigger`` gave the run a logical date (the
+trigger time) and the data interval the timetable inferred from it, so ``ds``,
+``data_interval_*`` and ``next_ds``/``prev_ds`` were always set. On Airflow 3 such
+a run carries only ``dag_run.run_after`` (the trigger time); these helpers rebuild
+the Airflow 2 values from it so every DAG keeps writing the same files.
+"""
+
+from __future__ import annotations
+
+import pendulum
+from airflow.timetables.base import Timetable
+
+
+def is_manual(dag_run) -> bool:
+    """True when a person started the run (Airflow 2: ``dag_run.external_trigger``)."""
+    run_type = dag_run.run_type
+    return getattr(run_type, "value", run_type) == "manual"
+
+
+def run_date(dag_run) -> pendulum.DateTime:
+    """The UTC date-time ``ds``/``ts`` are built from: the logical date, or the trigger time."""
+    return pendulum.instance(dag_run.logical_date or dag_run.run_after).in_tz("UTC")
+
+
+def run_ds(dag_run) -> str:
+    """Airflow 2 ``ds`` of the run (YYYY-MM-DD)."""
+    return run_date(dag_run).to_date_string()
+
+
+def run_interval(dag_run, timetable: Timetable) -> tuple[pendulum.DateTime, pendulum.DateTime]:
+    """Airflow 2 data interval: the scheduled interval, or the one the timetable infers
+    from the trigger time of a manual run (Airflow 3 leaves it empty)."""
+    if dag_run.data_interval_start is not None and dag_run.data_interval_end is not None:
+        return pendulum.instance(dag_run.data_interval_start), pendulum.instance(dag_run.data_interval_end)
+    interval = timetable.infer_manual_data_interval(run_after=pendulum.instance(dag_run.run_after))
+    return pendulum.instance(interval.start), pendulum.instance(interval.end)
