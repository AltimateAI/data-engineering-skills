diff --git a/plugins/claims_lib/__init__.py b/plugins/claims_lib/__init__.py
index a96afa0..759f9c8 100644
--- a/plugins/claims_lib/__init__.py
+++ b/plugins/claims_lib/__init__.py
@@ -1,7 +1,38 @@
 """Shared code for the claims DAGs (on sys.path via the plugins folder)."""
 
+from __future__ import annotations
+
+from datetime import datetime
 from pathlib import Path
 
+import pendulum
+
 PROJECT_ROOT = Path(__file__).resolve().parents[2]
 LAKE = PROJECT_ROOT / "output" / "lake"
 MARTS = PROJECT_ROOT / "output" / "marts"
+
+
+def trigger_time(dag_run) -> pendulum.DateTime:
+    """When this run was triggered.
+
+    Scheduled runs keep their logical date. A manual trigger (``airflow dags
+    trigger`` / UI / API) has no logical date on Airflow 3, so its trigger time
+    is ``run_after``, which is what ``logical_date`` was for such runs on
+    Airflow 2.
+    """
+    return pendulum.instance(dag_run.logical_date or dag_run.run_after)
+
+
+def run_day(ds: str | None, dag_run) -> str:
+    """``ds`` of a scheduled run; the trigger date of a manual run (as on Airflow 2)."""
+    return ds if ds is not None else trigger_time(dag_run).to_date_string()
+
+
+def manual_interval(cron: str, dag_run) -> tuple[datetime, datetime]:
+    """Data interval Airflow 2 gave a manual trigger: the latest closed period before run_after."""
+    from airflow.timetables.interval import CronDataIntervalTimetable
+
+    interval = CronDataIntervalTimetable(cron, timezone="UTC").infer_manual_data_interval(
+        run_after=pendulum.instance(dag_run.run_after)
+    )
+    return interval.start, interval.end
