+def register(path: Path) -> DAG | None:
+    """Build one config's DAG; on any error log the config file and skip it."""
+    try:
+        dag = build_dag(path)
+    except Exception as exc:  # one bad file must not take out the rest of the fleet
+        log.error("Skipping pipeline config %s: %s: %s", path, type(exc).__name__, exc)
