+def config_paths() -> list[Path]:
+    """Configs to build in this process.
+
+    A worker parsing the file to run one task sets the parsing context to that
+    task's dag_id; then only that config is read.  Config files are named after
+    their dag_id, so the lookup is a single path check.  Anything else (the DAG
+    processor, ``airflow dags list``, tests) builds the whole fleet.
+    """
+    wanted = get_parsing_context().dag_id
+    if wanted:
+        candidate = CONFIG_DIR / f"{wanted}.yaml"
+        if candidate.is_file():
+            return [candidate]
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+for _config_path in config_paths():
+    _built = register(_config_path)
+    if _built is not None and get_parsing_context().dag_id not in (None, _built.dag_id):
+        # The file was named after a different dag_id: fall back to the full fleet.
+        del globals()[_built.dag_id]
+        for _config_path in sorted(CONFIG_DIR.glob("*.yaml")):
+            register(_config_path)
+        break
+
