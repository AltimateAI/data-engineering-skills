+def config_paths() -> list[Path]:
+    """The configs to build this parse.
+
+    A worker parsing the file to run one task sets the parsing context to that
+    task's DAG id; then only that pipeline's config is read. Config files are
+    named after their dag_id (validate_config enforces it), so the lookup is a
+    single stat, not a scan of all configs.
+    """
+    wanted = get_parsing_context().dag_id
+    if wanted:
+        candidate = CONFIG_DIR / f"{wanted}.yaml"
+        if candidate.is_file():
+            return [candidate]
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+def build_fleet() -> dict[str, DAG]:
+    registry = load_yaml(REGISTRY)  # once per parse, not once per DAG
+    dags: dict[str, DAG] = {}
+    for path in config_paths():
+        try:
+            built = build_dag(path, registry)
+        except Exception as exc:  # one bad config must not take out the fleet
+            log.error("Skipping pipeline config %s: %s: %s", path.name, type(exc).__name__, exc)
+            warnings.warn(f"pipeline config {path.name} rejected: {type(exc).__name__}: {exc}")
+            continue
+        if built.dag_id in dags:
+            log.error("Skipping pipeline config %s: duplicate dag_id %r", path.name, built.dag_id)
+            continue
+        dags[built.dag_id] = built
+    return dags
+
+
+# Register the good DAGs in module globals; no stray DAG reference is left behind.
+globals().update(build_fleet())
