+
+    async def aget_manifest(self, partner: str, ds: str, client: httpx.AsyncClient | None = None) -> dict:
+        """Non-blocking variant for the triggerer: never stalls the shared event loop.
+
+        Pass a long-lived ``client`` when polling repeatedly; a new one is built otherwise.
+        """
+        conn = await self.aget_connection(self.manifest_conn_id)
+        url, headers = self.url_and_headers(conn, partner, ds)
+        try:
+            if client is None:
+                async with httpx.AsyncClient(timeout=self.request_timeout) as client:
