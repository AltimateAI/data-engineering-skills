+    def _first_wait_started(self, context) -> float:
+        """Epoch seconds when this sensor first started waiting in this DAG run, retries included.
+
+        XComs are cleared on every try, so the first try's start is kept in a Variable.
+        """
+        ti = context["ti"]
+        first_try = (ti.max_tries or 0) - (self.retries or 0) + 1
+        key = f"lake_sensor_start::{ti.dag_id}::{ti.run_id}::{ti.task_id}::{ti.map_index}"
+        now = time.time()
+        if ti.try_number > first_try:
+            try:
+                stored = Variable.get(key, default=None)
+                if stored is not None:
+                    return min(float(stored), now)
+            except Exception:
+                self.log.warning("Could not read first start time, restarting the clock", exc_info=True)
+        try:
+            Variable.set(key, str(now))
+        except Exception:
+            self.log.warning("Could not store first start time", exc_info=True)
+        return now
+
+    def _timed_out(self, message: str):
+        if self.soft_fail or self.never_fail:
+            return AirflowSkipException(message)
+        return AirflowSensorTimeout(message)
