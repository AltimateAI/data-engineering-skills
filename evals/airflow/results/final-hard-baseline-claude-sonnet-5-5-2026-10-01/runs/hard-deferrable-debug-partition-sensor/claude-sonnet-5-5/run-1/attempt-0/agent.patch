+    def _wait_started_at(self, context) -> float:
+        """Epoch time the sensor first started waiting; kept across retries (not across clears)."""
+        ti = context["ti"]
+        # Same "first try of this round" arithmetic Airflow uses for reschedule sensors.
+        round_id = (ti.max_tries or 0) - (self.retries or 0)
+        key = f"lake_sensor_start/{ti.dag_id}/{ti.run_id}/{ti.task_id}/{ti.map_index}"
+        saved = Variable.get(key, default=None, deserialize_json=True)
+        if isinstance(saved, dict) and saved.get("round") == round_id:
+            return float(saved["started_at"])
+        now = time.time()
+        Variable.set(key, {"round": round_id, "started_at": now}, serialize_json=True)
+        return now
