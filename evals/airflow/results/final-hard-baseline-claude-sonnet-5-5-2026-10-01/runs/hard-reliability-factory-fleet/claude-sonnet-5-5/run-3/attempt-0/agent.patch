+def _config_paths() -> list[Path]:
+    paths = sorted(CONFIG_DIR.glob("*.yaml"))
+    wanted = get_parsing_context().dag_id
+    if wanted:
+        # A worker only needs the DAG its task belongs to (config files are named
+        # after their dag_id). Fall back to everything if there is no such file.
+        match = [p for p in paths if p.stem == wanted]
+        if match:
+            return match
+    return paths
+
+
+def _load_fleet() -> None:
+    registry = load_yaml(REGISTRY)
+    seen: dict[str, Path] = {}
+    for config_path in _config_paths():
+        try:
+            dag = build_dag(config_path, registry)
+            if dag.dag_id in seen:
+                raise ValueError(f"duplicate dag_id {dag.dag_id!r}, already defined by {seen[dag.dag_id].name}")
+        except Exception as exc:
+            # A broken config only takes out its own DAG.
+            log.error("Skipping pipeline config %s: %s: %s", config_path, type(exc).__name__, exc)
+            continue
+        seen[dag.dag_id] = config_path
+        globals()[dag.dag_id] = dag
+
+
+_load_fleet()
