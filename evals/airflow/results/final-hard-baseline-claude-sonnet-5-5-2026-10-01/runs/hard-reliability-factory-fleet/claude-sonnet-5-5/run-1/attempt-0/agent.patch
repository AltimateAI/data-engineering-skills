+def _check_acyclic(deps: dict[str, list[str]]) -> None:
+    state: dict[str, int] = {}
+    for root in deps:
+        stack = [(root, iter(deps[root]))]
+        state[root] = 1
+        while stack:
+            node, it = stack[-1]
+            for nxt in it:
+                if state.get(nxt) == 1:
+                    raise ValueError(f"dependency cycle through step {nxt!r}")
+                if nxt not in state:
+                    state[nxt] = 1
+                    stack.append((nxt, iter(deps[nxt])))
+                    break
+            else:
+                state[node] = 2
+                stack.pop()
+
