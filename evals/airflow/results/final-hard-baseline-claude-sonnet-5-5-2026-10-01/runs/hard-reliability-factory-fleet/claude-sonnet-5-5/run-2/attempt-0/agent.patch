+_NAME_RE = re.compile(r"^name:\s*['\"]?([^\s'\"#]+)", re.M)
+
+
+def select_configs() -> list[Path]:
+    """All configs, or on a worker only the one that defines the DAG being run."""
+    paths = sorted(CONFIG_DIR.glob("*.yaml"))
+    wanted = get_parsing_context().dag_id
+    if wanted is None:
+        return paths
+    matches = [p for p in paths if p.stem == wanted]
+    if matches:
+        return matches
+    # name differs from the file name: find it without a full YAML parse
+    for p in paths:
+        try:
+            m = _NAME_RE.search(p.read_text())
+        except OSError:
+            continue
+        if m and m.group(1) == wanted:
+            return [p]
+    return []
+
+
+def build_fleet() -> None:
+    paths = select_configs()
+    if not paths:
+        return
+    try:
+        registry = load_yaml(REGISTRY)
+        registry["teams"], registry["datasets"]
+    except Exception:
+        log.exception("Failed to load registry %s; no fleet DAGs can be built", REGISTRY)
+        return
+    seen: dict[str, Path] = {}
+    for path in paths:
+        try:
+            dag = build_dag(path, registry)
+            if dag.dag_id in seen:
+                raise ValueError(f"dag_id {dag.dag_id!r} already defined by {seen[dag.dag_id].name}")
+        except Exception as exc:
+            log.error("Skipping pipeline config %s: %s: %s", path, type(exc).__name__, exc)
+            continue
+        seen[dag.dag_id] = path
+        globals()[dag.dag_id] = dag
+
+
+build_fleet()
