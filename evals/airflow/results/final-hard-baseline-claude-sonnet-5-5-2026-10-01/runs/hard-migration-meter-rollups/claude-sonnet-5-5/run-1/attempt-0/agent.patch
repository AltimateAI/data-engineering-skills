+def _events_interval(events_by_asset):
+    """Airflow 2's data interval of an asset-triggered run: earliest start to latest end of the source runs."""
+    starts, ends = [], []
+    for events in events_by_asset.values():
+        for event in events:
+            run = event.source_dag_run
+            if run is not None and run.data_interval_start is not None:
+                start, end = run.data_interval_start, run.data_interval_end
+            elif run is not None:
+                start, end = inferred_interval(HOURLY, run.run_after)
+            else:
+                start = end = event.timestamp
+            starts.append(pendulum.instance(start).in_timezone("UTC"))
+            ends.append(pendulum.instance(end).in_timezone("UTC"))
+    return min(starts), max(ends)
+
