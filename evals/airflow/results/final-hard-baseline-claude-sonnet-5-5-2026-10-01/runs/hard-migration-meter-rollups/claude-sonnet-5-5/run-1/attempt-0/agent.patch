diff --git a/plugins/meter_lib/intervals.py b/plugins/meter_lib/intervals.py
new file mode 100644
index 0000000..a88f59d
--- /dev/null
+++ b/plugins/meter_lib/intervals.py
@@ -0,0 +1,53 @@
+"""Schedules and run-date helpers shared by the metering DAGs.
+
+Airflow 2 gave every run a logical date and (for cron schedules) a data
+interval, including manual runs. Airflow 3 leaves both empty for manual runs
+triggered without a logical date and for asset-triggered runs, so the helpers
+below rebuild the Airflow 2 values from ``run_after`` / the triggering events.
+"""
+
+from __future__ import annotations
+
+from datetime import timedelta
+
+import pendulum
+from croniter import croniter
+
+HOURLY = "0 * * * *"
+TARIFFS_DAILY = "0 1 * * *"
+BILLING_DAILY = "30 2 * * *"
+REGISTRY_DAILY = "0 0 * * *"
+
+
+def _utc(value) -> pendulum.DateTime:
+    return pendulum.instance(value).in_timezone("UTC")
+
+
+def inferred_interval(cron: str, run_after) -> tuple[pendulum.DateTime, pendulum.DateTime]:
+    """Airflow's ``infer_manual_data_interval``: the last complete cron period before ``run_after``."""
+    itr = croniter(cron, _utc(run_after) + timedelta(seconds=1))
+    end = _utc(itr.get_prev(pendulum.DateTime))
+    start = _utc(itr.get_prev(pendulum.DateTime))
+    return start, end
+
+
+def data_interval(dag_run, cron: str) -> tuple[pendulum.DateTime, pendulum.DateTime]:
+    """Data interval of a run; inferred from ``run_after`` when Airflow left it empty."""
+    if dag_run.data_interval_start is not None and dag_run.data_interval_end is not None:
+        return _utc(dag_run.data_interval_start), _utc(dag_run.data_interval_end)
+    return inferred_interval(cron, dag_run.run_after)
+
+
+def logical_date(dag_run) -> pendulum.DateTime:
+    """Airflow 2's ``logical_date``: for manual runs without one, the moment of the trigger."""
+    return _utc(dag_run.logical_date or dag_run.run_after)
+
+
+def logical_day(dag_run, offset_days: int = 0) -> str:
+    """``{{ ds }}`` (plus ``offset_days``) as it was on Airflow 2; also usable as a template macro."""
+    return logical_date(dag_run).add(days=offset_days).strftime("%Y-%m-%d")
+
+
+def hour_stamp(dag_run) -> str:
+    """``YYYYMMDDTHH`` of the start of the run's hourly data interval."""
+    return data_interval(dag_run, HOURLY)[0].strftime("%Y%m%dT%H")
