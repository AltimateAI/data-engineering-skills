+def sync_day(dag_run, offset_days: int = 0) -> str:
+    """Day (YYYY-MM-DD) a tariff sync run is for, ``offset_days`` later.
+
+    The run's logical date, as on Airflow 2; a manual run without one (Airflow 3
+    default) is stamped with its trigger time there, so use that.
+    """
+    stamp = dag_run.logical_date or dag_run.run_after
+    return (stamp.astimezone(timezone.utc) + timedelta(days=offset_days)).strftime("%Y-%m-%d")
+
+
