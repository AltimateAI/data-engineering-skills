     """Invoice batch id finance expects for a billing day (YYYY-MM-DD)."""
     return "INV-" + str(day).replace("-", "")
diff --git a/plugins/meter_lib/timing.py b/plugins/meter_lib/timing.py
new file mode 100644
index 0000000..fb9104c
--- /dev/null
+++ b/plugins/meter_lib/timing.py
@@ -0,0 +1,41 @@
+"""Schedules and run-time helpers that keep Airflow 2 timing semantics.
+
+Airflow 3 schedules cron strings with ``CronTriggerTimetable`` (run at the tick,
+no data interval) and gives manual / asset-triggered runs no logical date or data
+interval. The metering DAGs were written against Airflow 2 semantics (a run covers
+the interval that just closed, manual runs are stamped with the trigger time), so
+the schedules are pinned to ``CronDataIntervalTimetable`` and these helpers
+recover the Airflow 2 values when the context has none.
+"""
+
+from __future__ import annotations
+
+import pendulum
+from airflow.timetables.interval import CronDataIntervalTimetable
+
+HOURLY = CronDataIntervalTimetable("0 * * * *", timezone="UTC")
+DAILY = CronDataIntervalTimetable("0 0 * * *", timezone="UTC")
+DAILY_0100 = CronDataIntervalTimetable("0 1 * * *", timezone="UTC")
+DAILY_0230 = CronDataIntervalTimetable("30 2 * * *", timezone="UTC")
+
+
+def run_after(context) -> pendulum.DateTime:
+    return pendulum.instance(context["dag_run"].run_after).in_timezone("UTC")
+
+
+def logical_date(context) -> pendulum.DateTime:
+    """Airflow 2 ``logical_date``: the trigger time for a manual run without one."""
+    value = context["dag_run"].logical_date
+    return pendulum.instance(value).in_timezone("UTC") if value else run_after(context)
+
+
+def data_interval(context, timetable) -> tuple[pendulum.DateTime, pendulum.DateTime]:
+    """Airflow 2 data interval: for a manual run without one, the last interval closed by the trigger time."""
+    dag_run = context["dag_run"]
+    if dag_run.data_interval_start is not None and dag_run.data_interval_end is not None:
+        return (
+            pendulum.instance(dag_run.data_interval_start).in_timezone("UTC"),
+            pendulum.instance(dag_run.data_interval_end).in_timezone("UTC"),
+        )
+    interval = timetable.infer_manual_data_interval(run_after=run_after(context))
+    return interval.start, interval.end
