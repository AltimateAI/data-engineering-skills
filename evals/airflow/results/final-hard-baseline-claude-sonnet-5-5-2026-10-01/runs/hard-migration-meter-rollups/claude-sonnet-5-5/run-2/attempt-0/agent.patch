diff --git a/plugins/meter_lib/dates.py b/plugins/meter_lib/dates.py
new file mode 100644
index 0000000..f8e31c5
--- /dev/null
+++ b/plugins/meter_lib/dates.py
@@ -0,0 +1,23 @@
+"""Date helpers for runs that may or may not carry a logical date.
+
+Airflow 2.x gave every run (manual ones too) a logical date and a data
+interval. In 3.x a run triggered without a logical date has neither, nor the
+``ds``-style template variables derived from them; the helpers below fill the
+gap the way 2.x did.
+"""
+
+from __future__ import annotations
+
+import pendulum
+
+
+def logical_date(context):
+    """The run's logical date; the trigger time for runs that have none."""
+    return context.get("logical_date") or pendulum.instance(context["dag_run"].run_after)
+
+
+def previous_boundary(run_after, hour: int, minute: int):
+    """Latest ``hour:minute`` UTC at or before ``run_after``."""
+    run_after = pendulum.instance(run_after).in_timezone("UTC")
+    boundary = run_after.start_of("day").add(hours=hour, minutes=minute)
+    return boundary if boundary <= run_after else boundary.subtract(days=1)
