+from airflow.sdk import dag, task
+from airflow.timetables.interval import CronDataIntervalTimetable
 
 from claims_lib import LAKE, MARTS, PROJECT_ROOT
 
+LOOKBACK_DAYS = 90  # how far back to search for a directory snapshot
+
+
+def latest_directory_version(ti, logical_date):
+    """Directory version of the latest provider_directory_daily run (03:00 UTC schedule)
+    whose logical date is at or before this run's.
+
+    Airflow 3 can no longer pull XComs of another DAG with include_prior_dates, so the
+    scheduled runs are walked back by run_id instead.
+    """
+    day = logical_date.replace(hour=3, minute=0, second=0, microsecond=0)
+    if day > logical_date:
+        day = day.subtract(days=1)
+    for _ in range(LOOKBACK_DAYS):
+        version = ti.xcom_pull(dag_id="provider_directory_daily", task_ids="sync_providers",
+                               run_id=f"scheduled__{day.isoformat()}")
+        if version is not None:
+            return version
+        day = day.subtract(days=1)
+    return None
+
 
