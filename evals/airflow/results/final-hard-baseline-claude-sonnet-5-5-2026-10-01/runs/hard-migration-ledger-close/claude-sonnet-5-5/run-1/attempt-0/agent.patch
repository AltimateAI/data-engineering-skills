diff --git a/plugins/ledger_lib/context.py b/plugins/ledger_lib/context.py
new file mode 100644
index 0000000..5ab5557
--- /dev/null
+++ b/plugins/ledger_lib/context.py
@@ -0,0 +1,24 @@
+"""Data interval of the current run, also for manual runs started without a logical date.
+
+Airflow 3 leaves ``data_interval_start``/``data_interval_end`` out of the template
+context when a run has no logical date (``airflow dags trigger <dag_id>``); Airflow 2
+inferred them from the trigger time through the DAG's timetable, which we repeat here.
+"""
+
+from __future__ import annotations
+
+import pendulum
+from airflow.timetables.base import DataInterval
+
+
+def data_interval(context) -> DataInterval:
+    if context.get("data_interval_start") is not None:
+        return DataInterval(start=context["data_interval_start"], end=context["data_interval_end"])
+    dag_run = context["dag_run"]
+    return context["dag"].timetable.infer_manual_data_interval(run_after=pendulum.instance(dag_run.run_after))
+
+
+def with_data_interval(context) -> dict:
+    """The template context with the data interval filled in."""
+    interval = data_interval(context)
+    return {**context, "data_interval_start": interval.start, "data_interval_end": interval.end}
