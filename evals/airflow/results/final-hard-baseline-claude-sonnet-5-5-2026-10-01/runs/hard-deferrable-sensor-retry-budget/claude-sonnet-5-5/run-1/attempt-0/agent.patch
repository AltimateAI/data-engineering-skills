index 0000000..517ba42
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,75 @@
+"""Async trigger that waits for a partner's daily manifest."""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from collections.abc import AsyncIterator
+from typing import Any
+
+import httpx
+from airflow.sdk import Connection
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestHook
+
+
+class ManifestTrigger(BaseTrigger):
+    """Poll the manifest API until the manifest is published or ``deadline`` passes.
+
+    ``deadline`` is an absolute epoch timestamp, so re-creating the trigger (triggerer
+    restart) never extends the wait. Fires one event with ``status`` in
+    ``published`` (``files``), ``timeout`` or ``error`` (``message``).
+    """
+
+    def __init__(
+        self,
+        *,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        deadline: float,
+        poke_interval: float,
+        request_timeout: float = 20.0,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.deadline = deadline
+        self.poke_interval = poke_interval
+        self.request_timeout = request_timeout
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "deadline": self.deadline,
+                "poke_interval": self.poke_interval,
+                "request_timeout": self.request_timeout,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        try:
+            conn = await Connection.async_get(self.manifest_conn_id)
+            url, headers = ManifestHook.url_and_headers(conn, self.partner, self.ds)
+            async with httpx.AsyncClient(timeout=self.request_timeout) as client:
+                while True:
+                    resp = await client.get(url, headers=headers)
+                    if resp.status_code != 200:
+                        raise RuntimeError(f"GET {url} -> HTTP {resp.status_code}")
+                    manifest = resp.json()
+                    if manifest["status"] == "PUBLISHED":
+                        yield TriggerEvent({"status": "published", "files": manifest["files"]})
+                        return
+                    remaining = self.deadline - time.time()
+                    if remaining <= 0:
+                        yield TriggerEvent({"status": "timeout"})
+                        return
+                    await asyncio.sleep(min(self.poke_interval, remaining))
+        except Exception as exc:  # httpx errors, bad payloads, connection lookup failures
+            yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
