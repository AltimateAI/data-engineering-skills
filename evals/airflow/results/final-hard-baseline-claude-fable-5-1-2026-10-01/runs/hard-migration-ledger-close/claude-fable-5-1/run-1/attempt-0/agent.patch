diff --git a/plugins/ledger_lib/runs.py b/plugins/ledger_lib/runs.py
new file mode 100644
index 0000000..cc4c4de
--- /dev/null
+++ b/plugins/ledger_lib/runs.py
@@ -0,0 +1,85 @@
+"""Per-run dates and audit facts, computed the way Airflow 2 computed them.
+
+Airflow 3 removed ``prev_ds``, ``next_ds``, ``yesterday_ds`` and ``conf`` from the
+template context, and a plain manual trigger (``airflow dags trigger <dag_id>``, the
+ops runbook) now creates a run *without* a logical date, so ``logical_date``, ``ds``,
+``data_interval_start`` and ``data_interval_end`` are missing from the context too.
+Airflow 2 gave such a run the trigger time as its logical date and inferred the data
+interval from that through the timetable. The audited outputs are keyed on these
+values, so the ledger tasks take them from here rather than from the raw context.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+import pendulum
+from airflow.configuration import conf
+from airflow.timetables.base import DataInterval, TimeRestriction
+
+DATE = "%Y-%m-%d"
+
+
+def is_manual(dag_run) -> bool:
+    """True for a run started by a person (CLI, API or UI trigger).
+
+    Airflow 2 recorded this as ``DagRun.external_trigger``; Airflow 3 only keeps ``run_type``.
+    """
+    run_type = getattr(dag_run.run_type, "value", dag_run.run_type)
+    return run_type == "manual"
+
+
+def started_by(dag_run) -> str:
+    """Value of the ``started_by`` audit field: ``operator`` or ``scheduler``."""
+    return "operator" if is_manual(dag_run) else "scheduler"
+
+
+def logical_date(context: Mapping[str, Any]) -> pendulum.DateTime:
+    """The run's logical date; for a plain manual trigger, the trigger time (as on Airflow 2)."""
+    value = context.get("logical_date")
+    if value is None:
+        value = context["dag_run"].run_after.replace(microsecond=0)
+    return pendulum.instance(value)
+
+
+def data_interval(context: Mapping[str, Any]) -> DataInterval:
+    """The run's data interval; for a plain manual trigger, what the timetable infers (as on Airflow 2)."""
+    start, end = context.get("data_interval_start"), context.get("data_interval_end")
+    if start is not None and end is not None:
+        return DataInterval(start=pendulum.instance(start), end=pendulum.instance(end))
+    return context["dag"].timetable.infer_manual_data_interval(run_after=logical_date(context))
+
+
+def template_vars(context: Mapping[str, Any]) -> dict[str, Any]:
+    """The Airflow 2 template variables the ledger templates use, rebuilt for this run.
+
+    ``prev_ds``/``next_ds`` keep their Airflow 2 meaning: the previous/next schedule for
+    a scheduled run, the run's own ``ds`` for a manual one (``None`` where the timetable
+    cannot say). ``conf`` is the Airflow configuration, read when the template renders.
+    """
+    date = logical_date(context)
+    interval = data_interval(context)
+    ds = date.strftime(DATE)
+    if is_manual(context["dag_run"]):
+        prev_ds = next_ds = ds
+    else:
+        timetable = context["dag"].timetable
+        get_prev = getattr(timetable, "_get_prev", None)  # cron/delta timetables only, as DAG.previous_schedule did
+        prev_ds = get_prev(date).strftime(DATE) if get_prev else None
+        following = timetable.next_dagrun_info(
+            last_automated_data_interval=interval,
+            restriction=TimeRestriction(earliest=None, latest=None, catchup=True),
+        )
+        next_ds = following.logical_date.strftime(DATE) if following and following.logical_date else None
+    return {
+        "logical_date": date,
+        "ds": ds,
+        "ds_nodash": ds.replace("-", ""),
+        "ts_nodash": date.strftime("%Y%m%dT%H%M%S"),
+        "data_interval_start": interval.start,
+        "data_interval_end": interval.end,
+        "yesterday_ds": date.subtract(days=1).strftime(DATE),
+        "prev_ds": prev_ds,
+        "next_ds": next_ds,
+        "conf": conf,
+    }
