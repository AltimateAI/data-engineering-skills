diff --git a/tests/test_runs.py b/tests/test_runs.py
new file mode 100644
index 0000000..c122ef5
--- /dev/null
+++ b/tests/test_runs.py
@@ -0,0 +1,77 @@
+"""ledger_lib.runs must reproduce the Airflow 2 run values the audited outputs are keyed on."""
+
+from types import SimpleNamespace
+
+import pendulum
+import pytest
+from airflow.timetables.interval import CronDataIntervalTimetable
+
+from ledger_lib.runs import data_interval, logical_date, started_by, template_vars
+from ledger_lib.workdays import WorkdayTimetable
+
+UTC = pendulum.timezone("UTC")
+
+
+def context(timetable, run_type, run_after, logical=None, interval=None):
+    ctx = {
+        "dag": SimpleNamespace(timetable=timetable),
+        "dag_run": SimpleNamespace(run_type=run_type, run_after=run_after),
+    }
+    if logical is not None:  # keys only exist on Airflow 3 when the run has a logical date
+        ctx.update(logical_date=logical, data_interval_start=interval.start, data_interval_end=interval.end)
+    return ctx
+
+
+@pytest.mark.parametrize(
+    "triggered_at, business_day",
+    [
+        ("2026-03-10T09:00:00", "2026-03-09"),  # Tuesday morning: Monday
+        ("2026-03-09T08:00:00", "2026-03-06"),  # Monday morning: previous Friday
+        ("2026-03-07T12:00:00", "2026-03-06"),  # Saturday: Friday
+        ("2026-03-10T00:00:00", "2026-03-09"),  # exactly midnight: the day that just ended
+    ],
+)
+def test_plain_manual_trigger_re_closes_latest_ended_business_day(triggered_at, business_day):
+    ctx = context(WorkdayTimetable(), "manual", pendulum.parse(triggered_at, tz=UTC).replace(microsecond=123))
+    interval = data_interval(ctx)
+    assert interval.start == pendulum.parse(business_day, tz=UTC)
+    assert interval.end == interval.start.add(days=1)
+    assert logical_date(ctx) == pendulum.parse(triggered_at, tz=UTC)
+    assert started_by(ctx["dag_run"]) == "operator"
+
+
+def test_scheduled_run_uses_its_own_interval():
+    start = pendulum.datetime(2026, 3, 4, tz="UTC")
+    ctx = context(WorkdayTimetable(), "scheduled", start.add(days=1), start, SimpleNamespace(start=start, end=start.add(days=1)))
+    assert data_interval(ctx) == (start, start.add(days=1))
+    assert started_by(ctx["dag_run"]) == "scheduler"
+    assert template_vars(ctx)["prev_ds"] is None  # Airflow 2: no previous schedule for custom timetables
+
+
+def test_weekly_report_dates_follow_the_cron_schedule():
+    timetable = CronDataIntervalTimetable("0 7 * * 1", timezone=UTC)
+    logical = pendulum.datetime(2026, 3, 2, 7, tz="UTC")
+    ctx = context(timetable, "scheduled", logical.add(weeks=1), logical, SimpleNamespace(start=logical, end=logical.add(weeks=1)))
+    run = template_vars(ctx)
+    assert (run["ds"], run["prev_ds"], run["next_ds"], run["yesterday_ds"]) == (
+        "2026-03-02", "2026-02-23", "2026-03-09", "2026-03-01")
+
+
+def test_fx_dates_follow_the_daily_schedule():
+    timetable = CronDataIntervalTimetable("0 6 * * *", timezone=UTC)
+    logical = pendulum.datetime(2026, 3, 10, 6, tz="UTC")
+    ctx = context(timetable, "scheduled", logical.add(days=1), logical, SimpleNamespace(start=logical, end=logical.add(days=1)))
+    run = template_vars(ctx)
+    assert (run["ds"], run["ds_nodash"], run["next_ds"], run["yesterday_ds"]) == (
+        "2026-03-10", "20260310", "2026-03-11", "2026-03-09")
+    assert run["conf"].get("ledger", "base_currency", fallback=None) in ("USD", None)
+
+
+def test_manual_runs_use_their_own_date_for_prev_and_next():
+    timetable = CronDataIntervalTimetable("0 6 * * *", timezone=UTC)
+    ctx = context(timetable, "manual", pendulum.datetime(2026, 3, 10, 9, 30, tz="UTC"))
+    run = template_vars(ctx)
+    assert run["ds"] == run["prev_ds"] == run["next_ds"] == "2026-03-10"
+    assert run["ts_nodash"] == "20260310T093000"
+    assert (run["data_interval_start"], run["data_interval_end"]) == (
+        pendulum.datetime(2026, 3, 9, 6, tz="UTC"), pendulum.datetime(2026, 3, 10, 6, tz="UTC"))
