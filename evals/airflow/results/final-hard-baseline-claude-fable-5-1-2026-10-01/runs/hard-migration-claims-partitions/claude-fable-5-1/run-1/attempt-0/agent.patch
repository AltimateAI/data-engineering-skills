@@ -1,7 +1,21 @@
 """Shared code for the claims DAGs (on sys.path via the plugins folder)."""
 
+from __future__ import annotations
+
+from datetime import datetime
 from pathlib import Path
 
 PROJECT_ROOT = Path(__file__).resolve().parents[2]
 LAKE = PROJECT_ROOT / "output" / "lake"
 MARTS = PROJECT_ROOT / "output" / "marts"
+
+
+def trigger_time(dag_run) -> datetime:
+    """Moment a manually triggered run was requested, to the second.
+
+    Airflow 2 gave every manual run a logical date equal to the trigger time
+    (microseconds zeroed by the CLI). Airflow 3 leaves ``logical_date`` empty for
+    ``airflow dags trigger`` without ``--logical-date`` and records the request
+    time in ``run_after`` instead, so fall back to that.
+    """
+    return (dag_run.logical_date or dag_run.run_after).replace(microsecond=0)
