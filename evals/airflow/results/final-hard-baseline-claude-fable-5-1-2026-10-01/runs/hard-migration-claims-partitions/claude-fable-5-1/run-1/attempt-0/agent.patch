+def directory_version_for(day: str, events, ti) -> str:
+    """Version of the newest provider-directory snapshot taken at or before ``day``.
+
+    On Airflow 2 this was ``xcom_pull(dag_id="provider_directory_daily",
+    include_prior_dates=True)``: the newest ``sync_providers`` return value from
+    a run whose logical date was not after this run's. Airflow 3 resolves
+    ``include_prior_dates`` against the pulled DAG's own runs, so a cross-DAG
+    pull finds nothing. ``sync_providers`` emits one ``PROVIDERS`` asset event
+    per successful run, so walk those instead: the version is in the event
+    extra, or (for events recorded before that was added) in the run's XCom.
+    """
+    versions = []
+    for event in events:
+        version = (event.extra or {}).get("version")
+        if version is None:
+            version = ti.xcom_pull(dag_id=event.source_dag_id, task_ids=event.source_task_id, run_id=event.source_run_id)
+        if version is not None and version <= day:
+            versions.append(version)
+    if not versions:
+        raise FileNotFoundError(f"no provider-directory snapshot at or before {day}")
+    return max(versions)
 
 
