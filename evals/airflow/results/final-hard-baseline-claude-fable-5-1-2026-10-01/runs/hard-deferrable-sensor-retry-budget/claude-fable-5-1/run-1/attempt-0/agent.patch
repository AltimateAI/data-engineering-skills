         if resp.status_code != 200:
             raise ManifestApiError(f"GET {url} -> HTTP {resp.status_code}")
         return resp.json()
+
+    async def aget_manifest(self, partner: str, ds: str, client: httpx.AsyncClient | None = None) -> dict:
+        """Async counterpart of :meth:`get_manifest` for use in triggers.
+
+        Everything awaits (connection lookup included), so the triggerer's event loop is never blocked.
+        Pass ``client`` to reuse one ``httpx.AsyncClient`` across calls.
+        """
+        conn = await self.aget_connection(self.manifest_conn_id)
+        url, headers = self.url_and_headers(conn, partner, ds)
+        try:
+            if client is None:
+                async with httpx.AsyncClient(timeout=self.request_timeout) as own_client:
+                    resp = await own_client.get(url, headers=headers)
+            else:
+                resp = await client.get(url, headers=headers, timeout=self.request_timeout)
+        except httpx.HTTPError as exc:
+            raise ManifestApiError(f"GET {url} failed: {exc!r}") from exc
+        if resp.status_code != 200:
+            raise ManifestApiError(f"GET {url} -> HTTP {resp.status_code}")
+        try:
+            return resp.json()
+        except ValueError as exc:
+            raise ManifestApiError(f"GET {url} -> unreadable body: {exc!r}") from exc
