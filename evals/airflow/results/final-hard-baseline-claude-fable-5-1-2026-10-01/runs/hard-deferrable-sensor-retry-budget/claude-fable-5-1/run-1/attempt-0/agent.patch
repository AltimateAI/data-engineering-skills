+from __future__ import annotations
+
+import asyncio
+import json
+import time
+from datetime import datetime, timedelta, timezone
+
+import httpx
+import pytest
+from airflow._shared.module_loading import import_string
+from conftest import TOKEN, fake_connection
+from partners import triggers
+from partners.hooks import ManifestHook
+from partners.triggers import PartnerManifestTrigger
+
+FILES = ["s3://partners/acme/2026-09-30/batch-0.csv.gz", "s3://partners/acme/2026-09-30/batch-1.csv.gz"]
+
+
+def make_trigger(**overrides) -> PartnerManifestTrigger:
+    kwargs = {
+        "partner": "acme",
+        "ds": "2026-09-30",
+        "deadline": datetime.now(timezone.utc) + timedelta(hours=1),
+        "poke_interval": 0.01,
+    }
+    kwargs.update(overrides)
+    return PartnerManifestTrigger(**kwargs)
+
+
+async def collect(trigger: PartnerManifestTrigger) -> list[dict]:
+    return [event.payload async for event in trigger.run()]
+
+
+@pytest.fixture
+def connection(monkeypatch):
+    async def aget_connection(cls, conn_id):
+        return fake_connection()
+
+    monkeypatch.setattr(ManifestHook, "aget_connection", classmethod(aget_connection))
+
+
+@pytest.fixture
+def api(monkeypatch):
+    """Route the trigger's httpx client to a handler; returns the list of requests it saw."""
+    seen: list[httpx.Request] = []
+
+    def install(handler):
+        def wrapped(request):
+            seen.append(request)
+            return handler(request, len(seen))
+
+        transport = httpx.MockTransport(wrapped)
+        real_client = httpx.AsyncClient
+        monkeypatch.setattr(triggers.httpx, "AsyncClient", lambda **kw: real_client(transport=transport, **kw))
+        return seen
+
+    return install
+
+
+def pending(request, n):
+    return httpx.Response(200, json={"status": "PENDING"})
+
+
+def published(request, n):
+    return httpx.Response(200, json={"status": "PUBLISHED", "files": FILES})
+
+
+def test_published_manifest_yields_its_files(connection, api):
+    seen = api(published)
+    events = asyncio.run(collect(make_trigger()))
+    assert events == [{"status": "published", "files": FILES}]
+    assert seen[0].url.path == "/v1/partners/acme/manifests/2026-09-30"
+    assert seen[0].headers["Authorization"] == f"Bearer {TOKEN}"
+
+
+def test_polls_while_pending_then_returns_files(connection, api):
+    seen = api(lambda request, n: published(request, n) if n >= 3 else pending(request, n))
+    events = asyncio.run(collect(make_trigger()))
+    assert events == [{"status": "published", "files": FILES}]
+    assert len(seen) == 3
+
+
+def test_deadline_reached_yields_timeout_event(connection, api):
+    deadline = datetime.now(timezone.utc) + timedelta(seconds=0.1)
+    seen = api(pending)
+    events = asyncio.run(collect(make_trigger(deadline=deadline)))
+    assert events == [{"status": "timeout", "deadline": deadline.isoformat()}]
+    assert len(seen) >= 2  # polled through the deadline, with one last call at it
+
+
+def test_http_error_is_reported_as_error_event(connection, api):
+    api(lambda request, n: httpx.Response(503, json={"error": "service unavailable"}))
+    events = asyncio.run(collect(make_trigger()))
+    assert len(events) == 1
+    assert events[0]["status"] == "error"
+    assert "HTTP 503" in events[0]["message"]
+
+
+def test_connection_failure_is_reported_as_error_event(connection, api):
+    def refuse(request, n):
+        raise httpx.ConnectError("connection refused", request=request)
+
+    api(refuse)
+    events = asyncio.run(collect(make_trigger()))
+    assert events[0]["status"] == "error"
+    assert "ConnectError" in events[0]["message"]
+
+
+def test_connection_lookup_failure_is_reported_as_error_event(monkeypatch, api):
+    async def missing(cls, conn_id):
+        raise RuntimeError(f"connection {conn_id} not found")
+
+    monkeypatch.setattr(ManifestHook, "aget_connection", classmethod(missing))
+    api(published)
+    events = asyncio.run(collect(make_trigger()))
+    assert events == [{"status": "error", "message": "RuntimeError: connection manifests_default not found"}]
+
+
+def test_serialize_rebuilds_an_identical_trigger():
+    deadline = datetime(2026, 9, 30, 10, 0, tzinfo=timezone(timedelta(hours=2)))
+    trigger = make_trigger(deadline=deadline, manifest_conn_id="other", poke_interval=300)
+    classpath, kwargs = trigger.serialize()
+    rebuilt = import_string(classpath)(**kwargs)
+    assert rebuilt.serialize() == (classpath, kwargs)
+    assert rebuilt.deadline == deadline
+    assert rebuilt.deadline.tzinfo == timezone.utc
+    assert rebuilt.poke_interval == 300
+
+
+def test_naive_deadline_is_rejected():
+    with pytest.raises(ValueError):
+        make_trigger(deadline=datetime(2026, 9, 30, 10, 0))  # noqa: DTZ001 - naive on purpose
+
+
+def test_slow_api_does_not_block_the_event_loop(monkeypatch, stub):
+    """With 1s API latency the loop must keep serving other coroutines between polls."""
+    server = stub("--latency", "1")
+
+    async def aget_connection(cls, conn_id):
+        return fake_connection(server.port)
+
+    monkeypatch.setattr(ManifestHook, "aget_connection", classmethod(aget_connection))
+    trigger = make_trigger(deadline=datetime.now(timezone.utc) + timedelta(seconds=2.5), poke_interval=0.1)
+
+    async def scenario():
+        gaps = []
+        stop = asyncio.Event()
+
+        async def heartbeat():
+            last = time.monotonic()
+            while not stop.is_set():
+                await asyncio.sleep(0.02)
+                now = time.monotonic()
+                gaps.append(now - last)
+                last = now
+
+        beat = asyncio.create_task(heartbeat())
+        events = await collect(trigger)
+        stop.set()
+        await beat
+        return events, max(gaps)
+
+    events, worst_gap = asyncio.run(scenario())
+    assert events[0]["status"] == "timeout"
+    requests = [json.loads(line) for line in server.log.read_text().splitlines()]
+    assert len(requests) >= 2
+    assert worst_gap < 0.3, f"event loop stalled for {worst_gap:.2f}s"
