+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+import pytest
+from airflow.sdk.bases.operator import TriggerFailureReason
+from airflow.sdk.exceptions import (
+    AirflowSensorTimeout,
+    AirflowSkipException,
+    TaskDeferralError,
+    TaskDeferred,
+)
+from partners import sensors
+from partners.hooks import ManifestApiError, ManifestHook
+from partners.sensors import TRIGGER_TIMEOUT_GRACE, PartnerManifestSensor
+from partners.triggers import PartnerManifestTrigger
+
+T0 = datetime(2026, 9, 30, 4, 0, tzinfo=timezone.utc)
+FILES = ["s3://partners/acme/2026-09-30/batch-0.csv.gz"]
+KEY = PartnerManifestSensor.started_at_key
+
+
+class FakeStateStore:
+    def __init__(self, **values):
+        self.values = dict(values)
+        self.retentions = {}
+
+    def get(self, key, default=None):
+        return self.values.get(key, default)
+
+    def set(self, key, value, *, retention=None):
+        self.values[key] = value
+        self.retentions[key] = retention
+
+
+def make_sensor(**overrides) -> PartnerManifestSensor:
+    kwargs = {"task_id": "wait_acme", "partner": "acme", "ds": "2026-09-30", "poke_interval": 300, "timeout": 3600, "retries": 3}
+    kwargs.update(overrides)
+    return PartnerManifestSensor(**kwargs)
+
+
+def make_context(store=None, try_number=1, max_tries=3):
+    context = {"ti": SimpleNamespace(try_number=try_number, max_tries=max_tries)}
+    if store is not None:
+        context["task_state_store"] = store
+    return context
+
+
+@pytest.fixture
+def now(monkeypatch):
+    clock = SimpleNamespace(value=T0)
+    monkeypatch.setattr(sensors, "timezone", SimpleNamespace(utcnow=lambda: clock.value))
+    return clock
+
+
+def deferral(sensor, context) -> TaskDeferred:
+    with pytest.raises(TaskDeferred) as info:
+        sensor.execute(context)
+    return info.value
+
+
+def test_first_try_records_the_start_and_defers_with_the_full_budget(now):
+    store = FakeStateStore()
+    sensor = make_sensor()
+    deferred = deferral(sensor, make_context(store))
+
+    assert store.values[KEY] == T0.isoformat()
+    assert store.retentions[KEY] >= timedelta(seconds=3600)
+    trigger = deferred.trigger
+    assert isinstance(trigger, PartnerManifestTrigger)
+    assert trigger.deadline == T0 + timedelta(seconds=3600)
+    assert (trigger.partner, trigger.ds, trigger.manifest_conn_id, trigger.poke_interval) == (
+        "acme",
+        "2026-09-30",
+        ManifestHook.default_conn_name,
+        300,
+    )
+    assert deferred.method_name == "execute_complete"
+    assert deferred.kwargs == {"started_at": T0.isoformat()}
+    assert deferred.timeout == timedelta(seconds=3600) + TRIGGER_TIMEOUT_GRACE
+
+
+def test_retry_continues_the_wait_from_the_recorded_start(now):
+    started = T0 - timedelta(seconds=1000)
+    store = FakeStateStore(**{KEY: started.isoformat()})
+    deferred = deferral(make_sensor(), make_context(store, try_number=2))
+
+    assert deferred.trigger.deadline == started + timedelta(seconds=3600)
+    assert deferred.timeout == timedelta(seconds=2600) + TRIGGER_TIMEOUT_GRACE
+    assert deferred.kwargs == {"started_at": started.isoformat()}
+    assert store.values[KEY] == started.isoformat()
+
+
+def test_budget_survives_a_run_of_retries(now):
+    """Four tries, each after an API outage, never move the deadline."""
+    store = FakeStateStore()
+    deadline = None
+    for try_number in range(1, 5):
+        now.value = T0 + timedelta(minutes=10 * (try_number - 1))
+        deferred = deferral(make_sensor(), make_context(store, try_number=try_number))
+        deadline = deadline or deferred.trigger.deadline
+        assert deferred.trigger.deadline == deadline == T0 + timedelta(seconds=3600)
+
+
+@pytest.mark.parametrize("soft_fail, expected", [(False, AirflowSensorTimeout), (True, AirflowSkipException)])
+def test_retry_that_starts_after_the_deadline_ends_the_wait(now, soft_fail, expected):
+    started = T0 - timedelta(seconds=3601)
+    store = FakeStateStore(**{KEY: started.isoformat()})
+    with pytest.raises(expected, match="timed out"):
+        make_sensor(soft_fail=soft_fail).execute(make_context(store, try_number=3))
+    assert store.values[KEY] == started.isoformat()
+
+
+def test_cleared_task_starts_a_fresh_budget(now):
+    # After a clear Airflow sets max_tries = try_number + retries, so try 5 of 7 is a first try again.
+    stale = T0 - timedelta(hours=5)
+    store = FakeStateStore(**{KEY: stale.isoformat()})
+    deferred = deferral(make_sensor(), make_context(store, try_number=5, max_tries=7))
+
+    assert deferred.trigger.deadline == T0 + timedelta(seconds=3600)
+    assert store.values[KEY] == T0.isoformat()
+
+
+def test_retry_without_a_recorded_start_counts_from_now(now):
+    store = FakeStateStore()
+    deferred = deferral(make_sensor(), make_context(store, try_number=2))
+    assert deferred.trigger.deadline == T0 + timedelta(seconds=3600)
+    assert store.values[KEY] == T0.isoformat()
+
+
+def test_without_a_state_store_the_sensor_still_defers(now):
+    deferred = deferral(make_sensor(), make_context(store=None))
+    assert deferred.trigger.deadline == T0 + timedelta(seconds=3600)
+
+
+def test_published_event_returns_the_file_list():
+    sensor = make_sensor()
+    assert sensor.execute_complete({}, event={"status": "published", "files": FILES}) == FILES
+
+
+@pytest.mark.parametrize("soft_fail, expected", [(False, AirflowSensorTimeout), (True, AirflowSkipException)])
+def test_timeout_event_ends_the_wait(soft_fail, expected):
+    sensor = make_sensor(soft_fail=soft_fail)
+    with pytest.raises(expected, match="timed out"):
+        sensor.resume_execution(
+            "execute_complete",
+            {"started_at": T0.isoformat(), "event": {"status": "timeout", "deadline": "x"}},
+            make_context(),
+        )
+
+
+@pytest.mark.parametrize("soft_fail", [False, True])
+def test_api_error_event_fails_the_try_so_retries_take_over(soft_fail):
+    sensor = make_sensor(soft_fail=soft_fail)
+    with pytest.raises(ManifestApiError, match="HTTP 503"):
+        sensor.resume_execution(
+            "execute_complete",
+            {"started_at": T0.isoformat(), "event": {"status": "error", "message": "GET ... -> HTTP 503"}},
+            make_context(),
+        )
+
+
+@pytest.mark.parametrize("soft_fail", [False, True])
+def test_unexpected_event_fails_the_try(soft_fail):
+    with pytest.raises(ManifestApiError, match="unexpected trigger event"):
+        make_sensor(soft_fail=soft_fail).execute_complete({}, event=None)
+
+
+@pytest.mark.parametrize("soft_fail", [False, True])
+def test_trigger_crash_fails_the_try_instead_of_skipping(soft_fail):
+    sensor = make_sensor(soft_fail=soft_fail)
+    with pytest.raises(TaskDeferralError):
+        sensor.resume_execution("__fail__", {"error": "Trigger failure", "traceback": ["boom"]}, make_context())
+
+
+@pytest.mark.parametrize("soft_fail, expected", [(False, AirflowSensorTimeout), (True, AirflowSkipException)])
+def test_scheduler_trigger_timeout_ends_the_wait(soft_fail, expected):
+    sensor = make_sensor(soft_fail=soft_fail)
+    with pytest.raises(expected, match="timed out"):
+        sensor.resume_execution("__fail__", {"error": TriggerFailureReason.TRIGGER_TIMEOUT}, make_context())
+
+
+def test_never_fail_turns_api_errors_into_skips():
+    sensor = make_sensor(never_fail=True)
+    with pytest.raises(AirflowSkipException):
+        sensor.execute_complete({}, event={"status": "error", "message": "HTTP 503"})
+
+
+def test_non_deferrable_sensor_pokes_and_returns_files(now, monkeypatch):
+    monkeypatch.setattr(ManifestHook, "get_manifest", lambda self, p, d: {"status": "PUBLISHED", "files": FILES})
+    store = FakeStateStore()
+    assert make_sensor(deferrable=False).execute(make_context(store)) == FILES
+    assert store.values[KEY] == T0.isoformat()
+
+
+def test_non_deferrable_sensor_spends_only_the_remaining_budget(now, monkeypatch):
+    monkeypatch.setattr(ManifestHook, "get_manifest", lambda self, p, d: {"status": "PENDING"})
+    started = T0 - timedelta(seconds=3600)
+    store = FakeStateStore(**{KEY: started.isoformat()})
+    with pytest.raises(AirflowSensorTimeout):
+        make_sensor(deferrable=False, poke_interval=0.01).execute(make_context(store, try_number=2))
