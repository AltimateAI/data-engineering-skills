+"""Trigger that polls the partner manifest API from the triggerer."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator
+from datetime import datetime, timezone
+from typing import Any
+
+import httpx
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestApiError, ManifestHook
+
+
+class PartnerManifestTrigger(BaseTrigger):
+    """Poll the manifest API until the manifest is PUBLISHED, the deadline passes, or the API errors.
+
+    The trigger never raises. Every outcome is a ``TriggerEvent`` whose payload carries a ``status``:
+
+    - ``published``: ``files`` holds the manifest's file list.
+    - ``timeout``: the deadline passed and the last call still saw PENDING.
+    - ``error``: the API answered with an error or could not be reached; ``message`` says what happened.
+
+    Reporting errors as events (instead of raising) matters: an exception escaping a trigger resumes the
+    task with a ``TaskDeferralError``, which ``BaseSensorOperator`` turns into a skip for ``soft_fail``
+    sensors. ``PartnerManifestSensor.execute_complete`` decides what each outcome means.
+
+    :param deadline: absolute, timezone-aware moment at which the wait is over. It travels in the serialized
+        kwargs, so a triggerer restart re-creates the trigger with the very same deadline.
+    :param poke_interval: seconds between two calls while the manifest is PENDING
+    :param request_timeout: per-call HTTP timeout in seconds
+    """
+
+    def __init__(
+        self,
+        *,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str = ManifestHook.default_conn_name,
+        deadline: datetime,
+        poke_interval: float = 60.0,
+        request_timeout: float = 20.0,
+    ) -> None:
+        super().__init__()
+        if not isinstance(deadline, datetime):
+            raise TypeError(f"deadline must be a datetime, got {type(deadline).__name__}")
+        if deadline.tzinfo is None:
+            raise ValueError("deadline must be timezone-aware")
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.deadline = deadline.astimezone(timezone.utc)
+        self.poke_interval = float(poke_interval)
+        self.request_timeout = float(request_timeout)
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            "partners.triggers.PartnerManifestTrigger",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "deadline": self.deadline,
+                "poke_interval": self.poke_interval,
+                "request_timeout": self.request_timeout,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id, request_timeout=self.request_timeout)
+        try:
+            async with httpx.AsyncClient() as client:
+                while True:
+                    manifest = await hook.aget_manifest(self.partner, self.ds, client=client)
+                    if manifest.get("status") == "PUBLISHED":
+                        files = manifest.get("files") or []
+                        self.log.info("Manifest %s/%s is published with %d files", self.partner, self.ds, len(files))
+                        yield TriggerEvent({"status": "published", "files": files})
+                        return
+                    remaining = (self.deadline - datetime.now(timezone.utc)).total_seconds()
+                    if remaining <= 0:
+                        self.log.info("Manifest %s/%s still pending at the deadline %s", self.partner, self.ds, self.deadline)
+                        yield TriggerEvent({"status": "timeout", "deadline": self.deadline.isoformat()})
+                        return
+                    self.log.debug("Manifest %s/%s pending; %.0fs left", self.partner, self.ds, remaining)
+                    await asyncio.sleep(min(self.poke_interval, remaining))
+        except ManifestApiError as exc:
+            self.log.warning("Manifest API error for %s/%s: %s", self.partner, self.ds, exc)
+            yield TriggerEvent({"status": "error", "message": str(exc)})
+        except Exception as exc:  # e.g. the connection could not be fetched; must not become a skip
+            self.log.exception("Unexpected error while polling the manifest for %s/%s", self.partner, self.ds)
+            yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
