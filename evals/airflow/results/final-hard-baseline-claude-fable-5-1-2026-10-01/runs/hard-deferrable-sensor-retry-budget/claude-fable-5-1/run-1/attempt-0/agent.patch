+TRIGGER_TIMEOUT_GRACE = timedelta(seconds=60)
 
 
 class PartnerManifestSensor(BaseSensorOperator):
     """Wait until the partner has published the manifest for ``ds`` and return its file list.
 
+    By default the sensor defers to :class:`~partners.triggers.PartnerManifestTrigger`, so it holds no
+    worker slot while waiting. The returned file list is pushed to XCom as the task's return value.
+
+    ``timeout`` is a per-DAG-run budget counted from the moment the sensor first started waiting in that
+    run. The start is persisted in the task state store, so neither the task's retries nor triggerer
+    restarts reset or extend it. A fresh budget starts only when the task is cleared. When the budget is
+    spent the sensor fails for good (no retries), or is skipped when ``soft_fail=True``.
+
+    A manifest API error (HTTP error or connection failure) fails the current try so the task's retries
+    take over; this holds for ``soft_fail`` sensors too, because an outage says nothing about the partner.
+
     :param partner: partner key, e.g. ``acme``
     :param ds: manifest date (templated, usually ``{{ ds }}``)
     :param manifest_conn_id: connection to the manifest API
+    :param deferrable: wait in the triggerer (default) instead of poking from a worker slot
     """
 
     template_fields: Sequence[str] = ("partner", "ds")
 
+    # Task state store key for when the sensor first started waiting in the current run.
+    # Renaming it on a deployed sensor restarts the budget of in-flight retries.
+    started_at_key = "partner_manifest_sensor.started_at"
+
     def __init__(
         self,
         *,
         partner: str,
         ds: str = "{{ ds }}",
         manifest_conn_id: str = ManifestHook.default_conn_name,
+        deferrable: bool = True,
         **kwargs: Any,
     ) -> None:
         super().__init__(**kwargs)
         self.partner = partner
         self.ds = ds
         self.manifest_conn_id = manifest_conn_id
+        self.deferrable = deferrable
 
     def poke(self, context) -> PokeReturnValue | bool:
         manifest = ManifestHook(self.manifest_conn_id).get_manifest(self.partner, self.ds)
         if manifest["status"] == "PUBLISHED":
             return PokeReturnValue(is_done=True, xcom_value=manifest["files"])
         return False
+
+    def execute(self, context) -> Any:
+        started_at = self._started_at(context)
+        deadline = started_at + timedelta(seconds=self.timeout)
+        remaining = (deadline - timezone.utcnow()).total_seconds()
+
+        if not self.deferrable:
+            # Let the base class poke loop spend only what is left of this run's budget.
+            self.timeout = max(remaining, 0)
+            return super().execute(context)
+
+        if remaining <= 0:
+            self._timed_out(started_at)
+
+        self.log.info(
+            "Waiting for manifest %s/%s in the triggerer until %s (%.0fs left of %gs, waiting since %s)",
+            self.partner,
+            self.ds,
+            deadline.isoformat(),
+            remaining,
+            self.timeout,
+            started_at.isoformat(),
+        )
+        self.defer(
+            trigger=PartnerManifestTrigger(
+                partner=self.partner,
+                ds=self.ds,
+                manifest_conn_id=self.manifest_conn_id,
+                deadline=deadline,
+                poke_interval=self.poke_interval,
+            ),
+            method_name="execute_complete",
+            kwargs={"started_at": started_at.isoformat()},
+            timeout=timedelta(seconds=remaining) + TRIGGER_TIMEOUT_GRACE,
+        )
+
+    def execute_complete(self, context, event: Any = None, started_at: str | None = None) -> list[str]:
+        status = event.get("status") if isinstance(event, dict) else None
+        if status == "published":
+            files = event["files"]
+            self.log.info("Manifest %s/%s published with %d files", self.partner, self.ds, len(files))
+            return files
+        if status == "timeout":
+            self._timed_out(datetime.fromisoformat(started_at) if started_at else None)
+        if status == "error":
+            self._fail_try(ManifestApiError(event.get("message") or "manifest API error"))
+        self._fail_try(ManifestApiError(f"unexpected trigger event: {event!r}"))
+
+    def resume_execution(self, next_method: str, next_kwargs: dict[str, Any] | None, context) -> Any:
+        # BaseSensorOperator.resume_execution turns every error raised while resuming into a skip for
+        # soft_fail sensors, which would skip globex on an API outage or a trigger crash. Resume through
+        # BaseOperator instead and apply soft_fail only to the timeout.
+        try:
+            return super(BaseSensorOperator, self).resume_execution(next_method, next_kwargs, context)
+        except TaskDeferralTimeout:
+            # The scheduler's backstop fired: the trigger did not report back by deadline + grace.
+            self._timed_out(None)
+        except TaskDeferralError as exc:
+            self._fail_try(exc)
+
+    def _started_at(self, context) -> datetime:
+        """Return when this sensor first started waiting in the current DAG run.
+
+        The first try of a wait (the very first try, or the first after the task was cleared) records
+        ``now`` in the task state store; later tries of the same wait read it back. Airflow sets
+        ``max_tries = try_number + retries`` when a task is cleared, so the first try of a wait is
+        ``max_tries - retries + 1``, the same rule Airflow's reschedule sensors use.
+        """
+        now = timezone.utcnow()
+        store = context.get("task_state_store")
+        if store is None:
+            self.log.warning("task_state_store is unavailable; the timeout is counted from this try only")
+            return now
+
+        ti = context["ti"]
+        first_try_number = (ti.max_tries or 0) - (self.retries or 0) + 1
+        if ti.try_number > first_try_number:
+            stored = store.get(self.started_at_key)
+            if stored:
+                started_at = datetime.fromisoformat(stored)
+                self.log.info("Try %s continues the wait started at %s", ti.try_number, started_at.isoformat())
+                return started_at
+            self.log.warning("Try %s has no recorded start of the wait; counting the timeout from now", ti.try_number)
+
+        store.set(self.started_at_key, now.isoformat(), retention=timedelta(seconds=self.timeout) + timedelta(days=7))
+        return now
+
+    def _timed_out(self, started_at: datetime | None) -> NoReturn:
+        since = f" (waiting since {started_at.isoformat()})" if started_at else ""
+        message = (
+            f"Sensor has timed out: no manifest for {self.partner}/{self.ds} "
+            f"within the {self.timeout:g}s budget{since}."
+        )
+        if self.soft_fail:
+            raise AirflowSkipException(message)
+        raise AirflowSensorTimeout(message)
+
+    def _fail_try(self, exc: Exception) -> NoReturn:
+        """Fail the current try (retries apply); only ``never_fail`` turns this into a skip."""
+        if self.never_fail:
+            raise AirflowSkipException("Skipping due to never_fail is set to True.") from exc
+        raise exc
