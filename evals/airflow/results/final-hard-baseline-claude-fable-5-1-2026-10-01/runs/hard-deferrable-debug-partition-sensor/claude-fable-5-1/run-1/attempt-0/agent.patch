@@ -0,0 +1,302 @@
+"""Unit tests for the lake hook, trigger and sensor (run: ``pytest tests``)."""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import subprocess
+import sys
+import time
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+from airflow.sdk.exceptions import AirflowSensorTimeout, AirflowSkipException, TaskDeferred
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "dags"))
+
+from lake import triggers as triggers_module  # noqa: E402
+from lake.hooks import LakeApiError, LakeCatalogHook  # noqa: E402
+from lake.sensors import STARTED_AT_KEY, PartitionPublishedSensor  # noqa: E402
+from lake.triggers import PartitionPublishedTrigger  # noqa: E402
+
+FILES = ["s3://lake/orders/2026-09-29/part-0.parquet", "s3://lake/orders/2026-09-29/part-1.parquet"]
+
+
+def now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def run_trigger(trigger: PartitionPublishedTrigger) -> dict:
+    async def first():
+        async for event in trigger.run():
+            return event.payload
+        raise AssertionError("trigger finished without an event")
+
+    return asyncio.run(first())
+
+
+@pytest.fixture(autouse=True)
+def clear_cache():
+    triggers_module._PUBLISHED.clear()
+    yield
+    triggers_module._PUBLISHED.clear()
+
+
+@pytest.fixture
+def catalog(tmp_path):
+    """Context manager-ish fixture: start the stub with the given flags, return (port, log)."""
+    procs = []
+
+    def start(*flags: str):
+        port_file = tmp_path / f"port{len(procs)}"
+        log = tmp_path / f"log{len(procs)}.jsonl"
+        proc = subprocess.Popen(
+            [sys.executable, str(ROOT / "tools/catalog_stub.py"), "--port-file", str(port_file), "--log", str(log), *flags],
+            stdout=subprocess.DEVNULL,
+        )
+        procs.append(proc)
+        for _ in range(100):
+            if port_file.exists() and port_file.read_text():
+                break
+            time.sleep(0.05)
+        return int(port_file.read_text()), log
+
+    yield start
+    for proc in procs:
+        proc.kill()
+        proc.wait()
+
+
+def hook_for(port: int) -> LakeCatalogHook:
+    conn = SimpleNamespace(host="127.0.0.1", port=port, schema="http", password="eval-lake-token")
+    hook = LakeCatalogHook("lake_default", request_timeout=5)
+
+    async def aget_connection(_conn_id):
+        return conn
+
+    hook.get_connection = lambda _conn_id: conn  # type: ignore[method-assign]
+    hook.aget_connection = aget_connection  # type: ignore[method-assign]
+    return hook
+
+
+# --------------------------------------------------------------------------- hook
+
+
+def test_hook_reads_published_partition(catalog):
+    port, _ = catalog("--publish", "orders/2026-09-29=0")
+    hook = hook_for(port)
+    assert hook.get_partition("orders", "2026-09-29")["state"] == "PUBLISHED"
+    assert asyncio.run(hook.aget_partition("orders", "2026-09-29"))["files"] == FILES
+    assert hook.get_partition("orders", "2026-09-30") == {"state": "PENDING"}
+
+
+def test_hook_errors_on_5xx_and_connection_failure(catalog):
+    port, _ = catalog("--down")
+    hook = hook_for(port)
+    with pytest.raises(LakeApiError, match="HTTP 503"):
+        hook.get_partition("orders", "2026-09-29")
+    with pytest.raises(LakeApiError, match="HTTP 503"):
+        asyncio.run(hook.aget_partition("orders", "2026-09-29"))
+    unreachable = hook_for(1)  # nothing listens on port 1
+    with pytest.raises(LakeApiError, match="failed"):
+        unreachable.get_partition("orders", "2026-09-29")
+    with pytest.raises(LakeApiError, match="failed"):
+        asyncio.run(unreachable.aget_partition("orders", "2026-09-29"))
+
+
+def test_async_hook_does_not_block_the_event_loop(catalog):
+    port, _ = catalog("--publish", "orders/2026-09-29=0", "--latency", "1.0")
+    hook = hook_for(port)
+
+    async def scenario():
+        ticks = 0
+
+        async def heartbeat():
+            nonlocal ticks
+            while True:
+                await asyncio.sleep(0.05)
+                ticks += 1
+
+        hb = asyncio.create_task(heartbeat())
+        info = await hook.aget_partition("orders", "2026-09-29")
+        hb.cancel()
+        return info, ticks
+
+    info, ticks = asyncio.run(scenario())
+    assert info["state"] == "PUBLISHED"
+    # With a blocking call the heartbeat would not run at all during the 1 s request.
+    assert ticks >= 10
+
+
+# ------------------------------------------------------------------------ trigger
+
+
+def fake_hook(responses):
+    """``responses``: list of dicts or exceptions returned by successive aget_partition calls."""
+    calls = []
+
+    async def aget_partition(table, partition):
+        calls.append((table, partition))
+        item = responses.pop(0) if len(responses) > 1 else responses[0]
+        if isinstance(item, Exception):
+            raise item
+        return item
+
+    hook = mock.Mock()
+    hook.aget_partition = aget_partition
+    hook.calls = calls
+    return hook
+
+
+def test_trigger_reports_published_files_for_its_own_partition():
+    today = PartitionPublishedTrigger("orders", "2026-09-30", deadline=now() + timedelta(hours=2), poll_interval=0.01)
+    yesterday = PartitionPublishedTrigger("orders", "2026-09-29", deadline=now() + timedelta(hours=2), poll_interval=0.01)
+    today_files = ["s3://lake/orders/2026-09-30/part-0.parquet"]
+    with mock.patch.object(triggers_module, "LakeCatalogHook", return_value=fake_hook([{"state": "PUBLISHED", "files": FILES}])):
+        assert run_trigger(yesterday) == {"status": "published", "files": FILES}
+    with mock.patch.object(triggers_module, "LakeCatalogHook", return_value=fake_hook([{"state": "PUBLISHED", "files": today_files}])):
+        # The cache must not serve yesterday's list for today's partition.
+        assert run_trigger(today) == {"status": "published", "files": today_files}
+    # Cached partitions are answered without calling the API.
+    with mock.patch.object(triggers_module, "LakeCatalogHook", return_value=fake_hook([LakeApiError("boom")])):
+        assert run_trigger(yesterday) == {"status": "published", "files": FILES}
+
+
+def test_trigger_times_out_at_the_absolute_deadline():
+    trigger = PartitionPublishedTrigger("orders", "2026-09-30", deadline=now() + timedelta(seconds=0.3), poll_interval=0.05)
+    hook = fake_hook([{"state": "PENDING"}])
+    with mock.patch.object(triggers_module, "LakeCatalogHook", return_value=hook):
+        started = time.monotonic()
+        assert run_trigger(trigger) == {"status": "timeout"}
+    assert 0.25 <= time.monotonic() - started < 1.0
+    assert len(hook.calls) >= 2
+
+
+def test_trigger_with_past_deadline_gives_up_immediately_even_after_recreation():
+    trigger = PartitionPublishedTrigger("orders", "2026-09-30", deadline=now() - timedelta(hours=5), poll_interval=60)
+    classpath, kwargs = trigger.serialize()
+    assert classpath == "lake.triggers.PartitionPublishedTrigger"
+    recreated = PartitionPublishedTrigger(**kwargs)  # what the triggerer does after a restart
+    assert recreated.deadline == trigger.deadline
+    with mock.patch.object(triggers_module, "LakeCatalogHook", return_value=fake_hook([{"state": "PENDING"}])):
+        started = time.monotonic()
+        assert run_trigger(recreated) == {"status": "timeout"}
+    assert time.monotonic() - started < 1.0
+
+
+def test_trigger_accepts_legacy_relative_timeout_kwargs():
+    # Tasks deferred by the previous version serialized {"timeout": seconds} instead of a deadline.
+    legacy = PartitionPublishedTrigger(table="orders", partition="2026-09-30", timeout=7200, lake_conn_id="lake_default", poll_interval=120)
+    assert timedelta(seconds=7190) < legacy.deadline - now() <= timedelta(seconds=7200)
+    with pytest.raises(ValueError):
+        PartitionPublishedTrigger(table="orders", partition="2026-09-30")
+
+
+def test_trigger_reports_api_errors():
+    trigger = PartitionPublishedTrigger("orders", "2026-09-30", deadline=now() + timedelta(hours=2), poll_interval=0.01)
+    with mock.patch.object(triggers_module, "LakeCatalogHook", return_value=fake_hook([LakeApiError("GET x -> HTTP 503")])):
+        assert run_trigger(trigger) == {"status": "error", "message": "GET x -> HTTP 503"}
+
+
+# ------------------------------------------------------------------------- sensor
+
+
+class FakeStore(dict):
+    def get(self, key, default=None):  # type: ignore[override]
+        return super().get(key, default)
+
+    def set(self, key, value, *, retention=None):
+        self[key] = value
+
+
+def sensor(**kwargs) -> PartitionPublishedSensor:
+    defaults = dict(task_id="wait_orders", table="orders", partition="2026-09-30", poke_interval=120, timeout=7200, retries=3)
+    defaults.update(kwargs)
+    return PartitionPublishedSensor(**defaults)
+
+
+def context(store, try_number=1, max_tries=3):
+    return {"ti": SimpleNamespace(try_number=try_number, max_tries=max_tries), "task_state_store": store}
+
+
+def defer_of(s, ctx) -> TaskDeferred:
+    with pytest.raises(TaskDeferred) as exc_info:
+        s.execute(ctx)
+    return exc_info.value
+
+
+def test_first_try_records_start_and_defers_with_absolute_deadline():
+    store = FakeStore()
+    before = now()
+    deferred = defer_of(sensor(), context(store))
+    trigger = deferred.trigger
+    assert isinstance(trigger, PartitionPublishedTrigger)
+    started_at = datetime.fromisoformat(store[STARTED_AT_KEY])
+    assert before <= started_at <= now()
+    assert trigger.deadline == started_at + timedelta(seconds=7200)
+    assert trigger.serialize()[1]["deadline"] == trigger.deadline.isoformat()
+    assert deferred.method_name == "execute_complete"
+    assert timedelta(seconds=7190) < deferred.timeout <= timedelta(seconds=7200)
+
+
+def test_retry_keeps_the_original_deadline():
+    started = now() - timedelta(minutes=50)
+    store = FakeStore({STARTED_AT_KEY: started.isoformat()})
+    deferred = defer_of(sensor(), context(store, try_number=2))
+    assert deferred.trigger.deadline == started + timedelta(hours=2)
+    assert deferred.timeout < timedelta(minutes=71)
+    assert store[STARTED_AT_KEY] == started.isoformat()
+
+
+def test_retry_after_the_deadline_times_out_without_waiting():
+    store = FakeStore({STARTED_AT_KEY: (now() - timedelta(hours=3)).isoformat()})
+    with pytest.raises(AirflowSensorTimeout):
+        sensor().execute(context(store, try_number=2))
+    with pytest.raises(AirflowSkipException):
+        sensor(soft_fail=True).execute(context(store, try_number=3))
+
+
+def test_clearing_the_task_starts_a_fresh_wait():
+    store = FakeStore({STARTED_AT_KEY: (now() - timedelta(days=1)).isoformat()})
+    # After a clear Airflow sets max_tries = last try_number + retries, so try 5 is a "first" try.
+    deferred = defer_of(sensor(), context(store, try_number=5, max_tries=7))
+    assert deferred.trigger.deadline > now() + timedelta(seconds=7190)
+    assert datetime.fromisoformat(store[STARTED_AT_KEY]) > now() - timedelta(seconds=5)
+
+
+def test_execute_complete_outcomes():
+    s = sensor()
+    assert s.execute_complete({}, {"status": "published", "files": FILES}) == FILES
+    with pytest.raises(LakeApiError, match="HTTP 503"):
+        s.execute_complete({}, {"status": "error", "message": "GET x -> HTTP 503"})
+    store = FakeStore({STARTED_AT_KEY: (now() - timedelta(hours=2)).isoformat()})
+    with pytest.raises(AirflowSensorTimeout, match="waited 7[12]\\d\\ds"):
+        s.execute_complete(context(store), {"status": "timeout"})
+    with pytest.raises(AirflowSkipException):
+        sensor(soft_fail=True).execute_complete({}, {"status": "timeout"})
+
+
+def test_non_deferrable_mode_uses_remaining_budget():
+    store = FakeStore({STARTED_AT_KEY: (now() - timedelta(hours=1)).isoformat()})
+    s = sensor(deferrable=False, poke_interval=0.01)
+    with mock.patch("lake.sensors.LakeCatalogHook") as hook_cls:
+        hook_cls.return_value.get_partition.return_value = {"state": "PUBLISHED", "files": FILES}
+        assert s.execute(context(store, try_number=2)) == FILES
+    assert 3500 < s.timeout <= 3600
+
+
+def test_dag_files_import():
+    from importlib import import_module
+
+    assert {t.task_id for t in import_module("lake_ingest").lake_ingest().tasks} == {
+        "wait_orders", "wait_customers", "load_orders", "load_customers"
+    }
+    assert {t.task_id for t in import_module("orders_diff").orders_diff().tasks} == {"wait_today", "wait_yesterday", "diff"}
+
+
+if __name__ == "__main__":  # pragma: no cover
+    sys.exit(pytest.main([__file__, *sys.argv[1:]]))
