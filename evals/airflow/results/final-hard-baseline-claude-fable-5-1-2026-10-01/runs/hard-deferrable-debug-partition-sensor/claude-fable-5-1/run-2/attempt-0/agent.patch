+    async def _afetch(self, url: str, headers: dict[str, str]) -> dict:
+        # A real async client: the triggerer runs every trigger on one event loop, so a blocking
+        # ``requests`` call here stalls every other deferred task for the duration of the call.
+        try:
+            async with httpx.AsyncClient(timeout=self.request_timeout) as client:
