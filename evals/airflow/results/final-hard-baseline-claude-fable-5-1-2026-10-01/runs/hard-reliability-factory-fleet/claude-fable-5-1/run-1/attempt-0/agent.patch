+def load_config(path: Path) -> dict:
+    cfg = load_yaml(path)
+    if not isinstance(cfg, dict) or not isinstance(cfg.get("name"), str):
+        raise ValueError("config must be a mapping with a string 'name'")
+    return cfg
+
+
+def select_configs(dag_id: str | None) -> list[tuple[Path, dict]]:
+    """Return (path, config) for the configs to build.
+
+    With no dag_id (the dag processor) that is every config that loads. When a
+    worker parses the file to run a task, Airflow tells us the dag_id and only
+    that pipeline's config is returned, so the other 139 DAGs are never built.
+    """
+    paths = sorted(CONFIG_DIR.glob("*.yaml"))
+    direct = None
+    if dag_id is not None:
+        # Configs are normally named after their pipeline; check that first.
+        direct = CONFIG_DIR / f"{dag_id}.yaml"
+        if direct in paths:
+            paths = [direct] + [p for p in paths if p != direct]
+    selected = []
+    for path in paths:
+        try:
+            cfg = load_config(path)
+        except Exception:
+            # In a worker only the requested pipeline's problems are relevant.
+            if dag_id is None or path == direct:
+                log.exception(
+                    "Pipeline config %s is broken; its DAG is skipped until the config is fixed",
+                    path,
+                )
+            continue
+        if dag_id is None or cfg["name"] == dag_id:
+            selected.append((path, cfg))
+            if dag_id is not None:
+                break
+    return selected
+
+
+def build_fleet(dag_id: str | None = None) -> dict[str, DAG]:
+    # A missing or unparseable registry is a deploy problem that no pipeline can
+    # be validated without, so let it fail the whole file loudly.
+    registry = load_yaml(REGISTRY)
+    dags: dict[str, DAG] = {}
+    sources: dict[str, Path] = {}
+    for path, cfg in select_configs(dag_id):
+        if cfg["name"] in dags:
+            log.error(
+                "Pipeline config %s is skipped: dag_id %r is already defined by %s",
+                path, cfg["name"], sources[cfg["name"]],
+            )
+            continue
+        try:
+            dag = build_dag(path, cfg, registry)
+        except Exception:
+            log.exception(
+                "Pipeline config %s is broken; its DAG is skipped until the config is fixed",
+                path,
+            )
+            continue
+        dags[dag.dag_id] = dag
+        sources[dag.dag_id] = path
+    return dags
+
+
+# Airflow only picks up DAG objects that are module globals.
+globals().update(build_fleet(get_parsing_context().dag_id))
