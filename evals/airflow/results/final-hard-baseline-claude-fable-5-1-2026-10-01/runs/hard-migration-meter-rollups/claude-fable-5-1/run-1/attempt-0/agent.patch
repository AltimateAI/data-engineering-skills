diff --git a/plugins/meter_lib/runs.py b/plugins/meter_lib/runs.py
new file mode 100644
index 0000000..5378888
--- /dev/null
+++ b/plugins/meter_lib/runs.py
@@ -0,0 +1,86 @@
+"""Schedules and run dates of the metering DAGs, with the semantics they had on Airflow 2.
+
+Airflow 3 changed three things the DAGs and the ops runbook rely on:
+
+* A cron string now gives a ``CronTriggerTimetable``, whose runs cover no data
+  interval (``data_interval_start == data_interval_end == logical_date``, the
+  fire time). Airflow 2 gave the run the interval that *ends* when it fires, so
+  the 02:30 billing run bills the previous day. :func:`cron_interval` pins that.
+* Manual runs (``airflow dags trigger``, the REST API) have no logical date, so
+  ``logical_date``, ``ds`` and ``data_interval_*`` are missing from the task
+  context. Airflow 2 used the trigger time as logical date and inferred the
+  data interval as the last complete schedule interval before it; the runbook
+  depends on both. :func:`run_date`, :func:`run_day` and :func:`data_interval`
+  reproduce them.
+* Asset-triggered runs have no data interval. Airflow 2 spanned them from the
+  earliest data interval of the loads that emitted the triggering events to the
+  latest. :func:`data_interval` rebuilds that from the ``data_interval_start`` /
+  ``data_interval_end`` the landing operator records in each event's ``extra``.
+
+Everything a run needs is on its ``dag_run`` (and the ``dag``), which templates
+have too: ``{{ macros.meter.run_day(dag_run) }}``,
+``{{ macros.meter.data_interval(dag, dag_run).start }}``.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+import pendulum
+from airflow.timetables.base import DataInterval
+from airflow.timetables.interval import CronDataIntervalTimetable
+
+if TYPE_CHECKING:
+    from pendulum import DateTime
+
+UTC = "UTC"
+
+
+def _utc(value: Any) -> DateTime:
+    return pendulum.instance(value).in_tz(UTC)
+
+
+def cron_interval(cron: str) -> CronDataIntervalTimetable:
+    """Cron schedule whose runs cover the interval ending when they fire (Airflow 2 semantics)."""
+    return CronDataIntervalTimetable(cron, timezone=UTC)
+
+
+def run_date(dag_run: Any) -> DateTime:
+    """Logical date of the run, or the trigger time for manual runs without one (Airflow 2's ``execution_date``)."""
+    if dag_run.logical_date is not None:
+        return _utc(dag_run.logical_date)
+    return _utc(dag_run.run_after).replace(microsecond=0)
+
+
+def run_day(dag_run: Any) -> str:
+    """``YYYY-MM-DD`` of :func:`run_date` (Airflow 2's ``ds``). Also a ``macros.meter.*`` macro."""
+    return run_date(dag_run).strftime("%Y-%m-%d")
+
+
+def _event_interval(event: Any) -> tuple[DateTime, DateTime]:
+    extra = event.extra or {}
+    if "data_interval_start" in extra and "data_interval_end" in extra:
+        return pendulum.parse(extra["data_interval_start"]), pendulum.parse(extra["data_interval_end"])
+    timestamp = _utc(event.timestamp)
+    return timestamp, timestamp
+
+
+def data_interval(dag: Any, dag_run: Any) -> DataInterval:
+    """Data interval of the run, as Airflow 2 would have set it. Also a ``macros.meter.*`` macro.
+
+    Scheduled and backfill runs: the interval the scheduler gave the run.
+    Asset-triggered runs: from the earliest start to the latest end of the loads
+    behind the triggering events (an event without that information counts as
+    its own timestamp, like Airflow 2 did for events without a source run).
+    Manual runs: the last complete schedule interval before the logical date,
+    or before the trigger time when there is no logical date. Airflow 3's own
+    interval for manual runs is ignored on purpose: the CLI infers it from the
+    trigger time even when a logical date is given.
+    """
+    if dag_run.run_type == "asset_triggered":
+        intervals = [_event_interval(event) for event in dag_run.consumed_asset_events]
+        if intervals:
+            return DataInterval(min(start for start, _ in intervals), max(end for _, end in intervals))
+    if dag_run.run_type in ("manual", "asset_triggered") or dag_run.data_interval_start is None:
+        return dag.timetable.infer_manual_data_interval(run_after=run_date(dag_run))
+    return DataInterval(_utc(dag_run.data_interval_start), _utc(dag_run.data_interval_end))
