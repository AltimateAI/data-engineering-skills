+def feed_day(context) -> str:
+    """The day (UTC, YYYY-MM-DD) this run produces the feed for.
+
+    Runs with a logical date use it. A manual trigger without one has
+    logical_date=None, so fall back to the dag run's run_after (the trigger
+    time), which is fixed per run and so survives clear/re-run.
+    """
+    dag_run = context["dag_run"]
+    moment = dag_run.logical_date or dag_run.run_after
+    return moment.astimezone(timezone.utc).strftime("%Y-%m-%d")
+
