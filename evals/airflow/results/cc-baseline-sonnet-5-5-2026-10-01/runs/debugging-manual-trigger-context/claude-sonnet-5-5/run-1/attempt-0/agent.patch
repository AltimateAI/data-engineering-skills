+def feed_day(dag_run) -> str:
+    """Day (YYYY-MM-DD, UTC) of the feed a run produces.
+
+    Scheduled runs and runs triggered with a logical date use the logical date.
+    Manual runs triggered without one have logical_date=None (and no ds/
+    logical_date in the task context), so fall back to run_after, the moment
+    the run was triggered. It is stored on the run, so clearing and re-running
+    later yields the same day.
+    """
+    moment = dag_run.logical_date or dag_run.run_after
+    return moment.astimezone(timezone.utc).strftime("%Y-%m-%d")
+
