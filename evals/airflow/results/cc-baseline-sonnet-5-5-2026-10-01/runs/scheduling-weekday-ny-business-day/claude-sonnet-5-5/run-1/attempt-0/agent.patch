+def previous_business_day(run_time: pendulum.DateTime) -> str:
+    """Previous Mon-Fri New York calendar day before ``run_time`` (bank holidays ignored)."""
+    day = run_time.in_timezone(NY_TZ).subtract(days=1)
+    while day.weekday() >= 5:  # Saturday=5, Sunday=6
+        day = day.subtract(days=1)
+    return day.format("YYYY-MM-DD")
+
