+def previous_watermark(before_batch: str) -> str | None:
+    """Largest ``updated_at`` loaded by batches of earlier intervals.
+
+    Tasks can no longer query the metadata DB in Airflow 3, so the high-water
+    mark is read from the batch files themselves. Only batches strictly before
+    ``before_batch`` count, which makes retries and clears of any interval
+    reproduce that interval's batch instead of seeing their own (or later) output.
+    """
+    marks = []
+    for batch in BATCH_DIR.glob("batch_*.csv"):
+        if batch.name < before_batch:
+            with batch.open(newline="") as fh:
+                marks.extend(r["updated_at"] for r in csv.DictReader(fh))
+    return max(marks, default=None)
 
 
