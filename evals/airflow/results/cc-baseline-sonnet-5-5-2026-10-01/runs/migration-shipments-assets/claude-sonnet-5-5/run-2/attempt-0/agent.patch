+def previous_watermark(before: str) -> str | None:
+    """High-water mark of the batches loaded for earlier intervals.
+
+    Tasks can no longer query the metadata DB in Airflow 3, so the mark is
+    derived from the batch files themselves. Only batches older than the
+    current one count, which keeps re-runs of an interval idempotent.
+    """
+    mark = None
+    for batch in sorted(BATCH_DIR.glob("batch_*.csv")):
+        if batch.name >= before:
+            continue
+        with batch.open(newline="") as fh:
+            for r in csv.DictReader(fh):
+                if mark is None or r["updated_at"] > mark:
+                    mark = r["updated_at"]
+    return mark
 
 
