+from pathlib import Path
+
+import pytest
+
+DAGS_DIR = Path(__file__).resolve().parents[1] / "dags"
+
+
+@pytest.fixture(scope="session")
+def dags_dir() -> Path:
+    return DAGS_DIR
+
+
+@pytest.fixture(scope="session")
+def dagbag(dags_dir):
+    from airflow.dag_processing.dagbag import DagBag
+
+    # safe_mode=False so files are parsed even if they lack the "airflow"/"dag"
+    # heuristic strings; we want every file in dags/ to be loaded.
+    return DagBag(dag_folder=str(dags_dir), safe_mode=False, bundle_path=dags_dir, bundle_name="tests")
