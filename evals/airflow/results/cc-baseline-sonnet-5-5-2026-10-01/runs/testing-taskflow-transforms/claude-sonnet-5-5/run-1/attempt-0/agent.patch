+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@pytest.fixture(scope="session")
+def mod():
+    """The DAG module, imported from its file (dags/ is not a package)."""
+    spec = importlib.util.spec_from_file_location("orders_enrichment_under_test", ROOT / "dags" / "orders_enrichment.py")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture(scope="session")
+def dag(mod):
+    return mod.orders_enrichment()
+
+
+@pytest.fixture
+def run_pipeline(mod, monkeypatch, tmp_path):
+    """Run the task functions in DAG order for a given ds, writing under tmp_path.
+
+    Mirrors the wiring in orders_enrichment(); test_dag_structure checks that
+    the real DAG has the same dependencies. Returns the output Path (may not exist).
+    """
+    out_dir = tmp_path / "output" / "orders_enriched"
+    monkeypatch.setattr(mod, "OUTPUT_DIR", out_dir)
+
+    def run(ds, data_dir=ROOT / "data"):
+        monkeypatch.setattr(mod, "DATA_DIR", Path(data_dir))
+        orders = mod.dedupe_orders.function(mod.extract_orders.function(ds=ds))
+        enriched = mod.convert_to_usd.function(orders, mod.load_fx_rates.function(ds=ds))
+        validated = mod.validate_totals.function(enriched)
+        return Path(mod.load_enriched.function(validated, ds=ds))
+
+    run.out_dir = out_dir
+    return run
diff --git a/tests/test_orders_enrichment.py b/tests/test_orders_enrichment.py
new file mode 100644
index 0000000..d83de23
--- /dev/null
+++ b/tests/test_orders_enrichment.py
@@ -0,0 +1,152 @@
+import csv
+from pathlib import Path
+
+import pytest
+
+HEADER = "order_id,order_date,updated_at,customer_id,currency,amount\n"
+
+
+def order(order_id="O-1", updated_at="2026-03-02T08:00:00", customer_id="C-1", currency="USD", amount="10.00",
+          order_date="2026-03-02"):
+    return {"order_id": order_id, "order_date": order_date, "updated_at": updated_at,
+            "customer_id": customer_id, "currency": currency, "amount": amount}
+
+
+# --- dedupe ---------------------------------------------------------------
+
+def test_dedupe_keeps_latest_version_by_updated_at(mod):
+    rows = [
+        order("A", "2026-03-02T08:00:00", amount="100.00"),
+        order("A", "2026-03-02T11:47:00", amount="120.00"),
+        order("A", "2026-03-02T09:30:00", amount="110.00"),
+    ]
+    assert [r["amount"] for r in mod.dedupe_orders.function(rows)] == ["120.00"]
+
+
+def test_dedupe_latest_wins_regardless_of_file_order(mod):
+    newest_first = [order("A", "2026-03-02T12:00:00", amount="2"), order("A", "2026-03-02T01:00:00", amount="1")]
+    assert mod.dedupe_orders.function(newest_first)[0]["amount"] == "2"
+    assert mod.dedupe_orders.function(newest_first[::-1])[0]["amount"] == "2"
+
+
+def test_dedupe_keeps_distinct_orders_sorted_by_id(mod):
+    rows = [order("B"), order("A"), order("C")]
+    assert [r["order_id"] for r in mod.dedupe_orders.function(rows)] == ["A", "B", "C"]
+
+
+# --- convert --------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "amount, rate, expected",
+    [
+        ("100.00", "1.0850", "108.50"),
+        ("1.00", "0.125", "0.13"),        # exact tie rounds up (half-even would give 0.12)
+        ("2.00", "0.1225", "0.25"),       # 0.2450 -> 0.25 (half-even would give 0.24)
+        ("40.50", "1.2700", "51.44"),     # 51.435
+        ("0.35", "1.0850", "0.38"),       # 0.37975
+        ("1.00", "0.1249", "0.12"),       # just below the tie rounds down
+        ("10.00", "1", "10.00"),
+    ],
+)
+def test_convert_rounds_half_up_to_cents(mod, amount, rate, expected):
+    [row] = mod.convert_to_usd.function([order(currency="EUR", amount=amount)], {"EUR": rate})
+    assert row["amount_usd"] == expected
+
+
+def test_convert_uses_rate_of_the_row_currency_and_keeps_fields(mod):
+    rows = [order("A", currency="EUR", amount="10.00"), order("B", currency="GBP", amount="10.00")]
+    out = mod.convert_to_usd.function(rows, {"EUR": "1.1", "GBP": "1.3"})
+    assert [r["amount_usd"] for r in out] == ["11.00", "13.00"]
+    assert out[0]["order_id"] == "A" and out[0]["amount"] == "10.00"
+
+
+def test_convert_fails_when_currency_has_no_rate(mod):
+    rows = [order("A", currency="EUR"), order("B", currency="JPY")]
+    with pytest.raises(ValueError, match="JPY.*B"):
+        mod.convert_to_usd.function(rows, {"EUR": "1.1"})
+
+
+# --- load_fx_rates / extract ---------------------------------------------
+
+def test_fx_rates_are_for_the_run_date_only_and_usd_is_implicit(mod):
+    rates = mod.load_fx_rates.function(ds="2026-03-02")
+    assert rates == {"USD": "1", "EUR": "1.0850", "GBP": "1.2700"}
+
+
+def test_fx_rate_missing_for_the_day_means_no_rate(mod):
+    assert "EUR" not in mod.load_fx_rates.function(ds="2026-03-09")  # no rates that day, not yesterday's
+
+
+def test_extract_only_returns_rows_for_run_date(mod):
+    rows = mod.extract_orders.function(ds="2026-03-02")
+    assert {r["order_date"] for r in rows} == {"2026-03-02"}
+    assert len(rows) == 6  # includes the duplicate exports
+
+
+# --- validate -------------------------------------------------------------
+
+def test_validate_passes_good_rows_through(mod):
+    rows = [{**order(), "amount_usd": "0.00"}]
+    assert mod.validate_totals.function(rows) == rows
+
+
+@pytest.mark.parametrize("override", [{"customer_id": ""}, {"amount_usd": "-0.01"}])
+def test_validate_rejects_bad_rows(mod, override):
+    with pytest.raises(ValueError, match="O-1"):
+        mod.validate_totals.function([{**order(), "amount_usd": "5.00", **override}])
+
+
+# --- DAG definition -------------------------------------------------------
+
+def test_dag_runs_daily_at_0600_utc(dag):
+    tt = dag.timetable
+    assert type(tt).__name__ == "CronTriggerTimetable"
+    assert tt.expression == "0 6 * * *"
+    assert tt.timezone.name == "UTC"
+    assert dag.catchup is False
+
+
+def test_dag_structure_gates_output_on_validation(dag):
+    up = {t.task_id: t.upstream_task_ids for t in dag.tasks}
+    assert up["load_enriched"] == {"validate_totals"}
+    assert up["validate_totals"] == {"convert_to_usd"}
+    assert up["convert_to_usd"] == {"dedupe_orders", "load_fx_rates"}
+    assert up["dedupe_orders"] == {"extract_orders"}
+    assert set(up) == {"extract_orders", "dedupe_orders", "load_fx_rates", "convert_to_usd",
+                       "validate_totals", "load_enriched"}
+
+
+# --- end to end on data/ --------------------------------------------------
+
+def read(path):
+    with Path(path).open(newline="") as fh:
+        return list(csv.DictReader(fh))
+
+
+def test_end_to_end_sample_data(run_pipeline):
+    out = run_pipeline("2026-03-02")
+    assert out == run_pipeline.out_dir / "2026-03-02.csv"
+    assert read(out) == [
+        {"order_id": "S-102", "customer_id": "C-7", "currency": "EUR", "amount": "120.00", "amount_usd": "130.20"},
+        {"order_id": "S-103", "customer_id": "C-9", "currency": "GBP", "amount": "40.50", "amount_usd": "51.44"},
+        {"order_id": "S-104", "customer_id": "C-10", "currency": "USD", "amount": "9.99", "amount_usd": "9.99"},
+        {"order_id": "S-105", "customer_id": "C-8", "currency": "EUR", "amount": "0.35", "amount_usd": "0.38"},
+    ]
+    assert out.read_text().splitlines()[0] == "order_id,customer_id,currency,amount,amount_usd"
+
+
+def test_end_to_end_missing_fx_rate_fails_and_writes_nothing(run_pipeline, tmp_path):
+    (tmp_path / "orders.csv").write_text(HEADER + "X-1,2026-03-02,2026-03-02T08:00:00,C-1,JPY,1000\n"
+                                         "X-2,2026-03-02,2026-03-02T08:00:00,C-1,EUR,5.00\n")
+    (tmp_path / "fx_rates.csv").write_text("rate_date,currency,usd_per_unit\n2026-03-02,EUR,1.0850\n")
+    with pytest.raises(ValueError, match="JPY"):
+        run_pipeline("2026-03-02", data_dir=tmp_path)
+    assert not run_pipeline.out_dir.exists()
+
+
+def test_end_to_end_failed_validation_writes_nothing(run_pipeline, tmp_path):
+    (tmp_path / "orders.csv").write_text(HEADER + "X-1,2026-03-02,2026-03-02T08:00:00,,USD,5.00\n")
+    (tmp_path / "fx_rates.csv").write_text("rate_date,currency,usd_per_unit\n")
+    with pytest.raises(ValueError, match="invalid orders"):
+        run_pipeline("2026-03-02", data_dir=tmp_path)
+    assert not run_pipeline.out_dir.exists()
