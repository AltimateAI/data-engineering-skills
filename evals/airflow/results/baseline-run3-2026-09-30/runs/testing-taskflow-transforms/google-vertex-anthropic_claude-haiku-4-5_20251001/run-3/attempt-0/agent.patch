+"""Pytest suite for orders_enrichment DAG.
+
+Tests cover:
+1. Unit tests for each transformation function
+2. Edge cases specific to finance requirements
+3. End-to-end validation on sample data
+
+Note: The DAG uses Airflow's @task decorator, which returns XComArg objects
+in the DAG context. These tests import pure Python implementations from
+helpers.py to test the transformation logic directly.
+"""
+
+import csv
+import tempfile
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+# Import pure transformation functions from helpers module
+from .helpers import (
+    dedupe_orders,
+    convert_to_usd,
+    validate_totals,
+    extract_orders,
+    load_fx_rates,
+    load_enriched,
+)
+
+
+class TestDedupeOrders:
+    """Test deduplication logic: keep latest version by updated_at, sorted by order_id."""
+
+    def test_dedupe_single_order_per_id(self):
+        """Single order per ID passes through unchanged."""
+        rows = [
+            {"order_id": "S-100", "updated_at": "2026-03-01T09:00:00", "customer_id": "C-1"},
+            {"order_id": "S-101", "updated_at": "2026-03-01T10:00:00", "customer_id": "C-2"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 2
+        assert result[0]["order_id"] == "S-100"
+        assert result[1]["order_id"] == "S-101"
+
+    def test_dedupe_keeps_latest_by_updated_at(self):
+        """When order appears twice, keep only the version with highest updated_at."""
+        rows = [
+            {"order_id": "S-100", "updated_at": "2026-03-01T08:00:00", "customer_id": "C-1", "amount": "10.00"},
+            {"order_id": "S-100", "updated_at": "2026-03-01T09:30:00", "customer_id": "C-1", "amount": "15.00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["updated_at"] == "2026-03-01T09:30:00"
+        assert result[0]["amount"] == "15.00"
+
+    def test_dedupe_output_sorted_by_order_id(self):
+        """Output is sorted by order_id regardless of input order."""
+        rows = [
+            {"order_id": "S-103", "updated_at": "2026-03-01T09:00:00"},
+            {"order_id": "S-101", "updated_at": "2026-03-01T10:00:00"},
+            {"order_id": "S-102", "updated_at": "2026-03-01T11:00:00"},
+        ]
+        result = dedupe_orders(rows)
+        assert [r["order_id"] for r in result] == ["S-101", "S-102", "S-103"]
+
+    def test_dedupe_complex_scenario(self):
+        """Test deduplication with mixed single and multiple versions."""
+        rows = [
+            {"order_id": "S-100", "updated_at": "2026-03-01T08:00:00", "amount": "10.00"},
+            {"order_id": "S-102", "updated_at": "2026-03-01T09:00:00", "amount": "20.00"},
+            {"order_id": "S-100", "updated_at": "2026-03-01T09:30:00", "amount": "12.00"},
+            {"order_id": "S-101", "updated_at": "2026-03-01T10:00:00", "amount": "15.00"},
+            {"order_id": "S-100", "updated_at": "2026-03-01T07:00:00", "amount": "8.00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 3
+        assert [r["order_id"] for r in result] == ["S-100", "S-101", "S-102"]
+        # S-100 should have the latest version (09:30)
+        assert result[0]["amount"] == "12.00"
+
+    def test_dedupe_empty_input(self):
+        """Empty input returns empty output."""
+        result = dedupe_orders([])
+        assert result == []
+
+
+class TestConvertToUSD:
+    """Test FX conversion: amount * usd_per_unit, rounded HALF_UP to cents."""
+
+    def test_convert_usd_to_usd(self):
+        """USD amounts stay the same (rate=1)."""
+        rows = [{"order_id": "S-100", "currency": "USD", "amount": "10.00"}]
+        rates = {"USD": "1"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "10.00"
+
+    def test_convert_eur_to_usd(self):
+        """EUR conversion with accurate rate."""
+        rows = [{"order_id": "S-101", "currency": "EUR", "amount": "20.00"}]
+        rates = {"USD": "1", "EUR": "1.0812"}
+        result = convert_to_usd(rows, rates)
+        # 20.00 * 1.0812 = 21.624, rounded HALF_UP to cents = 21.62
+        assert result[0]["amount_usd"] == "21.62"
+
+    def test_convert_gbp_to_usd(self):
+        """GBP conversion with accurate rate."""
+        rows = [{"order_id": "S-102", "currency": "GBP", "amount": "40.50"}]
+        rates = {"USD": "1", "GBP": "1.2655"}
+        result = convert_to_usd(rows, rates)
+        # 40.50 * 1.2655 = 51.2527, rounded HALF_UP to cents = 51.25
+        assert result[0]["amount_usd"] == "51.25"
+
+    def test_convert_rounding_half_up(self):
+        """HALF_UP rounding: .005 rounds up, .004 rounds down."""
+        # Test .005 rounding up
+        rows = [{"order_id": "S-1", "currency": "EUR", "amount": "10.00"}]
+        rates = {"EUR": "1.1245"}  # 10 * 1.1245 = 11.245 -> 11.25 (rounds up)
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "11.25"
+
+        # Test .004 rounding down
+        rows = [{"order_id": "S-2", "currency": "EUR", "amount": "10.00"}]
+        rates = {"EUR": "1.1244"}  # 10 * 1.1244 = 11.244 -> 11.24 (rounds down)
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "11.24"
+
+    def test_convert_missing_fx_rate_raises_error(self):
+        """Missing FX rate for a currency must raise ValueError, not guess."""
+        rows = [{"order_id": "S-100", "currency": "JPY", "amount": "1000"}]
+        rates = {"USD": "1"}  # No JPY rate
+        with pytest.raises(ValueError, match="no FX rate for JPY.*order S-100"):
+            convert_to_usd(rows, rates)
+
+    def test_convert_missing_fx_rate_multiple_orders(self):
+        """If one order has no rate, error is raised before processing others."""
+        rows = [
+            {"order_id": "S-100", "currency": "EUR", "amount": "10.00"},
+            {"order_id": "S-101", "currency": "JPY", "amount": "1000"},
+        ]
+        rates = {"USD": "1", "EUR": "1.0812"}
+        with pytest.raises(ValueError, match="no FX rate for JPY.*order S-101"):
+            convert_to_usd(rows, rates)
+
+    def test_convert_preserves_all_fields(self):
+        """All original fields are preserved in output."""
+        rows = [
+            {
+                "order_id": "S-100",
+                "customer_id": "C-1",
+                "currency": "EUR",
+                "amount": "20.00",
+                "order_date": "2026-03-01",
+                "updated_at": "2026-03-01T09:00:00",
+            }
+        ]
+        rates = {"EUR": "1.0812"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["order_id"] == "S-100"
+        assert result[0]["customer_id"] == "C-1"
+        assert result[0]["currency"] == "EUR"
+        assert result[0]["order_date"] == "2026-03-01"
+        assert result[0]["updated_at"] == "2026-03-01T09:00:00"
+        assert result[0]["amount_usd"] == "21.62"
+
+    def test_convert_zero_amount(self):
+        """Zero amounts convert to zero."""
+        rows = [{"order_id": "S-100", "currency": "EUR", "amount": "0.00"}]
+        rates = {"EUR": "1.0812"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "0.00"
+
+    def test_convert_large_amounts(self):
+        """Large amounts are converted accurately."""
+        rows = [{"order_id": "S-100", "currency": "GBP", "amount": "999999.99"}]
+        rates = {"GBP": "1.2655"}
+        result = convert_to_usd(rows, rates)
+        # 999999.99 * 1.2655 = 1265499.987345, rounded HALF_UP = 1265499.99
+        assert result[0]["amount_usd"] == "1265499.99"
+
+
+class TestValidateTotals:
+    """Test validation: reject orders with missing customer_id or negative amount_usd."""
+
+    def test_validate_valid_orders(self):
+        """Valid orders pass through unchanged."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-1", "amount_usd": "10.00"},
+            {"order_id": "S-101", "customer_id": "C-2", "amount_usd": "20.50"},
+        ]
+        result = validate_totals(rows)
+        assert len(result) == 2
+        assert result == rows
+
+    def test_validate_rejects_missing_customer_id(self):
+        """Orders with empty customer_id are rejected."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-1", "amount_usd": "10.00"},
+            {"order_id": "S-101", "customer_id": "", "amount_usd": "20.00"},
+            {"order_id": "S-102", "customer_id": "C-3", "amount_usd": "15.00"},
+        ]
+        with pytest.raises(ValueError, match="invalid orders.*S-101"):
+            validate_totals(rows)
+
+    def test_validate_rejects_none_customer_id(self):
+        """Orders with None customer_id are rejected."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-1", "amount_usd": "10.00"},
+            {"order_id": "S-101", "customer_id": None, "amount_usd": "20.00"},
+        ]
+        with pytest.raises(ValueError, match="invalid orders.*S-101"):
+            validate_totals(rows)
+
+    def test_validate_rejects_negative_amount_usd(self):
+        """Orders with negative amount_usd are rejected."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-1", "amount_usd": "10.00"},
+            {"order_id": "S-101", "customer_id": "C-2", "amount_usd": "-5.00"},
+        ]
+        with pytest.raises(ValueError, match="invalid orders.*S-101"):
+            validate_totals(rows)
+
+    def test_validate_rejects_multiple_bad_orders(self):
+        """Multiple bad orders are all reported."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-1", "amount_usd": "10.00"},
+            {"order_id": "S-101", "customer_id": "", "amount_usd": "20.00"},
+            {"order_id": "S-102", "customer_id": "C-3", "amount_usd": "-15.00"},
+            {"order_id": "S-103", "customer_id": None, "amount_usd": "5.00"},
+        ]
+        with pytest.raises(ValueError, match="invalid orders"):
+            validate_totals(rows)
+        # All three bad orders should be mentioned
+        try:
+            validate_totals(rows)
+        except ValueError as e:
+            error_msg = str(e)
+            assert "S-101" in error_msg
+            assert "S-102" in error_msg
+            assert "S-103" in error_msg
+
+    def test_validate_accepts_zero_amount(self):
+        """Zero amount_usd is acceptable (not negative)."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-1", "amount_usd": "0.00"},
+        ]
+        result = validate_totals(rows)
+        assert len(result) == 1
+
+    def test_validate_accepts_whitespace_customer_id(self):
+        """Customer ID that is only whitespace is accepted (field exists and is truthy in Python)."""
+        # Note: This tests the current behavior. "  " is truthy in Python.
+        rows = [
+            {"order_id": "S-100", "customer_id": "  ", "amount_usd": "10.00"},
+        ]
+        result = validate_totals(rows)
+        assert len(result) == 1
+
+    def test_validate_empty_input(self):
+        """Empty input passes validation."""
+        result = validate_totals([])
+        assert result == []
+
+
+class TestExtractOrders:
+    """Test extraction of orders for a specific date from sample data."""
+
+    def test_extract_orders_for_date(self):
+        """Extract only orders matching the given date from actual sample data."""
+        # Extract from actual sample data for 2026-03-02
+        result = extract_orders("2026-03-02")
+        assert len(result) > 0, "Sample data should have orders for 2026-03-02"
+        assert all(r["order_date"] == "2026-03-02" for r in result)
+
+    def test_extract_orders_no_match(self):
+        """Extract returns empty list when no orders match the date."""
+        result = extract_orders("2099-12-31")
+        assert result == []
+
+
+class TestLoadFXRates:
+    """Test loading FX rates for a specific date from sample data."""
+
+    def test_load_fx_rates_for_date(self):
+        """Load only rates matching the given date from actual sample data."""
