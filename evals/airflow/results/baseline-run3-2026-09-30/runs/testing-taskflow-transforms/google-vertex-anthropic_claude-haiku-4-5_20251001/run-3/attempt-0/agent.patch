+    def test_e2e_process_2026_03_02(self):
+        """Process 2026-03-02 sample data through entire pipeline.
+        
+        For 2026-03-02, the sample data has:
+        - S-102 appears twice; keep latest version (11:47) with EUR 120.00
+        - S-103 appears twice; keep latest version (08:30) with GBP 40.50
+        - S-104, S-105 appear once each
+        
+        Expected output:
+        - S-102: 120.00 EUR * 1.0850 = 130.20 USD
+        - S-103: 40.50 GBP * 1.2700 = 51.435 = 51.44 USD (HALF_UP)
+        - S-104: 9.99 USD * 1 = 9.99 USD
+        - S-105: 0.35 EUR * 1.0850 = 0.37975 = 0.38 USD (HALF_UP)
+        """
+        # Extract and dedupe orders for 2026-03-02
+        orders = extract_orders("2026-03-02")
+        assert len(orders) > 0, "Sample data should have orders for 2026-03-02"
+        
+        deduped = dedupe_orders(orders)
+        assert len(deduped) == 4, "Should have 4 unique orders after dedup"
+        assert [r["order_id"] for r in deduped] == ["S-102", "S-103", "S-104", "S-105"]
+        
+        # Load FX rates and convert
+        rates = load_fx_rates("2026-03-02")
+        enriched = convert_to_usd(deduped, rates)
+        
+        # Verify conversions
+        results_by_id = {r["order_id"]: r for r in enriched}
+        
+        # S-102: latest version has 120.00 EUR
+        assert results_by_id["S-102"]["amount"] == "120.00"
+        assert results_by_id["S-102"]["amount_usd"] == "130.20"
+        
+        # S-103: latest version has 40.50 GBP
+        assert results_by_id["S-103"]["amount"] == "40.50"
+        assert results_by_id["S-103"]["amount_usd"] == "51.44"  # 40.50 * 1.27 = 51.435 rounds up
+        
+        # S-104: 9.99 USD
+        assert results_by_id["S-104"]["amount_usd"] == "9.99"
+        
+        # S-105: 0.35 EUR
+        assert results_by_id["S-105"]["amount"] == "0.35"
+        assert results_by_id["S-105"]["amount_usd"] == "0.38"  # 0.35 * 1.085 = 0.37975 rounds up
+        
+        # Validate and ensure no errors
+        validated = validate_totals(enriched)
+        assert len(validated) == 4
