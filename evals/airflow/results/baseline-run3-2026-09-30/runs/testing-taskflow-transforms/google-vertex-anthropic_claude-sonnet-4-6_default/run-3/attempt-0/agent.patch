+"""Tests for validate_totals: refuse bad orders and gate the write step."""
+
+from __future__ import annotations
+
+import csv
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+from conftest import validate_totals, load_enriched, make_order
+
+
+def _make_enriched(
+    order_id: str = "O-001",
+    customer_id: str = "C-1",
+    currency: str = "USD",
+    amount: str = "10.00",
+    amount_usd: str = "10.00",
+) -> dict:
+    row = make_order(order_id, customer_id=customer_id, currency=currency, amount=amount)
+    row["amount_usd"] = amount_usd
+    return row
+
+
+# ---------------------------------------------------------------------------
+# validate_totals: rows that should pass
+# ---------------------------------------------------------------------------
+
+
+class TestValidateTotalsAccepts:
+    def test_valid_order_passes(self):
+        rows = [_make_enriched()]
+        assert validate_totals(rows) == rows
+
+    def test_zero_usd_amount_is_allowed(self):
+        """Zero is not negative; it must pass."""
+        rows = [_make_enriched(amount_usd="0.00")]
+        result = validate_totals(rows)
+        assert len(result) == 1
+
+    def test_multiple_valid_orders_all_returned(self):
+        rows = [
+            _make_enriched("O-1", amount_usd="10.00"),
+            _make_enriched("O-2", amount_usd="0.01"),
+            _make_enriched("O-3", amount_usd="999.99"),
+        ]
+        result = validate_totals(rows)
+        assert len(result) == 3
+
+    def test_empty_input_passes(self):
+        assert validate_totals([]) == []
+
+    def test_returned_rows_are_unchanged(self):
+        """validate_totals must not mutate or drop fields from passing rows."""
+        row = _make_enriched(order_id="O-1", amount_usd="55.00")
+        original_keys = set(row.keys())
+        result = validate_totals([row])
+        assert set(result[0].keys()) == original_keys
+        assert result[0] == row
+
+
+# ---------------------------------------------------------------------------
+# validate_totals: rows that should raise
+# ---------------------------------------------------------------------------
+
+
+class TestValidateTotalsRejects:
+    def test_negative_usd_raises(self):
+        rows = [_make_enriched(amount_usd="-0.01")]
+        with pytest.raises(ValueError):
+            validate_totals(rows)
+
+    def test_negative_usd_names_the_order(self):
+        rows = [_make_enriched("O-BAD", amount_usd="-5.00")]
+        with pytest.raises(ValueError, match="O-BAD"):
+            validate_totals(rows)
+
+    def test_empty_customer_id_raises(self):
+        rows = [_make_enriched(customer_id="")]
+        with pytest.raises(ValueError):
+            validate_totals(rows)
+
+    def test_empty_customer_id_names_the_order(self):
+        rows = [_make_enriched("O-NOCUST", customer_id="")]
+        with pytest.raises(ValueError, match="O-NOCUST"):
+            validate_totals(rows)
+
+    def test_one_bad_among_many_fails_all(self):
+        """A single invalid order must fail the entire call — partial writes must not happen."""
+        rows = [
+            _make_enriched("O-1", amount_usd="10.00"),
+            _make_enriched("O-2", customer_id=""),  # bad
+            _make_enriched("O-3", amount_usd="5.00"),
+        ]
+        with pytest.raises(ValueError):
+            validate_totals(rows)
+
+    def test_both_invalid_conditions_listed(self):
+        """If multiple orders are bad, the error should mention all of them."""
+        rows = [
+            _make_enriched("BAD-1", customer_id=""),
+            _make_enriched("BAD-2", amount_usd="-1.00"),
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            validate_totals(rows)
+        msg = str(exc_info.value)
+        assert "BAD-1" in msg
+        assert "BAD-2" in msg
+
+
+# ---------------------------------------------------------------------------
+# Finance requirement: nothing gets written to output/ unless
+# validate_totals has passed.
+# ---------------------------------------------------------------------------
+
+
+class TestOutputGating:
+    """validate_totals must gate load_enriched: if validation raises, no file
+    is written.  This mirrors the DAG's call chain:
+        load_enriched(validate_totals(enriched))
+    """
+
+    def test_no_file_written_when_validate_raises(self, tmp_output_dir):
+        """A bad batch must not produce an output CSV."""
+        bad_rows = [_make_enriched("O-BAD", amount_usd="-1.00")]
+
+        # Simulate the DAG call chain
+        with pytest.raises(ValueError):
+            validated = validate_totals(bad_rows)
+            load_enriched(validated, ds="2026-03-02")
+
+        # output/ directory should not even have been created, let alone have a file
+        out_file = tmp_output_dir / "2026-03-02.csv"
+        assert not out_file.exists()
+
+    def test_file_written_only_after_validate_passes(self, tmp_output_dir):
+        """A clean batch produces exactly one CSV in output/."""
+        good_rows = [_make_enriched("O-1", amount_usd="10.00")]
+
+        validated = validate_totals(good_rows)
+        load_enriched(validated, ds="2026-03-02")
+
+        out_file = tmp_output_dir / "2026-03-02.csv"
+        assert out_file.exists()
+
+    def test_output_file_has_correct_columns(self, tmp_output_dir):
+        """The CSV must contain exactly the five finance output columns."""
+        rows = [_make_enriched("O-1")]
+        validated = validate_totals(rows)
+        load_enriched(validated, ds="2026-03-02")
+
+        out_file = tmp_output_dir / "2026-03-02.csv"
+        with out_file.open(newline="") as fh:
+            reader = csv.DictReader(fh)
+            assert reader.fieldnames == ["order_id", "customer_id", "currency", "amount", "amount_usd"]
+
+    def test_output_file_excludes_internal_columns(self, tmp_output_dir):
+        """Columns like order_date and updated_at must NOT appear in the output CSV."""
+        row = make_order("O-1")
+        row["amount_usd"] = "10.00"
+        validated = validate_totals([row])
+        load_enriched(validated, ds="2026-03-02")
+
+        out_file = tmp_output_dir / "2026-03-02.csv"
+        with out_file.open(newline="") as fh:
+            header = fh.readline()
+        assert "order_date" not in header
+        assert "updated_at" not in header
