@@ -0,0 +1,205 @@
+"""End-to-end integration test using the real sample data in data/.
+
+Drives the full pipeline on the 2026-03-02 slice and asserts the exact
+values that Finance relies on.  No mocking — calls each task's raw
+callable in the same order as the DAG.
+"""
+
+from __future__ import annotations
+
+import csv
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+from conftest import (
+    dedupe_orders,
+    convert_to_usd,
+    validate_totals,
+    load_enriched,
+    extract_orders,
+    load_fx_rates,
+)
+
+# The pipeline date to exercise
+DS = "2026-03-02"
+
+# ── Expected values pre-computed from data/orders.csv + data/fx_rates.csv ──
+#
+# Rows for 2026-03-02 (raw):
+#   S-102  EUR 100.00  08:05     (superseded)
+#   S-103  GBP  40.50  08:30     ← winner (08:30 > 07:55)
+#   S-102  EUR 120.00  11:47     ← winner (11:47 > 08:05)
+#   S-104  USD   9.99  12:00
+#   S-103  GBP  38.00  07:55     (superseded)
+#   S-105  EUR   0.35  13:20
+#
+# FX rates for 2026-03-02: EUR=1.0850, GBP=1.2700, USD=1
+#
+#   S-102: 120.00 * 1.0850 = 130.200  → "130.20"
+#   S-103:  40.50 * 1.2700 =  51.435  → "51.44"  (HALF_UP)
+#   S-104:   9.99 * 1      =   9.990  → "9.99"
+#   S-105:   0.35 * 1.0850 =   0.3798 → "0.38"   (HALF_UP rounds 0.37975)
+
+EXPECTED = {
+    "S-102": {"customer_id": "C-7",  "currency": "EUR", "amount": "120.00", "amount_usd": "130.20"},
+    "S-103": {"customer_id": "C-9",  "currency": "GBP", "amount": "40.50",  "amount_usd": "51.44"},
+    "S-104": {"customer_id": "C-10", "currency": "USD", "amount": "9.99",   "amount_usd": "9.99"},
+    "S-105": {"customer_id": "C-8",  "currency": "EUR", "amount": "0.35",   "amount_usd": "0.38"},
+}
+
+
+@pytest.fixture(scope="module")
+def pipeline_result(tmp_path_factory):
+    """Run the full pipeline once, return (rows, output_path).
+
+    We patch OUTPUT_DIR directly on the module (and restore it afterwards)
+    rather than using monkeypatch, which is function-scoped and incompatible
+    with module-scoped fixtures.
+    """
+    import orders_enrichment as _mod
+
+    tmp = tmp_path_factory.mktemp("e2e_output")
+    original_output_dir = _mod.OUTPUT_DIR
+    _mod.OUTPUT_DIR = tmp
+    try:
+        raw = extract_orders(ds=DS)
+        deduped = dedupe_orders(raw)
+        rates = load_fx_rates(ds=DS)
+        enriched = convert_to_usd(deduped, rates)
+        validated = validate_totals(enriched)
+        path = load_enriched(validated, ds=DS)
+        return validated, Path(path)
+    finally:
+        _mod.OUTPUT_DIR = original_output_dir
+
+
+# ---------------------------------------------------------------------------
+# Deduplication against real data
+# ---------------------------------------------------------------------------
+
+
+class TestEndToEndDedupe:
+    def test_correct_number_of_orders_after_dedupe(self, pipeline_result):
+        """6 raw rows for 2026-03-02 collapse to 4 unique orders."""
+        rows, _ = pipeline_result
+        assert len(rows) == 4
+
+    def test_s102_latest_version_kept(self, pipeline_result):
+        """S-102 appears twice; the 11:47 version (EUR 120.00) must win."""
+        rows, _ = pipeline_result
+        row = next(r for r in rows if r["order_id"] == "S-102")
+        assert row["amount"] == "120.00"
+        assert row["updated_at"] == "2026-03-02T11:47:00"
+
+    def test_s103_latest_version_kept(self, pipeline_result):
+        """S-103 appears twice; the 08:30 version (GBP 40.50) must win over 07:55."""
+        rows, _ = pipeline_result
+        row = next(r for r in rows if r["order_id"] == "S-103")
+        assert row["amount"] == "40.50"
