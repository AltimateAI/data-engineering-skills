@@ -0,0 +1,124 @@
+"""Tests for dedupe_orders: keep only the latest version of each order."""
+
+from __future__ import annotations
+
+import pytest
+
+from conftest import dedupe_orders, make_order
+
+
+# ---------------------------------------------------------------------------
+# Core deduplication behaviour
+# ---------------------------------------------------------------------------
+
+
+class TestDedupeOrders:
+    """Finance requirement: when an order is exported more than once, only
+    its latest version (by updated_at) is kept."""
+
+    def test_duplicate_order_keeps_later_updated_at(self):
+        """The row with the later updated_at timestamp wins."""
+        rows = [
+            make_order("O-1", updated_at="2026-03-02T08:00:00", amount="100.00"),
+            make_order("O-1", updated_at="2026-03-02T11:47:00", amount="120.00"),
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["updated_at"] == "2026-03-02T11:47:00"
+        assert result[0]["amount"] == "120.00"
+
+    def test_duplicate_order_discards_earlier_updated_at(self):
+        """The row with the earlier timestamp is discarded regardless of input order."""
+        rows = [
+            make_order("O-1", updated_at="2026-03-02T11:47:00", amount="120.00"),
+            make_order("O-1", updated_at="2026-03-02T08:00:00", amount="100.00"),
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "120.00"
+
+    def test_three_versions_keeps_last(self):
+        """Of three exports of the same order the latest one is kept."""
+        rows = [
+            make_order("O-1", updated_at="2026-03-02T07:00:00", amount="50.00"),
+            make_order("O-1", updated_at="2026-03-02T09:00:00", amount="75.00"),
+            make_order("O-1", updated_at="2026-03-02T12:00:00", amount="99.00"),
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "99.00"
+
+    def test_distinct_orders_all_preserved(self):
+        """Different order_ids are never merged."""
+        rows = [
+            make_order("O-1", updated_at="2026-03-02T10:00:00"),
+            make_order("O-2", updated_at="2026-03-02T10:00:00"),
+            make_order("O-3", updated_at="2026-03-02T10:00:00"),
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 3
+        assert [r["order_id"] for r in result] == ["O-1", "O-2", "O-3"]
+
+    def test_mix_of_unique_and_duplicate_orders(self):
+        """When some orders have duplicates and others don't, each is handled correctly."""
+        rows = [
+            make_order("O-1", updated_at="2026-03-02T08:05:00", amount="100.00"),
+            make_order("O-2", updated_at="2026-03-02T10:00:00"),
+            make_order("O-1", updated_at="2026-03-02T11:47:00", amount="120.00"),
+            make_order("O-3", updated_at="2026-03-02T12:00:00"),
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 3
+        o1 = next(r for r in result if r["order_id"] == "O-1")
+        assert o1["amount"] == "120.00"
+
+    # ---------------------------------------------------------------------------
+    # Output ordering
+    # ---------------------------------------------------------------------------
+
+    def test_output_is_sorted_by_order_id(self):
+        """Output rows are sorted ascending by order_id."""
+        rows = [
+            make_order("O-3", updated_at="2026-03-02T10:00:00"),
+            make_order("O-1", updated_at="2026-03-02T10:00:00"),
+            make_order("O-2", updated_at="2026-03-02T10:00:00"),
+        ]
+        result = dedupe_orders(rows)
+        assert [r["order_id"] for r in result] == ["O-1", "O-2", "O-3"]
+
+    def test_sorting_is_lexicographic_not_numeric(self):
+        """order_id strings are sorted lexicographically (as the code uses sorted())."""
+        rows = [
+            make_order("O-10", updated_at="2026-03-02T10:00:00"),
+            make_order("O-2",  updated_at="2026-03-02T10:00:00"),
+            make_order("O-1",  updated_at="2026-03-02T10:00:00"),
+        ]
+        result = dedupe_orders(rows)
+        # Lexicographic: "O-1" < "O-10" < "O-2"
+        assert [r["order_id"] for r in result] == ["O-1", "O-10", "O-2"]
+
+    # ---------------------------------------------------------------------------
+    # Edge cases
+    # ---------------------------------------------------------------------------
+
+    def test_empty_input_returns_empty_list(self):
+        assert dedupe_orders([]) == []
+
+    def test_single_row_returned_unchanged(self):
+        row = make_order("O-1")
+        result = dedupe_orders([row])
+        assert result == [row]
+
+    def test_same_updated_at_last_seen_wins(self):
+        """When two rows share identical updated_at, Python's dict update means
+        the last one processed (later in the list) wins — consistent behaviour."""
+        rows = [
+            make_order("O-1", updated_at="2026-03-02T10:00:00", amount="10.00"),
+            make_order("O-1", updated_at="2026-03-02T10:00:00", amount="20.00"),
+        ]
+        # Both share the same timestamp; the code keeps whichever is 'greater' by
+        # string comparison — they are equal so the first row stays (current is not None
+        # and row["updated_at"] > current["updated_at"] is False).
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "10.00"
