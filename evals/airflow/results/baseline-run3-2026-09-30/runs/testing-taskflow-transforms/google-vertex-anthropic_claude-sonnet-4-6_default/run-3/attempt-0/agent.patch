+"""Tests for DAG-level properties: schedule, task wiring, and metadata."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+
+os.environ.setdefault("AIRFLOW__CORE__UNIT_TEST_MODE", "True")
+os.environ.setdefault("AIRFLOW_HOME", str(Path(__file__).resolve().parents[1] / ".airflow_test"))
+
+from airflow.models import DagBag
+
+DAGS_DIR = Path(__file__).resolve().parents[1] / "dags"
+
+
+@pytest.fixture(scope="module")
+def dag():
+    bag = DagBag(dag_folder=str(DAGS_DIR))
+    assert not bag.import_errors, f"DAG import errors: {bag.import_errors}"
+    return bag.dags["orders_enrichment"]
+
+
+class TestDagDefinition:
+    def test_dag_loads_without_errors(self):
+        bag = DagBag(dag_folder=str(DAGS_DIR))
+        assert "orders_enrichment" in bag.dags
+        assert not bag.import_errors
+
+    # -- Schedule --
+
+    def test_schedule_is_daily_0600_utc(self, dag):
+        """Finance requirement: runs once a day at 06:00 UTC."""
+        assert dag.schedule == "0 6 * * *"
+
+    # -- Safety flags --
+
+    def test_catchup_is_disabled(self, dag):
+        """catchup=False prevents unexpected historical backfills."""
+        assert dag.catchup is False
+
+    def test_max_active_runs_is_one(self, dag):
+        """max_active_runs=1 prevents concurrent runs from clobbering output."""
+        assert dag.max_active_runs == 1
+
+    # -- Task graph --
+
+    def test_all_expected_tasks_present(self, dag):
+        expected = {
+            "extract_orders",
+            "load_fx_rates",
+            "dedupe_orders",
+            "convert_to_usd",
+            "validate_totals",
+            "load_enriched",
+        }
+        assert {t.task_id for t in dag.tasks} == expected
+
+    def test_extract_feeds_dedupe(self, dag):
+        """extract_orders -> dedupe_orders."""
+        t = dag.get_task("extract_orders")
+        assert "dedupe_orders" in [d.task_id for d in t.downstream_list]
+
+    def test_dedupe_feeds_convert(self, dag):
+        """dedupe_orders -> convert_to_usd."""
+        t = dag.get_task("dedupe_orders")
+        assert "convert_to_usd" in [d.task_id for d in t.downstream_list]
+
+    def test_fx_feeds_convert(self, dag):
+        """load_fx_rates -> convert_to_usd."""
+        t = dag.get_task("load_fx_rates")
+        assert "convert_to_usd" in [d.task_id for d in t.downstream_list]
+
+    def test_convert_feeds_validate(self, dag):
+        """convert_to_usd -> validate_totals."""
+        t = dag.get_task("convert_to_usd")
+        assert "validate_totals" in [d.task_id for d in t.downstream_list]
+
+    def test_validate_feeds_load(self, dag):
+        """validate_totals -> load_enriched (ensures output gating in the DAG)."""
+        t = dag.get_task("validate_totals")
+        assert "load_enriched" in [d.task_id for d in t.downstream_list]
+
+    def test_load_enriched_is_terminal(self, dag):
+        """load_enriched has no downstream tasks."""
+        t = dag.get_task("load_enriched")
+        assert t.downstream_list == []
