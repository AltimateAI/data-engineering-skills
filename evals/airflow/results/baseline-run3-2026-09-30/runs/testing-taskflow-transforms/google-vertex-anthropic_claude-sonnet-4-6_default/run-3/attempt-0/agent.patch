+"""Shared pytest fixtures for the orders_enrichment test suite.
+
+The DAG is imported by adding dags/ to sys.path and using each task's
+`.function` attribute (the raw Python callable that Airflow wraps).  No
+scheduler, webserver, or database is required.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+import pytest
+
+# ---------------------------------------------------------------------------
+# Bootstrap: make the DAG module importable and put Airflow in test mode so
+# it skips database connectivity checks on import.
+# ---------------------------------------------------------------------------
+os.environ.setdefault("AIRFLOW__CORE__UNIT_TEST_MODE", "True")
+os.environ.setdefault("AIRFLOW_HOME", str(Path(__file__).resolve().parents[1] / ".airflow_test"))
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DAGS_DIR = REPO_ROOT / "dags"
+DATA_DIR = REPO_ROOT / "data"
+
+if str(DAGS_DIR) not in sys.path:
+    sys.path.insert(0, str(DAGS_DIR))
+
+import orders_enrichment as _mod  # noqa: E402  (must come after sys.path patch)
+
+
+# ---------------------------------------------------------------------------
+# Re-export the raw callables so test files don't have to reach into _mod.
+# ---------------------------------------------------------------------------
+
+dedupe_orders = _mod.dedupe_orders.function
+convert_to_usd = _mod.convert_to_usd.function
+validate_totals = _mod.validate_totals.function
+load_enriched = _mod.load_enriched.function
+extract_orders = _mod.extract_orders.function
+load_fx_rates = _mod.load_fx_rates.function
+
+
+@pytest.fixture()
+def tmp_output_dir(tmp_path, monkeypatch):
+    """Redirect OUTPUT_DIR to a temporary directory for the duration of a test."""
+    out = tmp_path / "orders_enriched"
+    monkeypatch.setattr(_mod, "OUTPUT_DIR", out)
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Tiny helper: build a minimal order row dict.
+# ---------------------------------------------------------------------------
+
+def make_order(
+    order_id: str = "O-001",
+    order_date: str = "2026-03-02",
+    updated_at: str = "2026-03-02T10:00:00",
+    customer_id: str = "C-1",
+    currency: str = "USD",
+    amount: str = "10.00",
+) -> dict:
+    return {
+        "order_id": order_id,
+        "order_date": order_date,
+        "updated_at": updated_at,
+        "customer_id": customer_id,
+        "currency": currency,
+        "amount": amount,
+    }
