@@ -0,0 +1,137 @@
+"""Tests for convert_to_usd: amount_usd = amount * usd_per_unit, rounded HALF_UP to cents."""
+
+from __future__ import annotations
+
+import pytest
+from decimal import Decimal
+
+from conftest import convert_to_usd, make_order
+
+
+# ---------------------------------------------------------------------------
+# Correct conversion maths
+# ---------------------------------------------------------------------------
+
+
+class TestConvertToUsd:
+    """Finance requirement: amount_usd = amount * that day's usd_per_unit,
+    rounded half-up to cents."""
+
+    # -- Basic cases --
+
+    def test_usd_order_rate_one(self):
+        """A USD order with rate=1 gives amount_usd == amount exactly."""
+        rows = [make_order("O-1", currency="USD", amount="15.00")]
+        result = convert_to_usd(rows, {"USD": "1"})
+        assert result[0]["amount_usd"] == "15.00"
+
+    def test_eur_conversion(self):
+        """EUR order: 20.00 * 1.0812 = 21.624 -> rounds HALF_UP to 21.62."""
+        rows = [make_order("O-1", currency="EUR", amount="20.00")]
+        result = convert_to_usd(rows, {"USD": "1", "EUR": "1.0812"})
+        assert Decimal(result[0]["amount_usd"]) == Decimal("21.62")
+
+    def test_gbp_conversion_rounds_half_up(self):
+        """GBP order: 40.50 * 1.2700 = 51.435 -> rounds HALF_UP to 51.44."""
+        rows = [make_order("O-1", currency="GBP", amount="40.50")]
+        result = convert_to_usd(rows, {"USD": "1", "GBP": "1.2700"})
+        assert Decimal(result[0]["amount_usd"]) == Decimal("51.44")
+
+    def test_small_eur_amount_rounds_half_up(self):
+        """EUR order: 0.35 * 1.0850 = 0.37975 -> rounds HALF_UP to 0.38."""
+        rows = [make_order("O-1", currency="EUR", amount="0.35")]
+        result = convert_to_usd(rows, {"USD": "1", "EUR": "1.0850"})
+        assert Decimal(result[0]["amount_usd"]) == Decimal("0.38")
+
+    # -- ROUND_HALF_UP vs ROUND_HALF_EVEN distinction --
+
+    def test_round_half_up_not_bankers_rounding(self):
+        """1.005 rounds HALF_UP to 1.01, not 1.00 (which ROUND_HALF_EVEN would give)."""
+        rows = [make_order("O-1", currency="USD", amount="1.005")]
+        result = convert_to_usd(rows, {"USD": "1"})
+        assert Decimal(result[0]["amount_usd"]) == Decimal("1.01")
+
+    def test_round_half_up_positive_halfway(self):
+        """2.345 * 1 rounds HALF_UP to 2.35."""
+        rows = [make_order("O-1", currency="USD", amount="2.345")]
+        result = convert_to_usd(rows, {"USD": "1"})
+        assert Decimal(result[0]["amount_usd"]) == Decimal("2.35")
+
+    def test_round_half_up_applied_after_multiplication(self):
+        """Rounding is applied to the product, not to the operands individually.
+        1.234 * 1.0850 = 1.338890 -> rounds to 1.34."""
+        rows = [make_order("O-1", currency="EUR", amount="1.234")]
+        result = convert_to_usd(rows, {"USD": "1", "EUR": "1.0850"})
+        expected = (Decimal("1.234") * Decimal("1.0850")).quantize(
+            Decimal("0.01"), rounding="ROUND_HALF_UP"
+        )
+        assert Decimal(result[0]["amount_usd"]) == expected
+
+    # -- Multiple rows --
+
+    def test_multiple_currencies_converted_independently(self):
+        """Each row uses its own currency's rate."""
+        rows = [
+            make_order("O-1", currency="USD", amount="9.99"),
+            make_order("O-2", currency="EUR", amount="120.00"),
+            make_order("O-3", currency="GBP", amount="40.50"),
+        ]
+        rates = {"USD": "1", "EUR": "1.0850", "GBP": "1.2700"}
+        result = convert_to_usd(rows, rates)
+
+        by_id = {r["order_id"]: r for r in result}
+        assert Decimal(by_id["O-1"]["amount_usd"]) == Decimal("9.99")
+        assert Decimal(by_id["O-2"]["amount_usd"]) == Decimal("130.20")
+        assert Decimal(by_id["O-3"]["amount_usd"]) == Decimal("51.44")
+
+    def test_original_fields_are_preserved(self):
+        """amount_usd is added; all original fields remain intact."""
+        row = make_order("O-1", currency="USD", amount="10.00", customer_id="C-5")
+        result = convert_to_usd([row], {"USD": "1"})
+        assert result[0]["order_id"] == "O-1"
+        assert result[0]["customer_id"] == "C-5"
+        assert result[0]["currency"] == "USD"
+        assert result[0]["amount"] == "10.00"
+        assert result[0]["amount_usd"] == "10.00"
+
+    def test_amount_usd_is_stored_as_string(self):
+        """amount_usd is serialised as a string (for CSV round-trip safety)."""
+        rows = [make_order("O-1", currency="USD", amount="5.00")]
+        result = convert_to_usd(rows, {"USD": "1"})
+        assert isinstance(result[0]["amount_usd"], str)
+
+    def test_empty_input_returns_empty_list(self):
+        result = convert_to_usd([], {"USD": "1"})
+        assert result == []
+
+    # ---------------------------------------------------------------------------
+    # Finance requirement: a currency with no FX rate for the day must FAIL the
+    # run — not be guessed, zeroed, or silently skipped.
+    # ---------------------------------------------------------------------------
+
+    def test_missing_fx_rate_raises_value_error(self):
+        """An order in a currency with no FX rate must raise ValueError."""
+        rows = [make_order("O-1", currency="JPY", amount="1000.00")]
+        with pytest.raises(ValueError, match="JPY"):
+            convert_to_usd(rows, {"USD": "1"})
+
+    def test_missing_fx_rate_error_names_the_order(self):
+        """The error message must identify the offending order_id."""
+        rows = [make_order("O-XYZ", currency="CHF", amount="50.00")]
+        with pytest.raises(ValueError, match="O-XYZ"):
+            convert_to_usd(rows, {"USD": "1"})
+
+    def test_missing_fx_rate_for_one_of_many_raises(self):
+        """Even one order with a missing rate must fail the entire call."""
+        rows = [
+            make_order("O-1", currency="USD", amount="10.00"),
+            make_order("O-2", currency="MXN", amount="200.00"),  # no MXN rate
+        ]
+        with pytest.raises(ValueError, match="MXN"):
+            convert_to_usd(rows, {"USD": "1"})
+
+    def test_usd_always_available_without_fx_file(self):
+        """USD rate=1 is built-in; a USD-only batch needs no extra rates dict entry."""
+        rows = [make_order("O-1", currency="USD", amount="42.00")]
+        result = convert_to_usd(rows, {"USD": "1"})
+        assert Decimal(result[0]["amount_usd"]) == Decimal("42.00")
