+"""
+Test suite for Airflow DAG integrity, policy compliance, and structure validation.
+
+Validates:
+- All DAGs can be imported without errors
+- DAG policy compliance (tags, catchup)
+- Task policy compliance (owner, retries)
+- Pipeline ordering (orders_ingest)
+"""
+
+from pathlib import Path
+from typing import Any
+
+import pytest
+from airflow.models import DAG, DagBag
+
+
+# ============================================================================
+# Fixtures
+# ============================================================================
+
+
+@pytest.fixture(scope="session")
+def dags_dir() -> Path:
+    """Return path to the dags directory."""
+    return Path(__file__).parent.parent / "dags"
+
+
+@pytest.fixture(scope="session")
+def dag_files(dags_dir: Path) -> list[Path]:
+    """Return list of all .py DAG files in dags_dir."""
+    return sorted(dags_dir.glob("*.py"))
+
+
+@pytest.fixture(scope="session")
+def loaded_dags(dags_dir: Path) -> dict[str, DAG]:
+    """Load all DAGs from the dags directory using DagBag.
+    
+    This fixture will fail if any DAG file has import errors or syntax issues.
+    """
+    dagbag = DagBag(dag_folder=str(dags_dir), safe_mode=True)
+    
+    # If there were any import errors, report them
+    if dagbag.import_errors:
+        error_msg = "DAG import errors:\n"
+        for file_path, exception_list in dagbag.import_errors.items():
+            for exc in exception_list:
+                error_msg += f"  {file_path}: {exc}\n"
+        raise RuntimeError(error_msg)
+    
+    # Return all loaded DAGs as {dag_id: DAG}
+    # Note: dagbag.get_dag() can fail if DB isn't initialized, so we access from dagbag.dags dict directly
+    dags = {}
+    for dag_id, dag in dagbag.dags.items():
+        dags[dag_id] = dag
+    
+    return dags
+
+
+# ============================================================================
+# Import & Loading Tests
+# ============================================================================
+
+
+class TestDagImports:
+    """Test that all DAG files can be imported without errors."""
+
+    def test_all_dag_files_exist(self, dag_files: list[Path]):
+        """DAG files should exist in the dags directory."""
+        assert len(dag_files) > 0, "No DAG files found in dags/"
+
+    def test_dags_can_be_loaded(self, loaded_dags: dict[str, DAG]):
+        """All DAGs should load without errors via DagBag."""
+        assert len(loaded_dags) > 0, "No DAGs were loaded from dags/"
+
+
+# ============================================================================
+# DAG Policy Tests
+# ============================================================================
+
+
+class TestDagPolicy:
+    """Test DAG-level policy compliance."""
+
+    def test_all_dags_have_tags(self, loaded_dags: dict[str, DAG]):
+        """Every DAG must have at least one tag."""
+        failed_dags = {}
+        for dag_id, dag in loaded_dags.items():
+            if not dag.tags or len(dag.tags) == 0:
+                failed_dags[dag_id] = dag.tags or []
+        
+        assert not failed_dags, (
+            f"DAGs without tags: {list(failed_dags.keys())}. "
+            f"All DAGs must have at least one tag."
+        )
+
+    def test_all_dags_have_catchup_false(self, loaded_dags: dict[str, DAG]):
+        """Every DAG must have catchup=False."""
+        failed_dags = {}
+        for dag_id, dag in loaded_dags.items():
+            if dag.catchup is not False:
+                failed_dags[dag_id] = dag.catchup
+        
+        assert not failed_dags, (
+            f"DAGs with catchup != False: {failed_dags}. "
+            f"All DAGs must have catchup=False."
+        )
+
+
+# ============================================================================
+# Task Policy Tests
+# ============================================================================
+
+
+class TestTaskPolicy:
+    """Test task-level policy compliance."""
+
+    def test_all_tasks_have_real_owner(self, loaded_dags: dict[str, DAG]):
+        """Every task must have an owner that is not 'airflow' (the default)."""
+        failed_tasks = {}
+        
+        for dag_id, dag in loaded_dags.items():
+            for task in dag.tasks:
+                # Check task-specific owner first, then fall back to DAG default
+                owner = task.owner or dag.owner or "airflow"
+                
+                if owner == "airflow":
+                    if dag_id not in failed_tasks:
+                        failed_tasks[dag_id] = []
+                    failed_tasks[dag_id].append((task.task_id, owner))
+        
+        assert not failed_tasks, (
+            f"Tasks with default owner 'airflow': {failed_tasks}. "
+            f"All tasks must have a real owner (not 'airflow')."
+        )
+
+    def test_all_tasks_have_minimum_retries(self, loaded_dags: dict[str, DAG]):
+        """Every task must have at least 2 retries."""
+        failed_tasks = {}
+        
+        for dag_id, dag in loaded_dags.items():
+            for task in dag.tasks:
+                # Check task-specific retries first, then fall back to DAG default
+                retries = (
+                    task.retries 
+                    if task.retries is not None 
+                    else (dag.default_args.get("retries", 0) if dag.default_args else 0)
+                )
+                
+                if retries < 2:
+                    if dag_id not in failed_tasks:
+                        failed_tasks[dag_id] = []
+                    failed_tasks[dag_id].append((task.task_id, retries))
+        
+        assert not failed_tasks, (
+            f"Tasks with < 2 retries: {failed_tasks}. "
+            f"All tasks must have at least 2 retries."
+        )
