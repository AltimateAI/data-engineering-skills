+    def test_operator_creates_table_if_missing(
+        self, mock_get_connection, temp_csv_file, temp_duckdb_file
+    ):
+        """Operator should create the table if it doesn't exist."""
+        # Table doesn't exist yet
+        con = duckdb.connect(temp_duckdb_file)
+        try:
+            with pytest.raises(Exception):
+                con.execute('SELECT * FROM "main"."new_table"')
+        finally:
+            con.close()
+        
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_create_table",
+            csv_path=temp_csv_file,
+            table="new_table",
+            partition_column="partition_date",
+            partition_date="2024-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        
+        rows_loaded = operator.execute({})
+        assert rows_loaded == 3
+        
+        # Verify table exists now
+        con = duckdb.connect(temp_duckdb_file)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM "main"."new_table"'
+            ).fetchone()
+            assert result[0] == 3
+        finally:
+            con.close()
