+class TestCsvPartitionToDuckDBOperator:
+    """Tests for CsvPartitionToDuckDBOperator."""
+
+    def test_operator_loads_single_partition(
+        self, mock_get_connection, temp_csv_file, temp_duckdb_file
+    ):
+        """Operator should load only rows matching the specified partition_date."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="partition_date",
+            partition_date="2024-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        
+        # Execute with a mock context
+        context = {}
+        rows_loaded = operator.execute(context)
+        
+        # Should load exactly 3 rows for 2024-01-01
+        assert rows_loaded == 3
+        
+        # Verify the data in the database
+        con = duckdb.connect(temp_duckdb_file)
+        try:
+            result = con.execute('SELECT COUNT(*) FROM "main"."test_table"').fetchone()
+            assert result[0] == 3
+            
+            # Verify correct rows were loaded
+            names = con.execute(
+                'SELECT name FROM "main"."test_table" ORDER BY id'
+            ).fetchall()
+            names = [row[0] for row in names]
+            assert names == ["Alice", "Bob", "Charlie"]
+        finally:
+            con.close()
+
+    def test_operator_returns_row_count(
+        self, mock_get_connection, temp_csv_file, temp_duckdb_file
+    ):
+        """Operator.execute() should return the number of rows loaded."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_count",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="partition_date",
+            partition_date="2024-01-02",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        
+        rows_loaded = operator.execute({})
+        assert rows_loaded == 2  # 2024-01-02 has 2 rows
+
+    def test_operator_is_idempotent_same_partition(
+        self, mock_get_connection, temp_csv_file, temp_duckdb_file
+    ):
+        """Re-running the same partition should replace rows, not duplicate them."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_idempotent",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="partition_date",
+            partition_date="2024-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        
+        # First run
+        rows_first = operator.execute({})
+        assert rows_first == 3
+        
+        # Second run of the same partition
+        rows_second = operator.execute({})
+        assert rows_second == 3
+        
+        # Total rows should still be 3, not 6 (no duplicates)
+        con = duckdb.connect(temp_duckdb_file)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM "main"."test_table"'
+            ).fetchone()
+            assert result[0] == 3
+        finally:
+            con.close()
+
+    def test_operator_leaves_other_partitions_untouched(
+        self, mock_get_connection, temp_csv_file, temp_duckdb_file
+    ):
+        """Loading one partition should not affect rows from other partitions."""
+        # Load 2024-01-01 (3 rows)
+        operator1 = CsvPartitionToDuckDBOperator(
+            task_id="load_jan01",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="partition_date",
+            partition_date="2024-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        rows1 = operator1.execute({})
+        assert rows1 == 3
+        
+        # Load 2024-01-02 (2 rows)
+        operator2 = CsvPartitionToDuckDBOperator(
+            task_id="load_jan02",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="partition_date",
+            partition_date="2024-01-02",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        rows2 = operator2.execute({})
+        assert rows2 == 2
+        
+        # Total should be 5 rows (3 + 2), not overwritten
+        con = duckdb.connect(temp_duckdb_file)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM "main"."test_table"'
+            ).fetchone()
+            assert result[0] == 5
+            
+            # Verify both partitions are present
+            jan01_count = con.execute(
+                'SELECT COUNT(*) FROM "main"."test_table" WHERE partition_date = ?',
+                ["2024-01-01"],
+            ).fetchone()[0]
+            jan02_count = con.execute(
+                'SELECT COUNT(*) FROM "main"."test_table" WHERE partition_date = ?',
+                ["2024-01-02"],
+            ).fetchone()[0]
+            assert jan01_count == 3
+            assert jan02_count == 2
+        finally:
+            con.close()
+
+    def test_operator_replaces_partition_on_rerun(
+        self, mock_get_connection, temp_csv_file, temp_duckdb_file
+    ):
+        """Re-running a partition should delete old rows and load new ones."""
+        # First: Load 2024-01-01
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_jan01",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="partition_date",
+            partition_date="2024-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        rows1 = operator.execute({})
+        assert rows1 == 3
+        
+        # Load another partition so we have data for both
+        operator2 = CsvPartitionToDuckDBOperator(
+            task_id="load_jan02",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="partition_date",
+            partition_date="2024-01-02",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        operator2.execute({})
+        
+        # Verify we have 5 rows total (3 + 2)
+        con = duckdb.connect(temp_duckdb_file)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM "main"."test_table"'
+            ).fetchone()
+            assert result[0] == 5
+        finally:
+            con.close()
+        
+        # Re-run 2024-01-01 (should delete old 2024-01-01 rows and reload)
+        rows_rerun = operator.execute({})
+        assert rows_rerun == 3
+        
+        # Verify total is still 5 (not 8)
+        con = duckdb.connect(temp_duckdb_file)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM "main"."test_table"'
+            ).fetchone()
+            assert result[0] == 5
+        finally:
+            con.close()
+
