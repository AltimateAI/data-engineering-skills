+"""Unit tests for DuckDBWarehouseHook and CsvPartitionToDuckDBOperator.
+
+Tests create a temporary DuckDB file and supply connections programmatically,
+requiring no external Airflow configuration or mocking of duckdb itself.
+All tests exercise the full execute() path against a real temporary database.
+"""
+
+import csv
+import json
+import os
+import tempfile
+from pathlib import Path
+from unittest import mock
+
+import duckdb
+import pytest
+
+from airflow.models import Connection
+from dags.warehouse.hooks import DuckDBWarehouseHook
+from dags.warehouse.operators import CsvPartitionToDuckDBOperator
+
+
+@pytest.fixture
+def temp_duckdb_file():
+    """Create a temporary DuckDB file that persists across test operations."""
+    with tempfile.TemporaryDirectory() as tmpdir:
+        db_path = Path(tmpdir) / "test.duckdb"
+        # Pre-create the file so it exists
+        con = duckdb.connect(str(db_path))
+        con.close()
+        yield str(db_path)
+
+
+@pytest.fixture
+def temp_csv_file():
+    """Create a temporary CSV file with test data for multiple dates."""
+    with tempfile.TemporaryDirectory() as tmpdir:
+        csv_path = Path(tmpdir) / "data.csv"
+        
+        # Create a CSV with multiple date partitions
+        with open(csv_path, "w", newline="") as f:
+            writer = csv.DictWriter(f, fieldnames=["id", "name", "partition_date"])
+            writer.writeheader()
+            # 2024-01-01: 3 rows
+            writer.writerow({"id": "1", "name": "Alice", "partition_date": "2024-01-01"})
+            writer.writerow({"id": "2", "name": "Bob", "partition_date": "2024-01-01"})
+            writer.writerow({"id": "3", "name": "Charlie", "partition_date": "2024-01-01"})
+            # 2024-01-02: 2 rows
+            writer.writerow({"id": "4", "name": "David", "partition_date": "2024-01-02"})
+            writer.writerow({"id": "5", "name": "Eve", "partition_date": "2024-01-02"})
+            # 2024-01-03: 1 row
+            writer.writerow({"id": "6", "name": "Frank", "partition_date": "2024-01-03"})
+        
+        yield str(csv_path)
+
+
+@pytest.fixture
+def mock_get_connection(temp_duckdb_file):
+    """Mock BaseHook.get_connection to return our test connection without external config.
+    
+    This fixture intercepts get_connection() calls and returns a Connection object
+    configured to use the temporary DuckDB file, so tests don't depend on CI Airflow config.
+    """
+    def _mock_get_connection(conn_id):
+        """Return a test connection pointing to the temp DuckDB file."""
+        return Connection(
+            conn_id=conn_id,
+            conn_type="duckdb",
+            host=temp_duckdb_file,
+            schema="main",
+        )
+    
+    with mock.patch.object(
+        DuckDBWarehouseHook, "get_connection", side_effect=_mock_get_connection
+    ):
+        yield _mock_get_connection
+
+
+class TestDuckDBWarehouseHook:
+    """Tests for DuckDBWarehouseHook."""
+
+    def test_default_connection_name(self):
+        """Verify hook has expected default connection name."""
+        assert DuckDBWarehouseHook.default_conn_name == "duckdb_warehouse"
+
+    def test_database_path_from_host(self, mock_get_connection, temp_duckdb_file):
+        """Hook should read database path from connection.host."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="duckdb_warehouse")
+        assert hook.database_path == temp_duckdb_file
+
+    def test_database_path_missing_raises_error(self, mock_get_connection):
+        """Hook should raise ValueError if connection has no host."""
+        def _mock_no_host(conn_id):
+            return Connection(
+                conn_id=conn_id,
+                conn_type="duckdb",
+                host="",  # empty host
+                schema="main",
+            )
+        
+        with mock.patch.object(
+            DuckDBWarehouseHook, "get_connection", side_effect=_mock_no_host
+        ):
+            hook = DuckDBWarehouseHook(duckdb_conn_id="bad_conn")
+            with pytest.raises(ValueError, match="has no host"):
+                _ = hook.database_path
+
+    def test_target_schema_from_connection_schema(self, mock_get_connection):
+        """Hook should read target schema from connection.schema."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="duckdb_warehouse")
+        assert hook.target_schema == "main"
+
+    def test_target_schema_defaults_to_main(self, mock_get_connection):
+        """Hook should default to 'main' schema if connection.schema is not set."""
+        def _mock_no_schema(conn_id):
+            return Connection(
+                conn_id=conn_id,
+                conn_type="duckdb",
+                host="<tmp>/test.duckdb",
+                schema="",  # empty schema
+            )
+        
+        with mock.patch.object(
+            DuckDBWarehouseHook, "get_connection", side_effect=_mock_no_schema
+        ):
+            hook = DuckDBWarehouseHook(duckdb_conn_id="test")
+            assert hook.target_schema == "main"
+
+    def test_target_schema_custom(self, mock_get_connection):
+        """Hook should use custom schema if connection.schema is set."""
+        def _mock_custom_schema(conn_id):
+            return Connection(
+                conn_id=conn_id,
+                conn_type="duckdb",
+                host="<tmp>/test.duckdb",
+                schema="custom_schema",
+            )
+        
+        with mock.patch.object(
+            DuckDBWarehouseHook, "get_connection", side_effect=_mock_custom_schema
+        ):
+            hook = DuckDBWarehouseHook(duckdb_conn_id="test")
+            assert hook.target_schema == "custom_schema"
+
+    def test_get_conn_opens_database(self, mock_get_connection, temp_duckdb_file):
+        """Hook.get_conn() should return an open DuckDB connection."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="duckdb_warehouse")
+        con = hook.get_conn()
+        try:
+            # Verify connection is usable
+            result = con.execute("SELECT 1").fetchone()
+            assert result[0] == 1
+        finally:
+            con.close()
+
+    def test_get_conn_read_only_mode(self, mock_get_connection, temp_duckdb_file):
+        """Hook should open read-only if connection.extra has read_only=true."""
+        def _mock_read_only(conn_id):
+            return Connection(
+                conn_id=conn_id,
+                conn_type="duckdb",
+                host=temp_duckdb_file,
+                schema="main",
+                extra=json.dumps({"read_only": True}),
+            )
+        
+        with mock.patch.object(
+            DuckDBWarehouseHook, "get_connection", side_effect=_mock_read_only
+        ):
+            hook = DuckDBWarehouseHook(duckdb_conn_id="test")
+            con = hook.get_conn()
+            try:
+                # Try to write; should fail in read-only mode
+                with pytest.raises(Exception):  # DuckDB raises an exception on write attempt
+                    con.execute("CREATE TABLE test_readonly (id INT)")
+            finally:
+                con.close()
+
