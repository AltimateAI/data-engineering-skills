+"""
+Shared fixtures for the warehouse hook/operator test suite.
+
+CI note
+-------
+These tests require no Airflow metadata database and no pre-configured
+Airflow connections.  The connection is injected via the Airflow SDK's
+``_preset_connections`` ContextVar, which is the hook the SDK itself
+provides for exactly this use-case (see ``_get_connection`` in
+``airflow.sdk.execution_time.context``).
+
+The ``ExecutorSafeguard.test_mode = True`` line disables the guard that
+prevents ``execute()`` from being called outside of a real TaskRunner,
+which is intentional for unit / integration tests.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+import duckdb
+import pytest
+
+# Make the DAGs package importable without an Airflow metastore.
+DAGS_DIR = Path(__file__).resolve().parents[1] / "dags"
+if str(DAGS_DIR) not in sys.path:
+    sys.path.insert(0, str(DAGS_DIR))
+
+DATA_DIR = Path(__file__).resolve().parents[1] / "data"
+ORDERS_CSV = str(DATA_DIR / "orders.csv")
+REFUNDS_CSV = str(DATA_DIR / "refunds.csv")
+
+# Allow operator.execute() to be invoked directly in tests.
+from airflow.sdk.bases.operator import ExecutorSafeguard  # noqa: E402
+
+ExecutorSafeguard.test_mode = True
+
+
+def _make_connection(db_path: str, schema: str = "raw", conn_id: str = "warehouse"):
+    """Return an Airflow Connection pointing at *db_path*."""
+    from airflow.sdk import Connection
+
+    return Connection(
+        conn_id=conn_id,
+        conn_type="duckdb",
+        host=db_path,
+        schema=schema,
+    )
+
+
+@pytest.fixture()
+def tmp_db(tmp_path):
+    """
+    Yield the path to a fresh, empty DuckDB file inside a pytest tmp_path.
+
+    Using ``tmp_path`` (not ``tempfile.mktemp``) ensures the file is cleaned
+    up even if a test fails, and guarantees the path does not collide across
+    parallel test runs.
+    """
+    db_path = str(tmp_path / "warehouse.duckdb")
+    # Create the file via duckdb so it is a valid DuckDB database from the start.
+    con = duckdb.connect(db_path)
+    con.close()
+    yield db_path
+
+
+@pytest.fixture()
+def preset_conn(tmp_db):
+    """
+    Inject a warehouse connection into the Airflow SDK's ContextVar and
+    yield ``(conn_id, db_path)``.  The ContextVar token is reset after each
+    test so that connections do not leak between tests.
+    """
+    from airflow.sdk.execution_time.context import _preset_connections
+
+    conn_id = "warehouse"
+    conn = _make_connection(tmp_db, schema="raw", conn_id=conn_id)
+    token = _preset_connections.set({conn_id: conn})
+    try:
+        yield conn_id, tmp_db
+    finally:
+        _preset_connections.reset(token)
