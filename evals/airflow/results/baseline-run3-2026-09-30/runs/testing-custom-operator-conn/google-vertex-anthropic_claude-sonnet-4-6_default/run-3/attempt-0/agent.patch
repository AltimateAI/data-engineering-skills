+"""
+Unit tests for DuckDBWarehouseHook.
+
+These tests exercise the hook in isolation: they verify that the hook
+reads ``host`` and ``schema`` from the Airflow connection correctly and
+that ``get_conn()`` returns a live DuckDB connection.
+
+No Airflow metadata database is required.  Connections are supplied via
+the ``preset_conn`` fixture defined in conftest.py.
+"""
+
+from __future__ import annotations
+
+import duckdb
+import pytest
+
+from airflow.sdk import Connection
+from airflow.sdk.execution_time.context import _preset_connections
+from warehouse.hooks import DuckDBWarehouseHook
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+
+def _inject(conn: Connection):
+    """Set *conn* as the only preset connection and return the token."""
+    return _preset_connections.set({conn.conn_id: conn})
+
+
+# ---------------------------------------------------------------------------
+# database_path property
+# ---------------------------------------------------------------------------
+
+
+class TestDatabasePath:
+    def test_returns_host_field(self, tmp_db):
+        conn = Connection(
+            conn_id="wh", conn_type="duckdb", host=tmp_db, schema="raw"
+        )
+        token = _inject(conn)
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id="wh")
+            assert hook.database_path == tmp_db
+        finally:
+            _preset_connections.reset(token)
+
+    def test_raises_when_host_missing(self, tmp_db):
+        """A connection with no host should raise a descriptive ValueError."""
+        conn = Connection(
+            conn_id="wh_nohost", conn_type="duckdb", host=None, schema="raw"
+        )
+        token = _inject(conn)
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id="wh_nohost")
+            with pytest.raises(ValueError, match="no host"):
+                _ = hook.database_path
+        finally:
+            _preset_connections.reset(token)
+
+
+# ---------------------------------------------------------------------------
+# target_schema property
+# ---------------------------------------------------------------------------
+
+
+class TestTargetSchema:
+    def test_returns_schema_field(self, tmp_db):
+        conn = Connection(
+            conn_id="wh", conn_type="duckdb", host=tmp_db, schema="analytics"
+        )
+        token = _inject(conn)
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id="wh")
+            assert hook.target_schema == "analytics"
+        finally:
+            _preset_connections.reset(token)
+
+    def test_defaults_to_main_when_schema_absent(self, tmp_db):
+        """schema=None on the connection should fall back to 'main'."""
+        conn = Connection(
+            conn_id="wh_noschema", conn_type="duckdb", host=tmp_db, schema=None
+        )
+        token = _inject(conn)
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id="wh_noschema")
+            assert hook.target_schema == "main"
+        finally:
+            _preset_connections.reset(token)
+
+
+# ---------------------------------------------------------------------------
+# get_conn()
+# ---------------------------------------------------------------------------
+
+
+class TestGetConn:
+    def test_returns_live_duckdb_connection(self, preset_conn):
+        """get_conn() must return a usable DuckDB connection object."""
+        conn_id, db_path = preset_conn
+        hook = DuckDBWarehouseHook(duckdb_conn_id=conn_id)
+        con = hook.get_conn()
+        try:
+            result = con.execute("SELECT 42 AS answer").fetchone()
+            assert result == (42,)
+        finally:
+            con.close()
+
+    def test_uses_correct_file(self, preset_conn):
+        """The connection returned by get_conn() must point to the configured file."""
+        conn_id, db_path = preset_conn
+        hook = DuckDBWarehouseHook(duckdb_conn_id=conn_id)
+        con = hook.get_conn()
+        try:
+            # Write a sentinel value and verify it can be read back from the
+            # same path via an independent connection.
+            con.execute("CREATE TABLE _sentinel (x INTEGER)")
+            con.execute("INSERT INTO _sentinel VALUES (99)")
+            con.close()
+
+            verify_con = duckdb.connect(db_path)
+            row = verify_con.execute("SELECT x FROM _sentinel").fetchone()
+            verify_con.close()
+            assert row == (99,)
+        except Exception:
+            con.close()
+            raise
+
+    def test_uses_conn_id_supplied_to_constructor(self, tmp_db):
+        """The hook must use the duckdb_conn_id passed at construction time."""
+        conn_a = Connection(
+            conn_id="wh_a", conn_type="duckdb", host=tmp_db, schema="raw"
+        )
+        # conn_b points to a non-existent path so get_conn() would fail if used.
+        conn_b = Connection(
+            conn_id="wh_b", conn_type="duckdb", host="/nonexistent/path.duckdb", schema="raw"
+        )
+        token = _preset_connections.set({"wh_a": conn_a, "wh_b": conn_b})
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id="wh_a")
+            con = hook.get_conn()
+            try:
+                result = con.execute("SELECT 1").fetchone()
+                assert result == (1,)
+            finally:
+                con.close()
+        finally:
+            _preset_connections.reset(token)
