@@ -41,16 +41,37 @@ def write_pnl_report(trade_date: str) -> Path:
 
 @dag(
     dag_id="fx_pnl_report",
-    schedule="@daily",
-    start_date=pendulum.datetime(2026, 1, 1, tz="UTC"),
+    schedule="0 6 * * 1-5",  # 6am America/New_York, Monday-Friday
+    start_date=pendulum.datetime(2026, 1, 1, tz="America/New_York"),
     catchup=False,
     default_args={"owner": "treasury-data"},
     tags=["treasury", "reports"],
 )
 def fx_pnl_report():
     @task
-    def build_report(ds=None) -> str:
-        return str(write_pnl_report(ds))
+    def build_report(logical_date=None) -> str:
+        """
+        Report the previous business day's P&L.
+        
+        logical_date is when the DAG is scheduled to run.
+        - Monday run (logical_date=Mon): report Friday
+        - Tuesday-Friday run (logical_date=Tue-Fri): report previous day
+        """
+        # Convert logical_date to New York time to get the execution date in ET
+        exec_time = pendulum.instance(logical_date, tz="America/New_York")
+        
+        # Determine previous business day
+        prev_day = exec_time.subtract(days=1)
+        
+        # If prev_day is Saturday (weekday=5) or Sunday (weekday=6), go back 2 days
+        # (from Monday=0 to Friday=4)
+        if prev_day.weekday() == 5:  # Saturday
+            prev_day = prev_day.subtract(days=1)
+        elif prev_day.weekday() == 6:  # Sunday
+            prev_day = prev_day.subtract(days=2)
+        
+        trade_date = prev_day.format("YYYY-MM-DD")
+        return str(write_pnl_report(trade_date))
 
     build_report()
 
