+def previous_business_day(run_date: pendulum.DateTime) -> str:
+    """Return the previous business day (Mon–Fri) as a YYYY-MM-DD string.
+
+    Monday  → Friday   (step back 3 days)
+    Tue–Fri → previous calendar day (step back 1 day)
+    """
+    # run_date.day_of_week: Monday=0 … Sunday=6 (pendulum convention)
+    if run_date.day_of_week == pendulum.MONDAY:
+        delta = 3
+    else:
+        delta = 1
+    return (run_date - timedelta(days=delta)).strftime("%Y-%m-%d")
+
+
