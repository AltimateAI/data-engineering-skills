+def _resolve_feed_day(context: dict) -> str:
+    """Return the feed date string (YYYY-MM-DD) for this run.
+
+    Resolution order:
+    1. logical_date from context  — set for all scheduled runs and UI-triggered
+       runs that supply a logical date.
+    2. UTC wall-clock time at the moment extract_orders executes — used only
+       when a manual UI trigger supplies no logical date.  The date is returned
+       from the task and stored in XCom so that clearing and re-running the
+       same DagRun tomorrow still produces *this* day's feed, not tomorrow's.
+    """
+    logical_date = context.get("logical_date")
+    if logical_date is not None:
+        return logical_date.strftime("%Y-%m-%d")
+    # Manual trigger with no date: capture wall-clock UTC now (once, here) so
+    # the value is frozen in XCom for any future re-run of this DagRun.
+    return datetime.now(tz=timezone.utc).strftime("%Y-%m-%d")
+
+
