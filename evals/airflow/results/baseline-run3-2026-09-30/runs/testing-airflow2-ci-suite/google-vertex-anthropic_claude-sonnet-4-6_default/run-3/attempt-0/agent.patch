+# ===========================================================================
+# 6. End-to-end run of shipments_daily for 2026-03-03 on sample data.
+# ===========================================================================
+class TestShipmentsDailyEndToEnd:
+    """Drive extract_shipments and build_report directly, without a scheduler.
+
+    Expected late shipments for 2026-03-03 (from data/shipments.csv):
+
+    SH-1001  DHL    promised 2026-03-02  delivered 2026-03-03  days_late=1
+    SH-1003  FedEx  promised 2026-02-28  undelivered           days_late=3
+    SH-1007  UPS    promised 2026-03-01  delivered 2026-03-03  days_late=2
+    SH-1009  DHL    promised 2026-02-26  undelivered           days_late=5
+
+    Sorted by (-days_late, shipment_id):  SH-1009, SH-1003, SH-1007, SH-1001
+    """
+
+    RUN_DATE = "2026-03-03"
+
+    EXPECTED = [
+        {
+            "shipment_id": "SH-1009",
+            "carrier": "DHL",
+            "promised_date": "2026-02-26",
+            "delivered_date": "",
+            "days_late": "5",
+        },
+        {
+            "shipment_id": "SH-1003",
+            "carrier": "FedEx",
+            "promised_date": "2026-02-28",
+            "delivered_date": "",
+            "days_late": "3",
+        },
+        {
+            "shipment_id": "SH-1007",
+            "carrier": "UPS",
+            "promised_date": "2026-03-01",
+            "delivered_date": "2026-03-03",
+            "days_late": "2",
+        },
+        {
+            "shipment_id": "SH-1001",
+            "carrier": "DHL",
+            "promised_date": "2026-03-02",
+            "delivered_date": "2026-03-03",
+            "days_late": "1",
+        },
+    ]
+
+    def test_end_to_end(self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+        """Run extract then build_report; assert the CSV matches expectations."""
+        import shipments_daily as sd  # type: ignore[import]
+
+        # Redirect OUTPUT_DIR to a temp directory so we don't pollute the repo.
+        output_dir = tmp_path / "late_shipments"
+        monkeypatch.setattr(sd, "OUTPUT_DIR", output_dir)
+
+        # --- Step 1: extract ---
+        rows = sd.extract_shipments()
+        assert isinstance(rows, list)
+        assert len(rows) > 0, "extract_shipments() returned no rows"
+
+        # --- Step 2: build_report (mock only the xcom_pull part) ---
+        mock_ti = MagicMock()
+        mock_ti.xcom_pull.return_value = rows
+
+        out_path = sd.build_report(ds=self.RUN_DATE, ti=mock_ti)
+
+        # --- Verify the output CSV ---
+        assert Path(out_path).exists(), f"Output file not created: {out_path}"
+
+        with open(out_path, newline="") as fh:
+            actual = list(csv.DictReader(fh))
+
+        # Check row count
+        assert len(actual) == len(self.EXPECTED), (
+            f"Expected {len(self.EXPECTED)} late shipments, got {len(actual)}.\n"
+            f"Actual rows: {actual}"
+        )
+
+        # Check each row (shipment_id, carrier, promised_date, delivered_date, days_late)
+        for i, (exp, got) in enumerate(zip(self.EXPECTED, actual)):
+            for col in ("shipment_id", "carrier", "promised_date", "delivered_date"):
+                assert got[col] == exp[col], (
+                    f"Row {i}: column '{col}': expected {exp[col]!r}, got {got[col]!r}"
+                )
+            assert int(got["days_late"]) == int(exp["days_late"]), (
+                f"Row {i} ({got['shipment_id']}): "
+                f"days_late expected {exp['days_late']}, got {got['days_late']}"
+            )
