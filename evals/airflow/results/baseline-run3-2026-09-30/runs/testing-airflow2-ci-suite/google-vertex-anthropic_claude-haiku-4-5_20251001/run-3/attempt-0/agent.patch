+"""Integration test for shipments_daily DAG end-to-end execution.
+
+This test runs the shipments_daily DAG on 2026-03-03 (a Tuesday) using
+the sample data in data/shipments.csv and verifies the output is correct.
+"""
+
+import shutil
+import sys
+from datetime import datetime
+from pathlib import Path
+
+import pytest
+from airflow.utils import timezone
+
+
+@pytest.fixture(scope="module")
+def project_root():
+    """Get the project root directory."""
+    return Path(__file__).resolve().parents[1]
+
+
+@pytest.fixture(scope="module")
+def cleanup_output(project_root):
+    """Clean up output directory before and after test."""
+    output_dir = project_root / "output"
+    if output_dir.exists():
+        shutil.rmtree(output_dir)
+    
+    yield
+    
+    # Optionally clean up after test; remove this if you want to inspect output
+    if output_dir.exists():
+        shutil.rmtree(output_dir)
+
+
+def test_shipments_daily_end_to_end(project_root, cleanup_output):
+    """Run shipments_daily DAG on 2026-03-03 and verify output."""
+    # Import the DAG
+    dags_dir = project_root / "dags"
+    sys.path.insert(0, str(dags_dir))
+    from shipments_daily import dag, build_report, extract_shipments
+    
+    # Create a mock context for task execution
+    from airflow.models import Variable, Connection
+    from airflow.utils.context import Context
+    from unittest.mock import MagicMock
+    
+    # Set the execution date to 2026-03-03 (Tuesday - should normally run)
+    execution_date = timezone.datetime(2026, 3, 3)
+    
+    # Create mock task instances and context
+    extract_ti = MagicMock()
+    extract_ti.task_id = "extract_shipments"
+    extract_ti.xcom_push = MagicMock()
+    
+    # Execute extract_shipments
+    shipments = extract_shipments()
+    assert len(shipments) > 0, "extract_shipments should return shipment data"
+    
+    # Verify shipment structure
+    assert all(
+        "shipment_id" in row and "promised_date" in row and "delivered_date" in row
+        for row in shipments
+    ), "Each shipment should have required fields"
+    
+    # Simulate XCom pull for build_report
+    build_report_ti = MagicMock()
+    build_report_ti.task_id = "build_report"
+    build_report_ti.xcom_pull = MagicMock(return_value=shipments)
+    
+    # Execute build_report with ds="2026-03-03"
+    output_file = build_report(
+        ds="2026-03-03",
+        ti=build_report_ti,
+        execution_date=execution_date,
+    )
+    
+    assert output_file is not None, "build_report should return output file path"
+    
+    # Verify output file was created
+    output_path = Path(output_file)
+    assert output_path.exists(), f"Output file should be created at {output_file}"
+    
+    # Parse and verify the output CSV
+    import csv
+    
+    with output_path.open(newline="") as fh:
+        reader = csv.DictReader(fh)
+        late_rows = list(reader)
+    
+    # On 2026-03-03, these shipments should be late:
+    # 1. SH-1001: promised 2026-03-02, delivered 2026-03-03 (1 day late) - delivered ON run date
+    # 2. SH-1003: promised 2026-02-28, undelivered (3 days overdue: Feb 29, Mar 1-2) - undelivered with past promised_date
+    # 3. SH-1007: promised 2026-03-01, delivered 2026-03-03 (2 days late) - delivered ON run date
+    # 4. SH-1009: promised 2026-02-26, undelivered (5 days overdue: Feb 27-29, Mar 1-2) - undelivered with past promised_date
+    # Note: SH-1005 was delivered on 2026-03-02 (before run date), not on 2026-03-03, so not marked late
+    
+    expected_late_count = 4  # SH-1001, SH-1003, SH-1007, SH-1009
+    assert len(late_rows) == expected_late_count, (
+        f"Expected {expected_late_count} late shipments on 2026-03-03, "
+        f"but got {len(late_rows)}: {[r['shipment_id'] for r in late_rows]}"
+    )
+    
+    # Verify expected shipments are in the output
+    shipment_ids = [r["shipment_id"] for r in late_rows]
+    assert "SH-1001" in shipment_ids, "SH-1001 (delivered late on 2026-03-03) should be in output"
+    assert "SH-1003" in shipment_ids, "SH-1003 (undelivered, overdue) should be in output"
+    assert "SH-1007" in shipment_ids, "SH-1007 (delivered late on 2026-03-03) should be in output"
+    assert "SH-1009" in shipment_ids, "SH-1009 (undelivered, overdue) should be in output"
+    
+    # Verify days_late calculations
+    rows_by_id = {r["shipment_id"]: r for r in late_rows}
+    
+    assert int(rows_by_id["SH-1001"]["days_late"]) == 1, "SH-1001 should be 1 day late"
+    assert int(rows_by_id["SH-1003"]["days_late"]) == 3, "SH-1003 should be 3 days late"
+    assert int(rows_by_id["SH-1007"]["days_late"]) == 2, "SH-1007 should be 2 days late"
+    assert int(rows_by_id["SH-1009"]["days_late"]) == 5, "SH-1009 should be 5 days late"
+    
+    # Verify sorting (worst-first: SH-1009 with 5 days should be first)
+    assert late_rows[0]["shipment_id"] == "SH-1009", "Results should be sorted by days_late descending"
