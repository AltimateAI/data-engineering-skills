+"""Test that all DAGs can be imported without errors."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+def get_dag_files():
+    """Collect all .py files in the dags/ directory."""
+    dags_dir = Path(__file__).resolve().parents[1] / "dags"
+    return sorted(dags_dir.glob("*.py"))
+
+
+@pytest.mark.parametrize("dag_file", get_dag_files(), ids=lambda f: f.name)
+def test_dag_imports(dag_file):
+    """Verify that each DAG file can be imported without raising an exception.
+    
+    This catches syntax errors, missing imports, and other import-time issues.
+    """
+    spec = importlib.util.spec_from_file_location(dag_file.stem, dag_file)
+    module = importlib.util.module_from_spec(spec)
+    
+    # Should not raise any exception
+    spec.loader.exec_module(module)
+    
+    # Verify the module is not empty
+    assert hasattr(module, "dag"), f"{dag_file.name} must define a DAG named 'dag'"
