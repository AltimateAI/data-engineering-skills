+"""Test DAG properties like schedule intervals and task retries."""
+
+from pathlib import Path
+
+from airflow.models import DAG
+from croniter import croniter
+
+
+def load_dag(dag_file: Path) -> DAG:
+    """Load a DAG from a Python file."""
+    import importlib.util
+    
+    spec = importlib.util.spec_from_file_location(dag_file.stem, dag_file)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.dag
+
+
+def get_all_dags():
+    """Collect all DAG objects from dags/ directory."""
+    dags_dir = Path(__file__).resolve().parents[1] / "dags"
+    dags = {}
+    for dag_file in sorted(dags_dir.glob("*.py")):
+        try:
+            dags[dag_file.stem] = load_dag(dag_file)
+        except Exception as e:
+            pytest.skip(f"Could not load {dag_file.name}: {e}")
+    return dags
+
+
+def test_shipments_daily_schedule():
+    """Verify shipments_daily runs at 07:30 UTC Monday to Friday only."""
+    dags = get_all_dags()
+    dag = dags["shipments_daily"]
+    
+    # The schedule should be "30 7 * * 1-5" (07:30 UTC, Mon-Fri)
+    # In Airflow 2.11, this is stored as schedule_interval
+    assert dag.schedule_interval == "30 7 * * 1-5", (
+        f"shipments_daily schedule is '{dag.schedule_interval}', "
+        "expected '30 7 * * 1-5' (07:30 UTC, Mon-Fri)"
+    )
+    
+    # Verify the cron expression is valid and only matches weekdays
+    cron = croniter(dag.schedule_interval)
+    from datetime import datetime
+    
+    # Test a Monday at 07:30 - should match
+    next_time = cron.get_next(datetime)
+    assert next_time.weekday() < 5, "Schedule should only run on weekdays"
+    assert next_time.hour == 7 and next_time.minute == 30
+
+
+def test_all_tasks_have_min_two_retries():
+    """Verify every task in every DAG has at least 2 retries."""
+    dags = get_all_dags()
+    
+    for dag_id, dag in dags.items():
+        for task in dag.tasks:
+            assert task.retries >= 2, (
+                f"Task '{task.task_id}' in DAG '{dag_id}' has only "
+                f"{task.retries} retries; minimum is 2"
+            )
+
+
+import pytest
