+"""Test the late shipment detection logic.
+
+Late shipment rules for a run date (as_of):
+1. A shipment delivered on as_of after its promised_date is late.
+2. A shipment still undelivered with promised_date before as_of is late.
+3. days_late is calculated from promised_date to delivered_date (or as_of if undelivered).
+"""
+
+from pathlib import Path
+from datetime import date
+
+import sys
+
+# Add dags directory to path so we can import the module
+dags_dir = Path(__file__).resolve().parents[1] / "dags"
+sys.path.insert(0, str(dags_dir))
+
+from shipments_daily import find_late_shipments, _days_between
+
+
+class TestDaysBetween:
+    """Test the date difference calculation."""
+    
+    def test_same_day(self):
+        """Days between same date should be 0."""
+        assert _days_between("2026-03-01", "2026-03-01") == 0
+    
+    def test_one_day_apart(self):
+        """Days between consecutive dates should be 1."""
+        assert _days_between("2026-03-01", "2026-03-02") == 1
+    
+    def test_multiple_days(self):
+        """Days between distant dates should be calculated correctly."""
+        # 2026-02-24 to 2026-03-02 is 6 days (Feb has 29 days in 2026)
+        assert _days_between("2026-02-24", "2026-03-02") == 6
+
+
+class TestLateSipmentDetection:
+    """Test late shipment detection logic."""
+    
+    def test_delivered_on_time_is_not_late(self):
+        """Shipment delivered on or before promised date is not late."""
+        rows = [
+            {
+                "shipment_id": "SH-101",
+                "ship_date": "2026-02-26",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-02",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0, "On-time delivery should not be marked as late"
+    
+    def test_delivered_early_is_not_late(self):
+        """Shipment delivered before promised date is not late."""
+        rows = [
+            {
+                "shipment_id": "SH-102",
+                "ship_date": "2026-02-26",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-01",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0, "Early delivery should not be marked as late"
+    
+    def test_delivered_late_is_marked_late(self):
+        """Shipment delivered after promised date is late."""
+        rows = [
+            {
+                "shipment_id": "SH-103",
+                "ship_date": "2026-02-26",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-03",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-103"
+        assert late[0]["days_late"] == 1
+    
+    def test_undelivered_with_past_promised_date_is_late(self):
+        """Undelivered shipment with promised date before run date is late."""
+        rows = [
+            {
+                "shipment_id": "SH-104",
+                "ship_date": "2026-02-25",
+                "carrier": "FedEx",
+                "promised_date": "2026-02-28",
+                "delivered_date": "",  # Empty string means undelivered
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-104"
+        # Days late = from promised_date (2026-02-28) to as_of (2026-03-03) = 3 days
+        # (Feb 29, Mar 1, Mar 2 = 3 days)
+        assert late[0]["days_late"] == 3
+    
+    def test_undelivered_with_future_promised_date_is_not_late(self):
+        """Undelivered shipment with promised date after run date is not yet late."""
+        rows = [
+            {
+                "shipment_id": "SH-105",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-05",
+                "delivered_date": "",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0, "Undelivered with future promised date is not yet late"
+    
+    def test_undelivered_promised_today_is_not_late(self):
+        """Undelivered shipment with promised date equal to run date is not late yet."""
+        rows = [
+            {
+                "shipment_id": "SH-106",
+                "ship_date": "2026-02-28",
+                "carrier": "UPS",
+                "promised_date": "2026-03-03",
+                "delivered_date": "",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0, "Undelivered with promised date = run date is not yet late"
+    
+    def test_future_ship_date_is_excluded(self):
+        """Shipment with ship_date after run date should be excluded."""
+        rows = [
+            {
+                "shipment_id": "SH-107",
+                "ship_date": "2026-03-05",
+                "carrier": "DHL",
+                "promised_date": "2026-03-10",
+                "delivered_date": "2026-03-15",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0, "Shipments with future ship date should not appear"
+    
+    def test_sorting_by_days_late_descending(self):
+        """Results should be sorted by days_late (worst first), then by shipment_id.
+        
+        Note: delivered shipments that are not delivered on as_of are NOT marked as late,
+        only if they are delivered on as_of AND after promised_date.
+        """
+        rows = [
+            {
+                "shipment_id": "SH-200",
+                "ship_date": "2026-02-20",
+                "carrier": "DHL",
+                "promised_date": "2026-02-24",
+                "delivered_date": "2026-03-03",  # Delivered on as_of after promised
+            },
+            {
+                "shipment_id": "SH-201",
+                "ship_date": "2026-02-20",
+                "carrier": "UPS",
+                "promised_date": "2026-02-25",
+                "delivered_date": "2026-03-03",  # Delivered on as_of after promised
+            },
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 2
+        # SH-200 is 7 days late (2026-02-24 to 2026-03-03)
+        # SH-201 is 6 days late (2026-02-25 to 2026-03-03)
+        # SH-200 has more days late, should be first
+        assert late[0]["shipment_id"] == "SH-200"
+        assert late[1]["shipment_id"] == "SH-201"
+    
+    def test_mixed_delivered_and_undelivered(self):
+        """Handle mix of delivered and undelivered late shipments.
+        
+        Note: SH-300 is delivered on 2026-03-04 but as_of is 2026-03-05,
+        so it won't match the "delivered on as_of" rule. It would only be
+        marked late if delivered on as_of (2026-03-05) and after promised_date.
+        """
+        rows = [
+            {
+                "shipment_id": "SH-300",
+                "ship_date": "2026-02-26",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-05",  # Delivered on as_of after promised
+            },
+            {
+                "shipment_id": "SH-301",
+                "ship_date": "2026-02-20",
+                "carrier": "UPS",
+                "promised_date": "2026-02-24",
+                "delivered_date": "",  # Undelivered, promised before as_of
+            },
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-05")
+        assert len(late) == 2
+        # SH-301 is 9 days overdue (promised 2026-02-24, now 2026-03-05)
+        # SH-300 is 3 days late (promised 2026-03-02, delivered 2026-03-05)
+        # SH-301 should be first (more days late)
+        assert late[0]["shipment_id"] == "SH-301"
+        assert late[0]["days_late"] == 9
+        assert late[1]["shipment_id"] == "SH-300"
+        assert late[1]["days_late"] == 3
