+"""Test task dependencies and ordering constraints."""
+
+from pathlib import Path
+
+from airflow.models import DAG
+
+
+def load_dag(dag_file: Path) -> DAG:
+    """Load a DAG from a Python file."""
+    import importlib.util
+    
+    spec = importlib.util.spec_from_file_location(dag_file.stem, dag_file)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.dag
+
+
+def test_shipments_daily_report_after_extract():
+    """Verify build_report task depends on extract_shipments task.
+    
+    The report cannot be built until shipment data is extracted from
+    the source file.
+    """
+    dag_file = Path(__file__).resolve().parents[1] / "dags" / "shipments_daily.py"
+    dag = load_dag(dag_file)
+    
+    # Get the task objects
+    extract_task = dag.get_task("extract_shipments")
+    report_task = dag.get_task("build_report")
+    
+    assert extract_task is not None, "extract_shipments task not found"
+    assert report_task is not None, "build_report task not found"
+    
+    # Check that extract_shipments is in the upstream dependencies of build_report
+    upstream_ids = {t.task_id for t in report_task.upstream_list}
+    assert "extract_shipments" in upstream_ids, (
+        "build_report must depend on extract_shipments; "
+        f"current upstream tasks: {upstream_ids}"
+    )
