diff --git a/dags/partners/triggers.py b/dags/partners/triggers.py
new file mode 100644
index 0000000..a923191
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,71 @@
+"""Trigger that polls the manifest API from the triggerer."""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from collections.abc import AsyncIterator
+from typing import Any
+
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestHook
+
+
+class PartnerManifestTrigger(BaseTrigger):
+    """Poll until the manifest is published or ``deadline`` (epoch seconds) has passed.
+
+    The deadline is absolute, so a trigger rebuilt after a triggerer restart keeps the same budget.
+    Yields exactly one event:
+
+    - ``{"status": "published", "files": [...]}``
+    - ``{"status": "timeout"}``
+    - ``{"status": "error", "message": "..."}``: the API failed; errors are reported, not raised,
+      so the sensor can fail the try instead of letting ``soft_fail`` turn it into a skip.
+    """
+
+    def __init__(
+        self,
+        *,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        deadline: float,
+        poke_interval: float,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.deadline = deadline
+        self.poke_interval = poke_interval
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "deadline": self.deadline,
+                "poke_interval": self.poke_interval,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id)
+        while True:
+            try:
+                manifest = await hook.aget_manifest(self.partner, self.ds)
+            except Exception as exc:  # outage, bad connection, bad payload: fail the try
+                yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
+                return
+            if manifest.get("status") == "PUBLISHED":
+                yield TriggerEvent({"status": "published", "files": manifest["files"]})
+                return
+            remaining = self.deadline - time.time()
+            if remaining <= 0:
+                yield TriggerEvent({"status": "timeout"})
+                return
+            # Sleep at most until the deadline, so the last check happens right at it.
+            await asyncio.sleep(min(self.poke_interval, remaining))
