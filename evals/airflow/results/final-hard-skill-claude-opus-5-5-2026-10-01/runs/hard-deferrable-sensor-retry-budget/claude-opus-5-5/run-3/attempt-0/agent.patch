+    def _deadline(self, context) -> float:
+        """Epoch time at which the wait ends: first wait in this run + ``timeout``.
+
+        The anchor lives in ``task_state_store``, which survives retries (XCom does not). It is
+        tagged with ``max_tries``: retries keep it, while clearing the task raises ``max_tries``,
+        so a cleared task starts a fresh wait instead of inheriting a stale anchor.
+        """
+        ti = context["ti"]
+        store = context.get("task_state_store")
+        if store is None:  # no store: the budget is per try
+            return time.time() + self.timeout
+        saved = store.get(_ANCHOR_KEY)
+        if isinstance(saved, dict) and saved.get("max_tries") == ti.max_tries:
+            started_at = float(saved["started_at"])
+        else:
