diff --git a/dags/partners/triggers.py b/dags/partners/triggers.py
new file mode 100644
index 0000000..99144e6
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,73 @@
+"""Trigger that waits in the triggerer for a partner's daily manifest."""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from collections.abc import AsyncIterator
+from typing import Any
+
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestApiError, ManifestHook
+
+
+class PartnerManifestTrigger(BaseTrigger):
+    """Poll the manifest API until it is published, the API fails, or ``deadline`` passes.
+
+    ``deadline`` is an absolute epoch timestamp, so a trigger rebuilt from ``serialize()`` after a
+    triggerer restart still stops at the original time. Every outcome is reported as an event
+    (``published``, ``error`` or ``timeout``); the trigger never raises, so the sensor decides how
+    the task ends.
+    """
+
+    def __init__(
+        self,
+        *,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        deadline: float,
+        poll_interval: float,
+        request_timeout: float = 20.0,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.deadline = float(deadline)
+        self.poll_interval = float(poll_interval)
+        self.request_timeout = float(request_timeout)
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "deadline": self.deadline,
+                "poll_interval": self.poll_interval,
+                "request_timeout": self.request_timeout,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id, request_timeout=self.request_timeout)
+        while True:
+            try:
+                manifest = await hook.aget_manifest(self.partner, self.ds)
+            except ManifestApiError as exc:
+                yield TriggerEvent({"status": "error", "message": str(exc)})
+                return
+            except Exception as exc:  # anything else must still fail the try, not skip it
+                yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
+                return
+            if manifest.get("status") == "PUBLISHED":
+                yield TriggerEvent({"status": "published", "files": list(manifest.get("files") or [])})
+                return
+            remaining = self.deadline - time.time()
+            if remaining <= 0:
+                yield TriggerEvent({"status": "timeout"})
+                return
+            await asyncio.sleep(min(self.poll_interval, remaining))
