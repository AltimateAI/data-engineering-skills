diff --git a/dags/partners/triggers.py b/dags/partners/triggers.py
new file mode 100644
index 0000000..432d38e
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,75 @@
+"""Trigger that polls the manifest API from the triggerer's event loop.
+
+Runs in the triggerer, so ``partners`` must be importable there (``dags/`` on its PYTHONPATH).
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator
+from datetime import datetime, timezone
+from typing import Any
+
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestHook
+
+
+class ManifestPublishedTrigger(BaseTrigger):
+    """Poll until the manifest is published or ``deadline`` passes.
+
+    ``deadline`` is absolute (tz-aware UTC), so a trigger rebuilt after a triggerer restart
+    keeps the original budget. Every outcome is an event, never an exception: the sensor
+    decides how the task ends (an exception here would become a skip under ``soft_fail``).
+
+    Events: ``{"status": "published", "files": [...]}``, ``{"status": "timeout", ...}``,
+    ``{"status": "error", "message": ...}``.
+    """
+
+    def __init__(
+        self,
+        partner: str,
+        ds: str,
+        deadline: datetime,
+        poll_interval: float,
+        manifest_conn_id: str = ManifestHook.default_conn_name,
+        request_timeout: float = 20.0,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.deadline = deadline
+        self.poll_interval = poll_interval
+        self.manifest_conn_id = manifest_conn_id
+        self.request_timeout = request_timeout
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "deadline": self.deadline,
+                "poll_interval": self.poll_interval,
+                "manifest_conn_id": self.manifest_conn_id,
+                "request_timeout": self.request_timeout,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id, request_timeout=self.request_timeout)
+        while True:
+            try:
+                manifest = await hook.aget_manifest(self.partner, self.ds)
+            except Exception as exc:  # ManifestApiError, bad JSON, missing connection...
+                yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
+                return
+            if manifest.get("status") == "PUBLISHED":
+                yield TriggerEvent({"status": "published", "files": manifest["files"]})
+                return
+            remaining = (self.deadline - datetime.now(timezone.utc)).total_seconds()
+            if remaining <= 0:
+                yield TriggerEvent({"status": "timeout", "deadline": self.deadline.isoformat()})
+                return
+            self.log.info("%s manifest for %s still %s", self.partner, self.ds, manifest.get("status"))
+            await asyncio.sleep(min(self.poll_interval, remaining))
