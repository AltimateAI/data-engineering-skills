+def config_paths() -> list[Path]:
+    """All configs, or only the running task's config when a worker parses the file."""
+    dag_id = get_parsing_context().dag_id
+    if dag_id:
+        path = CONFIG_DIR / f"{dag_id}.yaml"
+        if path.is_file():
+            return [path]
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+def register_dags() -> None:
+    for path in config_paths():
+        try:
+            built = build_dag(path)
+        except Exception as exc:  # one bad config must not take out the others
+            message = f"Skipping pipeline config {path.name}: {type(exc).__name__}: {exc}"
+            log.error(message)
+            warnings.warn(message, stacklevel=1)
+            continue
+        globals()[built.dag_id] = built
+
