+def validate(cfg, path: Path, registry: dict) -> None:
+    """Check the config as data, before any DAG object exists."""
+    if not isinstance(cfg, dict):
+        raise ConfigError("config is empty or not a mapping")
+    name = _require(cfg, "name", str)
+    if name != path.stem:
+        # Keeps dag_ids unique and lets a worker find a DAG's config by its id.
+        raise ConfigError(f"name {name!r} must match the file name {path.stem!r}")
+    team = _require(cfg, "team", str)
+    if team not in registry["teams"]:
+        raise ConfigError(f"unknown team {team!r}")
+    tier = cfg.get("tier")
+    if tier not in TIER_PRIORITY:
+        raise ConfigError(f"tier must be one of {sorted(TIER_PRIORITY)}, got {tier!r}")
+    sched = _require(cfg, "schedule", dict)
+    if "hour" not in sched:
+        raise ConfigError("missing required key 'schedule.hour'")
+    if "retries" in cfg and (not isinstance(cfg["retries"], int) or isinstance(cfg["retries"], bool)
+                             or cfg["retries"] < 0):
+        raise ConfigError(f"'retries' has an invalid value {cfg['retries']!r}")
+    owners = cfg.get("owners", [])
+    if not isinstance(owners, list) or not all(isinstance(o, str) for o in owners):
+        raise ConfigError(f"'owners' must be a list of names, got {owners!r}")
+
+    steps = _require(cfg, "steps", list)
+    if not steps:
+        raise ConfigError("'steps' is empty")
+    names: list[str] = []
+    for step in steps:
+        if not isinstance(step, dict) or not isinstance(step.get("name"), str):
+            raise ConfigError(f"step {step!r} has no name")
+        if step["name"] in names:
+            raise ConfigError(f"duplicate step {step['name']!r}")
+        names.append(step["name"])
