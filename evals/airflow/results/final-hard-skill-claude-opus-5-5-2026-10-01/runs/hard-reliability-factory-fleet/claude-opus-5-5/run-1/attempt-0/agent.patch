+def config_paths() -> list[Path]:
+    """All configs, or only the one a worker needs when it parses for a single task."""
+    dag_id = get_parsing_context().dag_id
+    if dag_id:
+        path = CONFIG_DIR / f"{dag_id}.yaml"
+        return [path] if path.is_file() else []
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+def build_fleet() -> dict[str, DAG]:
+    paths = config_paths()
+    if not paths:
+        return {}
+    registry = load_yaml(REGISTRY)  # shared input: loaded once per parse
+    dags: dict[str, DAG] = {}
+    for path in paths:
+        try:
+            dag = build_dag(path, registry)
+        except Exception as exc:  # one bad config must not take out the fleet
+            msg = f"Skipping pipeline config {path.name}: {type(exc).__name__}: {exc}"
+            log.error(msg)
+            warnings.warn(msg, stacklevel=1)
+            continue
+        dags[dag.dag_id] = dag
+    return dags
+
+
+globals().update(build_fleet())
