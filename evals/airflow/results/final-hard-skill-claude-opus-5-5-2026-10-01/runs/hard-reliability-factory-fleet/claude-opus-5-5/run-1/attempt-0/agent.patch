+def _check_acyclic(steps: dict[str, dict]) -> None:
+    state: dict[str, int] = {}  # 1 = visiting, 2 = done
+
+    def visit(n: str, chain: list[str]) -> None:
+        if state.get(n) == 2:
+            return
+        if state.get(n) == 1:
+            raise ConfigError(f"dependency cycle: {' -> '.join([*chain, n])}")
+        state[n] = 1
+        for u in steps[n]["depends_on"]:
+            visit(u, [*chain, n])
+        state[n] = 2
+
+    for n in steps:
+        visit(n, [])
