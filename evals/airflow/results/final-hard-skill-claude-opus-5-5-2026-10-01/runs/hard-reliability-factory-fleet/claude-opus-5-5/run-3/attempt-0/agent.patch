+def config_paths() -> list[Path]:
+    # A worker running a task only needs that task's DAG; the config file is
+    # named after the dag_id (enforced in validate()).
+    wanted = get_parsing_context().dag_id
+    if wanted:
+        path = CONFIG_DIR / f"{wanted}.yaml"
+        return [path] if path.is_file() else []
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+for _path in config_paths():
+    try:
+        _dag = build_dag(_path)
+    except Exception as exc:  # one bad config must not take out the rest of the fleet
+        _msg = f"Skipping pipeline config {_path.name}: {type(exc).__name__}: {exc}"
+        log.error(_msg)
+        warnings.warn(_msg, stacklevel=1)
+        continue
+    globals()[_dag.dag_id] = _dag
+# Leave no module-level reference to a DAG other than the registered ones.
+_dag = None
