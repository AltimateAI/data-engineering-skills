+def validate(cfg, path: Path, teams: dict, tables: frozenset) -> dict:
+    """Check the config as data before any DAG object exists."""
+    if not isinstance(cfg, dict):
+        raise ConfigError(f"expected a mapping, got {type(cfg).__name__}")
+    name = cfg.get("name")
+    if name != path.stem:
+        raise ConfigError(f"name {name!r} must match the file name ({path.stem!r})")
+    if not TASK_ID_RE.match(name):
+        raise ConfigError(f"invalid pipeline name {name!r}")
+    if cfg.get("team") not in teams:
+        raise ConfigError(f"unknown team {cfg.get('team')!r}")
+    if cfg.get("tier") not in TIER_PRIORITY:
+        raise ConfigError(f"tier must be one of {sorted(TIER_PRIORITY)}, got {cfg.get('tier')!r}")
+    if cfg.get("description") is not None and not isinstance(cfg["description"], str):
+        raise ConfigError("description must be a string")
+
+    sched = cfg.get("schedule")
+    if not isinstance(sched, dict):
+        raise ConfigError("schedule must be a mapping with at least `hour`")
+    _int_in(sched.get("hour"), 0, 23, "schedule.hour")
+    if "minute" in sched:
+        _int_in(sched["minute"], 0, 59, "schedule.minute")
+    days = sched.get("days", "*")
+    if isinstance(days, bool) or not isinstance(days, (str, int)) or not str(days).strip():
+        raise ConfigError(f"schedule.days must be a cron day-of-week field, got {days!r}")
+
+    _str_list(cfg.get("owners"), "owners")
+    if "retries" in cfg:
+        _int_in(cfg["retries"], 0, 100, "retries")
+
+    steps = cfg.get("steps")
+    if not isinstance(steps, list) or not steps:
+        raise ConfigError("steps must be a non-empty list")
+    seen: set[str] = set()
+    for i, step in enumerate(steps):
+        if not isinstance(step, dict):
+            raise ConfigError(f"steps[{i}] must be a mapping")
+        sname = step.get("name")
+        if not isinstance(sname, str) or not TASK_ID_RE.match(sname):
+            raise ConfigError(f"steps[{i}] has an invalid name {sname!r}")
+        if sname in seen:
+            raise ConfigError(f"duplicate step {sname!r}")
+        seen.add(sname)
+        if step.get("table") not in tables:
+            raise ConfigError(
+                f"step {sname!r}: unknown table {step.get('table')!r}: "
+                "register it in the platform catalog first"
+            )
+    for step in steps:
+        for upstream in _str_list(step.get("depends_on"), f"step {step['name']!r} depends_on"):
+            if upstream not in seen:
+                raise ConfigError(f"step {step['name']!r} depends on unknown step {upstream!r}")
+    return cfg
 
 
