+def close_window(dag_run) -> tuple[pendulum.DateTime, pendulum.DateTime]:
+    """[start, end) of the business day a ``daily_close`` run closes.
+
+    Scheduled runs carry their interval. A manual trigger without a logical date
+    (Airflow 3) has none, so infer it from the trigger time the way Airflow 2 did:
+    the latest weekday that has fully ended.
+    """
+    if dag_run.data_interval_start is not None and dag_run.data_interval_end is not None:
+        return (pendulum.instance(dag_run.data_interval_start),
+                pendulum.instance(dag_run.data_interval_end))
+    interval = WorkdayTimetable().infer_manual_data_interval(run_after=pendulum.instance(dag_run.run_after))
+    return interval.start, interval.end
+
