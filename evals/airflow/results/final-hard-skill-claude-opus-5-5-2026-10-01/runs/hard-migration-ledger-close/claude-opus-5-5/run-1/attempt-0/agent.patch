@@ -52,3 +52,16 @@ class WorkdayTimetable(Timetable):
         if restriction.latest is not None and start > restriction.latest:
             return None
         return DagRunInfo.interval(start=start, end=start.add(days=1))
+
+
+def close_interval(dag_run) -> DataInterval:
+    """The business day a ``daily_close`` run closes.
+
+    Scheduled runs carry it as their data interval. On Airflow 3 a plain
+    ``airflow dags trigger`` run has no data interval, so derive it from the trigger
+    time the way Airflow 2 did: the latest business day that has ended.
+    """
+    if dag_run.data_interval_start is not None and dag_run.data_interval_end is not None:
+        return DataInterval(start=pendulum.instance(dag_run.data_interval_start),
+                            end=pendulum.instance(dag_run.data_interval_end))
+    return WorkdayTimetable().infer_manual_data_interval(run_after=pendulum.instance(dag_run.run_after))
