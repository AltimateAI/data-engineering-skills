+def directory_version_as_of(provider_events, as_of: pendulum.DateTime) -> str | None:
+    """Version published by the latest provider_directory_daily run dated at or before ``as_of``.
+
+    Same lookup as the Airflow 2 ``xcom_pull(dag_id="provider_directory_daily", include_prior_dates=True)``;
+    a run's date is its logical date, or its trigger time for a manual run.
+    """
+    candidates = []
+    for event in provider_events:
+        if event.source_dag_id != "provider_directory_daily" or event.source_task_id != "sync_providers":
+            continue
+        run = event.source_dag_run
+        if run is not None:
+            run_date = pendulum.instance(run.logical_date or run.run_after)
+            if run_date <= as_of:
+                candidates.append((run_date, event))
+    for _, event in sorted(candidates, key=lambda c: c[0], reverse=True):
+        version = event.source_task_instance.xcom_pull()
+        if version is not None:
+            return version
+    return None
 
 
