+"""Daily inventory snapshot: end-of-day stock and low-stock alerts.
+
+Convention for this repo: every daily DAG writes one file per logical date
+(`{{ ds }}`) under output/<dag_id>/, so a rerun simply overwrites that day.
+"""
+
+from __future__ import annotations
+
+import csv
+from collections import defaultdict
+from datetime import timedelta
+from pathlib import Path
+
+import pendulum
+from airflow.decorators import dag, task
+from airflow.operators.empty import EmptyOperator
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DATA_DIR = PROJECT_ROOT / "data"
+OUTPUT_DIR = PROJECT_ROOT / "output"
+
+
+@dag(
+    dag_id="inventory_snapshot",
+    schedule="30 2 * * *",
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=False,
+    default_args={"owner": "supply-chain-analytics", "retries": 1, "retry_delay": timedelta(minutes=10)},
+    tags=["inventory"],
+)
+def inventory_snapshot():
+    start = EmptyOperator(task_id="start")
+
+    @task
+    def snapshot(ds=None) -> str:
+        """Compute end-of-day stock on hand per warehouse and SKU as of ds."""
+        # Aggregate qty_change up to and including the run date
+        stock: dict[tuple[str, str], float] = defaultdict(float)
+        with (DATA_DIR / "inventory_movements.csv").open(newline="") as fh:
+            for row in csv.DictReader(fh):
+                if row["movement_date"] <= ds:
+                    key = (row["warehouse_id"], row["sku"])
+                    stock[key] += float(row["qty_change"])
+
+        # Write output, sorted by warehouse_id then sku
+        out = OUTPUT_DIR / "inventory_snapshot" / f"{ds}.csv"
+        out.parent.mkdir(parents=True, exist_ok=True)
+        with out.open("w", newline="") as fh:
+            writer = csv.writer(fh)
+            writer.writerow(["warehouse_id", "sku", "on_hand"])
+            for (warehouse_id, sku) in sorted(stock.keys()):
+                writer.writerow([warehouse_id, sku, int(stock[(warehouse_id, sku)])])
+        return str(out)
+
+    @task
+    def low_stock(snapshot_path: str, ds=None) -> str:
+        """Find SKUs with on_hand below reorder_point."""
+        # Load reorder points
+        reorder_points: dict[str, float] = {}
+        with (DATA_DIR / "reorder_points.csv").open(newline="") as fh:
+            for row in csv.DictReader(fh):
+                reorder_points[row["sku"]] = float(row["reorder_point"])
+
+        # Read snapshot and filter to low stock
+        low_stock_items: list[tuple[str, str, float, float]] = []
+        with open(snapshot_path, newline="") as fh:
+            reader = csv.DictReader(fh)
+            for row in reader:
+                sku = row["sku"]
+                on_hand = float(row["on_hand"])
+                if sku in reorder_points and on_hand < reorder_points[sku]:
+                    low_stock_items.append(
+                        (row["warehouse_id"], sku, on_hand, reorder_points[sku])
+                    )
+
+        # Write low stock report, sorted by warehouse_id then sku
+        out = OUTPUT_DIR / "low_stock" / f"{ds}.csv"
+        out.parent.mkdir(parents=True, exist_ok=True)
+        with out.open("w", newline="") as fh:
+            writer = csv.writer(fh)
+            writer.writerow(["warehouse_id", "sku", "on_hand", "reorder_point"])
+            for warehouse_id, sku, on_hand, reorder_point in sorted(low_stock_items):
+                writer.writerow([warehouse_id, sku, int(on_hand), int(reorder_point)])
+        return str(out)
+
+    snap_task = snapshot()
+    start >> snap_task >> low_stock(snap_task)
+
+
+inventory_snapshot()
