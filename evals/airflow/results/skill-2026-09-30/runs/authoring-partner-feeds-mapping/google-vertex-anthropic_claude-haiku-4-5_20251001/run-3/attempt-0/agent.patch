+++ b/dags/partner_feeds.py
@@ -0,0 +1,180 @@
+"""Process partner order files and generate summary reports.
+
+Each partner uploads daily CSV files to data/partner_drop/<YYYY-MM-DD>/<partner>.csv
+with columns: order_id, amount. This DAG:
+1. Discovers all partner files for the run date
+2. Processes each file independently (one file = one task, failures are isolated)
+3. Writes partner JSON output to output/partner_feeds/<YYYY-MM-DD>/<partner>.json
+4. Aggregates summary to output/partner_feeds/<YYYY-MM-DD>/summary.json (always, even if no files)
+
+Schedule: Daily at 02:00 UTC, processing the previous calendar day (Monday files on Tuesday 02:00).
+Backfill-safe: Can rerun any date since 2026-09-01 via clear/backfill.
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+from pathlib import Path
+
+import pendulum
+from airflow.sdk import dag, task, get_current_context
+from airflow.timetables.interval import CronDataIntervalTimetable
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DATA_DROP = PROJECT_ROOT / "data" / "partner_drop"
+OUTPUT_BASE = PROJECT_ROOT / "output" / "partner_feeds"
+
+
+def get_run_date() -> str:
+    """Extract the business date for the run.
+    
+    For scheduled runs on an interval timetable, returns the start of the
+    data interval (the "processed" day). For reruns/backfills, uses the
+    same interval.
+    
+    Returns YYYY-MM-DD string in UTC.
+    """
+    context = get_current_context()
+    dag_run = context["dag_run"]
+    # On Airflow 3.x interval timetable, data_interval_start is the processed date
+    if dag_run.data_interval_start:
+        return dag_run.data_interval_start.strftime("%Y-%m-%d")
+    # Should not reach here with CronDataIntervalTimetable, but be safe
+    raise RuntimeError("Could not determine run date from dag_run context")
+
+
+@dag(
+    dag_id="partner_feeds",
+    schedule=CronDataIntervalTimetable("0 2 * * *", timezone="UTC"),
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=False,
+    max_active_runs=1,
+    tags=["partners"],
+    description="Process daily partner order files and generate summaries",
+)
+def partner_feeds():
+    """Main DAG."""
+
+    @task
+    def list_partner_files() -> list:
+        """Discover all partner CSV files for the run date.
+        
+        Returns:
+            List of (partner_name, file_path, run_date) tuples, or empty list if no files.
+        """
+        run_date = get_run_date()
+        date_dir = DATA_DROP / run_date
+
+        result = []
+        if date_dir.exists() and date_dir.is_dir():
+            for csv_file in sorted(date_dir.glob("*.csv")):
+                partner_name = csv_file.stem
+                result.append((partner_name, str(csv_file), run_date))
+
+        return result
+
+    @task
+    def process_partner_file(file_info: tuple) -> dict:
+        """Process a single partner CSV file and write JSON output.
+        
+        Args:
+            file_info: (partner_name, file_path, run_date) tuple
+            
+        Returns:
+            dict with keys: partner, rows, total_amount
+        """
+        partner_name, file_path, run_date = file_info
+        file_path = Path(file_path)
+
+        # Read and aggregate CSV
+        row_count = 0
+        total_amount = 0.0
+
+        try:
+            with open(file_path, encoding="utf-8") as f:
+                reader = csv.DictReader(f)
+                if reader.fieldnames != ["order_id", "amount"]:
+                    raise ValueError(
+                        f"Expected columns [order_id, amount], got {reader.fieldnames}"
+                    )
+                for row in reader:
+                    row_count += 1
+                    total_amount += float(row["amount"])
+        except Exception as e:
+            raise RuntimeError(
+                f"Failed to process {partner_name} ({file_path}): {e}"
+            ) from e
+
+        # Write partner JSON output
+        output_dir = OUTPUT_BASE / run_date
+        output_dir.mkdir(parents=True, exist_ok=True)
+        output_file = output_dir / f"{partner_name}.json"
+
+        output_data = {
+            "partner": partner_name,
+            "rows": row_count,
+            "total_amount": round(total_amount, 2),
+        }
+        output_file.write_text(json.dumps(output_data))
+
+        return output_data
+
+    @task
+    def write_summary() -> str:
+        """Aggregate partner results and write summary JSON.
+        
+        Always writes summary.json even if no partner files exist.
+        Reads partner JSON files directly from output directory to determine totals.
+        
+        Returns:
+            Path to summary file
+        """
+        run_date = get_run_date()
+        output_dir = OUTPUT_BASE / run_date
+        
+        # Count partner files and aggregate totals
+        total_files = 0
+        total_rows = 0
+        total_amount = 0.0
+        
+        if output_dir.exists():
+            for partner_json in sorted(output_dir.glob("partner_*.json")):
+                try:
+                    with open(partner_json) as f:
+                        data = json.load(f)
+                        total_files += 1
+                        total_rows += data["rows"]
+                        total_amount += data["total_amount"]
+                except Exception as e:
+                    # Log but don't fail; missing file might be in-progress
+                    pass
+        
+        # Write summary (even if no files)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        summary_file = output_dir / "summary.json"
+
+        summary_data = {
+            "files": total_files,
+            "rows": total_rows,
+            "total_amount": round(total_amount, 2),
+        }
+        summary_file.write_text(json.dumps(summary_data))
+
+        return str(summary_file)
+
+    # Task chain
+    file_list = list_partner_files()
+    
+    # Dynamic task mapping: expand process_partner_file over file list
+    partner_results = process_partner_file.expand(file_info=file_list)
+    
+    # Write summary unconditionally after list_partner_files completes.
+    # Using file_list as the trigger (not partner_results) ensures summary runs
+    # even when the file list is empty (so mapped task produces zero expansions).
+    summary = write_summary()
+    
+    file_list >> summary
+
+
+partner_feeds()
