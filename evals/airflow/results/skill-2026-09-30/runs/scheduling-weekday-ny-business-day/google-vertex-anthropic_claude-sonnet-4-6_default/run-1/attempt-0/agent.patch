+# ---------------------------------------------------------------------------
+# Date helpers (from the verified dates-and-schedules reference)
+# ---------------------------------------------------------------------------
+
+def _prev_business_day(d: pendulum.DateTime) -> pendulum.DateTime:
+    """Return the previous business day (Mon–Fri, no holiday calendar)."""
+    d = d.subtract(days=1)
+    while d.day_of_week in (pendulum.SATURDAY, pendulum.SUNDAY):
+        d = d.subtract(days=1)
+    return d
+
+
+def _resolve_trade_date(dag_run) -> str:
+    """Return the trade date (YYYY-MM-DD, NY timezone) this run should report.
+
+    Uses the verified run_window pattern from the skill reference:
+    - Interval timetables: use the interval (not applicable here).
+    - Trigger timetables / manual runs (3.x): anchor on logical_date or
+      run_after, convert to NY, then step back to the previous business day.
+    """
+    anchor = dag_run.logical_date or dag_run.run_after
+    anchor_ny = pendulum.instance(anchor).in_tz(NY).start_of("day")
+    trade_day = _prev_business_day(anchor_ny)
+    return trade_day.to_date_string()  # "YYYY-MM-DD"
+
+
