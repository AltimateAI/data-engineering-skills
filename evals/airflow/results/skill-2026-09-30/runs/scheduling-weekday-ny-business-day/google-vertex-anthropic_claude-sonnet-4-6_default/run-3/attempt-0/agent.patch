 import pendulum
 from airflow.sdk import dag, task
+from airflow.timetables.trigger import CronTriggerTimetable
 
 PROJECT_DIR = Path(__file__).resolve().parents[1]
 TRADES_CSV = PROJECT_DIR / "data" / "fx_trades.csv"
 REPORTS_DIR = PROJECT_DIR / "reports"
 
+NY_TZ = "America/New_York"
+
+
+def _prev_business_day(d: pendulum.DateTime) -> pendulum.DateTime:
+    """Return the business day immediately before ``d`` (Mon → Fri, no holidays)."""
+    d = d.subtract(days=1)
+    while d.day_of_week in (pendulum.SATURDAY, pendulum.SUNDAY):
+        d = d.subtract(days=1)
+    return d
+
+
+def _report_date(dag_run) -> str:
+    """
+    Return the trade date (YYYY-MM-DD, America/New_York) that this run should report.
+
+    Works for scheduled runs, manual triggers (no logical_date on Airflow 3.x),
+    reruns, and backfills.  The anchor is always dag_run.logical_date or
+    dag_run.run_after — both are fixed at run-creation time so a retry or clear
+    produces the same date.
+    """
+    anchor = dag_run.logical_date or dag_run.run_after
+    # Convert stdlib datetime → pendulum, move to NY, snap to start-of-day, then
+    # walk back to the previous business day.
+    anchor_ny = pendulum.instance(anchor).in_tz(NY_TZ).start_of("day")
+    bday = _prev_business_day(anchor_ny)
+    return bday.to_date_string()  # "YYYY-MM-DD"
+
 
 def write_pnl_report(trade_date: str) -> Path:
     """Aggregate the trades booked on ``trade_date`` (YYYY-MM-DD) per desk."""
