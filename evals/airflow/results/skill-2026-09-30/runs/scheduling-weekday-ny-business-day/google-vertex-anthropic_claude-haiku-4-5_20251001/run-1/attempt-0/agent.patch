 REPORTS_DIR = PROJECT_DIR / "reports"
 
 
+def prev_business_day(d):
+    """Subtract 1 day, then skip back over any weekend days."""
+    d = d.subtract(days=1)
+    while d.day_of_week in (pendulum.SATURDAY, pendulum.SUNDAY):
+        d = d.subtract(days=1)
+    return d
+
+
+def run_window(dag_run, tz="America/New_York", prev=None):
+    """
+    Compute the [start, end) window of the period this run processes.
+    
+    For a trigger timetable, applies the prev() function to the run's fire time.
+    Args:
+        dag_run: the Airflow dag_run object
+        tz: business timezone (default America/New_York)
+        prev: function to compute the period from the fire time; defaults to prev_business_day
+    
+    Returns:
+        (start, end) as tz-aware pendulum datetimes, where the period is [start, end)
+    """
+    if prev is None:
+        prev = prev_business_day
+    # For a trigger timetable, logical_date equals run_after (the fire time)
+    anchor = dag_run.logical_date or dag_run.run_after
+    start = prev(pendulum.instance(anchor).in_tz(tz).start_of("day"))
+    return start, start.add(days=1)
+
+
