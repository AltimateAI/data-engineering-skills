+def prev_business_day(d):
+    """Return the previous business day (skip weekends)."""
+    d = d.subtract(days=1)
+    while d.day_of_week in (pendulum.SATURDAY, pendulum.SUNDAY):
+        d = d.subtract(days=1)
+    return d
+
+
+def run_window(dag_run, tz="America/New_York"):
+    """Return [start, end) of the period this run processes (previous business day)."""
+    anchor = dag_run.logical_date or dag_run.run_after
+    start = prev_business_day(pendulum.instance(anchor).in_tz(tz).start_of("day"))
+    return start, start.add(days=1)
+
