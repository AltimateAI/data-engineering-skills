+def previous_watermark(ti) -> str | None:
+    """High-water mark stored by the most recent load.
+    
+    Fetches the most recent XCom value pushed by a previous run's load_batch task.
+    On the first run, returns None to start from the beginning of the source.
+    """
+    try:
+        # xcom_pull without task_ids reads from the current task, so we fetch
+        # from "load_batch" task explicitly. On the first run this will return None.
+        watermark = ti.xcom_pull(task_ids="load_batch", key="watermark")
+        return watermark
+    except Exception:
+        # If no prior run exists, xcom_pull returns None
+        return None
 
 
