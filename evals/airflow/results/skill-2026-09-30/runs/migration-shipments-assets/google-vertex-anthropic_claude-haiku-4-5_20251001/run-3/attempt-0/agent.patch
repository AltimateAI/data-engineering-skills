+def get_previous_watermark(ti=None) -> str | None:
+    """High-water mark stored by the most recent successful load.
+
+    Retrieves from XCom of the current DagRun. The previous run will have
+    pushed this value into the task's XCom; we retrieve it from there.
+    Since each run is deterministic and watermarks are cumulative, we can
+    fetch the last watermark stored by the prior execution.
+    """
+    if ti is None:
+        return None
+
+    try:
+        # Attempt to retrieve watermark from the most recent prior run via ti.xcom_pull
+        # with allow_none=True to handle first run (no prior watermark)
+        watermark = ti.xcom_pull(task_ids=None, key="watermark", allow_none=True)
+        return watermark
+    except Exception:
+        # On first run or if XCom retrieval fails, no prior watermark exists
+        return None
 
 
