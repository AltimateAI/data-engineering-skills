--- /dev/null
+++ b/tests/test_shipments_daily_structure.py
@@ -0,0 +1,69 @@
+"""Structural tests for the shipments_daily DAG.
+
+Rules covered:
+  - Runs at 07:30 UTC Monday to Friday only.
+  - build_report (report) can only run after extract_shipments (extract).
+"""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+
+
+# ─── Schedule ────────────────────────────────────────────────────────────────
+
+
+def test_schedule_weekdays_only(dagbag, upcoming_runs):
+    """Next 10 runs must all fire on weekdays (Mon=0 … Fri=4)."""
+    dag = dagbag.dags["shipments_daily"]
+    # Start from a Sunday so the fixture has to skip a weekend immediately.
+    after = datetime(2026, 3, 1, tzinfo=timezone.utc)
+    runs = upcoming_runs(dag, after, 10)
+    assert len(runs) == 10, "Expected 10 upcoming runs"
+    weekend_runs = [r for r in runs if r.weekday() >= 5]
+    assert not weekend_runs, (
+        "Some runs fire on a weekend: "
+        + ", ".join(r.strftime("%A %Y-%m-%d") for r in weekend_runs)
+    )
+
+
+def test_schedule_time_and_timezone(dagbag, upcoming_runs):
+    """Every run must fire at exactly 07:30 UTC (utcoffset == 0)."""
+    dag = dagbag.dags["shipments_daily"]
+    after = datetime(2026, 3, 2, tzinfo=timezone.utc)
+    runs = upcoming_runs(dag, after, 10)
+    assert len(runs) == 10
+    bad = [
+        r
+        for r in runs
+        if (r.hour, r.minute) != (7, 30) or r.utcoffset().total_seconds() != 0
+    ]
+    assert not bad, (
+        "Runs not at 07:30 UTC: "
+        + ", ".join(r.isoformat() for r in bad)
+    )
+
+
+# ─── Task order ──────────────────────────────────────────────────────────────
+
+
+def test_build_report_runs_after_extract_shipments(dagbag):
+    """build_report must have extract_shipments as a direct upstream dependency.
+
+    Uses exact upstream_task_ids comparison so an extra edge or a bypass also
+    fails — not just a reachability check.
+    """
+    dag = dagbag.dags["shipments_daily"]
+    report_task = dag.get_task("build_report")
+    assert report_task.upstream_task_ids == {
+        "extract_shipments"
+    }, (
+        f"build_report.upstream_task_ids = {report_task.upstream_task_ids!r}; "
+        "expected exactly {'extract_shipments'}"
+    )
+
+
+def test_build_report_not_reachable_without_extract(dagbag):
+    """build_report must have extract_shipments somewhere in its full ancestry."""
+    dag = dagbag.dags["shipments_daily"]
+    ancestors = dag.get_task("build_report").get_flat_relative_ids(upstream=True)
+    assert "extract_shipments" in ancestors
