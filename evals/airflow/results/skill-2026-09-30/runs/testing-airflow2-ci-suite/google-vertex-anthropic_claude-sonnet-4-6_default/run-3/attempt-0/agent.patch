+"""Pytest configuration for the Airflow DAG test suite.
+
+Airflow 2.11 — CronDataIntervalTimetable (interval semantics).
+No scheduler, webserver or metadata DB connection required in CI.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# Airflow reads config once on first import; set everything before any airflow symbol.
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+sys.path.insert(0, str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    from airflow.models import DagBag
+
+    return DagBag(dag_folder=str(DAGS), include_examples=False)
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrate the throwaway sqlite DB once per session (needed by dag.test())."""
+    subprocess.run(
+        [sys.executable, "-m", "airflow", "db", "migrate"],
+        check=True,
+        capture_output=True,
+    )
+
+
+@pytest.fixture(scope="session")
+def upcoming_runs():
+    """Return the next *n* run_after datetimes for *dag* after *after* (tz-aware)."""
+    from airflow.timetables.base import TimeRestriction
+
+    def _runs(dag, after, n):
+        tt = dag.timetable
+        restriction = TimeRestriction(earliest=after, latest=None, catchup=True)
+        last, runs = None, []
+        for _ in range(n):
+            info = tt.next_dagrun_info(
+                last_automated_data_interval=last, restriction=restriction
+            )
+            if info is None:
+                break
+            runs.append(info.run_after)
+            last = info.data_interval
+        return runs
+
+    return _runs
