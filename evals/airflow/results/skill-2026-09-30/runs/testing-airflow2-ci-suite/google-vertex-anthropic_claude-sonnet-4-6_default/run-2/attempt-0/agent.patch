+"""Pytest configuration for Airflow 2.11 DAG tests.
+
+Runs in CI with no scheduler, webserver or external connections.
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# Airflow reads its config on first import; set everything before any airflow import.
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+
+# Let tests import helper modules that live in dags/
+sys.path.insert(0, str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    from airflow.models import DagBag  # Airflow 2.x
+    return DagBag(dag_folder=str(DAGS), include_examples=False)
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrate the throwaway metadata DB once per session. Required by dag.test()."""
+    subprocess.run(
+        [sys.executable, "-m", "airflow", "db", "migrate"],
+        check=True,
+        capture_output=True,
+    )
+
+
+def upcoming_runs(dag, after, n):
+    """Return the next *n* run_after datetimes the scheduler would fire for *dag*.
+
+    Uses the timetable directly — no scheduler, no metadata DB.
+    Works on Airflow 2.x (CronDataIntervalTimetable).
+    """
+    from airflow.timetables.base import TimeRestriction
+
+    tt = dag.timetable
+    restriction = TimeRestriction(earliest=after, latest=None, catchup=True)
+    last, runs = None, []
+    for _ in range(n):
+        info = tt.next_dagrun_info(last_automated_data_interval=last, restriction=restriction)
+        if info is None:
+            break
+        runs.append(info.run_after)
+        last = info.data_interval
+    return runs
+
+
+@pytest.fixture(scope="session")
+def upcoming_runs_fn():
+    return upcoming_runs
