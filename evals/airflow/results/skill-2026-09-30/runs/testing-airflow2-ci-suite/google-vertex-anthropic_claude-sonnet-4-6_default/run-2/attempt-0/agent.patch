+"""Integrity tests: every DAG file imports, expected DAG ids are present,
+and every task in every DAG has at least 2 retries.
+"""
+from __future__ import annotations
+
+# The DAG ids this repo is expected to define today.
+EXPECTED_DAG_IDS = {"shipments_daily", "carrier_rates_weekly"}
+
+
+def test_no_import_errors(dagbag):
+    """Every file in dags/ must import without errors."""
+    assert dagbag.import_errors == {}, "\n\n".join(
+        f"{path}:\n{err}" for path, err in dagbag.import_errors.items()
+    )
+
+
+def test_expected_dags_are_present(dagbag):
+    """All expected DAG ids must exist; catching a DAG that silently stops parsing."""
+    missing = EXPECTED_DAG_IDS - set(dagbag.dags)
+    assert not missing, f"DAGs missing from DagBag: {missing}"
+
+
+def test_every_task_has_at_least_two_retries(dagbag):
+    """Every task in every DAG must have retries >= 2.
+
+    We read task.retries (not dag.default_args) because a task-level
+    override silently wins over default_args.
+    """
+    bad = [
+        (dag_id, task.task_id, task.retries)
+        for dag_id, dag in dagbag.dags.items()
+        for task in dag.tasks
+        if task.retries < 2
+    ]
+    assert not bad, (
+        "Tasks with fewer than 2 retries:\n"
+        + "\n".join(f"  dag={d}  task={t}  retries={r}" for d, t, r in bad)
+    )
