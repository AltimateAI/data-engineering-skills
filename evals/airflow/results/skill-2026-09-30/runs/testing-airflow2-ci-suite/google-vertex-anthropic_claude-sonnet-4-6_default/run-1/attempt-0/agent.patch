+"""pytest configuration for the Airflow 2.x DAG test suite.
+
+CI runs ``pytest tests/`` in the project virtualenv with no scheduler,
+webserver, or metadata DB pre-existing.  This file creates a throwaway
+SQLite database per session so tests remain hermetic and repeatable.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+# ---------------------------------------------------------------------------
+# Path constants
+# ---------------------------------------------------------------------------
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# ---------------------------------------------------------------------------
+# Airflow environment – must be set BEFORE the first airflow import.
+# A temp AIRFLOW_HOME prevents tests from touching any developer config or DB.
+# ---------------------------------------------------------------------------
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = (
+    f"sqlite:///{_TMP / 'airflow.db'}"
+)
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+
+# Allow test modules to do ``from shipments_daily import find_late_shipments``.
+sys.path.insert(0, str(DAGS))
+
+
+# ---------------------------------------------------------------------------
+# Session-scoped fixtures
+# ---------------------------------------------------------------------------
+
+@pytest.fixture(scope="session")
+def dagbag():
+    """Parse all DAG files once for the whole test session.
+
+    On Airflow 2.x ``DagBag`` lives in ``airflow.models.dagbag``.
+    ``include_examples=False`` is accepted on 2.x; on 3.x the env var
+    ``AIRFLOW__CORE__LOAD_EXAMPLES=False`` is used instead.
+    """
+    try:
+        from airflow.dag_processing.dagbag import DagBag  # Airflow >= 3.2
+    except ImportError:
+        from airflow.models.dagbag import DagBag  # Airflow 2.x
+
+    import airflow
+    kw = {} if airflow.__version__.startswith("3.") else {"include_examples": False}
+    return DagBag(dag_folder=str(DAGS), **kw)
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrate the throwaway metadata DB (needed by ``dag.test()``)."""
+    subprocess.run(
+        [sys.executable, "-m", "airflow", "db", "migrate"],
+        check=True,
+        capture_output=True,
+    )
+
+
+@pytest.fixture(scope="session")
+def upcoming_runs():
+    """Return a callable ``upcoming_runs(dag, after, n)`` that yields the
+    next *n* UTC datetimes at which the scheduler would fire a run of *dag*,
+    starting strictly after *after*.  Uses the timetable's own logic; no DB
+    or scheduler required.
+    """
+    from airflow.timetables.base import TimeRestriction
+
+    def _runs(dag, after, n):
+        tt = dag.timetable
+        try:
+            from airflow.serialization.encoders import (  # Airflow >= 3.0
+                coerce_to_core_timetable,
+            )
+            tt = coerce_to_core_timetable(tt)
+        except ImportError:
+            pass
+        restriction = TimeRestriction(earliest=after, latest=None, catchup=True)
+        last, runs = None, []
+        for _ in range(n):
+            info = tt.next_dagrun_info(
+                last_automated_data_interval=last, restriction=restriction
+            )
+            if info is None:
+                break
+            runs.append(info.run_after)
+            last = info.data_interval
+        return runs
+
+    return _runs
