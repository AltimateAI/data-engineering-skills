+class TestShipmentsDailyEndToEnd:
+    """Integration test: shipments_daily on sample data."""
+
+    def test_shipments_daily_end_to_end_2026_03_03(self, dagbag, airflow_db, tmp_path):
+        """Run shipments_daily end-to-end on sample data for 2026-03-03 (Tuesday).
+
+        Expected late shipments (sorted by days_late DESC, then shipment_id):
+        - SH-1009: undelivered, promised 2026-02-26, 5 days late
+        - SH-1003: undelivered, promised 2026-02-28, 3 days late
+        - SH-1007: delivered 2026-03-03, promised 2026-03-01, 2 days late
+        - SH-1001: delivered 2026-03-03, promised 2026-03-02, 1 day late
+        """
+        from dags.shipments_daily import OUTPUT_DIR
+
+        dag = dagbag.dags["shipments_daily"]
+
+        # Run the DAG for 2026-03-03
+        dr = dag.test(execution_date=datetime(2026, 3, 3, 7, 30, tzinfo=timezone.utc))
+
+        # Verify the run succeeded
+        assert dr.state == "success", (
+            f"DAG run failed. State: {dr.state}\n"
+            f"Task states: {[(t.task_id, t.state) for t in dr.get_task_instances()]}"
+        )
+
+        # Check that the output file was created
+        output_file = OUTPUT_DIR / "2026-03-03.csv"
+        assert output_file.exists(), f"Output file not found: {output_file}"
+
+        # Parse and verify the output
+        with output_file.open(newline="") as fh:
+            reader = csv.DictReader(fh)
+            rows = list(reader)
+
+        assert len(rows) == 4, f"Expected 4 late shipments, got {len(rows)}: {rows}"
+
+        # Verify shipment ids in order
+        shipment_ids = [r["shipment_id"] for r in rows]
+        assert shipment_ids == ["SH-1009", "SH-1003", "SH-1007", "SH-1001"], (
+            f"Unexpected order or ids: {shipment_ids}"
+        )
+
+        # Verify each row's data
+        expected = [
+            {
+                "shipment_id": "SH-1009",
+                "carrier": "DHL",
+                "promised_date": "2026-02-26",
+                "delivered_date": "",
+                "days_late": "5",
+            },
+            {
+                "shipment_id": "SH-1003",
+                "carrier": "FedEx",
+                "promised_date": "2026-02-28",
+                "delivered_date": "",
+                "days_late": "3",
+            },
+            {
+                "shipment_id": "SH-1007",
+                "carrier": "UPS",
+                "promised_date": "2026-03-01",
+                "delivered_date": "2026-03-03",
+                "days_late": "2",
+            },
+            {
+                "shipment_id": "SH-1001",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-03",
+                "days_late": "1",
+            },
+        ]
+
+        for i, (actual, exp) in enumerate(zip(rows, expected)):
+            for key in exp:
+                assert actual.get(key) == exp[key], (
+                    f"Row {i} ({actual.get('shipment_id')}): "
+                    f"expected {key}={exp[key]}, got {actual.get(key)}"
+                )
