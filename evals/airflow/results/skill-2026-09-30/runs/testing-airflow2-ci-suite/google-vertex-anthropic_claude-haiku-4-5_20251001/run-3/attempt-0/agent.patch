+"""Tests for carrier_rates_weekly DAG.
+
+Validates:
+- Schedule is 09:00 UTC on Mondays only
+- DAG structure and configuration
+- End-to-end execution
+"""
+
+from __future__ import annotations
+
+import csv
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from airflow.models import DAG
+
+from tests.conftest import upcoming_runs
+
+
+class TestCarrierRatesWeeklySchedule:
+    """Validate carrier_rates_weekly schedule."""
+
+    def test_schedule_is_mondays_0900_utc(self, dagbag, airflow_db, upcoming_runs):
+        """carrier_rates_weekly must run at 09:00 UTC on Mondays only."""
+        dag: DAG = dagbag.get_dag("carrier_rates_weekly")
+        assert dag is not None, "carrier_rates_weekly DAG not found in dagbag"
+
+        # Generate next 10 scheduled runs starting from 2026-01-05 (a Monday)
+        runs = list(upcoming_runs(dag, after=datetime(2026, 1, 4, 23, 0, 0, tzinfo=timezone.utc), n=10))
+        assert len(runs) >= 5, "Expected at least 5 scheduled runs"
+
+        # Verify all runs are on Mondays at 09:00 UTC
+        for run_time in runs[:5]:
+            assert run_time.weekday() == 0, f"Run {run_time} is not on a Monday"
+            assert run_time.hour == 9, f"Run {run_time} is not at 09:00 UTC (hour={run_time.hour})"
+            assert run_time.minute == 0, f"Run {run_time} minute is {run_time.minute}, expected 0"
+            assert run_time.second == 0, f"Run {run_time} second is {run_time.second}, expected 0"
+
+        # Verify we skip Tuesdays, Wednesdays, etc.
+        # The gap between consecutive runs should be ~7 days
+        for i in range(len(runs) - 1):
+            days_between = (runs[i + 1] - runs[i]).days
+            assert days_between == 7, f"Gap between runs {runs[i]} and {runs[i+1]} is {days_between} days, expected 7"
+
+
+class TestCarrierRatesWeeklyEndToEnd:
+    """End-to-end execution test for carrier_rates_weekly DAG."""
+
+    def test_carrier_rates_weekly_run_2026_01_12(self, dagbag):
+        """Run carrier_rates_weekly on 2026-01-12 (a Monday) and verify output."""
+        dag: DAG = dagbag.get_dag("carrier_rates_weekly")
+        assert dag is not None, "carrier_rates_weekly DAG not found"
+
+        run_date = "2026-01-12"
+
+        # Execute the DAG by running each task manually
+        task_instance = dag.get_task("summarize_rates")
+        assert task_instance is not None, "summarize_rates task not found"
+
+        # Set up the context
+        execution_date = datetime(2026, 1, 12, 9, 0, 0, tzinfo=timezone.utc)
+        data_interval_start = datetime(2026, 1, 5, 9, 0, 0, tzinfo=timezone.utc)
+        data_interval_end = datetime(2026, 1, 12, 9, 0, 0, tzinfo=timezone.utc)
+
+        context = {
+            "ds": run_date,
+            "execution_date": execution_date,
+            "data_interval_start": data_interval_start,
+            "data_interval_end": data_interval_end,
+            "ti": None,
+        }
+
+        # Execute the task
+        result = task_instance.python_callable(**context)
+        output_file = Path(result)
+
+        # Verify output file exists
+        assert output_file.exists(), f"Output file {output_file} not created"
+
+        # Read and validate output
+        rows = []
+        with output_file.open("r") as fh:
+            reader = csv.DictReader(fh)
+            rows = list(reader)
+
+        assert len(rows) > 0, "Output CSV has no data rows"
+
+        # Verify headers
+        assert "carrier" in [row for row in rows[0].keys()], "carrier column not found in output"
+        assert "avg_rate_per_kg" in [row for row in rows[0].keys()], "avg_rate_per_kg column not found in output"
+
+        # Verify expected carriers are present (DHL, UPS, FedEx from sample data)
+        carriers = sorted([row["carrier"] for row in rows])
+        assert "DHL" in carriers, "DHL not in output"
+        assert "FedEx" in carriers, "FedEx not in output"
+        assert "UPS" in carriers, "UPS not in output"
+
+        # Verify average rates are correct
+        # From carrier_rates.csv:
+        # DHL: (4.120 + 4.380) / 2 = 4.250
+        # UPS: (3.950 + 4.010) / 2 = 3.980
+        # FedEx: 4.260 / 1 = 4.260
+        dhl_row = next((row for row in rows if row["carrier"] == "DHL"), None)
+        assert dhl_row is not None, "DHL not found in output"
+        assert float(dhl_row["avg_rate_per_kg"]) == pytest.approx(4.250, rel=0.001), f"DHL average rate incorrect: {dhl_row['avg_rate_per_kg']}"
+
+        ups_row = next((row for row in rows if row["carrier"] == "UPS"), None)
+        assert ups_row is not None, "UPS not found in output"
+        assert float(ups_row["avg_rate_per_kg"]) == pytest.approx(3.980, rel=0.001), f"UPS average rate incorrect: {ups_row['avg_rate_per_kg']}"
+
+        fedex_row = next((row for row in rows if row["carrier"] == "FedEx"), None)
+        assert fedex_row is not None, "FedEx not found in output"
+        assert float(fedex_row["avg_rate_per_kg"]) == pytest.approx(4.260, rel=0.001), f"FedEx average rate incorrect: {fedex_row['avg_rate_per_kg']}"
