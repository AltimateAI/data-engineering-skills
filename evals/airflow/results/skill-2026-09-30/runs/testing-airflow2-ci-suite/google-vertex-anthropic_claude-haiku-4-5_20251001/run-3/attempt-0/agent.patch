+"""Tests for DAG import, structure, and configuration.
+
+Covers:
+- All DAG files import without errors
+- Every task in every DAG has at least 2 retries
+"""
+
+import pytest
+
+
+class TestDagImports:
+    """Test that all DAGs in dags/ import successfully."""
+
+    def test_no_import_errors(self, dagbag):
+        """All DAG files must import without errors."""
+        assert dagbag.import_errors == {}, (
+            f"DAG import errors:\n"
+            + "\n".join(f"  {k}: {v}" for k, v in dagbag.import_errors.items())
+        )
+
+    def test_expected_dag_ids_present(self, dagbag):
+        """The expected DAGs are defined and loaded."""
+        expected_dag_ids = {"shipments_daily", "carrier_rates_weekly"}
+        actual_dag_ids = set(dagbag.dags.keys())
+        assert actual_dag_ids == expected_dag_ids, (
+            f"Expected DAG ids {expected_dag_ids}, got {actual_dag_ids}"
+        )
+
+
+class TestTaskRetries:
+    """Test that every task in every DAG has at least 2 retries."""
+
+    @pytest.mark.parametrize("dag_id", ["shipments_daily", "carrier_rates_weekly"])
+    def test_all_tasks_have_min_retries(self, dagbag, dag_id):
+        """Every task in the DAG must have retries >= 2."""
+        dag = dagbag.dags[dag_id]
+        for task in dag.tasks:
+            assert task.retries >= 2, (
+                f"Task {task.task_id} in {dag_id} has {task.retries} retries, "
+                f"need >= 2"
+            )
