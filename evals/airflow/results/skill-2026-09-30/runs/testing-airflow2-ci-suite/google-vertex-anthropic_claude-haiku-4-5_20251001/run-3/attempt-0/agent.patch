+"""Tests for shipments_daily DAG.
+
+Covers:
+- Schedule: 07:30 UTC Monday-Friday only
+- Task order: report can only build after export is extracted
+- Business logic: late-shipments identification and days_late calculation
+- End-to-end run on sample data for 2026-03-03
+"""
+
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+# Import the DAG module to access the logic functions
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "dags"))
+from shipments_daily import find_late_shipments, _days_between
+
+
+class TestShipmentsDailySchedule:
+    """Test shipments_daily runs on the correct schedule: 07:30 UTC Mon-Fri."""
+
+    def test_schedule_is_weekdays_0730_utc(self, dagbag, upcoming_runs):
+        """shipments_daily must run at 07:30 UTC on weekdays only."""
+        dag = dagbag.dags["shipments_daily"]
+        # Get the next 10 scheduled run times starting from 2026-03-02 (Mon)
+        runs = upcoming_runs(dag, datetime(2026, 3, 2, tzinfo=timezone.utc), 10)
+
+        assert len(runs) >= 5, f"Expected >= 5 runs in 10-run window, got {len(runs)}"
+
+        # All runs should be on weekdays (0=Monday, 4=Friday)
+        weekdays = {r.weekday() for r in runs}
+        assert weekdays == {0, 1, 2, 3, 4}, (
+            f"Expected all runs on weekdays (0-4), got weekdays {weekdays}"
+        )
+
+        # All runs should be at 07:30 UTC
+        for run in runs[:5]:
+            assert run.hour == 7, f"Expected hour 7, got {run.hour}"
+            assert run.minute == 30, f"Expected minute 30, got {run.minute}"
+            assert run.utcoffset().total_seconds() == 0, (
+                f"Expected UTC (offset=0), got offset {run.utcoffset().total_seconds()}"
+            )
+
+
+class TestShipmentsDailyTaskOrder:
+    """Test that tasks in shipments_daily are ordered correctly."""
+
+    def test_report_depends_on_extract(self, dagbag):
+        """build_report task must run after extract_shipments."""
+        dag = dagbag.dags["shipments_daily"]
+        report_task = dag.get_task("build_report")
+        extract_task = dag.get_task("extract_shipments")
+
+        # Check that extract_shipments is an upstream dependency of report
+        upstream_ids = {t.task_id for t in dag.get_task("build_report").upstream_list}
+        assert "extract_shipments" in upstream_ids, (
+            f"build_report must depend on extract_shipments; upstream tasks: {upstream_ids}"
+        )
+
+    def test_full_task_chain_order(self, dagbag):
+        """Verify the full task chain: start >> extract >> report >> done."""
+        dag = dagbag.dags["shipments_daily"]
+        
+        # start -> extract_shipments
+        start = dag.get_task("start")
+        assert {t.task_id for t in start.downstream_list} == {"extract_shipments"}, (
+            "start must lead only to extract_shipments"
+        )
+
+        # extract_shipments -> build_report
+        extract = dag.get_task("extract_shipments")
+        assert {t.task_id for t in extract.downstream_list} == {"build_report"}, (
+            "extract_shipments must lead only to build_report"
+        )
+
+        # build_report -> done
+        report = dag.get_task("build_report")
+        assert {t.task_id for t in report.downstream_list} == {"done"}, (
+            "build_report must lead only to done"
+        )
+
+
+class TestLateSipmentsLogic:
+    """Test the business logic for identifying and measuring late shipments."""
+
+    def test_days_between(self):
+        """_days_between should compute days between dates (inclusive difference)."""
+        # 2026-02-28 to 2026-03-01 = 1 day
+        assert _days_between("2026-02-28", "2026-03-01") == 1
+        # 2026-03-01 to 2026-03-03 = 2 days
+        assert _days_between("2026-03-01", "2026-03-03") == 2
+        # Same day = 0 days
+        assert _days_between("2026-03-03", "2026-03-03") == 0
+
+    def test_find_late_shipments_delivered_late(self):
+        """Shipments delivered after their promised date are late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-03",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-001"
+        assert late[0]["days_late"] == 1  # delivered 1 day after promised
+
+    def test_find_late_shipments_not_late_if_on_time(self):
+        """Shipments delivered on or before promised date are not late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-03",
+                "delivered_date": "2026-03-03",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0
+
+    def test_find_late_shipments_undelivered_overdue(self):
+        """Undelivered shipments with promised_date before as_of are late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-02-28",
+                "carrier": "UPS",
+                "promised_date": "2026-03-01",
+                "delivered_date": "",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-001"
+        assert late[0]["days_late"] == 2  # from 2026-03-01 to 2026-03-03
+
+    def test_find_late_shipments_undelivered_not_yet_due(self):
+        """Undelivered shipments with promised_date >= as_of are not late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-02",
+                "carrier": "FedEx",
+                "promised_date": "2026-03-04",
+                "delivered_date": "",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0
+
+    def test_find_late_shipments_shipped_in_future(self):
+        """Shipments with ship_date after as_of are ignored."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-04",
+                "carrier": "DHL",
+                "promised_date": "2026-03-05",
+                "delivered_date": "",
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0
+
+    def test_find_late_shipments_delivered_on_different_day(self):
+        """Only shipments delivered ON the as_of date (and after promised_date) are late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-04",  # delivered after as_of
+            }
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0  # not counted because delivered_date != as_of
+
+    def test_find_late_shipments_sorting(self):
+        """Late shipments are sorted by days_late (desc), then by shipment_id (asc)."""
+        rows = [
+            {
+                "shipment_id": "SH-002",
+                "ship_date": "2026-02-28",
+                "carrier": "UPS",
+                "promised_date": "2026-03-01",
+                "delivered_date": "2026-03-03",
+            },
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-02-27",
+                "carrier": "DHL",
+                "promised_date": "2026-02-28",
+                "delivered_date": "2026-03-03",
+            },
+        ]
+        late = find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 2
+        # SH-001: 4 days late (2026-02-28 to 2026-03-03)
+        # SH-002: 2 days late (2026-03-01 to 2026-03-03)
+        assert late[0]["shipment_id"] == "SH-001"  # most late, first
+        assert late[1]["shipment_id"] == "SH-002"
+
+
+class TestShipmentsDailyEndToEnd:
+    """End-to-end test running shipments_daily on sample data."""
+
+    def test_shipments_daily_run_2026_03_03(self, dagbag, airflow_db, tmp_path, monkeypatch):
+        """Run shipments_daily for 2026-03-03 on sample data; verify output is correct."""
+        dag = dagbag.dags["shipments_daily"]
+
+        # Patch OUTPUT_DIR to use a temp directory instead of the repo
+        output_dir = tmp_path / "output" / "late_shipments"
+        for task in dag.tasks:
+            if hasattr(task, "python_callable"):
+                task.python_callable.__globals__["OUTPUT_DIR"] = output_dir
+
+        # Run the DAG for logical_date 2026-03-03 (which is the ds for the run)
+        dr = dag.test(execution_date=datetime(2026, 3, 3, 7, 30, tzinfo=timezone.utc))
+
+        # Verify the DAG run succeeded
+        assert dr.state == "success", (
+            f"DAG run failed; state={dr.state}. Task states: "
+            + ", ".join(f"{t.task_id}={t.state}" for t in dr.get_task_instances())
+        )
+
+        # Verify the output file was created with the correct filename
+        output_file = output_dir / "2026-03-03.csv"
+        assert output_file.exists(), f"Output file {output_file} was not created"
+
+        # Read and verify the output CSV
+        import csv
+        with output_file.open(newline="") as fh:
+            rows = list(csv.DictReader(fh))
+
+        # For 2026-03-03, the expected late shipments are:
+        # SH-1001: delivered 2026-03-03 after promised 2026-03-02 -> 1 day late
+        # SH-1005: delivered 2026-03-02 after promised 2026-02-24 -> 6 days late
+        # Late shipments for 2026-03-03:
+        # SH-1009: undelivered, promised 2026-02-26 < 2026-03-03 -> 5 days overdue
+        # SH-1003: undelivered, promised 2026-02-28 < 2026-03-03 -> 3 days overdue
+        # SH-1007: delivered 2026-03-03 after promised 2026-03-01 -> 2 days late
+        # SH-1001: delivered 2026-03-03 after promised 2026-03-02 -> 1 day late
+        # 
+        # Not late:
+        # SH-1002: delivered 2026-03-03 but promised 2026-03-03 (not after promise)
+        # SH-1004: undelivered, promised 2026-03-03 (not before run date)
+        # SH-1005: delivered 2026-03-02 (not delivered on run date)
+        # SH-1006: undelivered, promised 2026-03-06 (not before run date)
+        # SH-1008: delivered 2026-03-03 but promised 2026-03-04 (delivered before promise)
+        
+        expected_ids_sorted = ["SH-1009", "SH-1003", "SH-1007", "SH-1001"]
+        actual_ids = [r["shipment_id"] for r in rows]
+        
+        assert actual_ids == expected_ids_sorted, (
+            f"Expected shipments {expected_ids_sorted}, got {actual_ids}. "
+            f"Full output:\n" + "\n".join(str(r) for r in rows)
+        )
+
+        # Verify days_late values
+        assert rows[0]["days_late"] == "5", f"SH-1009 days_late should be 5, got {rows[0]['days_late']}"
+        assert rows[1]["days_late"] == "3", f"SH-1003 days_late should be 3, got {rows[1]['days_late']}"
+        assert rows[2]["days_late"] == "2", f"SH-1007 days_late should be 2, got {rows[2]['days_late']}"
+        assert rows[3]["days_late"] == "1", f"SH-1001 days_late should be 1, got {rows[3]['days_late']}"
