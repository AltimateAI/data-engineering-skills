+"""Test shipments_daily DAG task dependencies."""
+
+
+def test_shipments_daily_report_depends_on_extract(dagbag):
+    """Verify build_report task depends on extract_shipments (extract must run first)."""
+    dag = dagbag.dags["shipments_daily"]
+    report_task = dag.get_task("build_report")
+    
+    # build_report should depend on extract_shipments
+    upstream_task_ids = report_task.upstream_list
+    upstream_ids = {t.task_id for t in upstream_task_ids}
+    
+    assert "extract_shipments" in upstream_ids, (
+        f"build_report should depend on extract_shipments, "
+        f"but upstream tasks are: {upstream_ids}"
+    )
+
+
+def test_shipments_daily_task_order(dagbag):
+    """Verify the full task order: start >> extract_shipments >> build_report >> done."""
+    dag = dagbag.dags["shipments_daily"]
+    
+    # Verify each task's dependencies explicitly
+    start = dag.get_task("start")
+    extract = dag.get_task("extract_shipments")
+    report = dag.get_task("build_report")
+    done = dag.get_task("done")
+    
+    # start should have no upstream tasks
+    assert len(start.upstream_list) == 0, (
+        f"start should have no dependencies, but has: "
+        f"{[t.task_id for t in start.upstream_list]}"
+    )
+    
+    # extract should depend only on start
+    extract_upstream = {t.task_id for t in extract.upstream_list}
+    assert extract_upstream == {"start"}, (
+        f"extract_shipments should depend only on start, "
+        f"but depends on: {extract_upstream}"
+    )
+    
+    # report should depend only on extract
+    report_upstream = {t.task_id for t in report.upstream_list}
+    assert report_upstream == {"extract_shipments"}, (
+        f"build_report should depend only on extract_shipments, "
+        f"but depends on: {report_upstream}"
+    )
+    
+    # done should depend only on report
+    done_upstream = {t.task_id for t in done.upstream_list}
+    assert done_upstream == {"build_report"}, (
+        f"done should depend only on build_report, "
+        f"but depends on: {done_upstream}"
+    )
