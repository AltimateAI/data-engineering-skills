+"""Test shipments_daily DAG schedule: 07:30 UTC, Monday-Friday only."""
+
+from datetime import datetime, timezone
+
+
+def test_shipments_daily_schedule_0730_utc_weekdays(dagbag, upcoming_runs):
+    """Verify shipments_daily runs at 07:30 UTC on weekdays (Mon-Fri) only."""
+    dag = dagbag.dags["shipments_daily"]
+    
+    # Generate the next 10 runs starting from 2026-01-01
+    runs = upcoming_runs(dag, datetime(2026, 1, 1, tzinfo=timezone.utc), 10)
+    
+    # Should have 10 runs (all should fall on weekdays)
+    assert len(runs) == 10, f"Expected 10 runs, got {len(runs)}"
+    
+    # All runs should be on weekdays (Monday=0, ..., Friday=4)
+    weekdays = {r.weekday() for r in runs}
+    assert weekdays == {0, 1, 2, 3, 4}, (
+        f"Expected runs only on Mon-Fri (weekdays 0-4), "
+        f"but got weekdays: {weekdays}"
+    )
+    
+    # All runs should be at exactly 07:30 UTC
+    for run in runs:
+        assert run.hour == 7, f"Expected hour=7, got {run.hour} for {run}"
+        assert run.minute == 30, f"Expected minute=30, got {run.minute} for {run}"
+        assert run.utcoffset().total_seconds() == 0, (
+            f"Expected UTC (offset=0), got offset={run.utcoffset()} for {run}"
+        )
