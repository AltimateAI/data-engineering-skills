@@ -0,0 +1,104 @@
+"""End-to-end test of shipments_daily DAG on sample data."""
+
+import csv
+import shutil
+import sys
+from datetime import datetime
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import pytest
+
+# DAG_DIR will be set in the test
+DAG_DIR = Path(__file__).resolve().parents[1] / "dags"
+
+
+@pytest.mark.usefixtures("airflow_db")
+def test_shipments_daily_end_to_end(tmp_path, monkeypatch):
+    """Run shipments_daily end-to-end on sample data for 2026-03-03.
+    
+    Verifies:
+    - DAG runs to success
+    - Output file is created with correct columns
+    - Late shipments are correct (4 expected, matching the logic tests)
+    - Output data is sorted by -days_late
+    """
+    from airflow.models.dagbag import DagBag
+    
+    # Add dags to path
+    if str(DAG_DIR) not in sys.path:
+        sys.path.insert(0, str(DAG_DIR))
+    
+    # Patch the environment variable/module constant directly in sys.modules
+    # BEFORE DagBag loads the file
+    monkeypatch.setenv("OUTPUT_DIR", str(tmp_path / "late_shipments"))
+    
+    # Now load the DAG fresh — DagBag will read the file and execute it
+    # Use a fresh DagBag that doesn't use the session fixture's cache
+    dagbag = DagBag(dag_folder=str(DAG_DIR))
+    dag = dagbag.dags["shipments_daily"]
+    
+    # After DAG is loaded, import to get REPORT_COLUMNS
+    import shipments_daily
+    REPORT_COLUMNS = shipments_daily.REPORT_COLUMNS
+    
+    # Run the DAG for 2026-03-03 (execution_date on 2.11)
+    # Use UTC timezone for the datetime
+    dr = dag.test(execution_date=datetime(2026, 3, 3, tzinfo=ZoneInfo("UTC")))
+    
+    # Verify the DAG run succeeded
+    assert dr.state == "success", (
+        f"DAG run failed. State: {dr.state}. "
+        f"Task states: {[(t.task_id, t.state) for t in dr.get_task_instances()]}"
+    )
+    
+    # Verify the output file exists
+    output_file = tmp_path / "late_shipments" / "2026-03-03.csv"
+    assert output_file.exists(), f"Output file not created: {output_file}"
+    
+    # Read and verify the CSV
+    with output_file.open(newline="") as fh:
+        reader = csv.DictReader(fh)
+        rows = list(reader)
+    
+    # Should have 4 late shipments on 2026-03-03
+    assert len(rows) == 4, (
+        f"Expected 4 late shipments, got {len(rows)}: "
+        f"{[r['shipment_id'] for r in rows]}"
+    )
+    
+    # Verify column headers match REPORT_COLUMNS
+    actual_columns = set(rows[0].keys()) if rows else set()
+    expected_columns = set(REPORT_COLUMNS)
+    assert actual_columns == expected_columns, (
+        f"Column mismatch. Expected: {expected_columns}, Got: {actual_columns}"
+    )
+    
+    # Verify the shipment IDs and order
+    shipment_ids = [r["shipment_id"] for r in rows]
+    assert shipment_ids == ["SH-1009", "SH-1003", "SH-1007", "SH-1001"], (
+        f"Unexpected shipment order or IDs: {shipment_ids}. "
+        f"Expected: ['SH-1009', 'SH-1003', 'SH-1007', 'SH-1001']"
+    )
+    
+    # Verify days_late values are correct and in descending order
+    days_late_values = [int(r["days_late"]) for r in rows]
+    assert days_late_values == [5, 3, 2, 1], (
+        f"Unexpected days_late values: {days_late_values}. "
+        f"Expected: [5, 3, 2, 1]"
+    )
+    
+    # Spot-check a few specific rows
+    row_0 = rows[0]
+    assert row_0["shipment_id"] == "SH-1009"
+    assert row_0["carrier"] == "DHL"
+    assert row_0["promised_date"] == "2026-02-26"
+    assert row_0["delivered_date"] == ""
+    assert row_0["days_late"] == "5"
+    
+    row_3 = rows[3]
+    assert row_3["shipment_id"] == "SH-1001"
+    assert row_3["carrier"] == "DHL"
+    assert row_3["promised_date"] == "2026-03-02"
+    assert row_3["delivered_date"] == "2026-03-03"
+    assert row_3["days_late"] == "1"
