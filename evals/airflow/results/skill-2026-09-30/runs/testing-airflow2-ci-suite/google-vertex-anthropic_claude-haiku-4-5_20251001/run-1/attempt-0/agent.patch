+"""Test that every task in every DAG has at least 2 retries."""
+
+
+def test_all_tasks_have_minimum_retries(dagbag):
+    """Verify every task in every DAG has retries >= 2."""
+    failures = []
+    for dag_id, dag in dagbag.dags.items():
+        for task in dag.tasks:
+            if task.retries < 2:
+                failures.append(
+                    f"  DAG '{dag_id}', task '{task.task_id}': "
+                    f"retries={task.retries} (need >= 2)"
+                )
+
+    assert not failures, (
+        "Some tasks do not have minimum 2 retries:\n"
+        + "\n".join(failures)
+    )
