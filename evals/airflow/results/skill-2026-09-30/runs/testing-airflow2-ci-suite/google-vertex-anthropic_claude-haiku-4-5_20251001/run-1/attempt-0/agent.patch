+"""Test late-shipments business logic in shipments_daily."""
+
+import sys
+from pathlib import Path
+
+# Import the shipments_daily module to get the find_late_shipments function
+DAG_DIR = Path(__file__).resolve().parents[1] / "dags"
+sys.path.insert(0, str(DAG_DIR))
+
+from shipments_daily import find_late_shipments
+
+
+def test_late_shipments_delivered_after_promised_on_as_of_date():
+    """A shipment delivered on as_of after its promised date is late."""
+    rows = [
+        {
+            "shipment_id": "SH-1001",
+            "ship_date": "2026-02-26",
+            "carrier": "DHL",
+            "promised_date": "2026-03-02",
+            "delivered_date": "2026-03-03",
+        }
+    ]
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    assert len(late) == 1
+    assert late[0]["shipment_id"] == "SH-1001"
+    assert late[0]["days_late"] == 1  # 2026-03-03 - 2026-03-02
+
+
+def test_late_shipments_undelivered_promised_before_as_of():
+    """An undelivered shipment with promised_date < as_of is late."""
+    rows = [
+        {
+            "shipment_id": "SH-1003",
+            "ship_date": "2026-02-25",
+            "carrier": "FedEx",
+            "promised_date": "2026-02-28",
+            "delivered_date": "",
+        }
+    ]
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    assert len(late) == 1
+    assert late[0]["shipment_id"] == "SH-1003"
+    assert late[0]["days_late"] == 3  # 2026-03-03 - 2026-02-28
+
+
+def test_not_late_delivered_before_promised():
+    """A shipment delivered before promised is not late."""
+    rows = [
+        {
+            "shipment_id": "SH-1008",
+            "ship_date": "2026-03-02",
+            "carrier": "DHL",
+            "promised_date": "2026-03-04",
+            "delivered_date": "2026-03-03",
+        }
+    ]
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    assert len(late) == 0
+
+
+def test_not_late_delivered_on_time():
+    """A shipment delivered on or before promised is not late."""
+    rows = [
+        {
+            "shipment_id": "SH-1002",
+            "ship_date": "2026-02-27",
+            "carrier": "UPS",
+            "promised_date": "2026-03-03",
+            "delivered_date": "2026-03-03",
+        }
+    ]
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    assert len(late) == 0
+
+
+def test_not_late_undelivered_promised_future():
+    """An undelivered shipment with promised_date >= as_of is not late."""
+    rows = [
+        {
+            "shipment_id": "SH-1004",
+            "ship_date": "2026-03-01",
+            "carrier": "DHL",
+            "promised_date": "2026-03-03",
+            "delivered_date": "",
+        }
+    ]
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    assert len(late) == 0
+
+
+def test_not_late_delivered_on_different_day():
+    """A shipment delivered on a day other than as_of is not late (even if late)."""
+    rows = [
+        {
+            "shipment_id": "SH-1005",
+            "ship_date": "2026-02-20",
+            "carrier": "UPS",
+            "promised_date": "2026-02-24",
+            "delivered_date": "2026-03-02",
+        }
+    ]
+    # Check on 2026-03-03 (delivered on 2026-03-02, not as_of)
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    assert len(late) == 0
+
+
+def test_skip_shipment_not_yet_shipped():
+    """A shipment with ship_date > as_of is skipped."""
+    rows = [
+        {
+            "shipment_id": "SH-1006",
+            "ship_date": "2026-03-04",
+            "carrier": "FedEx",
+            "promised_date": "2026-03-06",
+            "delivered_date": "",
+        }
+    ]
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    assert len(late) == 0
+
+
+def test_late_shipments_sorted_by_days_late_desc_then_id():
+    """Late shipments are sorted by days_late (descending), then shipment_id."""
+    rows = [
+        {
+            "shipment_id": "SH-1009",
+            "ship_date": "2026-02-24",
+            "carrier": "DHL",
+            "promised_date": "2026-02-26",
+            "delivered_date": "",
+        },
+        {
+            "shipment_id": "SH-1003",
+            "ship_date": "2026-02-25",
+            "carrier": "FedEx",
+            "promised_date": "2026-02-28",
+            "delivered_date": "",
+        },
+        {
+            "shipment_id": "SH-1007",
+            "ship_date": "2026-02-28",
+            "carrier": "UPS",
+            "promised_date": "2026-03-01",
+            "delivered_date": "2026-03-03",
+        },
+        {
+            "shipment_id": "SH-1001",
+            "ship_date": "2026-02-26",
+            "carrier": "DHL",
+            "promised_date": "2026-03-02",
+            "delivered_date": "2026-03-03",
+        },
+    ]
+    late = find_late_shipments(rows, as_of="2026-03-03")
+    
+    # Should have all 4 as late
+    assert len(late) == 4
+    
+    # Check order: sorted by -days_late, then id
+    assert [r["shipment_id"] for r in late] == [
+        "SH-1009",  # 5 days
+        "SH-1003",  # 3 days
+        "SH-1007",  # 2 days
+        "SH-1001",  # 1 day
+    ]
+
+
+def test_late_shipments_days_late_calculation():
+    """days_late is calculated as (delivered or as_of) - promised_date."""
+    rows = [
+        {
+            "shipment_id": "SH-A",
+            "ship_date": "2026-01-01",
+            "carrier": "DHL",
+            "promised_date": "2026-01-05",
+            "delivered_date": "2026-01-10",
+        },
+        {
+            "shipment_id": "SH-B",
+            "ship_date": "2026-01-01",
+            "carrier": "UPS",
+            "promised_date": "2026-01-05",
+            "delivered_date": "",
+        },
+    ]
+    late = find_late_shipments(rows, as_of="2026-01-10")
+    
+    assert len(late) == 2
+    # SH-A delivered on 2026-01-10, promised 2026-01-05 -> 5 days
+    # SH-B undelivered, promised 2026-01-05, as_of 2026-01-10 -> 5 days
+    assert late[0]["days_late"] == 5
+    assert late[1]["days_late"] == 5
