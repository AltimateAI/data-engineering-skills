+    )
+
+    # 1. Output file was written.
+    out_file = out_dir / "2026-03-02.csv"
+    assert out_file.exists(), (
+        f"Expected output file {out_file} not created. Task states: {task_states}"
+    )
+
+    with out_file.open(newline="") as fh:
+        rows = list(csv.DictReader(fh))
+
+    order_ids = {r["order_id"] for r in rows}
+
+    # 2. Exactly 4 orders for 2026-03-02 (S-102, S-103, S-104, S-105).
+    assert order_ids == {"S-102", "S-103", "S-104", "S-105"}, (
+        f"Unexpected order set: {order_ids}"
+    )
+
+    by_id = {r["order_id"]: r for r in rows}
+
+    # 3. S-102: latest version kept (EUR 120.00 → $130.20).
+    assert by_id["S-102"]["amount"] == "120.00", "S-102 should carry the updated amount"
