+"""
+Shared fixtures for the orders_enrichment DAG test suite.
+
+Sets all Airflow env-vars before any Airflow import so the configuration is
+picked up on first import. Uses a throwaway SQLite DB per test session so
+the suite is fully self-contained and re-runnable.
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+_TMP = Path(tempfile.mkdtemp(prefix="orders-enrichment-tests-"))
+
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+
+# Make dags/ importable so tests can reach task callables directly.
+sys.path.insert(0, str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    try:
+        from airflow.dag_processing.dagbag import DagBag  # Airflow >= 3.2
+    except ImportError:
+        from airflow.models.dagbag import DagBag          # Airflow 3.0 / 3.1
+    return DagBag(dag_folder=str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrate the throwaway metadata DB.  Only dag.test() tests need this."""
+    subprocess.run(
+        [sys.executable, "-m", "airflow", "db", "migrate"],
+        check=True,
+        capture_output=True,
+    )
+
+
+@pytest.fixture(scope="session")
+def upcoming_runs():
+    """
+    upcoming_runs(dag, after, n) -> list of run_after datetimes (tz-aware).
+
+    Uses the timetable's own scheduling logic – no DB required.
+    """
+    from airflow.timetables.base import TimeRestriction
+
+    def _runs(dag, after, n):
+        tt = dag.timetable
+        try:
+            from airflow.serialization.encoders import coerce_to_core_timetable
+            tt = coerce_to_core_timetable(tt)
+        except ImportError:
+            pass
+        restriction = TimeRestriction(earliest=after, latest=None, catchup=True)
+        last, runs = None, []
+        for _ in range(n):
+            info = tt.next_dagrun_info(
+                last_automated_data_interval=last, restriction=restriction
+            )
+            if info is None:
+                break
+            runs.append(info.run_after)
+            last = info.data_interval
+        return runs
+
+    return _runs
