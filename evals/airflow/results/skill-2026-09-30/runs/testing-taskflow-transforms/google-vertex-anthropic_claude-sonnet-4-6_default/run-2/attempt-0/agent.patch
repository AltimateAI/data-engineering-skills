+    duplicate orders + multiple currencies) and assert that the output file:
+
+      1. Exists (validate_totals passed and load_enriched wrote it).
+      2. Contains exactly the 4 orders for that date (duplicates removed).
+      3. S-102 survived with the LATEST values (EUR 120.00 → $130.20).
+      4. S-103 survived with the LATEST values (GBP 40.50 → $51.44).
+      5. The discarded versions of S-102 and S-103 are NOT present.
+      6. All amount_usd values match the reference formula (ROUND_HALF_UP).
+
+    Expected output (derived from sample data, rates file, and the rounding rule):
+      S-102: EUR 120.00 × 1.0850 = 130.20
+      S-103: GBP 40.50  × 1.2700 = 51.44    (51.435 → half-up → 51.44)
+      S-104: USD  9.99  × 1      =  9.99
+      S-105: EUR  0.35  × 1.0850 =  0.38    (0.37975 → half-up → 0.38)
+    """
+    import airflow
+
+    dag = dagbag.dags[DAG_ID]
+
+    # Redirect output so we can inspect it without polluting the repo.
+    out_dir = tmp_path / "output" / "orders_enriched"
+    monkeypatch.setitem(
+        dag.get_task("load_enriched").python_callable.__globals__,
+        "OUTPUT_DIR",
+        out_dir,
+    )
+
+    # The DAG reads DATA_DIR for both orders and fx_rates (no connection needed).
+    # On Airflow 3.x dag.test() requires logical_date=.
+    logical_date = datetime(2026, 3, 2, 6, 0, tzinfo=timezone.utc)
+    dr = dag.test(logical_date=logical_date)
+
+    task_states = {ti.task_id: str(ti.state) for ti in dr.get_task_instances()}
+    assert str(dr.state) == "success", (
