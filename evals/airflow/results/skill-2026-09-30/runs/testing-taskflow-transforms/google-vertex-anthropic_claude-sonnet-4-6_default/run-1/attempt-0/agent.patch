+"""Shared fixtures for the orders_enrichment test suite.
+
+Sets all Airflow env-vars before any airflow import so every module
+picks up the throwaway config.  No running scheduler, webserver, or
+live DB required (CI: ``pytest tests/`` in the project venv).
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# Must be set before the first airflow import.
+_TMP = Path(tempfile.mkdtemp(prefix="orders-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+
+# Let test modules import helpers from dags/.
+sys.path.insert(0, str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    try:
+        from airflow.dag_processing.dagbag import DagBag  # Airflow >= 3.2
+    except ImportError:
+        from airflow.models.dagbag import DagBag           # Airflow 2.x / 3.0-3.1
+    return DagBag(dag_folder=str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrate the throwaway metadata DB (needed by dag.test() only)."""
+    subprocess.run(
+        [sys.executable, "-m", "airflow", "db", "migrate"],
+        check=True,
+        capture_output=True,
+    )
+
+
+def _upcoming_runs(dag, after: datetime, n: int):
+    """Return the next *n* run_after datetimes from the timetable."""
+    from airflow.timetables.base import TimeRestriction
+
+    tt = dag.timetable
+    try:
+        from airflow.serialization.encoders import coerce_to_core_timetable  # >= 3.0
+        tt = coerce_to_core_timetable(tt)
+    except ImportError:
+        pass
+    restriction = TimeRestriction(earliest=after, latest=None, catchup=True)
+    last, runs = None, []
+    for _ in range(n):
+        info = tt.next_dagrun_info(last_automated_data_interval=last, restriction=restriction)
+        if info is None:
+            break
+        runs.append(info.run_after)
+        last = info.data_interval
+    return runs
+
+
+@pytest.fixture(scope="session")
+def upcoming_runs():
+    return _upcoming_runs
