+class TestValidateTotals:
+    """Test validation: must have customer_id, amount_usd must be non-negative."""
+
+    def test_valid_order_passes(self):
+        """Order with customer_id and non-negative amount_usd passes."""
+        rows = [
+            {
+                "order_id": "A",
+                "customer_id": "C1",
+                "amount_usd": "100.00",
+            }
+        ]
+        result = validate_totals(rows)
