+"""Pytest suite for the orders_enrichment DAG.
+
+Tests the transform logic directly via extracted utility functions,
+and includes end-to-end tests on sample data.
+"""
+
+import csv
+from datetime import datetime
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+from airflow.models import DagBag
+
+from dags.orders_enrichment import (
+    DATA_DIR,
+    OUTPUT_DIR,
+)
+from tests.orders_enrichment_utils import (
+    dedupe_orders,
+    convert_to_usd,
+    validate_totals,
+    extract_orders_from_csv,
+    load_fx_rates_from_csv,
+    write_enriched_csv,
+)
+
+# Load the DAG from DagBag so we can access its attributes (schedule, catchup, tags, etc.)
+_dag_bag = DagBag(dag_folder="./dags")
+orders_enrichment = _dag_bag.dags["orders_enrichment"]
+
