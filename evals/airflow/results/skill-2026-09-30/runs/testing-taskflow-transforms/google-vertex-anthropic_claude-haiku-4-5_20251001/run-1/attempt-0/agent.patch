+class TestEndToEnd:
+    """End-to-end tests on sample data."""
+
+    @pytest.fixture(autouse=True)
+    def cleanup_output(self):
+        """Clean up output directory before and after each test."""
+        if OUTPUT_DIR.exists():
+            import shutil
+            shutil.rmtree(OUTPUT_DIR)
+        yield
+        if OUTPUT_DIR.exists():
+            import shutil
+            shutil.rmtree(OUTPUT_DIR)
+
+    def test_e2e_full_pipeline_on_sample_data(self):
+        """Run full transform pipeline on sample data without errors."""
+        ds = "2026-03-02"
+        orders = extract_orders_from_csv(ds)
+        assert len(orders) > 0, f"Sample data should have orders for {ds}"
+
+        rates = load_fx_rates_from_csv(ds)
+        assert rates, f"Sample data should have FX rates for {ds}"
+
+        deduped = dedupe_orders(orders)
+        assert len(deduped) <= len(orders), "Deduplication should not increase row count"
+
+        enriched = convert_to_usd(deduped, rates)
+        assert len(enriched) == len(deduped)
+        for row in enriched:
+            assert "amount_usd" in row
+            assert Decimal(row["amount_usd"]) >= 0
+
+        validated = validate_totals(enriched)
+        assert len(validated) == len(enriched)
+
+        output_path = write_enriched_csv(validated, ds)
+        assert Path(output_path).exists()
+
