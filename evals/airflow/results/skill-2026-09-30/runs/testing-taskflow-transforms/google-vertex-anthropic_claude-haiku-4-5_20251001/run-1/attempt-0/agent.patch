+            }
+        ]
+        rates = {"USD": "1"}
+        with pytest.raises(ValueError) as exc_info:
+            convert_to_usd(orders, rates)
+        assert "XYZ" in str(exc_info.value)
+
+    def test_e2e_invalid_order_fails_cleanly(self):
