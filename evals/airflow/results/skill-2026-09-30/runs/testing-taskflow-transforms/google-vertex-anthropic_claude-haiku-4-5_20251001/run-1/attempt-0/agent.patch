+
+    def test_missing_customer_id_fails(self):
+        """Order with no customer_id fails."""
+        rows = [
+            {
+                "order_id": "A",
+                "customer_id": "",
+                "amount_usd": "100.00",
+            }
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            validate_totals(rows)
+        assert "invalid orders" in str(exc_info.value)
+        assert "A" in str(exc_info.value)
+
+    def test_null_customer_id_fails(self):
+        """Order with None customer_id fails."""
+        rows = [
+            {
+                "order_id": "A",
+                "customer_id": None,
+                "amount_usd": "100.00",
+            }
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            validate_totals(rows)
+        assert "A" in str(exc_info.value)
+
+    def test_negative_amount_usd_fails(self):
+        """Order with negative amount_usd fails."""
+        rows = [
+            {
+                "order_id": "A",
+                "customer_id": "C1",
+                "amount_usd": "-10.00",
+            }
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            validate_totals(rows)
+        assert "A" in str(exc_info.value)
+
+    def test_zero_amount_usd_passes(self):
+        """Zero amount_usd is allowed."""
+        rows = [
+            {
+                "order_id": "A",
+                "customer_id": "C1",
+                "amount_usd": "0.00",
+            }
+        ]
+        result = validate_totals(rows)
+        assert len(result) == 1
+
+    def test_multiple_bad_orders_reported(self):
+        """Multiple invalid orders are all reported."""
+        rows = [
+            {"order_id": "A", "customer_id": "", "amount_usd": "100.00"},
+            {"order_id": "B", "customer_id": "C1", "amount_usd": "-5.00"},
+            {"order_id": "C", "customer_id": "C2", "amount_usd": "50.00"},
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            validate_totals(rows)
+        error_msg = str(exc_info.value)
+        assert "A" in error_msg
+        assert "B" in error_msg
+        assert "C" not in error_msg  # C is valid
+
+    def test_empty_input_passes(self):
+        """Empty input passes."""
+        result = validate_totals([])
+        assert result == []
