+class TestConvertToUsd:
+    """Test USD conversion: amount * usd_per_unit, rounded half-up to cents."""
+
+    def test_simple_conversion(self):
+        """Basic USD conversion with clean rates."""
+        rows = [{"order_id": "A", "amount": "100", "currency": "EUR"}]
+        rates = {"EUR": "1.10"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "110.00"
+
+    def test_usd_passthrough(self):
+        """USD currency stays at 1:1."""
+        rows = [{"order_id": "A", "amount": "50.00", "currency": "USD"}]
+        rates = {"USD": "1"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "50.00"
+
+    def test_rounding_half_up_rounds_up(self):
+        """0.5 cents rounds up."""
+        rows = [{"order_id": "A", "amount": "10", "currency": "EUR"}]
+        rates = {"EUR": "1.015"}  # 10 * 1.015 = 10.15, exact
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "10.15"
+
+    def test_rounding_half_up_one_third(self):
+        """1/3 rounds down to nearest cent."""
+        rows = [{"order_id": "A", "amount": "1", "currency": "GBP"}]
+        rates = {"GBP": "1.333333"}  # 1.333333 -> rounds to 1.33
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "1.33"
+
+    def test_rounding_half_up_two_thirds(self):
+        """2/3 rounds up to nearest cent."""
+        rows = [{"order_id": "A", "amount": "1", "currency": "GBP"}]
+        rates = {"GBP": "1.666667"}  # 1.666667 -> rounds to 1.67
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "1.67"
+
+    def test_missing_fx_rate_raises_error(self):
+        """Order in currency with no FX rate raises ValueError."""
+        rows = [{"order_id": "A", "amount": "100", "currency": "JPY"}]
+        rates = {"USD": "1"}
+        with pytest.raises(ValueError) as exc_info:
+            convert_to_usd(rows, rates)
+        assert "no FX rate for JPY" in str(exc_info.value)
+        assert "order A" in str(exc_info.value)
+
+    def test_multiple_currencies_first_missing_rate_fails(self):
+        """If any order has missing rate, the whole batch fails."""
+        rows = [
+            {"order_id": "A", "amount": "100", "currency": "EUR"},
+            {"order_id": "B", "amount": "100", "currency": "JPY"},
+        ]
+        rates = {"EUR": "1.10"}
+        with pytest.raises(ValueError) as exc_info:
+            convert_to_usd(rows, rates)
+        assert "JPY" in str(exc_info.value)
+
+    def test_multiple_currencies_all_with_rates(self):
+        """Multiple currencies, all have rates."""
+        rows = [
+            {"order_id": "A", "amount": "100", "currency": "EUR"},
+            {"order_id": "B", "amount": "100", "currency": "GBP"},
+        ]
+        rates = {"EUR": "1.10", "GBP": "1.25"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "110.00"
+        assert result[1]["amount_usd"] == "125.00"
+
+    def test_zero_amount(self):
+        """Zero amount converts to zero."""
+        rows = [{"order_id": "A", "amount": "0", "currency": "USD"}]
+        rates = {"USD": "1"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "0.00"
+
+    def test_preserves_other_fields(self):
+        """Conversion preserves all original fields plus adds amount_usd."""
+        rows = [
+            {
+                "order_id": "A",
+                "customer_id": "C1",
+                "amount": "100",
+                "currency": "EUR",
+                "order_date": "2026-01-01",
+            }
+        ]
+        rates = {"EUR": "1.10"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["order_id"] == "A"
+        assert result[0]["customer_id"] == "C1"
+        assert result[0]["order_date"] == "2026-01-01"
+        assert result[0]["amount_usd"] == "110.00"
+
