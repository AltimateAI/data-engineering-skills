+class TestDedupeOrders:
+    """Test deduplication logic: keep only latest version by updated_at."""
+
+    def test_no_duplicates(self):
+        """Single version of each order is unchanged."""
+        rows = [
+            {"order_id": "A", "customer_id": "C1", "updated_at": "2026-01-01T10:00:00"},
+            {"order_id": "B", "customer_id": "C2", "updated_at": "2026-01-01T11:00:00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 2
+        assert result[0]["order_id"] == "A"
+        assert result[1]["order_id"] == "B"
+
+    def test_duplicates_keep_latest(self):
+        """When an order_id appears twice, keep the one with later updated_at."""
+        rows = [
+            {"order_id": "A", "customer_id": "C1", "updated_at": "2026-01-01T10:00:00"},
+            {"order_id": "A", "customer_id": "C1", "updated_at": "2026-01-01T11:00:00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["updated_at"] == "2026-01-01T11:00:00"
+
+    def test_duplicates_sorted_by_order_id(self):
+        """Result is sorted by order_id."""
+        rows = [
+            {"order_id": "C", "customer_id": "C1", "updated_at": "2026-01-01T10:00:00"},
+            {"order_id": "A", "customer_id": "C1", "updated_at": "2026-01-01T10:00:00"},
+            {"order_id": "B", "customer_id": "C1", "updated_at": "2026-01-01T10:00:00"},
+        ]
+        result = dedupe_orders(rows)
+        assert [r["order_id"] for r in result] == ["A", "B", "C"]
+
+    def test_multiple_duplicates_each_keeps_latest(self):
+        """Multiple order_ids with multiple versions each."""
+        rows = [
+            {"order_id": "A", "updated_at": "2026-01-01T10:00:00"},
+            {"order_id": "A", "updated_at": "2026-01-01T12:00:00"},
+            {"order_id": "B", "updated_at": "2026-01-01T11:00:00"},
+            {"order_id": "B", "updated_at": "2026-01-01T09:00:00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 2
+        assert result[0]["order_id"] == "A"
+        assert result[0]["updated_at"] == "2026-01-01T12:00:00"
+        assert result[1]["order_id"] == "B"
+        assert result[1]["updated_at"] == "2026-01-01T11:00:00"
+
+    def test_empty_input(self):
+        """Empty input returns empty output."""
+        result = dedupe_orders([])
+        assert result == []
+
