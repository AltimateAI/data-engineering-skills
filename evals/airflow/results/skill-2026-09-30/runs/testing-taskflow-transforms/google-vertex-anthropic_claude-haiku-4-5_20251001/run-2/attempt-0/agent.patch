+"""
+Test suite for orders_enrichment DAG.
+
+Tests the finance-critical rules:
+- Only latest version of each order (by updated_at) is kept
+- amount_usd = amount * usd_per_unit, rounded half-up to cents
+- Orders with no FX rate for the day fail the run (not guessed)
+- Output is only written if validate_totals passes
+- DAG runs daily at 06:00 UTC
+- End-to-end validation on sample data
+"""
+
+import csv
+import json
+import shutil
+from datetime import datetime, timezone
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+
+class TestDagStructure:
+    """DAG metadata and scheduling."""
+
+    def test_dagbag_imports_cleanly(self, dagbag):
+        """Every file in dags/ must import without errors."""
+        assert dagbag.import_errors == {}, f"import errors: {dagbag.import_errors}"
+
+    def test_orders_enrichment_exists(self, dagbag):
+        """The orders_enrichment DAG must be defined."""
+        assert "orders_enrichment" in dagbag.dags
+
+    def test_schedule_is_daily_0600_utc(self, dagbab, upcoming_runs):
+        """DAG must run daily at 06:00 UTC."""
+        dag = dagbag.dags["orders_enrichment"]
+        runs = upcoming_runs(dag, datetime(2026, 3, 1, tzinfo=timezone.utc), 10)
+        
+        # All 10 runs should be on consecutive days at 06:00
+        assert len(runs) == 10
+        assert all(r.hour == 6 and r.minute == 0 and r.second == 0 for r in runs)
+        
+        # Check spacing is exactly 24 hours
+        for i in range(len(runs) - 1):
+            delta = runs[i + 1] - runs[i]
+            assert delta.total_seconds() == 86400  # 24 hours
+
+    def test_catchup_is_false(self, dagbag):
+        """catchup=False: no historical backfill on deployment."""
+        dag = dagbag.dags["orders_enrichment"]
+        assert dag.catchup is False
+
+    def test_max_active_runs_is_one(self, dagbag):
+        """max_active_runs=1: prevent concurrent runs (needed for daily file output)."""
+        dag = dagbag.dags["orders_enrichment"]
+        assert dag.max_active_runs == 1
+
+    def test_all_tasks_present(self, dagbag):
+        """All expected tasks must be defined."""
+        dag = dagbag.dags["orders_enrichment"]
+        task_ids = set(dag.task_ids)
+        expected = {"extract_orders", "load_fx_rates", "dedupe_orders", "convert_to_usd", 
+                    "validate_totals", "load_enriched"}
+        assert task_ids == expected, f"expected {expected}, got {task_ids}"
+
+    def test_task_dependencies(self, dagbag):
+        """Task execution order: extract → dedupe → convert → validate → load."""
+        dag = dagbag.dags["orders_enrichment"]
+        
+        extract = dag.get_task("extract_orders")
+        dedupe = dag.get_task("dedupe_orders")
+        load_fx = dag.get_task("load_fx_rates")
+        convert = dag.get_task("convert_to_usd")
+        validate = dag.get_task("validate_totals")
+        load = dag.get_task("load_enriched")
+        
+        # dedupe depends on extract
+        assert extract in dedupe.upstream_list
+        
+        # convert depends on dedupe and load_fx_rates
+        assert dedupe in convert.upstream_list
+        assert load_fx in convert.upstream_list
+        
+        # validate depends on convert
+        assert convert in validate.upstream_list
+        
+        # load depends on validate
+        assert validate in load.upstream_list
+
