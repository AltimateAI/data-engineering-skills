+
+    def test_dag_task_dependencies(self, dagbag):
+        """Task execution order is correct."""
+        dag = dagbag.dags["orders_enrichment"]
+
+        extract = dag.get_task("extract_orders")
+        load_fx = dag.get_task("load_fx_rates")
+        dedupe = dag.get_task("dedupe_orders")
+        convert = dag.get_task("convert_to_usd")
+        validate = dag.get_task("validate_totals")
+        load = dag.get_task("load_enriched")
+
+        # dedupe depends on extract
+        assert extract.task_id in dedupe.upstream_task_ids
+
+        # convert depends on dedupe and load_fx
+        assert dedupe.task_id in convert.upstream_task_ids
+        assert load_fx.task_id in convert.upstream_task_ids
+
+        # validate depends on convert
+        assert convert.task_id in validate.upstream_task_ids
+
+        # load depends on validate
+        assert validate.task_id in load.upstream_task_ids
+
