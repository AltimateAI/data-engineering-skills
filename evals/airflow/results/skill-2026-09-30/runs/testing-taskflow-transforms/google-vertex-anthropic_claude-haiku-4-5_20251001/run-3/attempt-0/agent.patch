+
+    def test_convert_preserves_other_fields(self):
+        """Conversion adds amount_usd without removing other fields."""
+        rows = [
+            {
+                "order_id": "S-102",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T11:47:00",
+                "customer_id": "C-7",
+                "currency": "EUR",
+                "amount": "120.00",
+            }
+        ]
+        rates = {"USD": "1", "EUR": "1.0850"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["order_id"] == "S-102"
+        assert result[0]["customer_id"] == "C-7"
+        assert result[0]["currency"] == "EUR"
+        assert result[0]["amount"] == "120.00"
+        assert "amount_usd" in result[0]
+
+    def test_convert_missing_fx_rate_raises_error(self):
+        """Missing FX rate for a currency raises ValueError."""
+        rows = [
+            {
+                "order_id": "S-101",
+                "order_date": "2026-03-01",
