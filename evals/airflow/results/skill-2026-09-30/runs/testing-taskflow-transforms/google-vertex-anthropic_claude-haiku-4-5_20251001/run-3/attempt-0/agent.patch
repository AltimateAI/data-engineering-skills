+    def test_e2e_2026_03_02(self, airflow_db, tmp_path, monkeypatch):
+        """Full run on 2026-03-02 with sample data."""
+        from dags.orders_enrichment import (
+            extract_orders,
+            load_fx_rates,
+            dedupe_orders,
+            convert_to_usd,
+            validate_totals,
+            load_enriched,
+        )
+
+        # Patch OUTPUT_DIR to temp directory
+        import dags.orders_enrichment as module
+        monkeypatch.setattr(module, "OUTPUT_DIR", tmp_path)
+
+        ds = "2026-03-02"
+
+        # Run the pipeline
+        orders = extract_orders(ds=ds)
+        fx_rates = load_fx_rates(ds=ds)
+        deduped = dedupe_orders(orders)
+        converted = convert_to_usd(deduped, fx_rates)
+        validated = validate_totals(converted)
+        output_path = load_enriched(validated, ds=ds)
+
+        # Verify output file exists
+        assert Path(output_path).exists()
+
+        # Verify output contains expected rows
+        with open(output_path) as fh:
+            lines = [line.strip() for line in fh.readlines()]
+
+        header = lines[0]
+        assert header == "order_id,customer_id,currency,amount,amount_usd"
+
+        # Parse CSV
+        rows = {}
+        for line in lines[1:]:
+            parts = line.split(",")
+            order_id = parts[0]
+            rows[order_id] = {
+                "order_id": parts[0],
+                "customer_id": parts[1],
+                "currency": parts[2],
+                "amount": parts[3],
+                "amount_usd": parts[4],
+            }
+
+        # Verify expected orders are present
+        assert "S-102" in rows
+        assert "S-103" in rows
+        assert "S-104" in rows
+        assert "S-105" in rows
+        assert len(rows) == 4
+
+        # S-102: 120.00 EUR * 1.0850 = 130.20
+        assert rows["S-102"]["amount_usd"] == "130.20"
+
+        # S-103: 40.50 GBP * 1.2700 = 51.435 -> 51.44 (ROUND_HALF_UP)
+        assert rows["S-103"]["amount_usd"] == "51.44"
+
+        # S-104: 9.99 USD * 1 = 9.99
+        assert rows["S-104"]["amount_usd"] == "9.99"
+
+        # S-105: 0.35 EUR * 1.0850 = 0.37975 -> 0.38 (ROUND_HALF_UP)
+        assert rows["S-105"]["amount_usd"] == "0.38"
