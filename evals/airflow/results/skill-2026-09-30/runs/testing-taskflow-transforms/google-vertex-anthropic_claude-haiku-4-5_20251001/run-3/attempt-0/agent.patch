+"""Tests for the orders_enrichment DAG.
+
+Validates:
+1. DAG structure and schedule (06:00 UTC daily)
+2. extract_orders: filters by order_date = ds
+3. dedupe_orders: keeps latest version by updated_at, sorted by order_id
+4. convert_to_usd: multiplies by FX rate, rounds half-up to cents
+5. Missing FX rate raises ValueError
+6. validate_totals: rejects orders with missing customer_id or negative amount_usd
+7. Output written only after validate_totals passes
+8. End-to-end on sample data (2026-03-02)
+"""
+from datetime import datetime, timezone
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+# Import the pure functions for unit testing (not the decorated @task versions)
+from dags.orders_enrichment_functions import (
+    convert_to_usd,
+    dedupe_orders,
+    extract_orders,
+    load_enriched,
+    load_fx_rates,
+    validate_totals,
+)
+
+
+class TestExtractOrders:
+    """Test extract_orders task."""
+
+    def test_extract_single_day(self):
+        """Extract only rows matching the run date."""
+        rows = extract_orders(ds="2026-03-02")
+        order_ids = [r["order_id"] for r in rows]
+        # S-102 and S-103 appear twice on 2026-03-02, S-104 and S-105 once each = 6 rows total
+        assert sorted(order_ids) == ["S-102", "S-102", "S-103", "S-103", "S-104", "S-105"]
+
+    def test_extract_different_day(self):
+        """Extract rows from a different date."""
+        rows = extract_orders(ds="2026-03-01")
+        assert len(rows) == 2
+        assert all(r["order_date"] == "2026-03-01" for r in rows)
+
+    def test_extract_no_rows(self):
+        """Return empty list for a date with no orders."""
+        rows = extract_orders(ds="2026-02-01")
+        assert rows == []
+
+    def test_extract_preserves_duplicates(self):
+        """Order can appear multiple times (before deduplication)."""
+        # S-102 appears twice on 2026-03-02
+        rows = extract_orders(ds="2026-03-02")
+        order_ids = [r["order_id"] for r in rows]
+        assert order_ids.count("S-102") == 1  # One row per date (both S-102 rows are on 03-02)
+        # Actually, looking at data: S-102 appears once on 03-02 with updated_at 08:05 and once with 11:47
+        # extract_orders filters by order_date, so both versions appear
+        rows_s102 = [r for r in rows if r["order_id"] == "S-102"]
+        assert len(rows_s102) == 2
+
+
+class TestDedupeOrders:
+    """Test dedupe_orders task."""
+
+    def test_dedupe_keeps_latest_by_updated_at(self):
+        """Keep the row with the highest updated_at timestamp."""
+        rows = [
+            {
+                "order_id": "S-102",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T08:05:00",
+                "customer_id": "C-7",
+                "currency": "EUR",
+                "amount": "100.00",
+            },
+            {
+                "order_id": "S-102",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T11:47:00",
+                "customer_id": "C-7",
+                "currency": "EUR",
+                "amount": "120.00",
+            },
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "120.00"
+        assert result[0]["updated_at"] == "2026-03-02T11:47:00"
+
+    def test_dedupe_older_version_discarded(self):
+        """Discard older versions even if they appear later in the list."""
+        rows = [
+            {
+                "order_id": "S-103",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T07:55:00",
+                "customer_id": "C-9",
+                "currency": "GBP",
+                "amount": "38.00",
+            },
+            {
+                "order_id": "S-103",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T08:30:00",
+                "customer_id": "C-9",
+                "currency": "GBP",
+                "amount": "40.50",
+            },
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "40.50"
+
+    def test_dedupe_returns_sorted_by_order_id(self):
+        """Result is sorted by order_id."""
+        rows = [
+            {
+                "order_id": "S-105",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T13:20:00",
+                "customer_id": "C-8",
+                "currency": "EUR",
+                "amount": "0.35",
+            },
+            {
+                "order_id": "S-102",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T11:47:00",
+                "customer_id": "C-7",
+                "currency": "EUR",
+                "amount": "120.00",
+            },
+        ]
+        result = dedupe_orders(rows)
+        assert [r["order_id"] for r in result] == ["S-102", "S-105"]
+
+    def test_dedupe_single_order(self):
+        """Single order with no duplicates passes through."""
+        rows = [
+            {
+                "order_id": "S-100",
+                "order_date": "2026-03-01",
+                "updated_at": "2026-03-01T09:12:00",
+                "customer_id": "C-7",
+                "currency": "USD",
+                "amount": "15.00",
+            }
+        ]
+        result = dedupe_orders(rows)
+        assert result == rows
+
