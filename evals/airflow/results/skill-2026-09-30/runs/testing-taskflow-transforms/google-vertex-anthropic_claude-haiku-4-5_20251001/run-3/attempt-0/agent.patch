+class TestConvertToUsd:
+    """Test convert_to_usd task."""
+
+    def test_convert_usd_no_change(self):
+        """USD amounts remain unchanged (rate = 1)."""
+        rows = [
+            {
+                "order_id": "S-100",
+                "order_date": "2026-03-01",
+                "updated_at": "2026-03-01T09:12:00",
+                "customer_id": "C-7",
+                "currency": "USD",
+                "amount": "15.00",
+            }
+        ]
+        rates = {"USD": "1"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "15.00"
+
+    def test_convert_eur_to_usd(self):
+        """EUR amounts converted at the given rate."""
+        rows = [
+            {
+                "order_id": "S-101",
+                "order_date": "2026-03-01",
+                "updated_at": "2026-03-01T10:40:00",
+                "customer_id": "C-8",
+                "currency": "EUR",
+                "amount": "20.00",
+            }
+        ]
+        rates = {"USD": "1", "EUR": "1.0812"}
+        result = convert_to_usd(rows, rates)
+        # 20.00 * 1.0812 = 21.624, rounded half-up to cents = 21.62
+        assert result[0]["amount_usd"] == "21.62"
+
+    def test_convert_rounding_half_up_down(self):
+        """Test rounding down: 0.625 -> 0.62 (ROUND_HALF_UP)."""
+        rows = [
+            {
+                "order_id": "S-test-1",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T12:00:00",
+                "customer_id": "C-test",
+                "currency": "EUR",
+                "amount": "0.576",
+            }
+        ]
+        rates = {"USD": "1", "EUR": "1.0833"}
+        result = convert_to_usd(rows, rates)
+        # 0.576 * 1.0833 = 0.623901, rounds down to 0.62
+        assert result[0]["amount_usd"] == "0.62"
+
+    def test_convert_rounding_half_up_up(self):
+        """Test rounding up: 0.625 -> 0.63 (ROUND_HALF_UP at the midpoint)."""
+        rows = [
+            {
+                "order_id": "S-test-2",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T12:00:00",
+                "customer_id": "C-test",
+                "currency": "GBP",
+                "amount": "0.495",
+            }
+        ]
+        rates = {"USD": "1", "GBP": "1.27"}
+        result = convert_to_usd(rows, rates)
+        # 0.495 * 1.27 = 0.62865, rounds to 0.63
