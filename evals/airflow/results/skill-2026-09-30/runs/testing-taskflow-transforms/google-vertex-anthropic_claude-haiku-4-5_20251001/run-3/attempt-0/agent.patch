+        """DAG runs daily at 06:00 UTC."""
+        dag = dagbag.dags["orders_enrichment"]
+        runs = upcoming_runs(dag, datetime(2026, 3, 1, tzinfo=timezone.utc), 10)
+
+        assert len(runs) == 10
+        # All runs should be at 06:00 UTC
+        for run in runs:
+            assert run.hour == 6
+            assert run.minute == 0
+            assert run.second == 0
+            # Pendulum Timezone('UTC') is equivalent to timezone.utc
+            assert str(run.tzinfo) == "UTC"
+
+    def test_dag_daily_schedule(self, dagbag, upcoming_runs):
+        """DAG runs every day (no gaps)."""
+        dag = dagbag.dags["orders_enrichment"]
+        runs = upcoming_runs(dag, datetime(2026, 3, 1, tzinfo=timezone.utc), 10)
+
+        # Check that runs are exactly one day apart
+        for i in range(len(runs) - 1):
+            delta = (runs[i + 1] - runs[i]).total_seconds()
+            assert delta == 86400  # 24 hours
+
