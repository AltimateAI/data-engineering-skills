+def _feed_day(context: dict) -> str:
+    """Return the calendar date (UTC, YYYY-MM-DD) this run should produce a feed for.
+
+    Decision rules (in priority order):
+    1. Scheduled / backfill run with an interval timetable: use data_interval_start.
+       Under CronDataIntervalTimetable the interval start is the logical_date, which
+       is the period that *just ended* — identical to 2.x behaviour.
+    2. Manual trigger with an explicit logical date: use logical_date (dag_run carries
+       the date the operator selected, which stays fixed even if the run is cleared
+       and re-run later).
+    3. Manual trigger with NO logical date (logical_date is None on Airflow 3.x):
+       use dag_run.run_after — the UTC timestamp of when the trigger button was
+       pressed.  run_after is immutable, so clearing and re-running tomorrow still
+       produces today's feed.
+
+    dag_run.* datetimes are stdlib datetime objects; wrap with pendulum.instance()
+    before calling pendulum methods.
+    """
+    dag_run = context["dag_run"]
+
+    # Case 1 & 2: logical_date is set (scheduled runs and manual runs with a date).
+    logical_date = context.get("logical_date")
+    if logical_date is not None:
+        return pendulum.instance(logical_date).in_tz("UTC").strftime("%Y-%m-%d")
+
+    # Case 3: manual trigger with no logical date — fall back to run_after (UTC).
+    return pendulum.instance(dag_run.run_after).in_tz("UTC").strftime("%Y-%m-%d")
+
+
 @dag(
-    schedule="0 4 * * *",
-    start_date=datetime(2026, 1, 1),
+    # CronDataIntervalTimetable preserves Airflow 2.x interval semantics:
+    # the run that fires at 04:00 on day D has logical_date = D-1 04:00
+    # and data_interval_start = D-1 04:00 -> data_interval_end = D 04:00.
+    # ds / logical_date therefore refer to D-1, matching the previous behaviour.
+    schedule=CronDataIntervalTimetable("0 4 * * *", timezone="UTC"),
+    start_date=pendulum.datetime(2026, 1, 1, tz="UTC"),
     catchup=False,
     tags=["partner", "acme"],
+    # Expose a 'day' param so operators can reprocess a specific date without
+    # creating a duplicate logical_date in the metadata DB.
+    params={},
 )
 def partner_feed():
     @task
     def extract_orders(**context) -> str:
-        day = context["logical_date"].strftime("%Y-%m-%d")
+        day = _feed_day(context)
