     deliver = BashOperator(
         task_id="deliver",
         bash_command=(
             "mkdir -p {{ params.outbox }}"
             " && cp {{ ti.xcom_pull(task_ids='extract_orders') }}"
-            " {{ params.outbox }}/acme_orders_{{ ds_nodash }}.csv"
+            " {{ params.outbox }}/acme_orders_{{ ti.xcom_pull(task_ids='get_day') | replace('-', '') }}.csv"
             " && cp {{ ti.xcom_pull(task_ids='write_manifest') }}"
-            " {{ params.outbox }}/acme_orders_{{ ds_nodash }}.manifest.json"
+            " {{ params.outbox }}/acme_orders_{{ ti.xcom_pull(task_ids='get_day') | replace('-', '') }}.manifest.json"
