@@ -21,16 +21,37 @@ OUTBOX = PROJECT_ROOT / "outbox" / "acme"
 FEED_COLUMNS = ["order_id", "sku", "qty", "amount"]
 
 
+def _feed_date(context: dict) -> str:
+    """Return the YYYY-MM-DD string for the day this run should produce a feed for.
+
+    Priority:
+    1. Scheduled run (interval timetable): use data_interval_start — the start of the
+       period this run covers.  This reproduces the Airflow 2.x ds / execution_date
+       value and is stable across retries and reruns.
+    2. Manual trigger (no data interval): use dag_run.run_after, the wall-clock time
+       of the trigger, so reruns the next day still produce the *original* day's feed.
+    """
+    dag_run = context["dag_run"]
+    start = dag_run.data_interval_start
+    end = dag_run.data_interval_end
+    if start is not None and end is not None and end > start:
+        # Interval timetable (scheduled): the run covers [start, end).
+        return pendulum.instance(start).in_tz("UTC").strftime("%Y-%m-%d")
+    # Manual trigger or trigger timetable: anchor on the trigger time.
+    anchor = dag_run.logical_date or dag_run.run_after
+    return pendulum.instance(anchor).in_tz("UTC").strftime("%Y-%m-%d")
+
