+def _feed_day(context: dict) -> str:
+    """Return the feed date as YYYY-MM-DD.
+
+    - Scheduled / backfill runs have a data interval; use data_interval_start
+      (same as the legacy ``ds`` under a CronDataIntervalTimetable).
+    - Manual triggers without a logical date have no interval; fall back to
+      dag_run.run_after (UTC), which is set at trigger time and never changes
+      on re-runs, so clearing and re-running tomorrow still produces the same
+      date's feed.
+    """
+    start = context.get("data_interval_start")
+    if start is not None:
+        return pendulum.instance(start).in_tz("UTC").strftime("%Y-%m-%d")
+    # Manual trigger with no logical date — use the trigger wall-clock time.
+    run_after = context["dag_run"].run_after
+    return pendulum.instance(run_after).in_tz("UTC").strftime("%Y-%m-%d")
+
