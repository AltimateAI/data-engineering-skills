+def _day_from_context(context) -> str:
+    """Return the ISO date string for the day this run should process.
+
+    Under an interval timetable (the default on Airflow 2.x for cron/preset
+    schedules) data_interval_start is the start of the period being loaded.
+    This value is set once when the run is created and never changes on
+    retry or clear, making it safe to use as the idempotency key.
+    """
+    dag_run = context["dag_run"]
+    start = dag_run.data_interval_start
+    if start is None:
+        # Fallback for manually-triggered runs that carry no interval:
+        # use the logical date (which on 2.x manual runs is always set).
+        start = dag_run.logical_date
+    # dag_run attributes are stdlib datetime; wrap with pendulum for safety.
+    return pendulum.instance(start).in_tz("UTC").to_date_string()
+
