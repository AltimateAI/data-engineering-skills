+def _prev_day(d):
+    return d.subtract(days=1)
+
+
+def run_window(dag_run, params=None, tz="UTC", prev=_prev_day):
+    """Return the [start, end) window this run processes, as pendulum datetimes.
+
+    • Interval timetable (Airflow 2.x @daily / CronDataIntervalTimetable):
+      uses data_interval_start / data_interval_end directly — the run IS the
+      period, so a scheduled run for 2026-03-02 returns (2026-03-02 00:00,
+      2026-03-03 00:00) regardless of when the worker executes.
+    • Trigger timetable / manual run: falls back to prev(anchor day).
+    • params override: if params["day"] is set (e.g. "2026-03-04"), process
+      that calendar day — useful for ad-hoc reprocessing without a backfill.
+    """
+    day = (params or {}).get("day")
+    if day:
+        start = pendulum.parse(day, tz=tz)
+        return start, start.add(days=1)
+
+    s, e = dag_run.data_interval_start, dag_run.data_interval_end
+    if s is not None and e is not None and e > s:
+        # Interval timetable — the run owns this window; use it directly.
+        return pendulum.instance(s).in_tz(tz), pendulum.instance(e).in_tz(tz)
+
+    # Trigger timetable or manual run: derive the period from the anchor.
+    anchor = dag_run.logical_date or dag_run.run_after
+    start = prev(pendulum.instance(anchor).in_tz(tz).start_of("day"))
+    return start, start.add(days=1)
+
