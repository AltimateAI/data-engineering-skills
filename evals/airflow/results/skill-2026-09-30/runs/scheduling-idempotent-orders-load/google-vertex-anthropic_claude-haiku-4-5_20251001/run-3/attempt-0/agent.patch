+def get_target_date() -> str:
+    """
+    Derive the target date from the run's scheduled interval.
+    
+    On Airflow 2.x with a @daily schedule (interval timetable):
+    - scheduled run: execution_date is the start of the interval (previous day for @daily)
+    - rerun/clear: recomputes the same day as the original run
+    - backfill: each run processes its own interval like a scheduled run
+    
+    Returns: ISO date string (YYYY-MM-DD)
+    """
+    context = get_current_context()
+    dag_run = context["dag_run"]
+    
+    # On 2.x, execution_date is the start of the interval (previous day for @daily)
+    # This is the same for scheduled runs, reruns, clears, and backfills
+    execution_date = dag_run.execution_date
+    # Convert to UTC and extract the date
+    target_date = pendulum.instance(execution_date).in_tz("UTC").date()
+    return target_date.isoformat()
+
