+"""Unit tests for DuckDBWarehouseHook and CsvPartitionToDuckDBOperator.
+
+Tests run against real temporary DuckDB files, not mocked. Connections are
+supplied via AIRFLOW_CONN_* environment variables.
+
+Contract being tested:
+  1. Hook reads DuckDB file path from connection.host and target schema from connection.schema
+  2. Operator loads only rows matching the partition_date
+  3. Operator returns the row count loaded
+  4. Re-running the same partition replaces old rows (no duplicates)
+  5. Other partitions are unaffected by a re-run
+"""
+
+import csv
+import json
+import tempfile
+from pathlib import Path
+
+import duckdb
+import pytest
+
+
+@pytest.fixture
+def duckdb_conn_env(tmp_path, monkeypatch):
+    """Set up a DuckDB connection via AIRFLOW_CONN_TEST_WAREHOUSE env var.
+    
+    Returns the temp database file path so tests can inspect it.
+    """
+    db_file = tmp_path / "test_warehouse.duckdb"
+    monkeypatch.setenv(
+        "AIRFLOW_CONN_TEST_WAREHOUSE",
+        json.dumps({
+            "conn_type": "duckdb",
+            "host": str(db_file),
+            "schema": "raw",
+            "extra": {},
+        }),
+    )
+    return db_file
+
+
+@pytest.fixture
+def csv_with_multiple_dates(tmp_path):
+    """Create a test CSV file with rows for multiple dates.
+    
+    Used to test partition loading and idempotency.
+    """
+    csv_file = tmp_path / "test_data.csv"
+    rows = [
+        ["order_id", "order_date", "customer_id", "amount"],
+        ["O-1001", "2026-03-01", "C-10", "100.00"],
+        ["O-1002", "2026-03-01", "C-11", "50.00"],
+        ["O-1003", "2026-03-02", "C-12", "75.00"],
+        ["O-1004", "2026-03-02", "C-13", "120.00"],
+        ["O-1005", "2026-03-03", "C-10", "40.00"],
+    ]
+    with open(csv_file, "w", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerows(rows)
+    return csv_file
+
+
+@pytest.fixture
+def csv_duplicate_date(tmp_path):
+    """Create a CSV with rows for a single date, for re-run idempotency test."""
+    csv_file = tmp_path / "duplicate_check.csv"
+    rows = [
+        ["order_id", "order_date", "customer_id", "amount"],
+        ["O-2001", "2026-03-02", "C-20", "200.00"],
+        ["O-2002", "2026-03-02", "C-21", "150.00"],
+    ]
+    with open(csv_file, "w", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerows(rows)
+    return csv_file
+
+
+def _read_rows_from_table(db_file, schema, table):
+    """Helper: read all rows from a table, return as list of dicts."""
+    con = duckdb.connect(str(db_file), read_only=True)
+    try:
+        rel = con.execute(f'SELECT * FROM "{schema}"."{table}"')
+        columns = [desc[0] for desc in rel.description]
+        result = rel.fetchall()
+        return [dict(zip(columns, row)) for row in result]
+    finally:
+        con.close()
+
+
+def _row_count_for_date(db_file, schema, table, date_col, date_val):
+    """Helper: count rows in table matching a specific date."""
+    con = duckdb.connect(str(db_file), read_only=True)
+    try:
+        count = con.execute(
+            f'SELECT count(*) FROM "{schema}"."{table}" WHERE "{date_col}" = ?',
+            [date_val],
+        ).fetchone()[0]
+        return count
+    finally:
+        con.close()
+
+
+class TestDuckDBWarehouseHook:
+    """Tests for DuckDBWarehouseHook."""
+
+    def test_hook_reads_database_path_from_connection_host(self, duckdb_conn_env):
+        """Hook.database_path returns the path from connection.host."""
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        assert hook.database_path == str(duckdb_conn_env)
+
+    def test_hook_reads_schema_from_connection(self, duckdb_conn_env, monkeypatch):
+        """Hook.target_schema returns connection.schema."""
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        assert hook.target_schema == "raw"
+
+    def test_hook_defaults_schema_to_main_when_not_set(self, tmp_path, monkeypatch):
+        """Hook.target_schema defaults to 'main' when connection.schema is not set."""
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        db_file = tmp_path / "test.duckdb"
+        monkeypatch.setenv(
+            "AIRFLOW_CONN_TEST_WAREHOUSE",
+            json.dumps({
+                "conn_type": "duckdb",
+                "host": str(db_file),
+                # no schema field
+            }),
+        )
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        assert hook.target_schema == "main"
+
+    def test_hook_raises_when_host_is_missing(self, monkeypatch):
+        """Hook.database_path raises ValueError when connection.host is empty."""
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        monkeypatch.setenv(
+            "AIRFLOW_CONN_TEST_WAREHOUSE",
+            json.dumps({
+                "conn_type": "duckdb",
+                "host": "",  # empty
+                "schema": "raw",
+            }),
+        )
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        with pytest.raises(ValueError, match="has no host"):
+            _ = hook.database_path
+
+    def test_hook_respects_read_only_extra(self, duckdb_conn_env, monkeypatch):
+        """Hook.get_conn() respects the read_only setting in connection.extra."""
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        monkeypatch.setenv(
+            "AIRFLOW_CONN_TEST_WAREHOUSE",
+            json.dumps({
+                "conn_type": "duckdb",
+                "host": str(duckdb_conn_env),
+                "schema": "raw",
+                "extra": {"read_only": True},
+            }),
+        )
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        # Create the database file first so read-only mode can open it
+        con_write = duckdb.connect(str(duckdb_conn_env))
+        con_write.close()
+
+        con_read = hook.get_conn()
+        try:
+            # read-only connection should not allow writes
+            with pytest.raises(Exception):  # DuckDB raises on write attempt
+                con_read.execute("CREATE TABLE test (id INTEGER)")
+        finally:
+            con_read.close()
+
