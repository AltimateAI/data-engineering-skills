+
+    def test_operator_idempotent_on_rerun_same_partition(
+        self, duckdb_conn_env, csv_duplicate_date
+    ):
+        """Re-running the same partition replaces old rows (no duplicates)."""
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        # First run: load 2 rows for 2026-03-02
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_test",
+            csv_path=str(csv_duplicate_date),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+        count_1 = op.execute(context={})
+        assert count_1 == 2
+
+        # Second run: load the same partition again
+        count_2 = op.execute(context={})
+        assert count_2 == 2
+
+        # Table should still have exactly 2 rows, not 4
+        rows = _read_rows_from_table(duckdb_conn_env, "raw", "orders")
+        assert len(rows) == 2
+
+    def test_operator_does_not_affect_other_partitions_on_rerun(
+        self, duckdb_conn_env, tmp_path
+    ):
+        """Re-running one partition leaves other partitions untouched."""
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        # Create a CSV with three dates
+        csv_file = tmp_path / "orders.csv"
+        rows = [
+            ["order_id", "order_date", "customer_id", "amount"],
+            ["O-A", "2026-03-01", "C-1", "100.00"],
+            ["O-B", "2026-03-02", "C-2", "200.00"],
+            ["O-C", "2026-03-02", "C-3", "150.00"],
+            ["O-D", "2026-03-03", "C-4", "300.00"],
+        ]
+        with open(csv_file, "w", newline="") as f:
+            writer = csv.writer(f)
+            writer.writerows(rows)
+
+        # Load all three dates
+        for date in ["2026-03-01", "2026-03-02", "2026-03-03"]:
+            op = CsvPartitionToDuckDBOperator(
+                task_id="load_test",
+                csv_path=str(csv_file),
+                table="orders",
+                partition_column="order_date",
+                partition_date=date,
+                duckdb_conn_id="test_warehouse",
+            )
+            op.execute(context={})
+
+        # Table should have 4 rows total
+        rows = _read_rows_from_table(duckdb_conn_env, "raw", "orders")
+        assert len(rows) == 4
+
+        # Re-run 2026-03-02 (which has 2 rows in CSV)
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_test",
+            csv_path=str(csv_file),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+        op.execute(context={})
+
+        # Should still have 4 rows total (2 for 03-01, 2 for 03-02, 1 for 03-03)
+        rows = _read_rows_from_table(duckdb_conn_env, "raw", "orders")
+        assert len(rows) == 4
+
+        # 2026-03-01 should still have its 1 row
+        assert _row_count_for_date(duckdb_conn_env, "raw", "orders", "order_date", "2026-03-01") == 1
+        # 2026-03-02 should have its 2 rows (not 4)
+        assert _row_count_for_date(duckdb_conn_env, "raw", "orders", "order_date", "2026-03-02") == 2
+        # 2026-03-03 should still have its 1 row
+        assert _row_count_for_date(duckdb_conn_env, "raw", "orders", "order_date", "2026-03-03") == 1
+
