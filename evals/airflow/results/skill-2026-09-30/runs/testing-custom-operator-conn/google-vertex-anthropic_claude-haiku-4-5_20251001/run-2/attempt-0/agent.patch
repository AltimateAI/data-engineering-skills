+"""Pytest configuration for Airflow DAG tests.
+
+No scheduler, webserver, or metadata DB; connections supplied via environment variables.
+"""
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# Set Airflow config before any Airflow import
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+sys.path.insert(0, str(DAGS))  # lets tests import DAG modules and helper packages
