+class TestCsvPartitionToDuckDBOperator:
+    """Tests for CsvPartitionToDuckDBOperator."""
+
+    def test_operator_loads_only_specified_partition_date(
+        self, duckdb_conn_env, csv_with_multiple_dates, monkeypatch
+    ):
+        """Operator loads only rows matching partition_date."""
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_test",
+            csv_path=str(csv_with_multiple_dates),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+        # Mock context (required by operator.execute)
+        context = {}
+        loaded_count = op.execute(context)
+
+        # Only 2 rows match 2026-03-02
+        assert loaded_count == 2
+        rows = _read_rows_from_table(duckdb_conn_env, "raw", "orders")
+        assert len(rows) == 2
+        assert all(row["order_date"] == "2026-03-02" for row in rows)
+
+    def test_operator_returns_row_count(
+        self, duckdb_conn_env, csv_with_multiple_dates
+    ):
+        """Operator.execute() returns the count of rows loaded."""
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_test",
+            csv_path=str(csv_with_multiple_dates),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        loaded = op.execute(context={})
+        assert loaded == 2  # Two rows for 2026-03-01
+
+    def test_operator_creates_schema_if_not_exists(
+        self, duckdb_conn_env, csv_with_multiple_dates
+    ):
+        """Operator creates the target schema if it doesn't exist."""
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_test",
+            csv_path=str(csv_with_multiple_dates),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op.execute(context={})
+
+        # Schema "raw" should exist now
+        con = duckdb.connect(str(duckdb_conn_env))
+        try:
+            schemas = con.execute("SELECT schema_name FROM information_schema.schemata").fetchall()
+            schema_names = [s[0] for s in schemas]
+            assert "raw" in schema_names
+        finally:
+            con.close()
+
+    def test_operator_creates_table_with_same_schema_as_csv(
+        self, duckdb_conn_env, csv_with_multiple_dates
+    ):
+        """Operator creates the table with columns from the CSV (all text)."""
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_test",
+            csv_path=str(csv_with_multiple_dates),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op.execute(context={})
+
+        # Check table exists and has expected columns
+        rows = _read_rows_from_table(duckdb_conn_env, "raw", "orders")
+        assert rows
+        # All columns should be present as text
+        expected_cols = {"order_id", "order_date", "customer_id", "amount"}
