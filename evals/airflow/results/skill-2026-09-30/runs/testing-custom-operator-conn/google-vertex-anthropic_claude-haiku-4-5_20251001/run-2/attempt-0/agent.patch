+    def test_operator_with_empty_partition(self, duckdb_conn_env, tmp_path):
+        """Operator handles a partition with zero matching rows gracefully."""
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        csv_file = tmp_path / "data.csv"
+        with open(csv_file, "w", newline="") as f:
+            writer = csv.writer(f)
+            writer.writerows([
+                ["id", "date"],
+                ["1", "2026-03-01"],
+            ])
+
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_test",
+            csv_path=str(csv_file),
+            table="data",
+            partition_column="date",
+            partition_date="2026-12-31",  # No rows match this date
+            duckdb_conn_id="test_warehouse",
+        )
+        loaded = op.execute(context={})
+
+        # Should return 0 for empty partition
+        assert loaded == 0
+
+        # Table should exist but be empty
+        con = duckdb.connect(str(duckdb_conn_env), read_only=True)
+        try:
+            count = con.execute('SELECT count(*) FROM "raw"."data"').fetchone()[0]
+            assert count == 0
+        finally:
+            con.close()
