+"""Pytest fixtures for warehouse hook and operator tests.
+
+Provides a temporary DuckDB database, Airflow test context, and connection
+configuration for unit tests. No external services required.
+"""
+
+from __future__ import annotations
+
+import sys
+import tempfile
+from pathlib import Path
+from typing import Generator
+
+import duckdb
+import pytest
+from airflow.sdk.definitions.connection import Connection
+from airflow.sdk.execution_time.context import _preset_connections
+from airflow.utils import db
+
+
+# Add dags to path so imports like "from warehouse.hooks" work
+sys.path.insert(0, str(Path(__file__).parent.parent / "dags"))
+
+
+@pytest.fixture
+def tmp_duckdb_path() -> Generator[str, None, None]:
+    """Create a temporary DuckDB file that persists for the test.
+
+    Yields the file path and cleans up after the test.
+    """
+    with tempfile.NamedTemporaryFile(suffix=".duckdb", delete=False) as f:
+        db_path = f.name
+
+    yield db_path
+
+    # Clean up
+    Path(db_path).unlink(missing_ok=True)
+
+
+@pytest.fixture
+def duckdb_connection(tmp_duckdb_path: str) -> Generator[None, None, None]:
+    """Create a DuckDB warehouse connection accessible via Airflow SDK.
+
+    This fixture:
+    1. Initializes the Airflow metadata database (in-memory SQLite)
+    2. Creates a DuckDB connection pointing to the temporary DuckDB file
+    3. Injects it into the runtime context using _preset_connections so that
+       Connection.get() and BaseHook.get_connection() can find it
+    4. Cleans up after the test
+
+    Use this fixture in any test that needs to instantiate hooks or operators.
+    """
+    # Initialize Airflow DB if not already done in this session
+    db.initdb()
+
+    # Create the connection using Airflow 3.3 SDK Connection class
+    conn = Connection(
+        conn_id="duckdb_warehouse",
+        conn_type="duckdb",
+        host=tmp_duckdb_path,
+        schema="main",
+    )
+
+    # Inject into the runtime context so Connection.get() and
+    # BaseHook.get_connection() can find it
+    token = _preset_connections.set({"duckdb_warehouse": conn})
+
+    yield
+
+    # Reset the context variable to its previous value
+    _preset_connections.reset(token)
+
+
+@pytest.fixture
+def sample_csv_file() -> Generator[str, None, None]:
+    """Create a temporary CSV file with sample data for testing.
+
+    Returns the path to a CSV with columns: id, date, value.
+    """
+    import csv
+
+    with tempfile.NamedTemporaryFile(
+        mode="w", suffix=".csv", delete=False, newline=""
+    ) as f:
+        writer = csv.DictWriter(f, fieldnames=["id", "date", "value"])
+        writer.writeheader()
+        writer.writerow({"id": "A1", "date": "2026-01-01", "value": "100"})
+        writer.writerow({"id": "A2", "date": "2026-01-01", "value": "200"})
+        writer.writerow({"id": "B1", "date": "2026-01-02", "value": "150"})
+        writer.writerow({"id": "B2", "date": "2026-01-02", "value": "250"})
+        csv_path = f.name
+
+    yield csv_path
+
+    # Clean up
+    Path(csv_path).unlink(missing_ok=True)
+
+
+@pytest.fixture
+def airflow_context() -> dict:
+    """Provide a minimal Airflow task context for operator.execute().
+
+    This context is sufficient for operators that log task information
+    or access basic task metadata.
+    """
+    return {
+        "ti": None,
+        "task_instance": None,
+        "dag": None,
+        "dag_run": None,
+    }
