+
+
+class TestCsvPartitionToDuckDBOperatorIntegration:
+    """Integration tests combining multiple partitions and reruns."""
+
+    def test_multiple_loads_and_reruns_maintain_consistency(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Complex scenario: load partition A, then B, rerun A, verify state."""
+        # Load 2026-01-01
+        op1 = CsvPartitionToDuckDBOperator(
+            task_id="load_partition_1",
+            csv_path=sample_csv_file,
+            table="events",
+            partition_column="date",
+            partition_date="2026-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        assert op1.execute(airflow_context) == 2
+
+        # Load 2026-01-02
+        op2 = CsvPartitionToDuckDBOperator(
+            task_id="load_partition_2",
+            csv_path=sample_csv_file,
+            table="events",
+            partition_column="date",
+            partition_date="2026-01-02",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        assert op2.execute(airflow_context) == 2
+
+        # Table should have 4 rows total
+        con = duckdb.connect(tmp_duckdb_path)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) as cnt FROM "main"."events"'
+            ).fetchall()
+            assert result[0][0] == 4
+        finally:
+            con.close()
+
+        # Rerun 2026-01-01
+        assert op1.execute(airflow_context) == 2
+
+        # Table should still have 4 rows (2 from each partition), not 6
+        con = duckdb.connect(tmp_duckdb_path)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) as cnt FROM "main"."events"'
+            ).fetchall()
+            assert result[0][0] == 4
+
