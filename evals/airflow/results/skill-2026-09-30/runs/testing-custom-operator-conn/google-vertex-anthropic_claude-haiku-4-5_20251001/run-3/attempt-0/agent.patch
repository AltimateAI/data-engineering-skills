+"""Unit tests for CsvPartitionToDuckDBOperator."""
+
+from __future__ import annotations
+
+import csv
+import tempfile
+from pathlib import Path
+
+import duckdb
+import pytest
+from airflow.models import Connection
+from sqlalchemy.orm import sessionmaker
+from airflow.settings import engine
+
+from warehouse.operators import CsvPartitionToDuckDBOperator
+
+
+class TestCsvPartitionToDuckDBOperatorBasic:
+    """Basic operator initialization and configuration."""
+
+    def test_operator_stores_parameters(self):
+        """Operator should store all constructor parameters."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path="/path/to/data.csv",
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-01-01",
+            duckdb_conn_id="custom_warehouse",
+        )
+
+        assert op.csv_path == "/path/to/data.csv"
+        assert op.table == "test_table"
+        assert op.partition_column == "date"
+        assert op.partition_date == "2026-01-01"
+        assert op.duckdb_conn_id == "custom_warehouse"
+
+    def test_operator_uses_default_connection_id(self):
+        """Operator should use default duckdb_warehouse connection if not specified."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path="/path/to/data.csv",
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-01-01",
+        )
+
+        assert op.duckdb_conn_id == "duckdb_warehouse"
+
+    def test_operator_marks_template_fields(self):
+        """Operator should mark csv_path and partition_date as template fields for Airflow templating."""
+        assert "csv_path" in CsvPartitionToDuckDBOperator.template_fields
+        assert "partition_date" in CsvPartitionToDuckDBOperator.template_fields
+
+
+class TestCsvPartitionToDuckDBOperatorExecution:
+    """Tests for the operator.execute() method with real DuckDB files."""
+
+    def test_operator_loads_only_matching_partition(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Operator should load only rows matching the specified partition_date."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_partition",
+            csv_path=sample_csv_file,
+            table="test_data",
+            partition_column="date",
+            partition_date="2026-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+
+        # Execute the operator
+        loaded_count = op.execute(airflow_context)
+
+        # Verify the correct number of rows were loaded (2 rows for 2026-01-01)
+        assert loaded_count == 2
+
+        # Verify the data in the table
+        con = duckdb.connect(tmp_duckdb_path)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) as cnt FROM "main"."test_data"'
+            ).fetchall()
+            assert result[0][0] == 2
+
+            # Verify only the correct date is in the table
+            date_check = con.execute(
+                'SELECT DISTINCT date FROM "main"."test_data" ORDER BY date'
+            ).fetchall()
+            assert date_check == [("2026-01-01",)]
+        finally:
+            con.close()
+
+    def test_operator_returns_number_of_rows_loaded(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Operator.execute() should return the count of rows loaded for the partition."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_partition",
+            csv_path=sample_csv_file,
+            table="test_data",
+            partition_column="date",
+            partition_date="2026-01-02",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+
+        loaded_count = op.execute(airflow_context)
+
+        # For 2026-01-02, there are 2 rows in the sample data
+        assert loaded_count == 2
+
+    def test_operator_replaces_existing_partition_on_rerun(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Re-running the operator for the same partition should replace that partition's rows.
+
+        This tests the idempotency contract: the second run should have the same
+        number of rows, not duplicates.
+        """
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_partition",
+            csv_path=sample_csv_file,
+            table="test_data",
+            partition_column="date",
+            partition_date="2026-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+
+        # First execution
+        first_count = op.execute(airflow_context)
+        assert first_count == 2
+
+        # Second execution (rerun)
+        second_count = op.execute(airflow_context)
+        assert second_count == 2  # Same count, not doubled
+
+        # Verify the table still has exactly 2 rows, not 4
+        con = duckdb.connect(tmp_duckdb_path)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) as cnt FROM "main"."test_data"'
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_leaves_other_partitions_intact(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Loading one partition should not affect rows from other partitions."""
+        # Load first partition
+        op1 = CsvPartitionToDuckDBOperator(
+            task_id="load_partition_1",
+            csv_path=sample_csv_file,
+            table="test_data",
+            partition_column="date",
+            partition_date="2026-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        count1 = op1.execute(airflow_context)
+        assert count1 == 2
+
+        # Load second partition
+        op2 = CsvPartitionToDuckDBOperator(
+            task_id="load_partition_2",
+            csv_path=sample_csv_file,
+            table="test_data",
+            partition_column="date",
+            partition_date="2026-01-02",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+        count2 = op2.execute(airflow_context)
+        assert count2 == 2
+
+        # Verify both partitions are in the table
+        con = duckdb.connect(tmp_duckdb_path)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) as cnt FROM "main"."test_data"'
+            ).fetchall()
+            assert result[0][0] == 4  # 2 rows from each partition
+
+            # Check both dates are present
+            dates = con.execute(
+                'SELECT DISTINCT date FROM "main"."test_data" ORDER BY date'
+            ).fetchall()
+            assert dates == [("2026-01-01",), ("2026-01-02",)]
+        finally:
+            con.close()
+
+    def test_operator_creates_schema_if_not_exists(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Operator should create the target schema if it doesn't exist."""
+        # Create a connection pointing to a custom schema
+        custom_conn = Connection(
+            conn_id="custom_schema_conn",
+            conn_type="duckdb",
+            host=tmp_duckdb_path,
+            schema="custom_schema",
+        )
+
+        Session = sessionmaker(bind=engine)
+        session = Session()
+
+        try:
+            session.add(custom_conn)
+            session.commit()
+        finally:
+            session.close()
+
+        try:
+            op = CsvPartitionToDuckDBOperator(
+                task_id="load_partition",
+                csv_path=sample_csv_file,
+                table="test_data",
+                partition_column="date",
+                partition_date="2026-01-01",
+                duckdb_conn_id="custom_schema_conn",
+            )
+
+            op.execute(airflow_context)
+
+            # Verify the schema was created and the table is in it
+            con = duckdb.connect(tmp_duckdb_path)
+            try:
+                result = con.execute(
+                    'SELECT COUNT(*) as cnt FROM "custom_schema"."test_data"'
+                ).fetchall()
+                assert result[0][0] == 2
+            finally:
+                con.close()
+        finally:
+            session = Session()
+            try:
+                session.query(Connection).filter(
+                    Connection.conn_id == "custom_schema_conn"
+                ).delete()
+                session.commit()
+            finally:
+                session.close()
+
+    def test_operator_creates_table_if_not_exists(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Operator should create the target table if it doesn't exist."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_partition",
+            csv_path=sample_csv_file,
+            table="new_table",
+            partition_column="date",
+            partition_date="2026-01-01",
+            duckdb_conn_id="duckdb_warehouse",
+        )
+
+        op.execute(airflow_context)
+
+        # Verify the table was created
+        con = duckdb.connect(tmp_duckdb_path)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) as cnt FROM "main"."new_table"'
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_loads_all_columns_as_text(
+        self, duckdb_connection, tmp_duckdb_path, airflow_context
+    ):
+        """Operator should load all CSV columns as text/varchar (using all_varchar=true)."""
+        # Create a CSV with numeric-looking values
+        with tempfile.NamedTemporaryFile(
+            mode="w", suffix=".csv", delete=False, newline=""
+        ) as f:
+            writer = csv.DictWriter(f, fieldnames=["id", "date", "amount"])
+            writer.writeheader()
+            writer.writerow({"id": "A1", "date": "2026-01-01", "amount": "99.99"})
+            csv_path = f.name
+
+        try:
+            op = CsvPartitionToDuckDBOperator(
+                task_id="load_partition",
+                csv_path=csv_path,
+                table="amounts",
+                partition_column="date",
+                partition_date="2026-01-01",
+                duckdb_conn_id="duckdb_warehouse",
+            )
+
+            op.execute(airflow_context)
+
+            # Verify the column is text, not numeric
+            con = duckdb.connect(tmp_duckdb_path)
+            try:
+                # Get column info
+                info = con.execute(
+                    'DESCRIBE "main"."amounts"'
+                ).fetchall()
+                # info is a list of (column_name, type, null, pk, default, extra)
+                col_types = {row[0]: row[1] for row in info}
+
+                # All columns should be VARCHAR
+                assert col_types["id"] == "VARCHAR"
+                assert col_types["date"] == "VARCHAR"
+                assert col_types["amount"] == "VARCHAR"
+            finally:
+                con.close()
+        finally:
+            Path(csv_path).unlink(missing_ok=True)
+
+    def test_operator_handles_empty_partition(
+        self, duckdb_connection, tmp_duckdb_path, sample_csv_file, airflow_context
+    ):
+        """Operator should handle partitions with no matching rows gracefully."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="load_partition",
+            csv_path=sample_csv_file,
+            table="test_data",
+            partition_column="date",
+            partition_date="2026-01-99",  # Non-existent date
+            duckdb_conn_id="duckdb_warehouse",
+        )
+
+        loaded_count = op.execute(airflow_context)
+
+        # Should return 0, not raise an error
+        assert loaded_count == 0
+
+        # Table should be created but empty
+        con = duckdb.connect(tmp_duckdb_path)
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) as cnt FROM "main"."test_data"'
+            ).fetchall()
+            assert result[0][0] == 0
