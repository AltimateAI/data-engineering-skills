+"""Pytest configuration for Airflow tests.
+
+This module sets up a minimal Airflow environment suitable for unit testing
+custom operators and hooks without a running scheduler or webserver.
+"""
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# Airflow reads its config once, on first import, so set everything before any airflow import.
+_TMP = Path(tempfile.mkdtemp(prefix="airflow-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = (
+    f"sqlite:///{_TMP / 'airflow.db'}"
+)
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+sys.path.insert(0, str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrate the throwaway metadata DB for dag.test() tests."""
+    subprocess.run(
+        [sys.executable, "-m", "airflow", "db", "migrate"],
+        check=True,
+        capture_output=True,
+    )
+
+
+@pytest.fixture
+def duckdb_connection(tmp_path, monkeypatch):
+    """Provide a DuckDB connection env var pointing to a temp DB file.
+
+    The connection uses the test-specific temp database file and a custom
+    schema. The operator/hook will find the path in the connection's host
+    and the schema in the connection's schema field.
+    """
+    db_path = tmp_path / "test.duckdb"
+    conn_str = json.dumps({
+        "conn_type": "duckdb",
+        "host": str(db_path),
+        "schema": "test_schema",
+    })
+    monkeypatch.setenv("AIRFLOW_CONN_TEST_WAREHOUSE", conn_str)
+    return db_path
