+"""Tests for DuckDBWarehouseHook."""
+
+import pytest
+
+from warehouse.hooks import DuckDBWarehouseHook
+
+
+class TestDuckDBWarehouseHook:
+    """Tests for DuckDBWarehouseHook initialization and connection properties."""
+
+    def test_hook_reads_database_path_from_connection_host(self, duckdb_connection):
+        """Hook extracts the DuckDB file path from the connection host."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        assert str(duckdb_connection) == hook.database_path
+
+    def test_hook_reads_schema_from_connection_schema(self, duckdb_connection):
+        """Hook extracts the target schema from the connection schema field."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        assert hook.target_schema == "test_schema"
+
+    def test_hook_defaults_schema_to_main_when_not_set(
+        self, tmp_path, monkeypatch
+    ):
+        """Hook defaults to 'main' schema when connection has no schema."""
+        import json
+
+        db_path = tmp_path / "test.duckdb"
+        conn_str = json.dumps({
+            "conn_type": "duckdb",
+            "host": str(db_path),
+            # schema intentionally omitted
+        })
+        monkeypatch.setenv("AIRFLOW_CONN_NO_SCHEMA", conn_str)
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="no_schema")
+        assert hook.target_schema == "main"
+
+    def test_hook_raises_when_host_missing(self, tmp_path, monkeypatch):
+        """Hook raises ValueError if connection has no host (database path)."""
+        import json
+
+        conn_str = json.dumps({
+            "conn_type": "duckdb",
+            # host intentionally missing
+            "schema": "test_schema",
+        })
+        monkeypatch.setenv("AIRFLOW_CONN_NO_HOST", conn_str)
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="no_host")
+        with pytest.raises(ValueError, match="has no host"):
+            _ = hook.database_path
+
+    def test_hook_get_conn_returns_duckdb_connection(self, duckdb_connection):
+        """Hook.get_conn() returns a functional DuckDB connection."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        con = hook.get_conn()
+        try:
+            # Smoke test: can execute a simple query
+            result = con.execute("SELECT 1 as val").fetchone()
+            assert result[0] == 1
+        finally:
+            con.close()
+
+    def test_hook_get_conn_opens_read_write_by_default(self, duckdb_connection):
+        """Hook opens DuckDB in read-write mode by default."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_warehouse")
+        con = hook.get_conn()
+        try:
+            # Create a test table to verify write access
+            con.execute("CREATE TABLE test (id INTEGER)")
+            result = con.execute(
+                "SELECT table_name FROM information_schema.tables "
+                "WHERE table_name = 'test'"
+            ).fetchall()
+            assert len(result) == 1
+        finally:
+            con.close()
+
+    def test_hook_get_conn_opens_read_only_when_configured(
+        self, tmp_path, monkeypatch
+    ):
+        """Hook opens DuckDB in read-only mode when extra.read_only is true."""
+        import json
+
+        db_path = tmp_path / "test.duckdb"
+
+        # First, create a database with a writable (non-read-only) connection
+        conn_str_write = json.dumps({
+            "conn_type": "duckdb",
+            "host": str(db_path),
+            "schema": "test_schema",
+        })
+        monkeypatch.setenv("AIRFLOW_CONN_WRITEONLY", conn_str_write)
+        hook_write = DuckDBWarehouseHook(duckdb_conn_id="writeonly")
+        con_write = hook_write.get_conn()
+        con_write.execute("CREATE TABLE test (id INTEGER)")
+        con_write.close()
+
+        # Now configure a read-only connection and test it rejects writes
+        conn_str_readonly = json.dumps({
+            "conn_type": "duckdb",
+            "host": str(db_path),
+            "schema": "test_schema",
+            "extra": {"read_only": True},
+        })
+        monkeypatch.setenv("AIRFLOW_CONN_READONLY", conn_str_readonly)
+
+        hook_read = DuckDBWarehouseHook(duckdb_conn_id="readonly")
+        con_read = hook_read.get_conn()
+        try:
+            with pytest.raises(Exception):  # DuckDB raises an error on write attempt
+                con_read.execute("CREATE TABLE other (id INTEGER)")
+        finally:
+            con_read.close()
+
+    def test_hook_uses_default_connection_id(self, monkeypatch):
+        """Hook uses 'duckdb_warehouse' as default connection id."""
+        import json
+
+        db_path = "<tmp>/test.duckdb"
+        conn_str = json.dumps({
+            "conn_type": "duckdb",
+            "host": db_path,
+        })
+        monkeypatch.setenv("AIRFLOW_CONN_DUCKDB_WAREHOUSE", conn_str)
+
+        # Instantiate without providing duckdb_conn_id
+        hook = DuckDBWarehouseHook()
+        assert hook.duckdb_conn_id == "duckdb_warehouse"
+
+    def test_hook_respects_custom_connection_id(
+        self, tmp_path, monkeypatch
+    ):
+        """Hook uses the custom duckdb_conn_id when provided."""
+        import json
+
+        db_path = tmp_path / "test.duckdb"
+        conn_str = json.dumps({
+            "conn_type": "duckdb",
+            "host": str(db_path),
+            "schema": "custom_schema",
+        })
+        monkeypatch.setenv("AIRFLOW_CONN_CUSTOM_WH", conn_str)
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="custom_wh")
+        assert hook.duckdb_conn_id == "custom_wh"
+        assert hook.target_schema == "custom_schema"
