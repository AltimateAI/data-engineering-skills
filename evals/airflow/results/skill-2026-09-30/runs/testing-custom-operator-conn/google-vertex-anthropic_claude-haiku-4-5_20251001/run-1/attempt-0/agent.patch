+"""Tests for CsvPartitionToDuckDBOperator."""
+
+import csv
+import tempfile
+from pathlib import Path
+
+import duckdb
+import pytest
+
+from warehouse.operators import CsvPartitionToDuckDBOperator
+
+
+class TestCsvPartitionToDuckDBOperator:
+    """Tests for CsvPartitionToDuckDBOperator execute() and partition handling."""
+
+    @pytest.fixture
+    def sample_csv(self, tmp_path):
+        """Create a sample CSV file with orders for multiple dates."""
+        csv_path = tmp_path / "orders.csv"
+        rows = [
+            {"order_id": "O-001", "order_date": "2026-03-01", "customer_id": "C-001", "amount": "10.00"},
+            {"order_id": "O-002", "order_date": "2026-03-01", "customer_id": "C-002", "amount": "20.00"},
+            {"order_id": "O-003", "order_date": "2026-03-02", "customer_id": "C-001", "amount": "30.00"},
+            {"order_id": "O-004", "order_date": "2026-03-02", "customer_id": "C-003", "amount": "15.00"},
+            {"order_id": "O-005", "order_date": "2026-03-03", "customer_id": "C-002", "amount": "25.00"},
+        ]
+        with open(csv_path, "w", newline="") as f:
+            writer = csv.DictWriter(f, fieldnames=rows[0].keys())
+            writer.writeheader()
+            writer.writerows(rows)
+        return csv_path
+
+    @pytest.fixture
+    def duckdb_with_connection(self, duckdb_connection):
+        """Create a DuckDB connection fixture that also sets up the env."""
+        return duckdb_connection
+
+    def test_operator_loads_partition_from_csv(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Operator successfully loads the specified partition from a CSV file."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        rows_loaded = operator.execute(context={})
+
+        # Verify the correct number of rows was loaded
+        assert rows_loaded == 2
+
+        # Verify the data is in the database
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders WHERE order_date = ?',
+                ["2026-03-01"]
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_loads_correct_partition_only(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Operator loads only rows matching the partition_date, not all rows."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        rows_loaded = operator.execute(context={})
+
+        assert rows_loaded == 2
+
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            # Verify only 2026-03-02 rows are in the table
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders'
+            ).fetchall()
+            assert result[0][0] == 2
+
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders WHERE order_date = ?',
+                ["2026-03-02"]
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_returns_row_count(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Operator.execute() returns the number of rows loaded for the partition."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-03",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        rows_loaded = operator.execute(context={})
+
+        # 2026-03-03 has exactly 1 row
+        assert rows_loaded == 1
+
+    def test_operator_creates_schema_if_missing(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Operator creates the target schema if it does not exist."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        operator.execute(context={})
+
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            # Verify the schema exists
+            result = con.execute(
+                "SELECT schema_name FROM information_schema.schemata "
+                "WHERE schema_name = 'test_schema'"
+            ).fetchall()
+            assert len(result) == 1
+        finally:
+            con.close()
+
+    def test_operator_creates_table_if_missing(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Operator creates the target table if it does not exist."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        operator.execute(context={})
+
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            # Verify the table exists
+            result = con.execute(
+                "SELECT table_name FROM information_schema.tables "
+                "WHERE table_name = 'orders' AND table_schema = 'test_schema'"
+            ).fetchall()
+            assert len(result) == 1
+        finally:
+            con.close()
+
+    def test_operator_loads_all_columns_as_text(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Operator loads all CSV columns and preserves them as text (varchar)."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        operator.execute(context={})
+
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            # Check that all expected columns exist
+            result = con.execute(
+                "SELECT column_name, data_type FROM information_schema.columns "
+                "WHERE table_name = 'orders' AND table_schema = 'test_schema' "
+                "ORDER BY ordinal_position"
+            ).fetchall()
+
+            # Should have: order_id, order_date, customer_id, amount (all VARCHAR)
+            assert len(result) == 4
+            for col_name, data_type in result:
+                assert data_type == "VARCHAR"  # all_varchar = true in operator
+                assert col_name in {"order_id", "order_date", "customer_id", "amount"}
+
+            # Verify sample row
+            sample = con.execute(
+                'SELECT order_id, amount FROM test_schema.orders WHERE order_id = ?',
+                ["O-001"]
+            ).fetchall()
+            assert sample[0] == ("O-001", "10.00")
+        finally:
+            con.close()
+
+    def test_operator_replaces_partition_on_rerun(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Re-running the same partition replaces the old rows without duplicating."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        # First run
+        first_count = operator.execute(context={})
+        assert first_count == 2
+
+        # Second run (re-run the same partition)
+        second_count = operator.execute(context={})
+        assert second_count == 2
+
+        # Verify total rows is still 2 (not 4), meaning old partition was deleted
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders'
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_leaves_other_partitions_untouched(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Loading one partition does not affect rows from other partitions."""
+        # Load 2026-03-01
+        op1 = CsvPartitionToDuckDBOperator(
+            task_id="load_orders_1",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op1.execute(context={})
+
+        # Load 2026-03-02
+        op2 = CsvPartitionToDuckDBOperator(
+            task_id="load_orders_2",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+        op2.execute(context={})
+
+        # Verify both partitions exist
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders'
+            ).fetchall()
+            assert result[0][0] == 4  # 2 from 2026-03-01 + 2 from 2026-03-02
+
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders WHERE order_date = ?',
+                ["2026-03-01"]
+            ).fetchall()
+            assert result[0][0] == 2
+
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders WHERE order_date = ?',
+                ["2026-03-02"]
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_idempotent_rerun_with_other_partitions(
+        self, sample_csv, duckdb_with_connection, duckdb_connection
+    ):
+        """Re-running a partition is idempotent even when other partitions exist."""
+        # Load 2026-03-01
+        op1 = CsvPartitionToDuckDBOperator(
+            task_id="load_orders_1",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op1.execute(context={})
+
+        # Load 2026-03-02
+        op2 = CsvPartitionToDuckDBOperator(
+            task_id="load_orders_2",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+        op2.execute(context={})
+
+        # Re-run 2026-03-01 (should replace, not duplicate)
+        op1_rerun = CsvPartitionToDuckDBOperator(
+            task_id="load_orders_1_rerun",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op1_rerun.execute(context={})
+
+        # Verify: total should still be 4, 2026-03-02 unchanged
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders'
+            ).fetchall()
+            assert result[0][0] == 4
+
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.orders WHERE order_date = ?',
+                ["2026-03-02"]
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_uses_custom_duckdb_conn_id(
+        self, sample_csv, tmp_path, monkeypatch
+    ):
+        """Operator respects the duckdb_conn_id parameter."""
+        import json
+
+        db_path = tmp_path / "custom.duckdb"
+        conn_str = json.dumps({
+            "conn_type": "duckdb",
+            "host": str(db_path),
+            "schema": "custom_schema",
+        })
+        monkeypatch.setenv("AIRFLOW_CONN_CUSTOM_WAREHOUSE", conn_str)
+
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_orders",
+            csv_path=str(sample_csv),
+            table="orders",
+            partition_column="order_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="custom_warehouse",
+        )
+
+        rows_loaded = operator.execute(context={})
+        assert rows_loaded == 2
+
+        # Verify data is in the custom database
+        con = duckdb.connect(str(db_path))
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM custom_schema.orders'
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
+
+    def test_operator_with_different_partition_column_name(
+        self, tmp_path, duckdb_with_connection, duckdb_connection
+    ):
+        """Operator works with different partition column names."""
+        # Create a CSV with a different date column name
+        csv_path = tmp_path / "refunds.csv"
+        rows = [
+            {"refund_id": "R-001", "refund_date": "2026-03-01", "amount": "50.00"},
+            {"refund_id": "R-002", "refund_date": "2026-03-02", "amount": "25.00"},
+            {"refund_id": "R-003", "refund_date": "2026-03-02", "amount": "75.00"},
+        ]
+        with open(csv_path, "w", newline="") as f:
+            writer = csv.DictWriter(f, fieldnames=rows[0].keys())
+            writer.writeheader()
+            writer.writerows(rows)
+
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="load_refunds",
+            csv_path=str(csv_path),
+            table="refunds",
+            partition_column="refund_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        rows_loaded = operator.execute(context={})
+
+        # Should load 2 rows for 2026-03-02
+        assert rows_loaded == 2
+
+        con = duckdb.connect(str(duckdb_connection))
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM test_schema.refunds WHERE refund_date = ?',
+                ["2026-03-02"]
+            ).fetchall()
+            assert result[0][0] == 2
+        finally:
+            con.close()
