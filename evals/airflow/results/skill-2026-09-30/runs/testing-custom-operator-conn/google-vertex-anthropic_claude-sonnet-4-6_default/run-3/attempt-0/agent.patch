+"""Shared pytest configuration for all tests.
+
+Sets Airflow environment variables before any airflow import so the core
+reads a fresh throwaway SQLite database and does not touch the developer's
+metadata DB or existing AIRFLOW_HOME.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+# Repo layout constants – resolve once so tests import correctly.
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# ── Airflow bootstrap ──────────────────────────────────────────────────────────
+# All env vars must be set BEFORE the first airflow import.
+_TMP_HOME = Path(tempfile.mkdtemp(prefix="airflow-test-home-"))
+os.environ["AIRFLOW_HOME"] = str(_TMP_HOME)
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = (
+    f"sqlite:///{_TMP_HOME / 'airflow.db'}"
+)
+
+# Put dags/ on sys.path so tests can import warehouse.hooks / warehouse.operators
+# directly (same as how the DAG file resolves them in Airflow's runtime).
+if str(DAGS) not in sys.path:
+    sys.path.insert(0, str(DAGS))
