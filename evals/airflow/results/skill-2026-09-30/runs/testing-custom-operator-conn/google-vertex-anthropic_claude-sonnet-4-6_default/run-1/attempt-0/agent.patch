+"""pytest configuration for the warehouse hook/operator test suite.
+
+Sets all Airflow environment variables before any Airflow import so the
+metadata DB, home directory, and example-DAG toggle are isolated to this
+pytest session.  CI needs no pre-existing connections or running services.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+# ---------------------------------------------------------------------------
+# All env vars must be set BEFORE the first import of anything under airflow.
+# ---------------------------------------------------------------------------
+_TMP = Path(tempfile.mkdtemp(prefix="wh-tests-"))
+
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(Path(__file__).resolve().parents[1] / "dags")
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+
+# Put dags/ on sys.path so "from warehouse.hooks import ..." works in tests.
+_DAGS = Path(__file__).resolve().parents[1] / "dags"
+if str(_DAGS) not in sys.path:
+    sys.path.insert(0, str(_DAGS))
