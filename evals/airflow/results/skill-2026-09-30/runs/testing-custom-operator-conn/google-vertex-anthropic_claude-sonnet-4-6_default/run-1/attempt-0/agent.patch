+"""Unit tests for DuckDBWarehouseHook and CsvPartitionToDuckDBOperator.
+
+Run with:  pytest tests/ -q
+
+CI requirements:
+- No Airflow connections pre-configured (all supplied via AIRFLOW_CONN_* env vars).
+- No running services.
+- DuckDB is exercised for real against a temporary file (not mocked).
+
+Rules tested:
+  R1 – Hook reads DB file path from connection.host.
+  R2 – Hook reads target schema from connection.schema (falls back to "main").
+  R3 – Operator honours the duckdb_conn_id it is given (not its hardcoded default).
+  R4 – execute() loads only rows where partition_column == partition_date.
+  R5 – execute() returns the number of rows it loaded.
+  R6 – Re-running the same partition replaces those rows (no duplicates).
+  R7 – A re-run leaves rows for other dates untouched.
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import textwrap
+from pathlib import Path
+
+import duckdb
+import pytest
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def _write_csv(path: Path, rows: list[dict]) -> None:
+    """Write a list-of-dicts to *path* as a CSV file."""
+    if not rows:
+        raise ValueError("rows must not be empty")
+    with path.open("w", newline="") as fh:
+        writer = csv.DictWriter(fh, fieldnames=list(rows[0].keys()))
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def _read_table(db_path: Path, schema: str, table: str) -> list[dict]:
+    """Return all rows from schema.table as a list of dicts."""
+    con = duckdb.connect(str(db_path), read_only=True)
+    try:
+        rel = con.execute(f'SELECT * FROM "{schema}"."{table}"')
+        cols = [d[0] for d in rel.description]
+        return [dict(zip(cols, row)) for row in rel.fetchall()]
+    finally:
+        con.close()
+
+
+def _conn_json(db_path: Path, schema: str = "raw") -> str:
+    """Return the JSON string for AIRFLOW_CONN_* env vars."""
+    return json.dumps({"conn_type": "generic", "host": str(db_path), "schema": schema})
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+@pytest.fixture()
+def sales_csv(tmp_path: Path) -> Path:
+    """A small CSV with rows spread across three dates."""
+    p = tmp_path / "sales.csv"
+    _write_csv(p, [
+        {"sale_date": "2026-03-01", "sale_id": "S-1", "amount": "10.00"},
+        {"sale_date": "2026-03-01", "sale_id": "S-2", "amount": "20.00"},
+        {"sale_date": "2026-03-02", "sale_id": "S-3", "amount": "30.00"},
+        {"sale_date": "2026-03-03", "sale_id": "S-4", "amount": "40.00"},
+        {"sale_date": "2026-03-03", "sale_id": "S-5", "amount": "50.00"},
+    ])
+    return p
+
+
+# ---------------------------------------------------------------------------
+# R1 – Hook reads the DB file path from connection.host
+# ---------------------------------------------------------------------------
+
+class TestDuckDBWarehouseHookConnection:
+    """DuckDBWarehouseHook reads its config from the Airflow connection."""
+
+    def test_hook_opens_file_from_connection_host(self, tmp_path, monkeypatch):
+        """R1: database_path comes from connection.host, not a hardcoded path."""
+        db_file = tmp_path / "my_warehouse.duckdb"
+        # Use a conn_id that is NOT the default ("duckdb_warehouse") so the
+        # operator can't accidentally succeed by falling through to some default.
+        monkeypatch.setenv("AIRFLOW_CONN_TEST_WH", _conn_json(db_file, schema="raw"))
+
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_wh")
+        assert hook.database_path == str(db_file)
+
+    def test_hook_missing_host_raises(self, monkeypatch):
+        """R1 negative: an empty host raises a clear ValueError."""
+        monkeypatch.setenv(
+            "AIRFLOW_CONN_TEST_WH_NOHOST",
+            json.dumps({"conn_type": "generic", "host": "", "schema": "raw"}),
+        )
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_wh_nohost")
+        with pytest.raises(ValueError, match="no host"):
+            _ = hook.database_path
+
+    # -----------------------------------------------------------------------
+    # R2 – Hook reads target schema from connection.schema
+    # -----------------------------------------------------------------------
+
+    def test_hook_schema_comes_from_connection(self, tmp_path, monkeypatch):
+        """R2: target_schema equals connection.schema when it is set."""
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_TEST_WH2", _conn_json(db_file, schema="staging"))
+
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_wh2")
+        assert hook.target_schema == "staging"
+
+    def test_hook_schema_defaults_to_main(self, tmp_path, monkeypatch):
+        """R2 fallback: target_schema == 'main' when connection.schema is blank."""
+        db_file = tmp_path / "wh_noscm.duckdb"
+        monkeypatch.setenv(
+            "AIRFLOW_CONN_TEST_WH_NOSCM",
+            json.dumps({"conn_type": "generic", "host": str(db_file), "schema": ""}),
+        )
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_wh_noscm")
+        assert hook.target_schema == "main"
+
+    def test_get_conn_opens_real_duckdb_file(self, tmp_path, monkeypatch):
+        """R1+R2 integration: get_conn() actually opens the file at connection.host."""
+        db_file = tmp_path / "real.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_TEST_WH3", _conn_json(db_file, schema="raw"))
+
+        from warehouse.hooks import DuckDBWarehouseHook
+
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_wh3")
+        con = hook.get_conn()
+        try:
+            con.execute("CREATE SCHEMA IF NOT EXISTS raw")
+            con.execute("CREATE TABLE raw.ping AS SELECT 1 AS x")
+        finally:
+            con.close()
+
+        # File must exist and be readable via plain duckdb.connect.
+        assert db_file.exists()
+        result = _read_table(db_file, "raw", "ping")
+        assert result == [{"x": 1}]
+
+
+# ---------------------------------------------------------------------------
+# R3 – Operator honours the duckdb_conn_id it is given
+# R4 – execute() loads only rows for partition_date
+# R5 – execute() returns the number of rows loaded
+# ---------------------------------------------------------------------------
+
+class TestCsvPartitionToDuckDBOperatorBasic:
+    """Core loading behaviour of CsvPartitionToDuckDBOperator."""
+
+    def _make_op(self, csv_path, conn_id, partition_date="2026-03-01"):
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        return CsvPartitionToDuckDBOperator(
+            task_id="t",
+            csv_path=str(csv_path),
+            table="sales",
+            partition_column="sale_date",
+            partition_date=partition_date,
+            duckdb_conn_id=conn_id,
+        )
+
+    def test_operator_uses_given_conn_id(self, tmp_path, sales_csv, monkeypatch):
+        """R3: the operator must use the conn_id it was constructed with.
+
+        We register *only* that conn_id (not the default 'duckdb_warehouse').
+        If the operator fell through to the default it would raise
+        AirflowNotFoundException and the test would fail.
+        """
+        db_file = tmp_path / "wh.duckdb"
+        # Deliberately NOT "duckdb_warehouse" (the class default_conn_name).
+        monkeypatch.setenv("AIRFLOW_CONN_CUSTOM_WH", _conn_json(db_file, schema="raw"))
+
+        op = self._make_op(sales_csv, conn_id="custom_wh")
+        op.execute(context={})
+
+        # File was created at the path we specified, proving the custom conn was used.
+        assert db_file.exists()
+
+    def test_execute_loads_only_partition_date_rows(self, tmp_path, sales_csv, monkeypatch):
+        """R4: only rows matching partition_date appear in the table."""
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_WH_R4", _conn_json(db_file, schema="raw"))
+
+        op = self._make_op(sales_csv, conn_id="wh_r4", partition_date="2026-03-01")
+        op.execute(context={})
+
+        rows = _read_table(db_file, "raw", "sales")
+        dates = {r["sale_date"] for r in rows}
+        assert dates == {"2026-03-01"}, f"Unexpected dates in table: {dates}"
+        sale_ids = {r["sale_id"] for r in rows}
+        assert sale_ids == {"S-1", "S-2"}
+
+    def test_execute_returns_row_count(self, tmp_path, sales_csv, monkeypatch):
+        """R5: the return value equals the number of rows loaded."""
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_WH_R5", _conn_json(db_file, schema="raw"))
+
+        op = self._make_op(sales_csv, conn_id="wh_r5", partition_date="2026-03-03")
+        loaded = op.execute(context={})
+
+        rows = _read_table(db_file, "raw", "sales")
+        assert loaded == 2  # S-4 and S-5 are on 2026-03-03
+        assert loaded == len(rows)
+
+    def test_execute_returns_zero_for_date_with_no_rows(self, tmp_path, sales_csv, monkeypatch):
+        """R5 boundary: a date absent from the CSV loads 0 rows and returns 0."""
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_WH_R5Z", _conn_json(db_file, schema="raw"))
+
+        op = self._make_op(sales_csv, conn_id="wh_r5z", partition_date="2099-01-01")
+        loaded = op.execute(context={})
+
+        assert loaded == 0
+        rows = _read_table(db_file, "raw", "sales")
+        assert rows == []
+
+    def test_uses_schema_from_connection(self, tmp_path, sales_csv, monkeypatch):
+        """R2+R4: operator writes into the schema that connection.schema specifies."""
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_WH_SCM", _conn_json(db_file, schema="staging"))
+
+        op = self._make_op(sales_csv, conn_id="wh_scm", partition_date="2026-03-02")
+        op.execute(context={})
+
+        rows = _read_table(db_file, "staging", "sales")
+        assert {r["sale_id"] for r in rows} == {"S-3"}
+
+
+# ---------------------------------------------------------------------------
+# R6 – Re-running the same partition replaces those rows (no duplicates)
+# R7 – A re-run leaves rows for other dates untouched
+# ---------------------------------------------------------------------------
+
+class TestCsvPartitionToDuckDBOperatorIdempotence:
+    """Idempotence: repeated runs produce no duplicates; neighbours are safe."""
+
+    def _make_op(self, csv_path, conn_id, partition_date):
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        return CsvPartitionToDuckDBOperator(
+            task_id="t",
+            csv_path=str(csv_path),
+            table="sales",
+            partition_column="sale_date",
+            partition_date=partition_date,
+            duckdb_conn_id=conn_id,
+        )
+
+    def test_rerun_same_partition_no_duplicates(self, tmp_path, sales_csv, monkeypatch):
+        """R6: running the same partition twice must not double-count its rows."""
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_WH_R6", _conn_json(db_file, schema="raw"))
+
+        op = self._make_op(sales_csv, conn_id="wh_r6", partition_date="2026-03-01")
+        first_count = op.execute(context={})
+        second_count = op.execute(context={})
+
+        rows = _read_table(db_file, "raw", "sales")
+        dates = {r["sale_date"] for r in rows}
+
+        assert dates == {"2026-03-01"}, "Only the loaded partition should be present"
+        assert len(rows) == first_count == second_count == 2, (
+            f"Expected 2 rows, got {len(rows)} after second run (duplicate check)"
+        )
+        # sale_ids must be the original two, each exactly once
+        assert sorted(r["sale_id"] for r in rows) == ["S-1", "S-2"]
+
+    def test_rerun_does_not_affect_other_dates(self, tmp_path, sales_csv, monkeypatch):
+        """R7: re-running partition A must leave partition B's rows unchanged.
+
+        Strategy:
+          1. Load 2026-03-03 (2 rows: S-4, S-5).
+          2. Load 2026-03-01 twice (2 rows: S-1, S-2).
+          3. Assert 2026-03-03 still has exactly S-4 and S-5.
+        """
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_WH_R7", _conn_json(db_file, schema="raw"))
+
+        # Seed a different partition first.
+        op_03 = self._make_op(sales_csv, conn_id="wh_r7", partition_date="2026-03-03")
+        op_03.execute(context={})
+
+        # Load 2026-03-01 twice.
+        op_01 = self._make_op(sales_csv, conn_id="wh_r7", partition_date="2026-03-01")
+        op_01.execute(context={})
+        op_01.execute(context={})
+
+        # 2026-03-03 rows must be untouched.
+        all_rows = _read_table(db_file, "raw", "sales")
+        mar03_rows = [r for r in all_rows if r["sale_date"] == "2026-03-03"]
+        assert sorted(r["sale_id"] for r in mar03_rows) == ["S-4", "S-5"], (
+            f"Rows for 2026-03-03 were altered. Got: {mar03_rows}"
+        )
+
+        # 2026-03-01 rows must also be correct (no extras).
+        mar01_rows = [r for r in all_rows if r["sale_date"] == "2026-03-01"]
+        assert sorted(r["sale_id"] for r in mar01_rows) == ["S-1", "S-2"], (
+            f"Rows for 2026-03-01 are wrong. Got: {mar01_rows}"
+        )
+
+        # Total row count must be exactly 4.
+        assert len(all_rows) == 4, (
+            f"Expected 4 total rows (2 per partition), got {len(all_rows)}"
+        )
+
+    def test_rerun_replaces_rows_when_csv_changes(self, tmp_path, monkeypatch):
+        """R6 extended: if the source CSV is updated, the second run loads the new rows.
+
+        This verifies the DELETE-then-INSERT semantics: the old rows are gone
+        and the new ones are present.
+        """
+        db_file = tmp_path / "wh.duckdb"
+        monkeypatch.setenv("AIRFLOW_CONN_WH_R6B", _conn_json(db_file, schema="raw"))
+
+        csv_path = tmp_path / "evolving.csv"
+
+        # First version of the CSV: one row for the target date.
+        _write_csv(csv_path, [
+            {"sale_date": "2026-03-02", "sale_id": "S-OLD", "amount": "99.00"},
+            {"sale_date": "2026-03-01", "sale_id": "S-NEIGHBOUR", "amount": "5.00"},
+        ])
+
+        from warehouse.operators import CsvPartitionToDuckDBOperator
+
+        op = CsvPartitionToDuckDBOperator(
+            task_id="t",
+            csv_path=str(csv_path),
+            table="sales",
+            partition_column="sale_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="wh_r6b",
+        )
+        op.execute(context={})
+
+        rows_after_first = _read_table(db_file, "raw", "sales")
+        assert {r["sale_id"] for r in rows_after_first if r["sale_date"] == "2026-03-02"} == {"S-OLD"}
+
+        # Second version: replace the target-date row with a different one.
+        _write_csv(csv_path, [
+            {"sale_date": "2026-03-02", "sale_id": "S-NEW", "amount": "77.00"},
+            {"sale_date": "2026-03-01", "sale_id": "S-NEIGHBOUR", "amount": "5.00"},
+        ])
+        count = op.execute(context={})
+
+        rows_after_second = _read_table(db_file, "raw", "sales")
+        mar02_rows = [r for r in rows_after_second if r["sale_date"] == "2026-03-02"]
+
+        assert count == 1
+        assert {r["sale_id"] for r in mar02_rows} == {"S-NEW"}, (
+            "Old row S-OLD should be gone; only S-NEW should remain"
+        )
+        # Neighbour date untouched (not loaded by this operator, so it was never there).
+        assert not any(r["sale_date"] == "2026-03-01" for r in rows_after_second)
