+"""Daily revenue report per store.
+
+Runs every day at 03:00 UTC and reports on the previous calendar day
+(midnight-to-midnight UTC).  Late orders trickle in until ~02:00, so by the
+time this runs at 03:00 the day's data is complete.
+
+Output: output/daily_revenue/<YYYY-MM-DD>.csv
+Columns: store_id, orders, revenue  (revenue rounded to 2 dp, sorted by store_id)
+
+Idempotent: the file is written atomically (temp-rename) so a rerun produces
+the same result.
+"""
+
+from __future__ import annotations
+
+import csv
+import os
+import tempfile
+from pathlib import Path
+
+import pendulum
+from airflow.sdk import dag, task
+from airflow.timetables.trigger import CronTriggerTimetable
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DATA_FILE = PROJECT_ROOT / "data" / "orders.csv"
+
+
+# ---------------------------------------------------------------------------
+# Date helpers (from the verified run_window recipe in references/dates-and-schedules.md)
+# ---------------------------------------------------------------------------
+
+def _prev_day(d: pendulum.DateTime) -> pendulum.DateTime:
+    return d.subtract(days=1)
+
+
+def _run_window(dag_run, params=None):
+    """Return (start, end) UTC datetimes for the calendar day this run reports on.
+
+    Under the CronTriggerTimetable the run carries no interval, so we derive
+    the previous calendar day from run_after (the anchor).
+
+    For reruns / backfills we also honour params["day"] so analysts can
+    reprocess any specific date.
+    """
+    tz = "UTC"
+    day_override = (params or {}).get("day")
+    if day_override:
+        start = pendulum.parse(day_override, tz=tz)
+        return start, start.add(days=1)
+
+    s, e = dag_run.data_interval_start, dag_run.data_interval_end
+    if s is not None and e is not None and e > s:
+        # interval timetable (should not happen with CronTriggerTimetable, but
+        # handle gracefully)
+        return pendulum.instance(s).in_tz(tz), pendulum.instance(e).in_tz(tz)
+
+    anchor = dag_run.logical_date or dag_run.run_after
+    start = _prev_day(pendulum.instance(anchor).in_tz(tz).start_of("day"))
+    return start, start.add(days=1)
+
+
+# ---------------------------------------------------------------------------
+# DAG
+# ---------------------------------------------------------------------------
+
+@dag(
+    dag_id="daily_revenue",
+    schedule=CronTriggerTimetable("0 3 * * *", timezone="UTC"),
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=True,          # allow backfilling since 2026-09-01
+    max_active_runs=1,     # run days sequentially during catch-up
+    params={"day": None},  # optional: override the reported day, e.g. "2026-09-14"
+    tags=["finance", "revenue"],
+)
+def daily_revenue():
+
+    @task
+    def compute_and_write(**context) -> str:
+        import csv as _csv  # heavy-ish; keep inside the task
+
+        dag_run = context["dag_run"]
+        params = context.get("params")
+        start, end = _run_window(dag_run, params)
+        report_date = start.to_date_string()          # "YYYY-MM-DD"
+
+        out_dir = PROJECT_ROOT / "output" / "daily_revenue"
+        out_dir.mkdir(parents=True, exist_ok=True)
+        out_file = out_dir / f"{report_date}.csv"
+
+        # ---- read & aggregate ----------------------------------------
+        # Parse orders.csv; filter to the half-open window [start, end).
+        # We use only stdlib so there is no parse-time import of pandas.
+        store_orders: dict[str, int] = {}
+        store_revenue: dict[str, float] = {}
+
+        with open(DATA_FILE, newline="", encoding="utf-8") as fh:
+            reader = _csv.DictReader(fh)
+            for row in reader:
+                ts = pendulum.parse(row["order_ts"], tz="UTC")
+                if not (start <= ts < end):
+                    continue
+                sid = row["store_id"]
+                store_orders[sid] = store_orders.get(sid, 0) + 1
+                store_revenue[sid] = store_revenue.get(sid, 0.0) + float(row["amount"])
+
+        rows = [
+            {
+                "store_id": sid,
+                "orders": store_orders[sid],
+                "revenue": round(store_revenue[sid], 2),
+            }
+            for sid in sorted(store_orders)
+        ]
+
+        # ---- atomic write --------------------------------------------
+        # Write to a temp file in the same directory, then rename so a
+        # rerun never leaves a partial file.
+        fd, tmp_path = tempfile.mkstemp(dir=out_dir, prefix=".tmp_", suffix=".csv")
+        try:
+            with os.fdopen(fd, "w", newline="", encoding="utf-8") as fh:
+                writer = _csv.DictWriter(fh, fieldnames=["store_id", "orders", "revenue"])
+                writer.writeheader()
+                writer.writerows(rows)
+            os.replace(tmp_path, out_file)
+        except Exception:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
+
+        return str(out_file)
+
+    compute_and_write()
+
+
+daily_revenue()
