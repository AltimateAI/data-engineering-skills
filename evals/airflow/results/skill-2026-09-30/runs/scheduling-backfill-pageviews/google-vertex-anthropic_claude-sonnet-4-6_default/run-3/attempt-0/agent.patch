+def _run_window(dag_run):
+    """Return (start, end) as pendulum UTC datetimes for the period this run covers.
+
+    Under CronDataIntervalTimetable the interval is always present and non-zero,
+    so we read it directly.  data_interval_start is D-1 03:00 UTC and
+    data_interval_end is D 03:00 UTC; we want the UTC calendar date of the start.
+    """
+    s = pendulum.instance(dag_run.data_interval_start).in_tz("UTC")
+    e = pendulum.instance(dag_run.data_interval_end).in_tz("UTC")
+    return s, e
+
