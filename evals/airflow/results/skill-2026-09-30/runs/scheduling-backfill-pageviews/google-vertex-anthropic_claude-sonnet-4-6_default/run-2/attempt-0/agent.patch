+def _run_window(dag_run):
+    """Return (start, end) for the day this run should process.
+
+    Under CronDataIntervalTimetable the interval is always present for
+    scheduled and backfill runs.  For manual runs (no interval) we fall
+    back to ``logical_date or run_after`` and subtract one day so the
+    period contract is preserved.
+    """
+    s = dag_run.data_interval_start
+    e = dag_run.data_interval_end
+    if s is not None and e is not None and e > s:
+        # Scheduled / backfill run: the interval IS the day to process.
+        return pendulum.instance(s).in_tz("UTC"), pendulum.instance(e).in_tz("UTC")
