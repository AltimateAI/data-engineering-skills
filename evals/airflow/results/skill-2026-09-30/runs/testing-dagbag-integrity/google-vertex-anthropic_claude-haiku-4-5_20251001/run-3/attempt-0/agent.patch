+#!/usr/bin/env python3
+"""
+Mutation testing harness for DAG integrity tests.
+
+This script verifies that each integrity test catches its corresponding rule violation
+by mutating the DAG files and re-running pytest. Each mutation should cause at least
+one test to fail.
+
+Mutations tested:
+1. Import error in a DAG file → test_no_import_errors should fail
+2. Missing tag on a DAG → test_all_dags_have_tags should fail
+3. catchup=True on a DAG → test_all_dags_have_catchup_false should fail
+4. owner="airflow" on a task → test_all_tasks_have_real_owner should fail
+5. retries=1 on a task → test_all_tasks_have_two_retries should fail
+6. Wrong task order in orders_ingest → test_orders_ingest_task_order should fail
+"""
+
+import subprocess
+import tempfile
+import shutil
+import os
+import sys
+from pathlib import Path
+
+
+class MutationTest:
+    """A single mutation test case."""
+
+    def __init__(self, name, file_path, original, mutation, expected_fail_tests):
+        self.name = name
+        self.file_path = file_path
+        self.original = original
+        self.mutation = mutation
+        self.expected_fail_tests = expected_fail_tests
+
+    def apply(self):
+        """Apply the mutation to the file."""
+        with open(self.file_path, 'r') as f:
+            content = f.read()
+        
+        if self.original not in content:
+            raise ValueError(
+                f"Mutation '{self.name}': original string not found in {self.file_path}"
+            )
+        
+        # Replace first occurrence only
+        new_content = content.replace(self.original, self.mutation, 1)
+        with open(self.file_path, 'w') as f:
+            f.write(new_content)
+
+    def revert(self):
+        """Revert the mutation."""
+        with open(self.file_path, 'r') as f:
+            content = f.read()
+        
+        new_content = content.replace(self.mutation, self.original, 1)
+        with open(self.file_path, 'w') as f:
+            f.write(new_content)
+
+
+def run_tests():
+    """Run pytest and return (passed, failed, errors)."""
+    result = subprocess.run(
+        [sys.executable, '-m', 'pytest', 'tests/', '-v', '--tb=short'],
+        cwd=os.getcwd(),
+        capture_output=True,
+        text=True
+    )
+    return result.returncode == 0, result.stdout, result.stderr
+
+
+def parse_pytest_output(stdout):
+    """Extract which tests failed from pytest output."""
+    failed = []
+    for line in stdout.split('\n'):
+        if 'FAILED' in line:
+            # Extract test name from lines like: "tests/test_dag_integrity.py::test_name FAILED"
+            parts = line.split('::')
+            if len(parts) >= 2:
+                test_name = parts[1].split(' ')[0]
+                failed.append(test_name)
+    return failed
+
+
+def main():
+    """Run all mutation tests."""
+    ws_root = os.getcwd()
+    dags_dir = os.path.join(ws_root, 'dags')
+    
+    if not os.path.isdir(dags_dir):
+        print(f"Error: dags/ directory not found at {dags_dir}")
+        sys.exit(1)
+    
+    mutations = [
+        MutationTest(
+            name="Import error in customer_snapshot.py",
+            file_path=os.path.join(dags_dir, 'customer_snapshot.py'),
+            original='from datetime import datetime, timedelta',
+            mutation='from datetime import datetime, timedelta_invalid  # MUTATION',
+            expected_fail_tests=['test_no_import_errors']
+        ),
+        MutationTest(
+            name="Missing tag on customer_snapshot DAG",
+            file_path=os.path.join(dags_dir, 'customer_snapshot.py'),
+            original='    tags=["customers"],',
+            mutation='    tags=[],  # MUTATION: removed tag',
+            expected_fail_tests=['test_all_dags_have_tags']
+        ),
+        MutationTest(
+            name="catchup=True on marketing_spend DAG",
+            file_path=os.path.join(dags_dir, 'marketing_spend.py'),
+            original='    catchup=False,',
+            mutation='    catchup=True,  # MUTATION',
+            expected_fail_tests=['test_all_dags_have_catchup_false']
+        ),
+        MutationTest(
+            name="owner='airflow' in default_args",
+            file_path=os.path.join(dags_dir, 'orders_ingest.py'),
+            original='    "owner": "data-platform",',
+            mutation='    "owner": "airflow",  # MUTATION: default owner',
+            expected_fail_tests=['test_all_tasks_have_real_owner']
+        ),
+        MutationTest(
+            name="retries=1 in default_args",
+            file_path=os.path.join(dags_dir, 'orders_ingest.py'),
+            original='    "retries": 2,',
+            mutation='    "retries": 1,  # MUTATION: insufficient retries',
+            expected_fail_tests=['test_all_tasks_have_two_retries']
+        ),
+        MutationTest(
+            name="Wrong task order in orders_ingest",
+            file_path=os.path.join(dags_dir, 'orders_ingest.py'),
+            original='    publish_summary(load_orders(validate_orders(extract_orders())))',
+            mutation='    load_orders(publish_summary(validate_orders(extract_orders())))  # MUTATION',
+            expected_fail_tests=['test_orders_ingest_task_order']
+        ),
+    ]
+    
+    print("=" * 80)
+    print("MUTATION TESTING HARNESS")
+    print("=" * 80)
+    
+    results = []
+    
+    for mutation in mutations:
+        print(f"\n[TEST] {mutation.name}")
+        print(f"  File: {mutation.file_path}")
+        print(f"  Expected failures: {', '.join(mutation.expected_fail_tests)}")
+        
+        try:
+            # Apply mutation
+            mutation.apply()
+            print(f"  ✓ Mutation applied")
+            
+            # Run tests
+            passed, stdout, stderr = run_tests()
+            
+            if passed:
+                print(f"  ✗ FAILED: All tests still passed (mutation not detected)")
+                results.append({
+                    'name': mutation.name,
+                    'success': False,
+                    'reason': 'Tests still passed'
+                })
+            else:
+                # Check which tests failed
+                failed_tests = parse_pytest_output(stdout)
+                expected_set = set(mutation.expected_fail_tests)
+                failed_set = set(failed_tests)
+                
+                if expected_set & failed_set:  # At least one expected test failed
+                    print(f"  ✓ SUCCESS: Expected test(s) failed: {', '.join(failed_set)}")
+                    results.append({
+                        'name': mutation.name,
+                        'success': True,
+                        'failed_tests': list(failed_set)
+                    })
+                else:
+                    print(f"  ✗ FAILED: Wrong tests failed. Expected {expected_set}, got {failed_set}")
+                    results.append({
+                        'name': mutation.name,
+                        'success': False,
+                        'reason': f'Wrong tests failed: {failed_set}'
+                    })
+        
+        except Exception as e:
+            print(f"  ✗ ERROR: {e}")
+            results.append({
+                'name': mutation.name,
+                'success': False,
+                'reason': str(e)
+            })
+        
+        finally:
+            # Revert mutation
+            try:
+                mutation.revert()
+                print(f"  ✓ Mutation reverted")
+            except Exception as e:
+                print(f"  ✗ ERROR reverting mutation: {e}")
+    
+    # Summary
+    print("\n" + "=" * 80)
+    print("SUMMARY")
+    print("=" * 80)
+    
+    successes = sum(1 for r in results if r['success'])
+    total = len(results)
+    
+    for r in results:
+        status = "✓" if r['success'] else "✗"
+        print(f"{status} {r['name']}")
+    
+    print(f"\nTotal: {successes}/{total} mutations correctly detected")
+    
+    if successes == total:
+        print("\n✓ All mutation tests passed!")
+        return 0
+    else:
+        print(f"\n✗ {total - successes} mutation test(s) failed!")
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
