+"""
+Test DAG integrity, imports, and policy compliance.
+
+Rules enforced:
+1. All files in dags/ must import without errors or cycles
+2. Every DAG must have at least one tag
+3. Every DAG must have catchup=False
+4. Every task must have owner != "airflow" (real owner)
+5. Every task must have retries >= 2
+6. orders_ingest must have tasks in exact order:
+   extract_orders -> validate_orders -> load_orders -> publish_summary
+"""
+
+
+EXPECTED_DAGS = {"orders_ingest", "customer_snapshot", "marketing_spend"}
+
+
+def test_no_import_errors(dagbag):
+    """Fail if any file in dags/ fails to import or has cycles."""
+    assert dagbag.import_errors == {}, "\n\n".join(
+        f"{f}:\n{e}" for f, e in dagbag.import_errors.items()
+    )
+
+
+def test_expected_dags_load(dagbag):
+    """Fail if any expected DAG stops being defined (e.g., syntax error, missing decorator)."""
+    assert EXPECTED_DAGS <= set(dagbag.dags), f"Missing DAGs: {EXPECTED_DAGS - set(dagbag.dags)}"
+
+
+def test_all_dags_have_tags(dagbag):
+    """Every DAG must have at least one tag."""
+    bad = [d.dag_id for d in dagbag.dags.values() if not d.tags]
+    assert not bad, f"DAGs without tags: {bad}"
+
+
+def test_all_dags_have_catchup_false(dagbag):
+    """Every DAG must have catchup=False."""
+    bad = [d.dag_id for d in dagbag.dags.values() if d.catchup is not False]
+    assert not bad, f"DAGs with catchup != False: {bad}"
+
+
+def test_all_tasks_have_real_owner(dagbag):
+    """Every task must have an owner != 'airflow' (the default)."""
+    bad = []
+    for d in dagbag.dags.values():
+        for t in d.tasks:
+            if t.owner == "airflow":
+                bad.append((d.dag_id, t.task_id, t.owner))
+    assert not bad, f"Tasks with default owner 'airflow': {bad}"
+
+
+def test_all_tasks_have_two_retries(dagbag):
+    """Every task must have retries >= 2."""
+    bad = []
+    for d in dagbag.dags.values():
+        for t in d.tasks:
+            if t.retries < 2:
+                bad.append((d.dag_id, t.task_id, t.retries))
+    assert not bad, f"Tasks with retries < 2: {bad}"
+
+
+def test_orders_ingest_task_order(dagbag):
+    """orders_ingest must have tasks in exact order:
+    extract_orders -> validate_orders -> load_orders -> publish_summary
+    """
+    dag = dagbag.dags["orders_ingest"]
+    expected = {
+        "extract_orders": set(),
+        "validate_orders": {"extract_orders"},
+        "load_orders": {"validate_orders"},
+        "publish_summary": {"load_orders"},
+    }
+    actual = {t: dag.get_task(t).upstream_task_ids for t in expected}
+    assert actual == expected, f"Task order mismatch.\nExpected: {expected}\nActual: {actual}"
