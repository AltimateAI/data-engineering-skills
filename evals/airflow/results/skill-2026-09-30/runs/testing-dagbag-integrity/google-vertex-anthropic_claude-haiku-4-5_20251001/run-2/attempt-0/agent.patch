+"""Tests for the orders_ingest DAG structure and task ordering.
+
+The orders_ingest pipeline has a strict sequential order:
+  extract_orders -> validate_orders -> load_orders -> publish_summary
+
+Any change to this order breaks downstream consumers and must be detected.
+"""
+
+import pytest
+
+
+def test_orders_ingest_task_order(dagbag):
+    """Verify the orders_ingest pipeline executes in the exact required order.
+    
+    The pipeline must follow: extract -> validate -> load -> publish
+    """
+    dag = dagbag.dags["orders_ingest"]
+    
+    # Expected task sequence
+    expected_order = ["extract_orders", "validate_orders", "load_orders", "publish_summary"]
+    
+    # Get the actual upstream dependencies for each task
+    actual_tasks = list(dag.task_dict.keys())
+    
+    # Build the actual ordering by walking the dependency graph
+    task_order = []
+    current = dag.task_dict.get("extract_orders")
+    
+    if current is None:
+        pytest.fail(f"Task 'extract_orders' not found in dag. Available tasks: {actual_tasks}")
+    
+    task_order.append(current.task_id)
+    
+    while current:
+        # Get the next task (downstream)
+        downstream = list(current.downstream_list)
+        if not downstream:
+            current = None
+        elif len(downstream) == 1:
+            current = downstream[0]
+            task_order.append(current.task_id)
+        else:
+            pytest.fail(
+                f"Task {current.task_id} has multiple downstream tasks {[t.task_id for t in downstream]}. "
+                f"Expected a linear pipeline."
+            )
+    
+    # Verify the order matches exactly
+    assert task_order == expected_order, (
+        f"orders_ingest task order mismatch.\n"
+        f"Expected: {expected_order}\n"
+        f"Actual:   {task_order}"
+    )
+
+
+def test_orders_ingest_has_four_tasks(dagbag):
+    """Verify orders_ingest has exactly the four expected tasks."""
+    dag = dagbag.dags["orders_ingest"]
+    expected_tasks = {"extract_orders", "validate_orders", "load_orders", "publish_summary"}
+    actual_tasks = set(dag.task_dict.keys())
+    
+    assert actual_tasks == expected_tasks, (
+        f"orders_ingest task set mismatch.\n"
+        f"Expected: {expected_tasks}\n"
+        f"Actual: {actual_tasks}\n"
+        f"Missing: {expected_tasks - actual_tasks}\n"
+        f"Extra: {actual_tasks - expected_tasks}"
+    )
+
+
+def test_orders_ingest_extract_has_no_upstream(dagbag):
+    """Verify extract_orders is the first task (no upstream dependencies)."""
+    dag = dagbag.dags["orders_ingest"]
+    extract = dag.task_dict["extract_orders"]
+    
+    assert len(extract.upstream_list) == 0, (
+        f"extract_orders should be the first task with no upstream, "
+        f"but has upstream: {[t.task_id for t in extract.upstream_list]}"
+    )
+
+
+def test_orders_ingest_publish_has_no_downstream(dagbag):
+    """Verify publish_summary is the last task (no downstream dependencies)."""
+    dag = dagbag.dags["orders_ingest"]
+    publish = dag.task_dict["publish_summary"]
+    
+    assert len(publish.downstream_list) == 0, (
+        f"publish_summary should be the last task with no downstream, "
+        f"but has downstream: {[t.task_id for t in publish.downstream_list]}"
+    )
