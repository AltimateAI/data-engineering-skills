+"""Tests for DAG import integrity and basic structure.
+
+Tests in this file verify:
+- All files in dags/ import successfully with no errors
+- Expected DAGs are defined
+"""
+
+import pytest
+
+
+def test_no_import_errors(dagbag):
+    """Fail if any DAG file fails to import.
+    
+    This catches syntax errors, cycles, undefined references, and other errors
+    that prevent a DAG from being parsed.
+    """
+    assert dagbag.import_errors == {}, (
+        f"DAG files failed to import:\n"
+        f"{dagbag.import_errors}"
+    )
+
+
+def test_expected_dags_exist(dagbag):
+    """Verify that the expected DAGs are defined."""
+    expected = {"orders_ingest", "customer_snapshot", "marketing_spend"}
+    actual = set(dagbag.dags.keys())
+    
+    assert expected == actual, (
+        f"DAGs mismatch.\n"
+        f"Expected: {expected}\n"
+        f"Actual: {actual}\n"
+        f"Missing: {expected - actual}\n"
+        f"Extra: {actual - expected}"
+    )
