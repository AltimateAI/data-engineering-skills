+"""Tests for DAG and task configuration policies.
+
+Tests in this file verify:
+- Every DAG has at least one tag
+- Every DAG has catchup=False
+- Every task has a real owner (not the default "airflow")
+- Every task has at least 2 retries
+"""
+
+import pytest
+
+
+def test_every_dag_has_tags(dagbag):
+    """Every DAG must have at least one tag for organization and discoverability."""
+    failures = []
+    for dag_id in dagbag.dags:
+        dag = dagbag.dags[dag_id]
+        if not dag.tags:
+            failures.append(f"{dag_id}: no tags")
+    
+    assert not failures, f"DAGs with missing tags:\n" + "\n".join(failures)
+
+
+def test_every_dag_has_catchup_false(dagbag):
+    """Every DAG must have catchup=False to prevent unintended backfill runs."""
+    failures = []
+    for dag_id in dagbag.dags:
+        dag = dagbag.dags[dag_id]
+        if dag.catchup is not False:
+            failures.append(f"{dag_id}: catchup={dag.catchup} (expected False)")
+    
+    assert not failures, f"DAGs with catchup enabled:\n" + "\n".join(failures)
+
+
+def test_every_task_has_real_owner(dagbag):
+    """Every task must have an explicit owner (not the default 'airflow').
+    
+    A real owner is required for alerting and accountability.
+    """
+    failures = []
+    for dag_id in dagbag.dags:
+        dag = dagbag.dags[dag_id]
+        for task in dag.tasks:
+            if task.owner == "airflow":
+                failures.append(f"{dag_id}.{task.task_id}: owner is 'airflow' (default)")
+            elif not task.owner or task.owner.strip() == "":
+                failures.append(f"{dag_id}.{task.task_id}: owner is empty")
+    
+    assert not failures, f"Tasks with invalid owners:\n" + "\n".join(failures)
+
+
+def test_every_task_has_minimum_retries(dagbag):
+    """Every task must have at least 2 retries for resilience against transient failures."""
+    failures = []
+    for dag_id in dagbag.dags:
+        dag = dagbag.dags[dag_id]
+        for task in dag.tasks:
+            if task.retries < 2:
+                failures.append(
+                    f"{dag_id}.{task.task_id}: retries={task.retries} (minimum 2 required)"
+                )
+    
+    assert not failures, f"Tasks with insufficient retries:\n" + "\n".join(failures)
