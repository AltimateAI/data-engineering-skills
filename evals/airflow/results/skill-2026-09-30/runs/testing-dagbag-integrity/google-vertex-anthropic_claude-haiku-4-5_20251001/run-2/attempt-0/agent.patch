+"""Pytest configuration for Airflow DAG tests.
+
+This module sets up the Airflow environment for testing:
+- Uses a throwaway SQLite DB (no dev DB pollution)
+- Sets DAGS_FOLDER to dags/
+- Disables example DAGs
+- Provides fixtures for DagBag, DB migration, and schedule generation
+"""
+
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# Airflow reads its config once, on first import, so set everything before any airflow import.
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+sys.path.insert(0, str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    """Load all DAGs from the dags/ folder.
+    
+    Returns a DagBag object that can be queried with dagbag.dags[dag_id].
+    Raises if any DAG file fails to import.
+    """
+    try:
+        from airflow.dag_processing.dagbag import DagBag  # Airflow >= 3.2
+    except ImportError:
+        from airflow.models.dagbag import DagBag          # Airflow 2.x, 3.0, 3.1
+    return DagBag(dag_folder=str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def airflow_db():
+    """Migrate the throwaway metadata DB. Only dag.test() tests need it."""
+    subprocess.run([sys.executable, "-m", "airflow", "db", "migrate"], check=True, capture_output=True)
+
+
+@pytest.fixture(scope="session")
+def upcoming_runs():
+    """Generate the next N scheduled run times for a DAG.
+    
+    Args:
+        dag: The DAG object
+        after: Earliest datetime to consider (aware, in UTC)
+        n: Number of runs to generate
+        
+    Returns:
+        List of n aware datetimes when the scheduler would start a run
+    """
+    from airflow.timetables.base import TimeRestriction
+
+    def _runs(dag, after, n):
+        tt = dag.timetable
+        try:
+            from airflow.serialization.encoders import coerce_to_core_timetable  # Airflow >= 3.0
+            tt = coerce_to_core_timetable(tt)
+        except ImportError:
+            pass
+        restriction = TimeRestriction(earliest=after, latest=None, catchup=True)
+        last, runs = None, []
+        for _ in range(n):
+            info = tt.next_dagrun_info(last_automated_data_interval=last, restriction=restriction)
+            if info is None:
+                break
+            runs.append(info.run_after)
+            last = info.data_interval
+        return runs
+
+    return _runs
