+"""Pytest configuration for Airflow DAG tests.
+
+Sets up a throwaway environment (temp AIRFLOW_HOME, in-memory SQLite) so tests
+are fully self-contained and leave no side effects.  Airflow reads its config on
+first import, so all env vars are set before any airflow module is touched.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# --- must happen before any airflow import ---
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+
+# Allow test files to import DAG helper modules by name
+sys.path.insert(0, str(DAGS))
+
+
+@pytest.fixture(scope="session")
+def dagbag():
+    """Load all DAGs from the project's dags/ folder once per session."""
+    try:
+        from airflow.dag_processing.dagbag import DagBag  # Airflow >= 3.2
+    except ImportError:
+        from airflow.models.dagbag import DagBag  # Airflow 2.x / 3.0 / 3.1
+
+    return DagBag(dag_folder=str(DAGS))
