+"""
+Pytest configuration for Airflow DAG tests.
+
+Sets all required environment variables *before* any Airflow import so that
+Airflow reads them on first initialisation.  Uses a throwaway sqlite DB so
+tests never touch a developer's or CI's real metadata store.
+
+Compatible with Airflow 3.x (tested against 3.3).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+# ── paths ──────────────────────────────────────────────────────────────────────
+REPO = Path(__file__).resolve().parents[1]
+DAGS = REPO / "dags"
+
+# ── Airflow environment ─────────────────────────────────────────────────────────
+# Must be set before *any* airflow import; Airflow reads config once on startup.
+_TMP = Path(tempfile.mkdtemp(prefix="dag-tests-"))
+os.environ["AIRFLOW__CORE__DAGS_FOLDER"] = str(DAGS)
+os.environ["AIRFLOW__CORE__LOAD_EXAMPLES"] = "False"
+os.environ["AIRFLOW__DATABASE__SQL_ALCHEMY_CONN"] = f"sqlite:///{_TMP / 'airflow.db'}"
+os.environ.setdefault("AIRFLOW_HOME", str(_TMP))
+
+# Make DAG helper modules importable (e.g. `from orders_ingest import …`)
+sys.path.insert(0, str(DAGS))
+
+
+# ── shared fixtures ─────────────────────────────────────────────────────────────
+
+@pytest.fixture(scope="session")
+def dagbag():
+    """Load all DAGs from dags/ exactly once per test session."""
+    try:
+        from airflow.dag_processing.dagbag import DagBag  # Airflow >= 3.2
+    except ImportError:
+        from airflow.models.dagbag import DagBag          # Airflow 2.x / 3.0 / 3.1
+    return DagBag(dag_folder=str(DAGS))
