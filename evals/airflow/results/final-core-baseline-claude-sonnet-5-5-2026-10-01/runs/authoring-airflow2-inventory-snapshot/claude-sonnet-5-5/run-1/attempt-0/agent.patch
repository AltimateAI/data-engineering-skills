+"""Daily end-of-day inventory snapshot per warehouse and SKU, plus low-stock report.
+
+Follows the repo convention: one file per logical date (`{{ ds }}`) under
+output/<dag_id>/ (and output/low_stock/), so a rerun simply overwrites that day.
+"""
+
+from __future__ import annotations
+
+import csv
+from collections import defaultdict
+from datetime import timedelta
+from pathlib import Path
+
+import pendulum
+from airflow.decorators import dag, task
+from airflow.operators.empty import EmptyOperator
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DATA_DIR = PROJECT_ROOT / "data"
+OUTPUT_DIR = PROJECT_ROOT / "output"
+
+
+@dag(
+    dag_id="inventory_snapshot",
+    schedule="30 2 * * *",
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=False,
+    default_args={"owner": "supply-chain-analytics", "retries": 1, "retry_delay": timedelta(minutes=10)},
+    tags=["inventory"],
+)
+def inventory_snapshot():
+    start = EmptyOperator(task_id="start")
+
+    @task
+    def snapshot(ds=None) -> str:
+        totals: dict[tuple[str, str], int] = defaultdict(int)
+        with (DATA_DIR / "inventory_movements.csv").open(newline="") as fh:
+            for row in csv.DictReader(fh):
+                # ISO dates compare correctly as strings; include the run date itself.
+                if row["movement_date"] <= ds:
+                    totals[(row["warehouse_id"], row["sku"])] += int(row["qty_change"])
+        out = OUTPUT_DIR / "inventory_snapshot" / f"{ds}.csv"
+        out.parent.mkdir(parents=True, exist_ok=True)
+        with out.open("w", newline="") as fh:
+            writer = csv.writer(fh)
+            writer.writerow(["warehouse_id", "sku", "on_hand"])
+            for (warehouse_id, sku) in sorted(totals):
+                writer.writerow([warehouse_id, sku, totals[(warehouse_id, sku)]])
+        return str(out)
+
+    @task
+    def low_stock(snapshot_path: str, ds=None) -> str:
+        with (DATA_DIR / "reorder_points.csv").open(newline="") as fh:
+            reorder_points = {r["sku"]: int(r["reorder_point"]) for r in csv.DictReader(fh)}
+        rows = []
+        with open(snapshot_path, newline="") as fh:
+            for row in csv.DictReader(fh):
+                on_hand = int(row["on_hand"])
+                point = reorder_points.get(row["sku"])
+                if point is not None and on_hand < point:
+                    rows.append((row["warehouse_id"], row["sku"], on_hand, point))
+        out = OUTPUT_DIR / "low_stock" / f"{ds}.csv"
+        out.parent.mkdir(parents=True, exist_ok=True)
+        with out.open("w", newline="") as fh:
+            writer = csv.writer(fh)
+            writer.writerow(["warehouse_id", "sku", "on_hand", "reorder_point"])
+            writer.writerows(sorted(rows))
+        return str(out)
+
+    start >> low_stock(snapshot())
+
+
+inventory_snapshot()
