+NY_TZ = "America/New_York"
+
+
+def previous_business_day(run_time: pendulum.DateTime) -> str:
+    """Previous weekday (YYYY-MM-DD) before ``run_time``, in New York time.
+
+    Monday (and any weekend day, for manual runs) maps to the prior Friday.
+    Bank holidays are not considered.
+    """
+    day = run_time.in_timezone(NY_TZ).start_of("day").subtract(days=1)
+    while day.day_of_week in (pendulum.SATURDAY, pendulum.SUNDAY):
+        day = day.subtract(days=1)
+    return day.to_date_string()
+
+
