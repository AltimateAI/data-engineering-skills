@@ -0,0 +1,63 @@
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from croniter import croniter
+
+from conftest import DAGS_DIR
+
+DAG_FILES = sorted(p.name for p in DAGS_DIR.glob("*.py"))
+
+
+def test_dag_files_found():
+    assert DAG_FILES
+
+
+@pytest.mark.parametrize("filename", DAG_FILES)
+def test_dag_file_imports(dagbag, filename):
+    errors = {Path(k).name: v for k, v in dagbag.import_errors.items()}
+    assert filename not in errors, errors.get(filename)
+
+
+def test_no_import_errors(dagbag):
+    assert dagbag.import_errors == {}
+
+
+def test_every_dag_file_defines_a_dag(dagbag):
+    files_with_dags = {Path(d.fileloc).name for d in dagbag.dags.values()}
+    assert files_with_dags == set(DAG_FILES)
+
+
+def test_shipments_daily_schedule_is_0730_utc_weekdays(dagbag):
+    dag = dagbag.dags["shipments_daily"]
+    assert dag is not None
+    assert str(dag.timezone) == "UTC"
+    assert isinstance(dag.schedule_interval, str)
+
+    it = croniter(dag.schedule_interval, datetime(2026, 3, 1, tzinfo=timezone.utc))
+    end = datetime(2026, 3, 29, tzinfo=timezone.utc)  # four full weeks
+    fires = []
+    while (nxt := it.get_next(datetime)) < end:
+        fires.append(nxt)
+    assert all((f.hour, f.minute, f.second) == (7, 30, 0) for f in fires)
+    assert all(f.weekday() < 5 for f in fires)
+    start = datetime(2026, 3, 1, tzinfo=timezone.utc)
+    expected = {
+        (start + timedelta(days=i)).date() for i in range(28) if (start + timedelta(days=i)).weekday() < 5
+    }
+    assert {f.date() for f in fires} == expected  # every weekday fires exactly once
+
+
+def test_every_task_has_at_least_two_retries(dagbag):
+    tasks = [(dag.dag_id, t) for dag in dagbag.dags.values() for t in dag.tasks]
+    assert tasks
+    too_few = {f"{d}.{t.task_id}": t.retries for d, t in tasks if (t.retries or 0) < 2}
+    assert too_few == {}
+
+
+def test_report_runs_after_extract(dagbag):
+    dag = dagbag.dags["shipments_daily"]
+    report = dag.get_task("build_report")
+    extract = dag.get_task("extract_shipments")
+    assert extract.task_id in report.upstream_task_ids
+    assert report.task_id in {t.task_id for t in extract.get_flat_relatives(upstream=False)}
