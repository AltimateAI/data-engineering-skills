@@ -0,0 +1,84 @@
+import csv
+
+import pytest
+
+from conftest import ROOT
+
+AS_OF = "2026-03-03"
+
+
+def ship(sid, promised, delivered="", ship_date="2026-02-01"):
+    return {
+        "shipment_id": sid,
+        "ship_date": ship_date,
+        "carrier": "DHL",
+        "promised_date": promised,
+        "delivered_date": delivered,
+    }
+
+
+def late(module, rows, as_of=AS_OF):
+    return {r["shipment_id"]: r["days_late"] for r in module.find_late_shipments(rows, as_of)}
+
+
+@pytest.mark.parametrize(
+    "promised, delivered, expected",
+    [
+        ("2026-03-02", AS_OF, 1),  # delivered today, one day after promise
+        ("2026-02-24", AS_OF, 7),
+        (AS_OF, AS_OF, None),  # delivered on the promised date: on time
+        ("2026-03-04", AS_OF, None),  # delivered early
+        ("2026-02-24", "2026-03-02", None),  # late, but reported on its own delivery day
+        ("2026-02-24", "2026-03-04", None),  # delivered after the run date
+        ("2026-03-02", "", 1),  # open, promised before run date
+        ("2026-02-26", "", 5),
+        (AS_OF, "", None),  # open, promised today: not late yet
+        ("2026-03-04", "", None),  # open, promised in the future
+    ],
+)
+def test_late_rules(shipments_module, promised, delivered, expected):
+    result = late(shipments_module, [ship("S", promised, delivered)])
+    assert result == ({} if expected is None else {"S": expected})
+
+
+def test_late_results_sorted_worst_first_then_by_id(shipments_module):
+    rows = [ship("B", "2026-03-01"), ship("C", "2026-02-20"), ship("A", "2026-03-01")]
+    out = shipments_module.find_late_shipments(rows, AS_OF)
+    assert [r["shipment_id"] for r in out] == ["C", "A", "B"]
+
+
+def test_shipments_daily_end_to_end_on_sample_data(dagbag, shipments_module, monkeypatch, tmp_path):
+    """Run the DAG's tasks in dependency order on data/ for 2026-03-03.
+
+    Tasks are executed directly (XCom stubbed in memory) so no Airflow metadata
+    DB or scheduler is needed; output goes to tmp_path, not the repo.
+    """
+    monkeypatch.setattr(shipments_module, "DATA_DIR", ROOT / "data")
+    monkeypatch.setattr(shipments_module, "OUTPUT_DIR", tmp_path)
+
+    xcoms = {}
+
+    class StubTI:
+        def xcom_pull(self, task_ids):
+            return xcoms.get(task_ids)
+
+    dag = dagbag.dags["shipments_daily"]
+    for task in dag.topological_sort():
+        func = getattr(task, "python_callable", None)
+        if func is None:
+            continue
+        # resolve by name against the freshly imported (patched) module
+        func = getattr(shipments_module, func.__name__)
+        xcoms[task.task_id] = func(ds=AS_OF, ti=StubTI())
+
+    with (tmp_path / f"{AS_OF}.csv").open(newline="") as fh:
+        reader = csv.DictReader(fh)
+        assert reader.fieldnames == shipments_module.REPORT_COLUMNS
+        rows = list(reader)
+
+    assert [(r["shipment_id"], r["days_late"]) for r in rows] == [
+        ("SH-1009", "5"),
+        ("SH-1003", "3"),
+        ("SH-1007", "2"),
+        ("SH-1001", "1"),
+    ]
