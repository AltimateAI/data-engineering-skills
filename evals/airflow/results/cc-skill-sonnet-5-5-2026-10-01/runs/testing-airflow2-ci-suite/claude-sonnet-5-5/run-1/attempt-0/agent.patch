+++ b/tests/test_dags.py
@@ -0,0 +1,107 @@
+import csv
+from datetime import datetime, timezone
+
+import pytest
+
+EXPECTED_DAGS = {"shipments_daily", "carrier_rates_weekly"}
+
+
+def test_no_import_errors(dagbag):
+    assert dagbag.import_errors == {}, "\n\n".join(f"{f}:\n{e}" for f, e in dagbag.import_errors.items())
+
+
+def test_expected_dags_load(dagbag):
+    assert EXPECTED_DAGS <= set(dagbag.dags)
+
+
+def test_every_task_has_at_least_two_retries(dagbag):
+    bad = [(d.dag_id, t.task_id, t.retries) for d in dagbag.dags.values() for t in d.tasks if t.retries < 2]
+    assert dagbag.dags and not bad
+
+
+def test_shipments_daily_runs_0730_utc_weekdays(dagbag, upcoming_runs):
+    # two full weeks starting on a Monday
+    runs = upcoming_runs(dagbag.dags["shipments_daily"], datetime(2026, 3, 2, tzinfo=timezone.utc), 10)
+    assert len(runs) == 10
+    assert {r.weekday() for r in runs} == {0, 1, 2, 3, 4}
+    assert all((r.hour, r.minute, r.second, r.utcoffset().total_seconds()) == (7, 30, 0, 0) for r in runs)
+
+
+def test_report_built_only_after_extract(dagbag):
+    dag = dagbag.dags["shipments_daily"]
+    assert "extract_shipments" in dag.get_task("build_report").get_flat_relative_ids(upstream=True)
+
+
+# --- late-shipment rules -------------------------------------------------
+
+def _row(sid, promised, delivered="", ship="2026-02-01"):
+    return {"shipment_id": sid, "ship_date": ship, "carrier": "X",
+            "promised_date": promised, "delivered_date": delivered}
+
+
+@pytest.fixture
+def find_late():
+    import shipments_daily
+    return shipments_daily.find_late_shipments
+
+
+def _days(rows):
+    return {r["shipment_id"]: r["days_late"] for r in rows}
+
+
+def test_delivered_on_run_date_after_promise_is_late(find_late):
+    rows = [_row("A", "2026-03-02", "2026-03-03"), _row("B", "2026-02-20", "2026-03-03")]
+    assert _days(find_late(rows, "2026-03-03")) == {"A": 1, "B": 11}
+
+
+def test_delivered_on_run_date_on_time_or_early_is_not_late(find_late):
+    rows = [_row("A", "2026-03-03", "2026-03-03"), _row("B", "2026-03-04", "2026-03-03")]
+    assert find_late(rows, "2026-03-03") == []
+
+
+def test_delivered_late_on_other_day_is_not_reported(find_late):
+    rows = [_row("A", "2026-02-24", "2026-03-02"), _row("B", "2026-03-01", "2026-03-04")]
+    assert find_late(rows, "2026-03-03") == []
+
+
+def test_undelivered_past_promise_is_late_with_days_to_run_date(find_late):
+    rows = [_row("A", "2026-03-02"), _row("B", "2026-02-26")]
+    assert _days(find_late(rows, "2026-03-03")) == {"A": 1, "B": 5}
+
+
+def test_undelivered_promised_on_or_after_run_date_is_not_late(find_late):
+    rows = [_row("A", "2026-03-03"), _row("B", "2026-03-04")]
+    assert find_late(rows, "2026-03-03") == []
+
+
+def test_result_keeps_row_fields_and_orders_worst_first(find_late):
+    rows = [_row("B", "2026-03-02"), _row("C", "2026-02-20"), _row("A", "2026-03-02")]
+    out = find_late(rows, "2026-03-03")
+    assert [r["shipment_id"] for r in out] == ["C", "A", "B"]
+    assert out[0]["promised_date"] == "2026-02-20" and out[0]["carrier"] == "X"
+
+
+# --- end to end ----------------------------------------------------------
+
+def test_shipments_daily_end_to_end_on_sample_data(dagbag, airflow_db, tmp_path, monkeypatch):
+    dag = dagbag.dags["shipments_daily"]
+    # DagBag loads the file as a private module: patch the globals the task really uses
+    monkeypatch.setitem(dag.get_task("build_report").python_callable.__globals__, "OUTPUT_DIR", tmp_path)
+
+    dr = dag.test(execution_date=datetime(2026, 3, 3, 7, 30, tzinfo=timezone.utc))
+    states = {ti.task_id: ti.state for ti in dr.get_task_instances()}
+    assert dr.state == "success", states
+
+    out = tmp_path / "2026-03-03.csv"
+    assert out.exists()
+    with out.open(newline="") as fh:
+        rows = list(csv.DictReader(fh))
+    ids = {r["shipment_id"] for r in rows}
+    # hand-checked against data/shipments.csv
+    assert {"SH-1001", "SH-1003", "SH-1007", "SH-1009"} <= ids   # delivered late today / still open and overdue
+    assert not ids & {"SH-1002", "SH-1004", "SH-1005", "SH-1006", "SH-1008"}
+    by_id = {r["shipment_id"]: r for r in rows}
+    assert by_id["SH-1001"]["days_late"] == "1" and by_id["SH-1009"]["days_late"] == "5"
+    for r in rows:   # every row satisfies the rule
+        assert r["promised_date"] < "2026-03-03"
+        assert r["delivered_date"] in ("", "2026-03-03")
