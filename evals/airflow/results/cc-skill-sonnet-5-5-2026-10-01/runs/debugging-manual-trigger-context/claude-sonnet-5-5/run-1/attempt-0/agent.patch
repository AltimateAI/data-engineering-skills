+def feed_day(dag_run) -> str:
+    """Day (YYYY-MM-DD) this run produces the feed for.
+
+    Scheduled / dated runs use their logical date. A manual trigger without a
+    date has none on Airflow 3, so use run_after (fixed when the run is created,
+    so clearing and re-running it later yields the same day), in UTC.
+    """
+    moment = dag_run.logical_date or dag_run.run_after
+    return moment.astimezone(timezone.utc).strftime("%Y-%m-%d")
+
