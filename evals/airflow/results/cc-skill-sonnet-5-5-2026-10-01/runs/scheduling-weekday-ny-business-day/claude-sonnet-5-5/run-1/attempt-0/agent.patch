+def prev_business_day(d):
+    """Previous Mon-Fri day (no holiday calendar)."""
+    d = d.subtract(days=1)
+    while d.day_of_week in (pendulum.SATURDAY, pendulum.SUNDAY):
+        d = d.subtract(days=1)
+    return d
+
+
+def report_day(dag_run, params=None) -> str:
+    """New York trade date (YYYY-MM-DD) this run reports.
+
+    Scheduled/backfilled runs fire weekdays 06:00 NY and report the previous
+    business day (Monday -> Friday). Manual runs have no logical date on
+    Airflow 3, so the trigger time (run_after) is used the same way. A
+    ``day`` param overrides it to reprocess a specific trade date.
+    """
+    day = (params or {}).get("day")
+    if day:
+        return day
+    anchor = dag_run.logical_date or dag_run.run_after
+    local = pendulum.instance(anchor).in_tz(NY).start_of("day")
+    return prev_business_day(local).to_date_string()
+
+
