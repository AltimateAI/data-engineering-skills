+            # reschedule mode already measures the wait from the first try (see BaseSensorOperator)
+            return super().execute(context)
+        end_time = self._wait_deadline(context)
+        remaining = end_time - time.time()
+        if remaining <= 0:
+            self._timed_out(f"{self.table}/{self.partition} was not published within {self.timeout}s")
         if not self.deferrable:
+            self.timeout = remaining
             return super().execute(context)
