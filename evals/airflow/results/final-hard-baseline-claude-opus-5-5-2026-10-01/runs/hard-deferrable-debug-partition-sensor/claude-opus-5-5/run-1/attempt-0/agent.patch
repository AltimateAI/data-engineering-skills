+    def _wait_deadline(self, context) -> float:
+        """Return the UNIX time at which the wait ends, anchored at the first try of this run.
+
+        The start is kept in the task state store, which retries of the same task instance share.
+        It is tagged with the first try number of the current attempt cycle, so clearing the task
+        (which grants a fresh set of tries) starts a fresh wait.
+        """
+        now = time.time()
+        store = context.get("task_state_store")
+        if store is None:
+            return now + self.timeout
+        ti = context["ti"]
+        first_try = ti.max_tries - (self.retries or 0) + 1
+        saved = store.get(_WAIT_STARTED_KEY)
+        if isinstance(saved, dict) and saved.get("first_try") == first_try:
+            started = float(saved["started_at"])
+        else:
+            started = now
+            store.set(
+                _WAIT_STARTED_KEY,
+                {"first_try": first_try, "started_at": started},
+                retention=timedelta(seconds=self.timeout) + timedelta(days=7),
+            )
+        return started + self.timeout
+
+    def _timed_out(self, message: str):
