diff --git a/dags/partners/triggers.py b/dags/partners/triggers.py
new file mode 100644
index 0000000..98a8650
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,77 @@
+"""Trigger that polls the manifest API from the triggerer."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator
+from datetime import datetime, timezone
+from typing import Any
+
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestHook
+
+
+class PartnerManifestTrigger(BaseTrigger):
+    """Poll until the manifest is published or ``deadline`` passes, then fire exactly one event.
+
+    ``deadline`` is an absolute UTC ISO timestamp, so a triggerer restart (which re-creates the
+    trigger from these kwargs) resumes against the same deadline instead of starting a new one.
+
+    Events (``status``):
+      - ``published``: ``files`` holds the manifest's file list
+      - ``timeout``: still not published when the deadline passed
+      - ``error``: the API failed (5xx, connection error, ...); ``message`` describes it.
+        Reported as an event rather than raised, because a crashed trigger reaches the
+        sensor as a TaskDeferralError, which soft_fail would turn into a skip.
+    """
+
+    def __init__(
+        self,
+        *,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        poke_interval: float,
+        deadline: str,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.poke_interval = poke_interval
+        self.deadline = deadline
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "poke_interval": self.poke_interval,
+                "deadline": self.deadline,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        deadline = datetime.fromisoformat(self.deadline)
+        hook = ManifestHook(self.manifest_conn_id)
+        while True:
+            try:
+                manifest = await hook.aget_manifest(self.partner, self.ds)
+            except Exception as exc:  # noqa: BLE001 - any failure must reach the sensor as a retryable error
+                yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
+                return
+            if manifest.get("status") == "PUBLISHED":
+                yield TriggerEvent({"status": "published", "files": manifest["files"]})
+                return
+            remaining = (deadline - datetime.now(timezone.utc)).total_seconds()
+            if remaining <= 0:
+                yield TriggerEvent({"status": "timeout"})
+                return
+            self.log.info(
+                "Manifest %s/%s not published yet; %.0fs left before timeout", self.partner, self.ds, remaining
+            )
+            # Last sleep ends exactly at the deadline, so the final check happens at the deadline.
+            await asyncio.sleep(min(self.poke_interval, remaining))
