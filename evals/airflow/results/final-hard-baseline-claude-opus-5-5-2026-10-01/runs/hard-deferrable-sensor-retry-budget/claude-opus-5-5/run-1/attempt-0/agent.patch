         self.partner = partner
         self.ds = ds
         self.manifest_conn_id = manifest_conn_id
+        self.deferrable = deferrable
+        self._deadline: datetime | None = None
+
+    def _get_deadline(self, context) -> datetime:
+        """Deadline for this DAG run: first start of waiting (persisted across retries) + ``timeout``."""
+        now = datetime.now(timezone.utc)
+        store = context.get("task_state_store")
+        if store is None:
+            self.log.warning("task_state_store unavailable; timeout counts from this try only")
+            return now + timedelta(seconds=self.timeout)
+        started_raw = store.get(self.started_at_key)
+        if started_raw is None:
+            started_at = now
+            store.set(
+                self.started_at_key,
+                started_at.isoformat(),
+                retention=timedelta(seconds=self.timeout) + timedelta(days=7),
+            )
+        else:
+            started_at = datetime.fromisoformat(started_raw)
+        deadline = started_at + timedelta(seconds=self.timeout)
+        self.log.info("Waiting for %s/%s since %s; giving up at %s", self.partner, self.ds, started_at, deadline)
+        return deadline
+
+    def _timed_out(self) -> NoReturn:
+        message = f"Manifest {self.partner}/{self.ds} not published within timeout of {self.timeout}s"
+        if self.soft_fail:
+            raise AirflowSkipException(message)
+        # AirflowSensorTimeout fails the task without retrying.
+        raise AirflowSensorTimeout(message)
+
+    def execute(self, context) -> Any:
+        self._deadline = self._get_deadline(context)
+        if not self.deferrable:
+            if not self.reschedule:
+                # Base class's per-try budget must not outlast the run-wide one.
+                self.timeout = max(0.0, (self._deadline - datetime.now(timezone.utc)).total_seconds())
+            return super().execute(context)
+
+        remaining = (self._deadline - datetime.now(timezone.utc)).total_seconds()
+        if remaining <= 0:
+            self._timed_out()
+        # One check from the worker first: returns immediately if already published, and an API
+        # error here fails the try directly.
+        manifest = ManifestHook(self.manifest_conn_id).get_manifest(self.partner, self.ds)
+        if manifest["status"] == "PUBLISHED":
