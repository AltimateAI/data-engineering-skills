 from __future__ import annotations
 
+import functools
+import ssl
+
+import httpx
 import requests
 from airflow.sdk import BaseHook
 
@@ -15,6 +19,13 @@ class ManifestApiError(Exception):
     """The manifest API answered with an error or could not be reached."""
 
 
+@functools.cache
+def _ssl_context() -> ssl.SSLContext:
+    # Loading the CA bundle is blocking file I/O; httpx would do it for every new client.
+    # Build it once per process so async clients can be created on the event loop cheaply.
+    return ssl.create_default_context()
+
+
 class ManifestHook(BaseHook):
     """Connection: ``host``/``port`` locate the API, ``schema`` is the URL scheme, ``password`` the token."""
 
@@ -43,3 +54,21 @@ class ManifestHook(BaseHook):
         if resp.status_code != 200:
             raise ManifestApiError(f"GET {url} -> HTTP {resp.status_code}")
         return resp.json()
+
+    def async_client(self) -> httpx.AsyncClient:
+        """Return an ``httpx.AsyncClient`` for :meth:`aget_manifest`; the caller closes it."""
+        return httpx.AsyncClient(timeout=self.request_timeout, verify=_ssl_context())
+
+    async def aget_manifest(self, partner: str, ds: str, client: httpx.AsyncClient) -> dict:
+        """Async :meth:`get_manifest` for use on the triggerer's event loop."""
+        url, headers = self.url_and_headers(await self.aget_connection(self.manifest_conn_id), partner, ds)
+        try:
+            resp = await client.get(url, headers=headers)
+        except httpx.HTTPError as exc:
+            raise ManifestApiError(f"GET {url} failed: {exc!r}") from exc
+        if resp.status_code != 200:
+            raise ManifestApiError(f"GET {url} -> HTTP {resp.status_code}")
+        try:
+            return resp.json()
+        except ValueError as exc:
+            raise ManifestApiError(f"GET {url} returned invalid JSON: {exc!r}") from exc
