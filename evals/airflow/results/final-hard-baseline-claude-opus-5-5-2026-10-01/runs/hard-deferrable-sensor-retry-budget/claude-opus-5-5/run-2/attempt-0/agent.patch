diff --git a/dags/partners/triggers.py b/dags/partners/triggers.py
new file mode 100644
index 0000000..3ab831e
--- /dev/null
+++ b/dags/partners/triggers.py
@@ -0,0 +1,71 @@
+"""Trigger that waits for a partner's daily manifest on the triggerer."""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from collections.abc import AsyncIterator
+from typing import Any
+
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestHook
+
+
+class PartnerManifestTrigger(BaseTrigger):
+    """Poll the manifest API until the manifest is published, the deadline passes, or the API errors.
+
+    Fires exactly one event with ``status`` set to ``published`` (with ``files``), ``timeout`` or
+    ``error`` (with ``message``). ``deadline`` is an absolute UNIX timestamp, so a triggerer restart
+    re-creates the trigger without extending the wait.
+    """
+
+    def __init__(
+        self,
+        *,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        poke_interval: float,
+        deadline: float,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.poke_interval = poke_interval
+        self.deadline = deadline
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "poke_interval": self.poke_interval,
+                "deadline": self.deadline,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id)
+        async with hook.async_client() as client:
+            while True:
+                try:
+                    manifest = await hook.aget_manifest(self.partner, self.ds, client)
+                    files = manifest["files"] if manifest["status"] == "PUBLISHED" else None
+                except Exception as exc:  # noqa: BLE001
+                    # Report every failure as an event so the task fails this try with the cause.
+                    self.log.warning("Manifest API call failed: %r", exc)
+                    yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
+                    return
+                if files is not None:
+                    yield TriggerEvent({"status": "published", "files": files})
+                    return
+                remaining = self.deadline - time.time()
+                if remaining <= 0:
+                    yield TriggerEvent({"status": "timeout"})
+                    return
+                self.log.info("Manifest %s/%s not published yet", self.partner, self.ds)
+                await asyncio.sleep(min(self.poke_interval, remaining))
