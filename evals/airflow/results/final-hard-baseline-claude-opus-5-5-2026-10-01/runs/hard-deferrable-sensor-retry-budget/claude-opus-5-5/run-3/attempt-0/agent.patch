@@ -0,0 +1,79 @@
+"""Trigger that polls the manifest API from the triggerer.
+
+It runs on the triggerer's shared event loop, so everything here is async: the HTTP
+call goes through ``httpx.AsyncClient`` and the connection through ``aget_connection``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from collections.abc import AsyncIterator
+from typing import Any
+
+import httpx
+from airflow.triggers.base import BaseTrigger, TriggerEvent
+
+from partners.hooks import ManifestHook, shared_ssl_context
+
+
+class ManifestPublishedTrigger(BaseTrigger):
+    """Fire once the manifest is published, the API errors, or ``deadline`` passes.
+
+    Every outcome is reported as an event (``published``, ``error`` or ``timeout``) rather
+    than raised: an exception escaping a trigger reaches the sensor as a deferral error,
+    which ``soft_fail`` would turn into a skip.
+
+    :param deadline: absolute end of the wait budget, epoch seconds. Being absolute, a
+        trigger recreated after a triggerer restart keeps the same deadline.
+    """
+
+    def __init__(
+        self,
+        *,
+        partner: str,
+        ds: str,
+        manifest_conn_id: str,
+        poke_interval: float,
+        deadline: float,
+    ) -> None:
+        super().__init__()
+        self.partner = partner
+        self.ds = ds
+        self.manifest_conn_id = manifest_conn_id
+        self.poke_interval = poke_interval
+        self.deadline = deadline
+
+    def serialize(self) -> tuple[str, dict[str, Any]]:
+        return (
+            f"{type(self).__module__}.{type(self).__qualname__}",
+            {
+                "partner": self.partner,
+                "ds": self.ds,
+                "manifest_conn_id": self.manifest_conn_id,
+                "poke_interval": self.poke_interval,
+                "deadline": self.deadline,
+            },
+        )
+
+    async def run(self) -> AsyncIterator[TriggerEvent]:
+        hook = ManifestHook(self.manifest_conn_id)
+        async with httpx.AsyncClient(verify=await shared_ssl_context()) as client:
+            while True:
+                # The sensor checked right before deferring, so wait first. The last sleep
+                # is cut short so one final check happens at the deadline.
+                remaining = self.deadline - time.time()
+                await asyncio.sleep(max(0.0, min(self.poke_interval, remaining)))
+                try:
+                    manifest = await hook.aget_manifest(self.partner, self.ds, client=client)
+                    files = list(manifest["files"]) if manifest["status"] == "PUBLISHED" else None
+                except Exception as exc:
+                    yield TriggerEvent({"status": "error", "message": f"{type(exc).__name__}: {exc}"})
+                    return
+                if files is not None:
+                    yield TriggerEvent({"status": "published", "files": files})
+                    return
+                if time.time() >= self.deadline:
+                    yield TriggerEvent({"status": "timeout"})
+                    return
+                self.log.info("Manifest %s/%s still pending", self.partner, self.ds)
