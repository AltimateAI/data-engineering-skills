index 0000000..9d43a0d
--- /dev/null
+++ b/plugins/claims_lib/runtime.py
@@ -0,0 +1,45 @@
+"""Run-context helpers that keep the Airflow 2 semantics the claims DAGs rely on.
+
+Airflow 3 changed a few run-context behaviours these DAGs depend on:
+
+* Runs triggered without a logical date (``airflow dags trigger`` with no
+  ``--logical-date``) have ``logical_date=None`` and no ``ts``. On Airflow 2 the
+  logical date of such a run was the trigger time with microseconds zeroed.
+* ``xcom_pull(include_prior_dates=True)`` without ``map_indexes`` returns every
+  prior value (unordered, as a list once there is more than one) instead of the
+  latest one, and for another DAG it looks up the *calling* run_id in that DAG,
+  so it finds nothing.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta
+from typing import Any
+
+
+def trigger_time(dag_run) -> datetime:
+    """Logical date of the run, or for runs without one the trigger time, to the second (Airflow 2 ``logical_date``)."""
+    return (dag_run.logical_date or dag_run.run_after).replace(microsecond=0)
+
+
+def latest_xcom(ti, *, task_id: str, key: str = "return_value", dag_id: str | None = None,
+                at_or_before: datetime | None = None) -> Any:
+    """Latest XCom of ``dag_id.task_id`` from a run at or before this run (Airflow 2 ``include_prior_dates=True``).
+
+    For another DAG, ``at_or_before`` (this run's logical date) selects the
+    latest run of that DAG at or before it, and the XCom is pulled relative to
+    that run.
+    """
+    run_id = None
+    if dag_id is not None and dag_id != ti.dag_id:
+        from airflow.sdk.execution_time.comms import GetPreviousDagRun
+        from airflow.sdk.execution_time.task_runner import SUPERVISOR_COMMS
+
+        # The API returns the latest run strictly before the given date.
+        msg = SUPERVISOR_COMMS.send(GetPreviousDagRun(dag_id=dag_id, logical_date=at_or_before + timedelta(microseconds=1)))
+        if msg.dag_run is None:
+            return None
+        run_id = msg.dag_run.run_id
+    # map_indexes=-1 makes the API return only the newest matching value.
+    return ti.xcom_pull(task_ids=task_id, dag_id=dag_id, key=key, include_prior_dates=True,
+                        map_indexes=-1, run_id=run_id)
