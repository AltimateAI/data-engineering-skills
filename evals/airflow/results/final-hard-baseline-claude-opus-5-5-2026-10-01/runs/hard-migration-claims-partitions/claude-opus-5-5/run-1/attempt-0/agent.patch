diff --git a/plugins/claims_lib/xcom.py b/plugins/claims_lib/xcom.py
new file mode 100644
index 0000000..0f5a095
--- /dev/null
+++ b/plugins/claims_lib/xcom.py
@@ -0,0 +1,26 @@
+"""Cross-DAG XCom lookup with the Airflow 2 ``include_prior_dates`` semantics."""
+
+from __future__ import annotations
+
+from datetime import timedelta
+from typing import Any
+
+
+def latest_xcom_from_dag(ti, dag_run, *, dag_id: str, task_id: str, key: str = "return_value") -> Any:
+    """Latest XCom of ``dag_id.task_id`` from a run with a logical date at or before this run's.
+
+    On Airflow 2, ``ti.xcom_pull(dag_id=..., include_prior_dates=True)`` did this.
+    On Airflow 3 the "prior dates" are anchored on a run of the *other* DAG with
+    this run's run_id, which never exists, so the pull returns nothing. Anchor
+    the pull on the other DAG's latest run at or before our logical date instead.
+    """
+    from airflow.sdk.execution_time.comms import GetPreviousDagRun
+    from airflow.sdk.execution_time.task_runner import SUPERVISOR_COMMS
+
+    # The previous-run lookup is strictly "before"; nudge by 1µs to include equal dates.
+    before = dag_run.logical_date + timedelta(microseconds=1)
+    anchor = SUPERVISOR_COMMS.send(GetPreviousDagRun(dag_id=dag_id, logical_date=before)).dag_run
+    if anchor is None:
+        return None
+    return ti.xcom_pull(dag_id=dag_id, task_ids=task_id, key=key, run_id=anchor.run_id,
+                        include_prior_dates=True, map_indexes=-1)
