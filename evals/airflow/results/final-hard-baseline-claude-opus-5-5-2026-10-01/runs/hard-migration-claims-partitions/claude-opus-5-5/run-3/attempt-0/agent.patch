+def directory_version(ds: str) -> str | None:
+    """Latest completed provider snapshot at or before ``ds``.
+
+    Equivalent to pulling provider_directory_daily's ``sync_providers`` XCom with
+    include_prior_dates, which Airflow 3 no longer resolves across DAGs (it looks
+    up this run's run_id in the other DAG and finds nothing). A snapshot counts
+    once its ``.status`` file is written, i.e. right before that XCom is pushed.
+    """
+    snapshots = LAKE / "providers"
+    days = [p.stem for p in snapshots.glob("*.status") if p.stem <= ds and p.with_suffix(".csv").exists()]
+    return max(days, default=None)
+
