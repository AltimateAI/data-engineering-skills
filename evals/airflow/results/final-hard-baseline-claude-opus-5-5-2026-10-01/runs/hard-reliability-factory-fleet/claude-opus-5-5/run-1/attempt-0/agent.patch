+def config_paths() -> list[Path]:
+    # A worker running a task only needs that task's DAG; names match file
+    # names, so its config can be found without reading the other configs.
+    dag_id = get_parsing_context().dag_id
+    if dag_id is not None:
+        path = CONFIG_DIR / f"{dag_id}.yaml"
+        return [path] if path.is_file() else []
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+def build_fleet() -> dict[str, DAG]:
+    paths = config_paths()
+    if not paths:
+        return {}
+    registry = load_yaml(REGISTRY)
+    dags = {}
+    for path in paths:
+        try:
+            dag = build_dag(path, registry)
+        except Exception as exc:
+            log.error("Skipping pipeline config %s: %s: %s", path, type(exc).__name__, exc)
+            continue
+        dags[dag.dag_id] = dag
+    return dags
+
