+def load_configs(paths: list[Path], registry: dict) -> dict[str, tuple[Path, dict]]:
+    """Returns {dag_id: (path, config)} for the configs that are valid; logs the rest."""
+    by_name: dict[str, list[tuple[Path, dict]]] = {}
+    for path in paths:
+        try:
+            cfg = validate(load_yaml(path), registry)
+        except Exception as exc:
+            log.error("Skipping pipeline config %s: %s", path, exc)
+            continue
+        by_name.setdefault(cfg["name"], []).append((path, cfg))
+
+    configs = {}
+    for name, claims in by_name.items():
+        if len(claims) > 1:
+            # A config whose file is named after the pipeline keeps it, so a copied
+            # config with a forgotten rename cannot take over an existing DAG.
+            owner = [c for c in claims if c[0].stem == name]
+            for path, _ in claims:
+                if not owner or path != owner[0][0]:
+                    log.error("Skipping pipeline config %s: pipeline name %r is used by %s",
+                              path, name, ", ".join(str(p) for p, _ in claims))
+            if not owner:
+                continue
+            claims = owner
+        configs[name] = claims[0]
+    return configs
+
+
+def build_fleet() -> dict[str, DAG]:
+    registry = load_yaml(REGISTRY)
+    wanted = get_parsing_context().dag_id  # set when a worker parses to run a task
+
+    configs: dict[str, tuple[Path, dict]] = {}
+    if wanted:
+        # Fast path: the config named after the DAG wins any name clash, so
+        # it is enough on its own when it exists and is valid.
+        own = CONFIG_DIR / f"{wanted}.yaml"
+        if own.is_file():
+            configs = {k: v for k, v in load_configs([own], registry).items() if k == wanted}
+    if not configs:
+        configs = load_configs(sorted(CONFIG_DIR.glob("*.yaml")), registry)
+        if wanted:
+            configs = {k: v for k, v in configs.items() if k == wanted}
+
+    dags = {}
+    for name, (path, cfg) in sorted(configs.items()):
+        try:
+            dags[name] = build_dag(path, cfg, registry)
+        except Exception as exc:
+            log.error("Skipping pipeline config %s: %s", path, exc)
+    return dags
+
