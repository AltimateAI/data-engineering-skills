+def validate(path: Path, cfg, registry: dict) -> None:
+    """Raise ConfigError if the config cannot produce a correct DAG."""
+    _require(isinstance(cfg, dict), "config must be a mapping")
+    for key in ("name", "team", "tier", "schedule", "steps"):
