+def config_paths() -> list[Path]:
+    # A worker running a task only needs that task's DAG; the config file is
+    # named after the dag_id (enforced in validate()).
+    dag_id = get_parsing_context().dag_id
+    if dag_id:
+        path = CONFIG_DIR / f"{dag_id}.yaml"
+        return [path] if path.is_file() else []
+    return sorted(CONFIG_DIR.glob("*.yaml"))
+
+
+def build_fleet() -> dict[str, DAG]:
+    paths = config_paths()
+    if not paths:
+        return {}
+    try:
+        registry = load_yaml(REGISTRY)
+        if not (isinstance(registry, dict) and isinstance(registry.get("teams"), dict)
+                and isinstance(registry.get("datasets"), dict)):
+            raise ConfigError("registry must contain 'teams' and 'datasets' mappings")
+    except Exception as exc:
+        log.error("Pipeline registry %s is unreadable, no fleet DAGs built: %s", REGISTRY, exc)
+        return {}
+
+    dags: dict[str, DAG] = {}
+    for path in paths:
+        try:
+            cfg = load_yaml(path)
+            validate(path, cfg, registry)
+            dags[cfg["name"]] = build_dag(path, cfg, registry)
+        except Exception as exc:
+            log.error("Skipping pipeline config %s (its DAG will not load until fixed): %s: %s",
+                      path, type(exc).__name__, exc)
+    return dags
