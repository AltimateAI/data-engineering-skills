+    name = cfg["name"]
+    _require(isinstance(name, str) and NAME_RE.match(name) is not None, f"invalid name {name!r}")
+    # One config per dag_id: a new file can never shadow or clash with another pipeline.
+    _require(name == path.stem, f"name {name!r} must match the file name {path.stem!r}")
+
+    _require(cfg["team"] in registry["teams"], f"unknown team {cfg['team']!r}")
+    _require(cfg["tier"] in TIER_PRIORITY, f"tier must be one of {sorted(TIER_PRIORITY)}, got {cfg['tier']!r}")
+    _require(cfg.get("description") is None or isinstance(cfg["description"], str), "description must be a string")
