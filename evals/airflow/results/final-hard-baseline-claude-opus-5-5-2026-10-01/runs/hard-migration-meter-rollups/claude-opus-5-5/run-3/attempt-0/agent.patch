diff --git a/plugins/meter_lib/runs.py b/plugins/meter_lib/runs.py
new file mode 100644
index 0000000..a687055
--- /dev/null
+++ b/plugins/meter_lib/runs.py
@@ -0,0 +1,112 @@
+"""Run dates with Airflow 2 semantics for runs Airflow 3 creates without them.
+
+Airflow 3 creates manual runs triggered without a logical date (``airflow dags
+trigger <dag_id>``, REST API with ``"logical_date": null``) and asset-triggered
+runs with neither a logical date nor a data interval, so ``ds``,
+``data_interval_start`` and friends are missing from their context. The
+metering outputs are keyed on those dates, so they are derived here exactly as
+Airflow 2 did:
+
+* logical date: when the run was triggered (``run_after``);
+* manual run of a cron schedule: the last complete interval before that;
+* asset-triggered run: from the start of the earliest to the end of the latest
+  data interval of the runs that produced the triggering events (the event time
+  for events without a source run);
+* anything else: the empty interval at the logical date.
+
+Runs that carry their own dates (scheduled runs) are left untouched.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+import pendulum
+from croniter import croniter
+
+from airflow.sdk import CronDataIntervalTimetable
+
+
+def _utc(value) -> pendulum.DateTime:
+    return pendulum.instance(value).in_timezone("UTC")
+
+
+def _logical_date(dag_run) -> pendulum.DateTime:
+    if dag_run.logical_date is not None:
+        return _utc(dag_run.logical_date)
+    run_after = _utc(dag_run.run_after)
+    if dag_run.run_type == "manual":  # the 2.x CLI trigger dropped microseconds
+        run_after = run_after.replace(microsecond=0)
+    return run_after
+
+
+def logical_date(context) -> pendulum.DateTime:
+    if context.get("logical_date") is not None:
+        return context["logical_date"]
+    return _logical_date(context["dag_run"])
+
+
+def _last_complete_cron_interval(timetable, run_after):
+    tz = pendulum.timezone(timetable.timezone) if isinstance(timetable.timezone, str) else timetable.timezone
+    local = run_after.in_timezone(tz).naive()
+    prev = croniter(timetable.expression, local).get_prev(datetime)
+    end = local if croniter(timetable.expression, prev).get_next(datetime) == local else prev
+    start = croniter(timetable.expression, end).get_prev(datetime)
+    return _utc(pendulum.instance(start, tz=tz)), _utc(pendulum.instance(end, tz=tz))
+
+
+def _run_interval(dag_run, timetable):
+    """Data interval of a run without the triggering-events case (see ``data_interval``)."""
+    if dag_run.data_interval_start is not None:
+        return _utc(dag_run.data_interval_start), _utc(dag_run.data_interval_end)
+    when = _logical_date(dag_run)
+    if dag_run.run_type == "manual" and isinstance(timetable, CronDataIntervalTimetable):
+        return _last_complete_cron_interval(timetable, when)
+    return when, when
+
+
+def data_interval(context, source_timetables=None) -> tuple[pendulum.DateTime, pendulum.DateTime]:
+    """2.x data interval of the current run.
+
+    ``source_timetables`` maps the dag_id of the asset producers to their
+    timetables, to recover the 2.x interval of a producing run that has none
+    (a manual run triggered without a logical date).
+    """
+    if context.get("data_interval_start") is not None:
+        return context["data_interval_start"], context["data_interval_end"]
+
+    events = context.get("triggering_asset_events") or {}
+    bounds = []
+    for asset in events:
+        for event in events[asset]:
+            source = event.source_dag_run
+            if source is not None:
+                bounds.append(_run_interval(source, (source_timetables or {}).get(source.dag_id)))
+            else:
+                bounds.append((_utc(event.timestamp), _utc(event.timestamp)))
+    if bounds:
+        return min(start for start, _ in bounds), max(end for _, end in bounds)
+
+    return _run_interval(context["dag_run"], context["dag"].timetable)
+
+
+def ensure_run_dates(context) -> None:
+    """Fill in the date keys of ``context`` that Airflow 3 leaves out, with their 2.x values."""
+    if context.get("logical_date") is not None:
+        return
+    when = logical_date(context)
+    start, end = data_interval(context)
+    ds = when.strftime("%Y-%m-%d")
+    ts = when.isoformat()
+    context.update(
+        {
+            "logical_date": when,
+            "ds": ds,
+            "ds_nodash": ds.replace("-", ""),
+            "ts": ts,
+            "ts_nodash": when.strftime("%Y%m%dT%H%M%S"),
+            "ts_nodash_with_tz": ts.replace("-", "").replace(":", ""),
+            "data_interval_start": start,
+            "data_interval_end": end,
+        }
+    )
