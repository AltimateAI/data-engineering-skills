diff --git a/ops/airflow3_cutover.sql b/ops/airflow3_cutover.sql
new file mode 100644
index 0000000..993edec
--- /dev/null
+++ b/ops/airflow3_cutover.sql
@@ -0,0 +1,15 @@
+-- One-off fix for the Airflow 2.11 -> 3.3 cutover. Run it once against the
+-- metadata DB right after `airflow db migrate`, before starting the 3.3 scheduler.
+--
+-- The 3.0 migration backfills dag_run.run_after with data_interval_end. For
+-- asset (dataset) triggered runs that is the end of the readings window, not
+-- the time the run was triggered (their 2.x logical date). Airflow 3 starts
+-- the event window of the next usage_rollup run at the previous run's
+-- run_after, so without this fix the first rollup after cutover would
+-- re-consume events the last 2.11 rollup already processed (wider span,
+-- different file name, double-counted rows_delivered).
+UPDATE dag_run
+SET run_after = logical_date
+WHERE dag_id = 'usage_rollup'
+  AND run_type = 'asset_triggered'
+  AND logical_date IS NOT NULL;
