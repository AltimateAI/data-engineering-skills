diff --git a/plugins/meter_lib/runs.py b/plugins/meter_lib/runs.py
new file mode 100644
index 0000000..d3aa1ef
--- /dev/null
+++ b/plugins/meter_lib/runs.py
@@ -0,0 +1,85 @@
+"""Run dates of the metering DAGs, with the semantics they had on Airflow 2.
+
+Airflow 3 no longer gives a logical date or a data interval to manual runs
+triggered without a logical date (``airflow dags trigger <dag_id>``, the REST
+API with ``"logical_date": null``) nor to asset-triggered runs, and infers the
+data interval of a manual run from the trigger time even when a logical date is
+given. The lake, rollup, billing and tariff files are keyed on those dates, so
+they are derived here exactly as Airflow 2 derived them:
+
+* scheduled (and backfill) runs: the run's own logical date and data interval;
+* manual runs: logical date = the one given, else the trigger time; data
+  interval = the last complete schedule interval at the logical date;
+* asset-triggered runs: data interval = from the earliest start to the latest
+  end of the data intervals of the runs that produced the triggering events
+  (the event timestamp for an event without a producing run).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import NamedTuple
+
+import pendulum
+from pendulum import DateTime
+
+
+class RunDates(NamedTuple):
+    logical_date: DateTime
+    data_interval_start: DateTime
+    data_interval_end: DateTime
+
+    @property
+    def ds(self) -> str:
+        return self.logical_date.strftime("%Y-%m-%d")
+
+
+def _dt(value) -> DateTime:
+    return pendulum.instance(value).in_timezone(pendulum.UTC)
+
+
+def _logical_date(dag_run) -> DateTime:
+    if dag_run.logical_date is not None:
+        return _dt(dag_run.logical_date)
+    # Airflow 2 used the trigger time, microseconds dropped, as the logical date.
+    return _dt(dag_run.run_after).replace(microsecond=0)
+
+
+def _cron_run_dates(dag_run, cron: str, timezone) -> RunDates:
+    if dag_run.run_type != "manual":
+        return RunDates(
+            _dt(dag_run.logical_date), _dt(dag_run.data_interval_start), _dt(dag_run.data_interval_end)
+        )
+    from airflow.timetables.interval import CronDataIntervalTimetable
+
+    logical_date = _logical_date(dag_run)
+    interval = CronDataIntervalTimetable(cron, timezone).infer_manual_data_interval(run_after=logical_date)
+    return RunDates(logical_date, _dt(interval.start), _dt(interval.end))
+
+
+def run_dates(dag_run, dag) -> RunDates:
+    """Logical date and data interval of a run of a ``CronDataIntervalTimetable`` DAG."""
+    return _cron_run_dates(dag_run, dag.timetable.expression, dag.timetable.timezone)
+
+
+def asset_run_dates(dag_run, triggering_asset_events, source_schedules: Mapping[str, str]) -> RunDates:
+    """Logical date and data interval of an asset-triggered run.
+
+    ``source_schedules`` maps the producing DAGs to their (UTC) cron schedule,
+    to recover the data interval of manual producing runs.
+    """
+    logical_date = _logical_date(dag_run)
+    starts, ends = [], []
+    for events in triggering_asset_events.values():
+        for event in events:
+            source = event.source_dag_run
+            if source is not None:
+                dates = _cron_run_dates(source, source_schedules[source.dag_id], "UTC")
+                starts.append(dates.data_interval_start)
+                ends.append(dates.data_interval_end)
+            else:
+                starts.append(_dt(event.timestamp))
+                ends.append(_dt(event.timestamp))
+    if not starts:  # manual run
+        return RunDates(logical_date, logical_date, logical_date)
+    return RunDates(logical_date, min(starts), max(ends))
