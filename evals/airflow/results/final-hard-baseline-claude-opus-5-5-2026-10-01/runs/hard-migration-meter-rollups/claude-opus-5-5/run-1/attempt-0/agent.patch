diff --git a/plugins/meter_lib/runs.py b/plugins/meter_lib/runs.py
new file mode 100644
index 0000000..2366579
--- /dev/null
+++ b/plugins/meter_lib/runs.py
@@ -0,0 +1,63 @@
+"""Run dates of the metering DAGs, as Airflow 2 assigned them.
+
+Airflow 3 creates manual runs triggered without a logical date (the runbook's
+plain ``airflow dags trigger``) and asset-triggered runs with neither a
+logical date nor a data interval. Airflow 2 gave both kinds of run a logical
+date and a data interval, and the files the DAGs write are named and sliced by
+them, so these helpers rebuild the Airflow 2 values for such runs.
+"""
+
+from __future__ import annotations
+
+from airflow.sdk import timezone
+from airflow.timetables.interval import CronDataIntervalTimetable
+
+
+def _trigger_time(context):
+    # Airflow 2 used the trigger time, without microseconds, as logical date.
+    return timezone.coerce_datetime(context["dag_run"].run_after).replace(microsecond=0)
+
+
+def logical_date(context):
+    """The run's logical date; the trigger time for a manual run without one."""
+    if context.get("logical_date") is not None:
+        return context["logical_date"]
+    return _trigger_time(context)
+
+
+def data_interval(context, cron: str):
+    """The run's data interval for a DAG on the UTC ``cron`` schedule.
+
+    A manual run without a logical date gets the last complete interval before
+    it was triggered, as Airflow 2 inferred it.
+    """
+    if context.get("data_interval_start") is not None:
+        return context["data_interval_start"], context["data_interval_end"]
+    interval = CronDataIntervalTimetable(cron, timezone="UTC").infer_manual_data_interval(
+        run_after=_trigger_time(context)
+    )
+    return interval.start, interval.end
+
+
+def asset_triggered_interval(context):
+    """Data interval of an asset-triggered run, as Airflow 2 derived it from its events.
+
+    From the earliest data interval start to the latest data interval end of
+    the runs that emitted the triggering events (the event timestamp for an
+    event without a source run). A run without events (manual) spans its
+    trigger time only.
+    """
+    starts, ends = [], []
+    for events in context["triggering_asset_events"].values():
+        for event in events:
+            run = event.source_dag_run
+            if run is not None and run.data_interval_start is not None:
+                starts.append(timezone.coerce_datetime(run.data_interval_start))
+                ends.append(timezone.coerce_datetime(run.data_interval_end))
+            else:
+                starts.append(timezone.coerce_datetime(event.timestamp))
+                ends.append(timezone.coerce_datetime(event.timestamp))
+    if not starts:
+        start = logical_date(context)
+        return start, start
+    return min(starts), max(ends)
