+# Key Changes: Before & After
+
+## 1. Replace "Yesterday" with Scheduled Execution Date
+
+### Before (Non-idempotent, non-backfillable)
+```python
+def load_orders() -> str:
+    day = (datetime.now() - timedelta(days=1)).date()  # ❌ Always "yesterday"
+    # If run now, loads yesterday
+    # If re-run tomorrow, loads "yesterday from tomorrow" (wrong day!)
+    # If backfill, all runs load the same day
+```
+
+### After (Schedule-aware, backfill-safe)
+```python
+def load_orders(ds: str) -> str:
+    # ✓ Airflow provides 'ds' = scheduled execution date (YYYY-MM-DD)
+    # ✓ Each run, including re-runs and backfills, uses its scheduled date
+    # ✓ Backfill 2026-03-01 to 2026-03-05 loads 5 different days correctly
+```
+
+---
+
+## 2. Add Delete-Before-Insert (Upsert Pattern)
+
+### Before (Duplicates on re-run)
+```python
+@task
+def load_orders() -> str:
+    # ...
+    con.execute(
+        f"""
+        INSERT INTO orders  # ❌ Pure insert, no deduplication
+        SELECT ...
+        WHERE CAST(order_ts AS DATE) = ?
+        """,
+        [day],
+    )
+    # Re-running this task = duplicate rows in `orders`
+```
+
+### After (Idempotent)
+```python
+@task
+def load_orders(ds: str) -> str:
+    # ...
+    # ✓ Delete existing rows for this day
+    con.execute(
+        """
+        DELETE FROM orders
+        WHERE order_date = CAST(? AS DATE)
+        """,
+        [ds],
+    )
+    
+    # ✓ Insert fresh data
+    con.execute(
+        f"""
+        INSERT INTO orders
+        SELECT ...
+        WHERE CAST(order_ts AS DATE) = CAST(? AS DATE)
+        """,
+        [ds],
+    )
+    # Re-running = exact same rows (no duplicates)
+```
+
+### Applied to Both Tasks
+- `load_orders` → deletes from `orders`, reinserts
+- `build_daily_revenue` → deletes from `daily_revenue`, recalculates
+
+---
+
+## 3. Enable Backfill Support
+
+### Before
+```python
+@dag(
+    schedule="@daily",
+    catchup=False,  # ❌ Blocks historical backfills
+    start_date=pendulum.datetime(2026, 3, 1, tz="UTC"),
+)
+```
+
+### After
+```python
+@dag(
+    schedule="@daily",
+    catchup=True,   # ✓ Allows backfills
+    start_date=pendulum.datetime(2026, 3, 1, tz="UTC"),
+)
+```
+
+---
+
+## 4. Fix Daily Revenue Rollup (Same Pattern)
+
+### Before
+```python
+@task
+def build_daily_revenue(day: str) -> None:
+    # ...
+    con.execute(
+        """
+        INSERT INTO daily_revenue  # ❌ Pure insert
+        SELECT ...
+        FROM orders
+        WHERE order_date = CAST(? AS DATE)
+        """,
+        [day],
+    )
+    # Re-running = duplicate rows = doubled revenue in dashboard ❌
+```
+
+### After
+```python
+@task
+def build_daily_revenue(day: str) -> None:
+    # ...
+    # ✓ Delete existing rollup
+    con.execute(
+        """
+        DELETE FROM daily_revenue
+        WHERE order_date = CAST(? AS DATE)
+        """,
+        [day],
+    )
+    
+    # ✓ Insert fresh rollup
+    con.execute(
+        """
+        INSERT INTO daily_revenue
+        SELECT ...
+        FROM orders
+        WHERE order_date = CAST(? AS DATE)
+        """,
+        [day],
+    )
+    # Re-running = exact same aggregate, no duplicates ✓
+```
+
+---
+
+## Impact Summary
+
+| Problem | Fix | Impact |
+|---------|-----|--------|
+| Re-runs corrupt data with duplicates | Delete-before-insert upsert | No more doubled revenue |
+| Can't backfill (hardcoded "yesterday") | Use Airflow's `ds` parameter | Backfill early March in one command |
+| Clearing a failed run broke the day | Idempotent pattern | Safe to retry/re-run/backfill any day |
+| Can't support catchup | Set `catchup=True` | Enables historical backfill |
+
