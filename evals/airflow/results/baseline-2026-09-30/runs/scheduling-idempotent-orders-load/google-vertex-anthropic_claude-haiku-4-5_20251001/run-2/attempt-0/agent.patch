+if [ "$DAYS" -eq "5" ]; then
+    echo "✓✓✓ BACKFILL VERIFIED: Loaded 5 different days correctly ✓✓✓"
+else
+    echo "✗ BACKFILL FAILED: Expected 5 days, got $DAYS"
+    exit 1
+fi
