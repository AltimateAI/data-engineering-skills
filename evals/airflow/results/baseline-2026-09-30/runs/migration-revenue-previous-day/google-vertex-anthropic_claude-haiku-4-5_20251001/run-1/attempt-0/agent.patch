+def load_dags():
+    """Load DAGs directly from the modules without requiring the Airflow DB."""
+    import sys
+    from importlib import import_module
+    
+    sys.path.insert(0, str(DAGS_DIR.parent))
+    dags = {}
+    for dag_file in DAGS_DIR.glob("*.py"):
+        if dag_file.name.startswith("_"):
+            continue
+        module_name = f"dags.{dag_file.stem}"
+        try:
+            module = import_module(module_name)
+            if hasattr(module, "dag"):
+                dags[module.dag.dag_id] = module.dag
+        except Exception as e:
+            pytest.fail(f"Failed to import {module_name}: {e}")
+    return dags
+
+
+def test_no_import_errors(load_dags):
+    """Verify all DAGs can be imported without errors."""
+    assert len(load_dags) >= 2, f"Expected at least 2 DAGs, found {len(load_dags)}"
+    assert "daily_revenue" in load_dags, "daily_revenue DAG not found"
+    assert "region_reference" in load_dags, "region_reference DAG not found"
+
+
+def test_daily_revenue_structure(load_dags):
+    """Verify the revenue pipeline keeps its expected structure."""
+    dag = load_dags["daily_revenue"]
     assert dag is not None
     assert set(dag.task_ids) == {"load_daily_revenue", "publish_manifest"}
     assert dag.get_task("publish_manifest").upstream_task_ids == {"load_daily_revenue"}
