+def publish_marker(ti, data_interval_start, data_interval_end) -> None:
+    """Write the completion marker that the dashboard loader waits for."""
+    # Extract the event count from the extract task
+    count = ti.xcom_pull(task_ids="extract_hour")
+    
+    # Format the marker filename: YYYYMMDDTHHHHM.done (e.g. 202603050900.done)
+    hour_str = data_interval_start.strftime("%Y%m%dT%H0000")
+    
+    # Format the marker content with hour and staged count
+    hour_formatted = data_interval_start.strftime("%Y-%m-%dT%H:00")
+    marker_content = f"hour={hour_formatted} staged={count}"
+    
+    # Create markers directory and write the .done file
+    MARKERS.mkdir(parents=True, exist_ok=True)
+    marker_file = MARKERS / f"{hour_str}.done"
+    marker_file.write_text(marker_content)
+
+
+def cleanup_staging(data_interval_start) -> None:
+    """Delete staging files from the day before this run's hour."""
+    # Delete staging files from 24 hours before the current data_interval_start
+    delete_before = data_interval_start - timedelta(days=1)
+    delete_pattern = delete_before.strftime("%Y%m%dT")
+    
+    # Find and delete matching staging files
+    if STAGING.exists():
+        for staging_file in STAGING.glob(f"{delete_pattern}*.csv"):
+            staging_file.unlink()
+
+
