+"""
+Shared pytest fixtures for the Airflow 2.11 test suite.
+
+Sets up an in-memory SQLite database so dag.test() works without a running
+Airflow scheduler, webserver, or any external infrastructure.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+
+def pytest_configure(config):
+    """
+    Set Airflow env vars before any import of airflow happens.
+
+    Must be done at collection time (before session fixtures) so that the
+    SQLAlchemy engine is initialised with the right URL.
+    """
+    os.environ.setdefault("AIRFLOW__DATABASE__SQL_ALCHEMY_CONN", "sqlite://")
+    os.environ.setdefault("AIRFLOW__CORE__UNIT_TEST_MODE", "True")
+    # Silence the Airflow 2→3 deprecation warnings that flood the output
+    os.environ.setdefault("AIRFLOW__METRICS__STATSD_ON", "False")
+
+
+@pytest.fixture(scope="session", autouse=True)
+def _airflow_db():
+    """
+    Initialise the in-memory SQLite schema once for the entire test session.
+
+    dag.test() writes task-instance rows, so the schema must exist before
+    any test that calls it.
+    """
+    from airflow.utils.db import initdb  # import after env vars are set
+
+    initdb()
diff --git a/tests/test_dag_integrity.py b/tests/test_dag_integrity.py
new file mode 100644
index 0000000..f6be06c
--- /dev/null
+++ b/tests/test_dag_integrity.py
@@ -0,0 +1,156 @@
+"""
+DAG integrity tests.
+
+Covers:
+ - Every file in dags/ loads without import errors.
+ - shipments_daily runs at 07:30 UTC Monday–Friday only.
+ - Every task in every DAG has at least 2 retries.
+ - In shipments_daily, build_report depends on extract_shipments
+   (report can only run after the export is extracted).
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+from croniter import croniter
+from datetime import datetime, timezone
+
+from airflow.models import DagBag
+
+# ── Fixtures ─────────────────────────────────────────────────────────────────
+
+DAGS_DIR = Path(__file__).resolve().parents[1] / "dags"
+
+
+@pytest.fixture(scope="module")
+def dagbag() -> DagBag:
+    """Load all DAGs from the dags/ directory once per module."""
+    bag = DagBag(dag_folder=str(DAGS_DIR), include_examples=False)
+    return bag
+
+
+# ── 1. Import integrity ───────────────────────────────────────────────────────
+
+
+def test_no_import_errors(dagbag: DagBag):
+    """Every file in dags/ must import cleanly (no syntax / runtime errors)."""
+    assert dagbag.import_errors == {}, (
+        f"DAG import errors detected:\n"
+        + "\n".join(f"  {path}: {err}" for path, err in dagbag.import_errors.items())
+    )
+
+
+@pytest.mark.parametrize("dag_file", sorted(DAGS_DIR.glob("*.py")))
+def test_dag_file_produces_at_least_one_dag(dag_file: Path, dagbag: DagBag):
+    """Each .py file in dags/ must contribute at least one DAG to the bag."""
+    dag_ids_from_file = [
+        dag_id
+        for dag_id, dag in dagbag.dags.items()
+        if Path(dag.fileloc).resolve() == dag_file.resolve()
+    ]
+    assert dag_ids_from_file, (
+        f"{dag_file.name} did not register any DAG. "
+        "Check for import errors or missing 'with DAG(...)' blocks."
+    )
+
+
+# ── 2. shipments_daily schedule ───────────────────────────────────────────────
+
+# Weekday at 07:30 UTC — must fire
+_WEEKDAY_07_30 = [
+    pytest.param(datetime(2026, 3, 2, 7, 30, tzinfo=timezone.utc), id="Monday"),
+    pytest.param(datetime(2026, 3, 3, 7, 30, tzinfo=timezone.utc), id="Tuesday"),
+    pytest.param(datetime(2026, 3, 4, 7, 30, tzinfo=timezone.utc), id="Wednesday"),
+    pytest.param(datetime(2026, 3, 5, 7, 30, tzinfo=timezone.utc), id="Thursday"),
+    pytest.param(datetime(2026, 3, 6, 7, 30, tzinfo=timezone.utc), id="Friday"),
+]
+
+# Weekend or wrong time — must NOT fire
+_NO_FIRE = [
+    pytest.param(datetime(2026, 3, 7, 7, 30, tzinfo=timezone.utc), id="Saturday"),
+    pytest.param(datetime(2026, 3, 8, 7, 30, tzinfo=timezone.utc), id="Sunday"),
+    pytest.param(datetime(2026, 3, 2, 7, 31, tzinfo=timezone.utc), id="Monday_07:31"),
+    pytest.param(datetime(2026, 3, 2, 7, 0, tzinfo=timezone.utc),  id="Monday_07:00"),
+    pytest.param(datetime(2026, 3, 2, 8, 30, tzinfo=timezone.utc), id="Monday_08:30"),
+]
+
+
+def _get_shipments_schedule(dagbag: DagBag) -> str:
+    dag = dagbag.dags.get("shipments_daily")
+    assert dag is not None, "shipments_daily DAG not found in DagBag"
+    schedule = dag.schedule_interval
+    assert isinstance(schedule, str), (
+        f"Expected a cron string for shipments_daily schedule, got {type(schedule)}"
+    )
+    return schedule
+
+
+@pytest.mark.parametrize("dt", _WEEKDAY_07_30)
+def test_shipments_daily_fires_on_weekday_at_0730(dt: datetime, dagbag: DagBag):
+    """shipments_daily must match its cron on every weekday at 07:30 UTC."""
+    schedule = _get_shipments_schedule(dagbag)
+    assert croniter.match(schedule, dt), (
+        f"Expected schedule '{schedule}' to fire at {dt} but it did not."
+    )
+
+
+@pytest.mark.parametrize("dt", _NO_FIRE)
+def test_shipments_daily_does_not_fire_outside_schedule(dt: datetime, dagbag: DagBag):
+    """shipments_daily must NOT match its cron on weekends or at wrong times."""
+    schedule = _get_shipments_schedule(dagbag)
+    assert not croniter.match(schedule, dt), (
+        f"Expected schedule '{schedule}' NOT to fire at {dt} but it did."
+    )
+
+
+# ── 3. Retry policy (all tasks, all DAGs) ────────────────────────────────────
+
+MIN_RETRIES = 2
+
+
+def _all_tasks():
+    """Collect (dag_id, task_id, task) triples from the DagBag."""
+    bag = DagBag(dag_folder=str(DAGS_DIR), include_examples=False)
+    params = []
+    for dag_id, dag in bag.dags.items():
+        for task in dag.tasks:
+            params.append(
+                pytest.param(
+                    dag_id, task.task_id, task,
+                    id=f"{dag_id}/{task.task_id}",
+                )
+            )
+    return params
+
+
+@pytest.mark.parametrize("dag_id,task_id,task", _all_tasks())
+def test_task_has_minimum_retries(dag_id: str, task_id: str, task):
+    """Every task in every DAG must be configured with at least 2 retries."""
+    assert task.retries >= MIN_RETRIES, (
+        f"{dag_id}.{task_id} has retries={task.retries}; "
+        f"minimum required is {MIN_RETRIES}."
+    )
+
+
+# ── 4. shipments_daily task dependency ───────────────────────────────────────
+
+
+def test_build_report_depends_on_extract_shipments(dagbag: DagBag):
+    """
+    build_report must be a direct or transitive downstream of extract_shipments.
+
+    This ensures the report can only be built after the export is extracted —
+    i.e., extract_shipments must appear in build_report's upstream task set.
+    """
+    dag = dagbag.dags.get("shipments_daily")
+    assert dag is not None, "shipments_daily DAG not found"
+
+    build_report = dag.get_task("build_report")
+    upstream_ids = {t.task_id for t in build_report.get_flat_relatives(upstream=True)}
+
+    assert "extract_shipments" in upstream_ids, (
+        f"build_report's upstream tasks are {upstream_ids!r}; "
+        "'extract_shipments' must be an upstream dependency."
+    )
