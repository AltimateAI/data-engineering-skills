@@ -0,0 +1,112 @@
+"""
+End-to-end test for the shipments_daily DAG on 2026-03-03.
+
+Runs the full DAG (start → extract_shipments → build_report → done) against
+the real data in data/shipments.csv using dag.test(), which executes tasks
+in-process via the SequentialExecutor without any running scheduler or
+webserver.
+
+Assertions:
+  - The DAG run completes in state 'success'.
+  - The output file output/late_shipments/2026-03-03.csv is created.
+  - The file contains exactly the four expected late shipments in the correct
+    order (worst first) with the correct days_late values.
+"""
+
+from __future__ import annotations
+
+import csv
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+from airflow.models import DagBag
+
+DAGS_DIR = Path(__file__).resolve().parents[1] / "dags"
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+OUTPUT_FILE = PROJECT_ROOT / "output" / "late_shipments" / "2026-03-03.csv"
+RUN_DATE = datetime(2026, 3, 3, 7, 30, tzinfo=timezone.utc)
+
+# Expected rows in output order (worst days_late first, ties by shipment_id asc)
+EXPECTED_ROWS = [
+    {"shipment_id": "SH-1009", "carrier": "DHL",
+     "promised_date": "2026-02-26", "delivered_date": "", "days_late": "5"},
+    {"shipment_id": "SH-1003", "carrier": "FedEx",
+     "promised_date": "2026-02-28", "delivered_date": "", "days_late": "3"},
+    {"shipment_id": "SH-1007", "carrier": "UPS",
+     "promised_date": "2026-03-01", "delivered_date": "2026-03-03", "days_late": "2"},
+    {"shipment_id": "SH-1001", "carrier": "DHL",
+     "promised_date": "2026-03-02", "delivered_date": "2026-03-03", "days_late": "1"},
+]
+
+
+@pytest.fixture(scope="module")
+def dag_run(tmp_path_factory):
+    """
+    Execute shipments_daily for 2026-03-03 and return the DagRun.
+
+    Uses dag.test() which runs tasks sequentially in-process; no scheduler,
+    webserver, or worker processes are required.
+    """
+    bag = DagBag(dag_folder=str(DAGS_DIR), include_examples=False)
+    assert "shipments_daily" in bag.dags, (
+        f"shipments_daily not found in DagBag. Import errors: {bag.import_errors}"
+    )
+    dag = bag.dags["shipments_daily"]
+    run = dag.test(execution_date=RUN_DATE)
+    return run
+
+
+def test_dag_run_succeeds(dag_run):
+    """The full DAG run must complete with state 'success'."""
+    assert dag_run is not None, "dag.test() returned None — the run did not start"
