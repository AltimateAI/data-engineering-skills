+"""
+Unit tests for the late-shipment business logic in shipments_daily.
+
+Rules under test (from the DAG docstring):
+  A shipment is late for a given run date (as_of) if:
+    (a) It was delivered ON as_of AND delivered_date > promised_date, OR
+    (b) It has not yet been delivered AND promised_date < as_of.
+
+  days_late:
+    - For delivered shipments: (delivered_date - promised_date).days
+    - For open shipments:      (as_of - promised_date).days
+
+  Sorting: worst (highest days_late) first; ties broken by shipment_id ascending.
+
+  Shipments whose ship_date is after as_of are excluded entirely.
+  Shipments delivered on a day other than as_of are excluded (only same-day
+  deliveries are flagged for that run date).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from dags.shipments_daily import find_late_shipments
+
+AS_OF = "2026-03-03"  # Tuesday
+
+
+# ── Helpers ───────────────────────────────────────────────────────────────────
+
+def _row(shipment_id, ship_date, carrier, promised_date, delivered_date=""):
+    return {
+        "shipment_id": shipment_id,
+        "ship_date": ship_date,
+        "carrier": carrier,
+        "promised_date": promised_date,
+        "delivered_date": delivered_date,
+    }
+
+
+# ── Delivered-and-late cases ──────────────────────────────────────────────────
+
+class TestDeliveredLate:
+    """Shipment delivered on as_of, after the promised date."""
+
+    def test_delivered_on_as_of_after_promise_is_late(self):
+        row = _row("SH-A", "2026-02-28", "DHL", promised_date="2026-03-02",
+                   delivered_date=AS_OF)
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert len(result) == 1
+        assert result[0]["shipment_id"] == "SH-A"
+        assert result[0]["days_late"] == 1   # 03-03 minus 03-02
+
+    def test_days_late_counts_from_promised_to_delivered(self):
+        row = _row("SH-B", "2026-02-20", "UPS", promised_date="2026-02-24",
+                   delivered_date=AS_OF)
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert len(result) == 1
+        assert result[0]["days_late"] == 7   # 03-03 minus 02-24
+
+    def test_delivered_on_as_of_exactly_on_time_is_not_late(self):
+        """delivered_date == promised_date == as_of → on time."""
+        row = _row("SH-C", "2026-02-27", "FedEx", promised_date=AS_OF,
+                   delivered_date=AS_OF)
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert result == []
+
+    def test_delivered_on_as_of_before_promise_is_not_late(self):
+        """Early delivery (delivered < promised) is never late."""
+        row = _row("SH-D", "2026-03-02", "DHL", promised_date="2026-03-04",
+                   delivered_date=AS_OF)
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert result == []
+
+    def test_delivered_before_as_of_is_excluded(self):
+        """A shipment delivered before as_of doesn't appear in today's report."""
+        row = _row("SH-E", "2026-02-20", "UPS", promised_date="2026-02-24",
+                   delivered_date="2026-03-02")  # delivered yesterday
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert result == []
+
+    def test_delivered_after_as_of_is_excluded(self):
+        """A shipment that will be delivered in the future is not flagged today."""
+        row = _row("SH-F", "2026-02-28", "DHL", promised_date="2026-03-02",
+                   delivered_date="2026-03-04")
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert result == []
+
+
+# ── Open (undelivered) cases ──────────────────────────────────────────────────
+
+class TestOpenLate:
+    """Shipments still undelivered as of the run date."""
+
+    def test_open_shipment_with_past_promise_is_late(self):
+        row = _row("SH-G", "2026-02-25", "FedEx", promised_date="2026-02-28")
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert len(result) == 1
+        assert result[0]["shipment_id"] == "SH-G"
+        assert result[0]["days_late"] == 3   # 03-03 minus 02-28
+
+    def test_days_late_for_open_counts_to_as_of(self):
+        row = _row("SH-H", "2026-02-24", "DHL", promised_date="2026-02-26")
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert len(result) == 1
+        assert result[0]["days_late"] == 5   # 03-03 minus 02-26
+
+    def test_open_shipment_with_promise_equal_to_as_of_is_not_late(self):
+        """promised_date == as_of → still within SLA today (not yet late)."""
+        row = _row("SH-I", "2026-03-01", "DHL", promised_date=AS_OF)
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert result == []
+
+    def test_open_shipment_with_future_promise_is_not_late(self):
+        row = _row("SH-J", "2026-03-01", "UPS", promised_date="2026-03-05")
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert result == []
+
+
+# ── Exclusion by ship_date ────────────────────────────────────────────────────
+
+class TestShipDateExclusion:
+    """Rows whose ship_date is after as_of must be excluded."""
+
+    def test_not_yet_shipped_excluded(self):
+        row = _row("SH-K", "2026-03-04", "FedEx", promised_date="2026-03-06")
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert result == []
+
+    def test_shipped_on_as_of_included_if_otherwise_late(self):
+        """ship_date == as_of is still eligible (it has shipped)."""
+        row = _row("SH-L", AS_OF, "DHL", promised_date="2026-02-28")
+        # open and past promise → late
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert len(result) == 1
+
+    def test_shipped_before_as_of_eligible(self):
+        row = _row("SH-M", "2026-02-01", "UPS", promised_date="2026-02-28")
+        result = find_late_shipments([row], as_of=AS_OF)
+        assert len(result) == 1
+
+
+# ── Sorting ───────────────────────────────────────────────────────────────────
+
+class TestSorting:
+    """Results must be sorted: worst (highest days_late) first,
+    ties broken by shipment_id ascending."""
+
+    def test_sorted_by_days_late_descending(self):
+        rows = [
+            _row("SH-N1", "2026-02-01", "DHL", "2026-02-24"),   # days_late=7
+            _row("SH-N2", "2026-02-01", "UPS", "2026-03-01"),   # days_late=2
+            _row("SH-N3", "2026-02-01", "FedEx", "2026-02-28"), # days_late=3
+        ]
+        result = find_late_shipments(rows, as_of=AS_OF)
+        assert [r["shipment_id"] for r in result] == ["SH-N1", "SH-N3", "SH-N2"]
+
+    def test_ties_broken_by_shipment_id_ascending(self):
+        rows = [
+            _row("SH-Z", "2026-02-01", "DHL", "2026-03-01"),  # days_late=2
+            _row("SH-A", "2026-02-01", "UPS", "2026-03-01"),  # days_late=2
+            _row("SH-M", "2026-02-01", "FedEx", "2026-03-01"), # days_late=2
+        ]
+        result = find_late_shipments(rows, as_of=AS_OF)
+        assert [r["shipment_id"] for r in result] == ["SH-A", "SH-M", "SH-Z"]
+
+    def test_empty_input_returns_empty(self):
+        assert find_late_shipments([], as_of=AS_OF) == []
+
+    def test_no_late_shipments_returns_empty(self):
+        rows = [
+            _row("SH-O1", "2026-02-27", "UPS", AS_OF, delivered_date=AS_OF),  # on-time
+            _row("SH-O2", "2026-03-01", "DHL", "2026-03-05"),  # future promise
+        ]
+        result = find_late_shipments(rows, as_of=AS_OF)
+        assert result == []
+
+
+# ── Full sample-data snapshot ─────────────────────────────────────────────────
+
+class TestSampleDataSnapshot:
+    """
+    Regression snapshot against the actual data/shipments.csv rows for 2026-03-03.
+
+    Expected late shipments (derived manually from the CSV):
+      SH-1009: open, promised 2026-02-26, days_late=5  (03-03 − 02-26)
+      SH-1003: open, promised 2026-02-28, days_late=3  (03-03 − 02-28)
+      SH-1007: delivered 03-03, promised 2026-03-01, days_late=2
+      SH-1001: delivered 03-03, promised 2026-03-02, days_late=1
+
+    Not included:
+      SH-1002: delivered 03-03, promised 03-03 → on time (delivered == promised)
+      SH-1004: open, promised 03-03 → not yet late (promise == as_of)
+      SH-1005: delivered 03-02 ≠ as_of → excluded from today's window
+      SH-1006: ship_date 03-04 > as_of → not yet shipped
+      SH-1008: delivered 03-03, promised 03-04 → early delivery, not late
+    """
+
+    SAMPLE_ROWS = [
+        {"shipment_id": "SH-1001", "ship_date": "2026-02-26", "carrier": "DHL",
+         "promised_date": "2026-03-02", "delivered_date": "2026-03-03"},
+        {"shipment_id": "SH-1002", "ship_date": "2026-02-27", "carrier": "UPS",
+         "promised_date": "2026-03-03", "delivered_date": "2026-03-03"},
+        {"shipment_id": "SH-1003", "ship_date": "2026-02-25", "carrier": "FedEx",
+         "promised_date": "2026-02-28", "delivered_date": ""},
+        {"shipment_id": "SH-1004", "ship_date": "2026-03-01", "carrier": "DHL",
+         "promised_date": "2026-03-03", "delivered_date": ""},
+        {"shipment_id": "SH-1005", "ship_date": "2026-02-20", "carrier": "UPS",
+         "promised_date": "2026-02-24", "delivered_date": "2026-03-02"},
+        {"shipment_id": "SH-1006", "ship_date": "2026-03-04", "carrier": "FedEx",
+         "promised_date": "2026-03-06", "delivered_date": ""},
+        {"shipment_id": "SH-1007", "ship_date": "2026-02-28", "carrier": "UPS",
+         "promised_date": "2026-03-01", "delivered_date": "2026-03-03"},
+        {"shipment_id": "SH-1008", "ship_date": "2026-03-02", "carrier": "DHL",
+         "promised_date": "2026-03-04", "delivered_date": "2026-03-03"},
+        {"shipment_id": "SH-1009", "ship_date": "2026-02-24", "carrier": "DHL",
+         "promised_date": "2026-02-26", "delivered_date": ""},
+    ]
+
+    def test_correct_shipments_flagged(self):
+        result = find_late_shipments(self.SAMPLE_ROWS, as_of=AS_OF)
+        ids = [r["shipment_id"] for r in result]
+        assert ids == ["SH-1009", "SH-1003", "SH-1007", "SH-1001"]
+
+    def test_correct_days_late(self):
+        result = find_late_shipments(self.SAMPLE_ROWS, as_of=AS_OF)
+        by_id = {r["shipment_id"]: r["days_late"] for r in result}
+        assert by_id == {
+            "SH-1001": 1,
+            "SH-1003": 3,
+            "SH-1007": 2,
+            "SH-1009": 5,
+        }
+
+    def test_excluded_shipments_absent(self):
+        result = find_late_shipments(self.SAMPLE_ROWS, as_of=AS_OF)
+        ids = {r["shipment_id"] for r in result}
+        assert "SH-1002" not in ids, "SH-1002 is on-time; must not appear"
+        assert "SH-1004" not in ids, "SH-1004 promise==as_of; must not appear"
+        assert "SH-1005" not in ids, "SH-1005 was delivered yesterday; must not appear"
+        assert "SH-1006" not in ids, "SH-1006 hasn't shipped yet; must not appear"
+        assert "SH-1008" not in ids, "SH-1008 is early delivery; must not appear"
