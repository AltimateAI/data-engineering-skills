@@ -0,0 +1,178 @@
+"""DAG integrity tests — catch broken imports and structural violations.
+
+These tests run offline: no scheduler, webserver or database required.
+
+Covered:
+1. Every DAG file in dags/ must import without error.
+2. Every task in every DAG must have at least 2 retries.
+3. shipments_daily must be scheduled at 07:30 UTC, Monday–Friday only.
+4. In shipments_daily, build_report must be directly downstream of
+   extract_shipments (report can only be built after the export is extracted).
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+from airflow.models import DagBag
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DAGS_DIR = PROJECT_ROOT / "dags"
+
+
+# ---------------------------------------------------------------------------
+# Helper: collect all .py files in dags/ so parametrize works even when new
+# files are added later.
+# ---------------------------------------------------------------------------
+DAG_FILES = sorted(DAGS_DIR.glob("*.py"))
+
+
+# ---------------------------------------------------------------------------
+# 1. Import integrity — every dag file must load without error
+# ---------------------------------------------------------------------------
+
+class TestDagImports:
+    """Each DAG file in dags/ must be importable without any errors."""
+
+    @pytest.mark.parametrize("dag_file", DAG_FILES, ids=lambda p: p.name)
+    def test_dag_file_loads_without_errors(self, dag_file: Path) -> None:
+        """DagBag must report zero import errors for each DAG file."""
+        os.chdir(PROJECT_ROOT)
+        # Load a fresh DagBag scoped to a single file to get a precise error
+        # message if something goes wrong.
+        bag = DagBag(dag_folder=str(dag_file), include_examples=False)
+        errors = bag.import_errors
+        assert errors == {}, (
+            f"{dag_file.name} failed to import:\n"
+            + "\n".join(f"  {k}: {v}" for k, v in errors.items())
+        )
+
+
+# ---------------------------------------------------------------------------
+# 2. Retry policy — every task in every DAG must have >= 2 retries
+# ---------------------------------------------------------------------------
+
+class TestRetryPolicy:
+    """Every task in every DAG must be configured with at least 2 retries."""
+
+    def _all_tasks(self, dagbag: DagBag):
+        """Yield (dag_id, task_id, retries) for every task across all DAGs."""
+        for dag_id, dag in dagbag.dags.items():
+            for task in dag.tasks:
+                yield dag_id, task.task_id, task.retries
+
+    def test_all_tasks_have_at_least_two_retries(self, dagbag: DagBag) -> None:
+        """Fail if any task has fewer than 2 retries; report all violators."""
+        violations = [
+            f"  {dag_id}.{task_id}: retries={retries}"
+            for dag_id, task_id, retries in self._all_tasks(dagbag)
+            if retries < 2
+        ]
+        assert not violations, (
+            "The following tasks have fewer than 2 retries:\n"
+            + "\n".join(violations)
+        )
+
+
+# ---------------------------------------------------------------------------
+# 3. shipments_daily schedule — 07:30 UTC, Monday–Friday only
+# ---------------------------------------------------------------------------
+
+class TestShipmentsDailySchedule:
+    """shipments_daily must run at 07:30 UTC on weekdays (Mon–Fri) only."""
+
+    DAG_ID = "shipments_daily"
+    EXPECTED_CRON = "30 7 * * 1-5"
+
+    def test_dag_exists(self, dagbag: DagBag) -> None:
+        assert self.DAG_ID in dagbag.dags, (
+            f"DAG '{self.DAG_ID}' was not found in DagBag"
+        )
+
+    def test_schedule_is_weekdays_0730_utc(self, dagbag: DagBag) -> None:
+        dag = dagbag.dags[self.DAG_ID]
+        schedule = dag.schedule_interval
+        assert schedule == self.EXPECTED_CRON, (
+            f"Expected schedule '{self.EXPECTED_CRON}', got '{schedule}'"
+        )
+
+    def test_schedule_fires_on_monday(self, dagbag: DagBag) -> None:
+        """Verify cron expression: Monday is included (dow=1)."""
+        from croniter import croniter
+        from datetime import datetime, timezone
+
+        dag = dagbag.dags[self.DAG_ID]
+        cron = dag.schedule_interval
+        # Start from Sunday 2026-03-01 00:00 UTC, expect next fire on Monday
+        base = datetime(2026, 3, 1, 0, 0, tzinfo=timezone.utc)
+        it = croniter(cron, base)
+        next_run = it.get_next(datetime)
+        assert next_run.weekday() == 0, (  # 0 = Monday
+            f"First fire after Sunday should be Monday, got weekday={next_run.weekday()}"
+        )
+        assert next_run.hour == 7 and next_run.minute == 30, (
+            f"Expected 07:30, got {next_run.hour}:{next_run.minute:02d}"
+        )
+
+    def test_schedule_does_not_fire_on_saturday(self, dagbag: DagBag) -> None:
+        """Verify cron expression: Saturday is excluded (dow=6)."""
+        from croniter import croniter
+        from datetime import datetime, timezone
+
+        dag = dagbag.dags[self.DAG_ID]
+        cron = dag.schedule_interval
+        # 2026-03-06 is a Friday; next run after 07:30 should be Monday 2026-03-09
+        base = datetime(2026, 3, 6, 7, 30, tzinfo=timezone.utc)
+        it = croniter(cron, base)
+        next_run = it.get_next(datetime)
+        assert next_run.weekday() not in (5, 6), (  # 5=Sat, 6=Sun
+            f"Schedule must not fire on weekends, but next run is weekday={next_run.weekday()}"
+        )
+
+    def test_schedule_does_not_fire_on_sunday(self, dagbag: DagBag) -> None:
+        """Verify cron expression: Sunday is excluded (dow=0 in cron = Sunday? No — verify)."""
+        from croniter import croniter
+        from datetime import datetime, timezone
+
+        dag = dagbag.dags[self.DAG_ID]
+        cron = dag.schedule_interval
+        # Step through 14 consecutive days and assert no fire on Sat or Sun
+        base = datetime(2026, 3, 2, 0, 0, tzinfo=timezone.utc)
+        it = croniter(cron, base)
+        for _ in range(10):  # 10 weekday firings ≈ 2 full weeks
+            run = it.get_next(datetime)
+            assert run.weekday() <= 4, (
+                f"Schedule fired on a weekend: {run} (weekday={run.weekday()})"
+            )
+
+
+# ---------------------------------------------------------------------------
+# 4. Task dependency — build_report must be downstream of extract_shipments
+# ---------------------------------------------------------------------------
+
+class TestShipmentsDailyDependencies:
+    """In shipments_daily, build_report must be directly downstream of extract_shipments."""
+
+    DAG_ID = "shipments_daily"
+
+    def test_extract_is_upstream_of_report(self, dagbag: DagBag) -> None:
+        dag = dagbag.dags[self.DAG_ID]
+        extract = dag.get_task("extract_shipments")
+        report = dag.get_task("build_report")
+
+        downstream_ids = {t.task_id for t in extract.downstream_list}
+        assert "build_report" in downstream_ids, (
+            "build_report must be a direct downstream dependency of extract_shipments, "
+            f"but extract_shipments downstream tasks are: {downstream_ids}"
+        )
+
+    def test_report_is_not_upstream_of_extract(self, dagbag: DagBag) -> None:
+        """Sanity check: the dependency must not be inverted."""
+        dag = dagbag.dags[self.DAG_ID]
+        report = dag.get_task("build_report")
+        upstream_ids = {t.task_id for t in report.upstream_list}
+        assert "extract_shipments" in upstream_ids, (
+            "build_report must have extract_shipments as an upstream dependency"
+        )
