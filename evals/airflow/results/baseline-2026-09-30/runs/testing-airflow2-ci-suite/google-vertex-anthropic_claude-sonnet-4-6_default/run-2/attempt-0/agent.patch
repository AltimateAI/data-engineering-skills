@@ -0,0 +1,176 @@
+"""Unit tests for the late-shipment classification logic in shipments_daily.
+
+Tests are pure Python — no Airflow, no database, no scheduler.
+
+Rules under test (from the DAG docstring and find_late_shipments):
+  A shipment is *late* for a given run date (as_of) when:
+    (a) It was delivered ON as_of and delivery_date > promised_date, OR
+    (b) It is still undelivered and promised_date < as_of.
+
+  days_late = (delivered_date if delivered, else as_of) - promised_date, in calendar days.
+
+  The result is sorted worst-first by days_late descending, then shipment_id ascending.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+
+# Make the dags package importable without installing it.
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "dags"))
+from shipments_daily import find_late_shipments  # noqa: E402
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def _row(
+    shipment_id: str,
+    ship_date: str,
+    promised_date: str,
+    delivered_date: str = "",
+    carrier: str = "DHL",
+) -> dict:
+    return {
+        "shipment_id": shipment_id,
+        "ship_date": ship_date,
+        "carrier": carrier,
+        "promised_date": promised_date,
+        "delivered_date": delivered_date,
+    }
+
+
+RUN_DATE = "2026-03-03"
+
+
+# ---------------------------------------------------------------------------
+# Case (a): delivered on as_of, after promised date → late
+# ---------------------------------------------------------------------------
+
+class TestDeliveredOnRunDateAfterPromised:
+    def test_delivered_on_run_date_after_promised_is_late(self) -> None:
+        rows = [_row("SH-001", "2026-03-01", "2026-03-02", "2026-03-03")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert len(result) == 1
+        assert result[0]["shipment_id"] == "SH-001"
+
+    def test_days_late_is_difference_from_promised_to_delivered(self) -> None:
+        # promised 2026-02-26, delivered 2026-03-03 → 5 days late
+        rows = [_row("SH-001", "2026-02-24", "2026-02-26", "2026-03-03")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result[0]["days_late"] == 5
+
+    def test_delivered_on_run_date_exactly_on_promised_is_not_late(self) -> None:
+        rows = [_row("SH-001", "2026-03-01", "2026-03-03", "2026-03-03")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result == []
+
+    def test_delivered_before_run_date_is_not_late(self) -> None:
+        """Deliveries that happened before today are not evaluated today."""
+        rows = [_row("SH-001", "2026-02-20", "2026-02-24", "2026-03-02")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result == []
+
+    def test_delivered_after_run_date_is_not_late_today(self) -> None:
+        """A future delivery date should not be flagged on this run."""
+        rows = [_row("SH-001", "2026-03-01", "2026-03-02", "2026-03-05")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result == []
+
+
+# ---------------------------------------------------------------------------
+# Case (b): undelivered and promised_date < as_of → late
+# ---------------------------------------------------------------------------
+
+class TestUndeliveredPastPromisedDate:
+    def test_undelivered_past_promised_is_late(self) -> None:
+        rows = [_row("SH-001", "2026-02-25", "2026-02-28")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert len(result) == 1
+        assert result[0]["shipment_id"] == "SH-001"
+
+    def test_days_late_uses_run_date_when_undelivered(self) -> None:
+        # promised 2026-02-28, run date 2026-03-03 → 3 days late
+        rows = [_row("SH-001", "2026-02-25", "2026-02-28")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result[0]["days_late"] == 3
+
+    def test_undelivered_promised_today_is_not_late(self) -> None:
+        """If promised_date == as_of and not yet delivered, not late yet."""
+        rows = [_row("SH-001", "2026-03-01", "2026-03-03")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result == []
+
+    def test_undelivered_promised_in_future_is_not_late(self) -> None:
+        rows = [_row("SH-001", "2026-03-01", "2026-03-10")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result == []
+
+
+# ---------------------------------------------------------------------------
+# Ship-date filtering — only shipments shipped on or before as_of are checked
+# ---------------------------------------------------------------------------
+
+class TestShipDateFiltering:
+    def test_shipment_not_yet_shipped_is_excluded(self) -> None:
+        rows = [_row("SH-001", "2026-03-04", "2026-03-02")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert result == []
+
+    def test_shipment_shipped_on_run_date_is_included(self) -> None:
+        rows = [_row("SH-001", "2026-03-03", "2026-03-02", "2026-03-03")]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert len(result) == 1
+
+
+# ---------------------------------------------------------------------------
+# Sorting — worst-first (descending days_late), then shipment_id ascending
+# ---------------------------------------------------------------------------
+
+class TestSortOrder:
+    def test_sorted_worst_first_by_days_late(self) -> None:
+        rows = [
+            _row("SH-001", "2026-02-24", "2026-02-26"),   # 5 days late
+            _row("SH-002", "2026-02-25", "2026-02-28"),   # 3 days late
+            _row("SH-003", "2026-02-28", "2026-03-01", "2026-03-03"),  # 2 days late
+        ]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert [r["shipment_id"] for r in result] == ["SH-001", "SH-002", "SH-003"]
+        assert result[0]["days_late"] >= result[1]["days_late"] >= result[2]["days_late"]
+
+    def test_tie_broken_by_shipment_id_ascending(self) -> None:
+        rows = [
+            _row("SH-Z", "2026-02-28", "2026-03-01", "2026-03-03"),   # 2 days
+            _row("SH-A", "2026-02-28", "2026-03-01", "2026-03-03"),   # 2 days
+            _row("SH-M", "2026-02-28", "2026-03-01", "2026-03-03"),   # 2 days
+        ]
+        result = find_late_shipments(rows, RUN_DATE)
+        assert [r["shipment_id"] for r in result] == ["SH-A", "SH-M", "SH-Z"]
+
+    def test_empty_input_returns_empty(self) -> None:
+        assert find_late_shipments([], RUN_DATE) == []
+
+
+# ---------------------------------------------------------------------------
+# Mixed-case: multiple late and non-late shipments together
+# ---------------------------------------------------------------------------
+
+class TestMixedCases:
+    def test_only_late_shipments_are_returned(self) -> None:
+        rows = [
+            _row("SH-OK1", "2026-03-01", "2026-03-05"),           # future promised, undelivered
+            _row("SH-OK2", "2026-03-01", "2026-03-03", "2026-03-03"),  # on-time delivered today
+            _row("SH-OK3", "2026-02-20", "2026-02-24", "2026-03-02"),  # delivered before today
+            _row("SH-LATE1", "2026-02-25", "2026-02-28"),          # undelivered, past promised
+            _row("SH-LATE2", "2026-02-28", "2026-03-01", "2026-03-03"),  # delivered today, late
+        ]
+        result = find_late_shipments(rows, RUN_DATE)
+        ids = {r["shipment_id"] for r in result}
+        assert ids == {"SH-LATE1", "SH-LATE2"}
+        assert "SH-OK1" not in ids
+        assert "SH-OK2" not in ids
+        assert "SH-OK3" not in ids
