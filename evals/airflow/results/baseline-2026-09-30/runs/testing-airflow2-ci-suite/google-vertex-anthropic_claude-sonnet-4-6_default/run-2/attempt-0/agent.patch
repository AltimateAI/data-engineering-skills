@@ -0,0 +1,169 @@
+"""End-to-end test for shipments_daily on the sample data for 2026-03-03.
+
+Runs the actual python callables from the DAG (extract_shipments and
+build_report) back-to-back with a lightweight xcom stub.  No scheduler,
+webserver or database is required — we only call the functions, never
+instantiate a TaskInstance against a real Airflow DB.
+
+Expected output for run date 2026-03-03 from data/shipments.csv
+---------------------------------------------------------------
+Shipment rules (see DAG docstring):
+  Late if delivered on the run date after the promised date, OR
+  if still undelivered and promised date is before the run date.
+
+Row-by-row analysis:
+  SH-1001  delivered=2026-03-03 (=run date) > promised=2026-03-02  → LATE  1 day
+  SH-1002  delivered=2026-03-03 (=run date) = promised=2026-03-03  → on time
+  SH-1003  undelivered, promised=2026-02-28 < 2026-03-03           → LATE  3 days
+  SH-1004  undelivered, promised=2026-03-03 = run date             → not late yet
+  SH-1005  delivered=2026-03-02 ≠ run date                         → not evaluated
+  SH-1006  ship_date=2026-03-04 > run date                         → excluded
+  SH-1007  delivered=2026-03-03 (=run date) > promised=2026-03-01  → LATE  2 days
+  SH-1008  delivered=2026-03-03 (=run date) < promised=2026-03-04  → on time
+  SH-1009  undelivered, promised=2026-02-26 < 2026-03-03           → LATE  5 days
+
+Expected late shipments sorted worst-first:
+  SH-1009  5 days  (undelivered)
+  SH-1003  3 days  (undelivered)
+  SH-1007  2 days  (delivered today)
+  SH-1001  1 day   (delivered today)
+"""
+
+from __future__ import annotations
+
+import csv
+import os
+import tempfile
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+@pytest.fixture(scope="module")
+def shipments_dag(dagbag):
+    """Return the shipments_daily DAG object."""
+    dag = dagbag.dags.get("shipments_daily")
+    assert dag is not None, "shipments_daily not found in DagBag"
+    return dag
+
+
+@pytest.fixture(scope="module")
+def e2e_output(shipments_dag, tmp_path_factory):
+    """Run extract_shipments then build_report and return the output CSV rows.
+
+    Uses a temporary output directory so the test never writes to the real
+    output/ folder and is safe to run repeatedly.
+    """
+    tmp_dir = tmp_path_factory.mktemp("e2e_output")
+
+    # --- Step 1: extract ---
+    extract_task = shipments_dag.get_task("extract_shipments")
+    rows = extract_task.python_callable()
+    assert isinstance(rows, list) and len(rows) > 0, "extract returned no rows"
+
+    # --- Step 2: build_report (stub xcom so it gets the rows from Step 1) ---
+    build_task = shipments_dag.get_task("build_report")
+
+    # Temporarily redirect OUTPUT_DIR to our tmp directory so the report is
+    # written there instead of <project>/output/late_shipments/.
+    import shipments_daily as sd
+    original_output_dir = sd.OUTPUT_DIR
+    sd.OUTPUT_DIR = tmp_dir
+    try:
+        ti_mock = MagicMock()
+        ti_mock.xcom_pull.return_value = rows
+        out_path = build_task.python_callable(ds="2026-03-03", ti=ti_mock)
+    finally:
+        sd.OUTPUT_DIR = original_output_dir
+
+    out = Path(out_path)
+    assert out.exists(), f"Report file was not created at {out}"
+
+    with out.open(newline="") as fh:
+        return list(csv.DictReader(fh))
+
+
+# ---------------------------------------------------------------------------
+# Tests
+# ---------------------------------------------------------------------------
+
+class TestShipmentsDailyE2E:
+    RUN_DATE = "2026-03-03"
+    EXPECTED_ORDER = ["SH-1009", "SH-1003", "SH-1007", "SH-1001"]
+
+    def test_exactly_four_late_shipments(self, e2e_output) -> None:
+        """There must be exactly 4 late shipments for 2026-03-03."""
+        assert len(e2e_output) == 4, (
+            f"Expected 4 late rows, got {len(e2e_output)}: "
+            + str([r["shipment_id"] for r in e2e_output])
+        )
+
+    def test_correct_shipment_ids(self, e2e_output) -> None:
+        """The four late shipments are SH-1001, SH-1003, SH-1007, SH-1009."""
+        ids = {r["shipment_id"] for r in e2e_output}
+        assert ids == set(self.EXPECTED_ORDER), (
+            f"Expected IDs {set(self.EXPECTED_ORDER)}, got {ids}"
+        )
+
+    def test_sort_order_worst_first(self, e2e_output) -> None:
+        """Rows must be ordered worst (most days late) first."""
+        ids = [r["shipment_id"] for r in e2e_output]
+        assert ids == self.EXPECTED_ORDER, (
+            f"Expected order {self.EXPECTED_ORDER}, got {ids}"
+        )
+
+    def test_days_late_values(self, e2e_output) -> None:
+        """days_late must be correct for each shipment."""
+        by_id = {r["shipment_id"]: int(r["days_late"]) for r in e2e_output}
+        assert by_id["SH-1009"] == 5, f"SH-1009: expected 5, got {by_id['SH-1009']}"
+        assert by_id["SH-1003"] == 3, f"SH-1003: expected 3, got {by_id['SH-1003']}"
+        assert by_id["SH-1007"] == 2, f"SH-1007: expected 2, got {by_id['SH-1007']}"
+        assert by_id["SH-1001"] == 1, f"SH-1001: expected 1, got {by_id['SH-1001']}"
+
+    def test_on_time_shipments_excluded(self, e2e_output) -> None:
+        """SH-1002 (on time), SH-1004 (not yet late), SH-1008 (early) must not appear."""
+        ids = {r["shipment_id"] for r in e2e_output}
+        for excluded in ("SH-1002", "SH-1004", "SH-1008"):
+            assert excluded not in ids, (
+                f"{excluded} should not be in the late-shipments report"
+            )
+
+    def test_future_ship_date_excluded(self, e2e_output) -> None:
+        """SH-1006 (ship_date after run date) must not appear."""
+        ids = {r["shipment_id"] for r in e2e_output}
+        assert "SH-1006" not in ids
+
+    def test_previously_delivered_excluded(self, e2e_output) -> None:
+        """SH-1005 (delivered on 2026-03-02, before run date) must not appear."""
+        ids = {r["shipment_id"] for r in e2e_output}
+        assert "SH-1005" not in ids
+
