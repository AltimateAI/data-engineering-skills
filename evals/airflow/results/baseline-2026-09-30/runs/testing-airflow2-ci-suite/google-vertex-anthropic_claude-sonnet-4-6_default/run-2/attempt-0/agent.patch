+"""Shared fixtures for the Airflow DAG test suite.
+
+No scheduler, webserver or database is required.  DagBag is loaded
+once per session so every test module gets the same parsed objects
+without re-importing the dag files repeatedly.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+from airflow.models import DagBag
+
+# Resolve the project root (one level above this tests/ directory) so that
+# DATA_DIR / OUTPUT_DIR inside the dag files resolve correctly regardless of
+# where pytest is invoked from.
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DAGS_DIR = PROJECT_ROOT / "dags"
+
+
+@pytest.fixture(scope="session")
+def dagbag() -> DagBag:
+    """Load all DAGs from dags/ exactly once for the whole test session."""
+    # Ensure the working directory the dag files use for relative paths is the
+    # project root, matching the runtime Airflow environment.
+    os.chdir(PROJECT_ROOT)
+    bag = DagBag(dag_folder=str(DAGS_DIR), include_examples=False)
+    return bag
