+"""Test the late-shipment detection logic from shipments_daily."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+def load_shipments_daily_module(dags_dir: Path):
+    """Load the shipments_daily module to access its functions."""
+    spec = importlib.util.spec_from_file_location(
+        "shipments_daily", dags_dir / "shipments_daily.py"
+    )
+    assert spec is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def shipments_module(dags_dir: Path):
+    """Fixture providing the shipments_daily module."""
+    return load_shipments_daily_module(dags_dir)
+
+
+class TestFindLateShipments:
+    """Test the find_late_shipments logic."""
+
+    def test_delivered_after_promised_date_on_run_date(self, shipments_module):
+        """A shipment delivered on run_date after promised_date is late.
+        
+        Key: The delivery_date must EQUAL the run_date AND be AFTER promised_date.
+        """
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-03",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-001"
+        # days_late = delivered_date - promised_date = 2026-03-03 - 2026-03-02 = 1 day
+        assert late[0]["days_late"] == 1
+
+    def test_not_delivered_after_promised_date_before_run_date(self, shipments_module):
+        """A shipment undelivered with promised_date before run_date is late."""
+        rows = [
+            {
+                "shipment_id": "SH-002",
+                "ship_date": "2026-02-28",
+                "carrier": "UPS",
+                "promised_date": "2026-03-01",
+                "delivered_date": "",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-05")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-002"
+        assert late[0]["days_late"] == 4  # from 2026-03-01 to 2026-03-05
+
+    def test_not_late_delivered_on_time(self, shipments_module):
+        """A shipment delivered on or before promised_date is not late."""
+        rows = [
+            {
+                "shipment_id": "SH-003",
+                "ship_date": "2026-03-01",
+                "carrier": "FedEx",
+                "promised_date": "2026-03-03",
+                "delivered_date": "2026-03-03",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0
+
+    def test_not_late_undelivered_promised_future(self, shipments_module):
+        """A shipment undelivered with promised_date >= run_date is not late."""
+        rows = [
+            {
+                "shipment_id": "SH-004",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-05",
+                "delivered_date": "",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0
+
+    def test_not_included_before_ship_date(self, shipments_module):
+        """A shipment with ship_date > run_date is excluded."""
+        rows = [
+            {
+                "shipment_id": "SH-005",
+                "ship_date": "2026-03-05",
+                "carrier": "UPS",
+                "promised_date": "2026-03-06",
+                "delivered_date": "",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-03")
+        assert len(late) == 0
+
+    def test_delivered_before_promised_not_late(self, shipments_module):
+        """A shipment delivered before promised_date is not late, even if before run_date."""
+        rows = [
+            {
+                "shipment_id": "SH-006",
+                "ship_date": "2026-02-28",
+                "carrier": "FedEx",
+                "promised_date": "2026-03-05",
+                "delivered_date": "2026-03-02",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-10")
+        assert len(late) == 0
+
+    def test_delivered_not_on_run_date_not_late(self, shipments_module):
+        """A shipment delivered before run_date (even if late) is not in the report.
+        
+        The report only includes shipments delivered ON the run_date that are late,
+        or undelivered shipments whose promised_date has passed.
+        """
+        rows = [
+            {
+                "shipment_id": "SH-006b",
+                "ship_date": "2026-02-28",
+                "carrier": "FedEx",
+                "promised_date": "2026-03-01",
+                "delivered_date": "2026-03-02",  # delivered late, but not on run_date
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-05")
+        # Not late in report because delivered_date != run_date
+        assert len(late) == 0
+
+    def test_sorting_worst_first(self, shipments_module):
+        """Late shipments are sorted by days_late descending, then by shipment_id."""
+        rows = [
+            {
+                "shipment_id": "SH-A",
+                "ship_date": "2026-02-20",
+                "carrier": "DHL",
+                "promised_date": "2026-02-25",
+                "delivered_date": "",
+            },
+            {
+                "shipment_id": "SH-B",
+                "ship_date": "2026-02-20",
+                "carrier": "UPS",
+                "promised_date": "2026-02-24",
+                "delivered_date": "",
+            },
+            {
+                "shipment_id": "SH-C",
+                "ship_date": "2026-02-20",
+                "carrier": "FedEx",
+                "promised_date": "2026-02-25",
+                "delivered_date": "",
+            },
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-05")
+        assert len(late) == 3
+        # SH-B is 10 days late, SH-A and SH-C are 9 days late (sorted by ID)
+        assert late[0]["shipment_id"] == "SH-B"
+        assert late[1]["shipment_id"] == "SH-A"
+        assert late[2]["shipment_id"] == "SH-C"
+
+    def test_days_late_from_promised_to_delivered(self, shipments_module):
+        """days_late is correctly calculated from promised to delivered date.
+        
+        Only included if delivered_date == run_date.
+        """
+        rows = [
+            {
+                "shipment_id": "SH-007",
+                "ship_date": "2026-02-20",
+                "carrier": "DHL",
+                "promised_date": "2026-02-25",
+                "delivered_date": "2026-02-28",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-02-28")
+        assert len(late) == 1
+        # days_late = (Feb 28) - (Feb 25) = 3 days
+        assert late[0]["days_late"] == 3
+
+    def test_days_late_from_promised_to_run_date(self, shipments_module):
+        """days_late is correctly calculated from promised to run_date for undelivered."""
+        rows = [
+            {
+                "shipment_id": "SH-008",
+                "ship_date": "2026-02-20",
+                "carrier": "UPS",
+                "promised_date": "2026-02-25",
+                "delivered_date": "",
+            }
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-02")
+        assert len(late) == 1
+        # days_late = (Mar 02) - (Feb 25) = 5 days
+        assert late[0]["days_late"] == 5
+
+    def test_mixed_delivered_and_undelivered(self, shipments_module):
+        """Mix of delivered and undelivered late shipments sorted correctly."""
+        rows = [
+            {
+                "shipment_id": "SH-D",
+                "ship_date": "2026-02-20",
+                "carrier": "DHL",
+                "promised_date": "2026-02-24",
+                "delivered_date": "2026-03-01",  # Delivered 2026-03-01, late but not on run_date
+            },
+            {
+                "shipment_id": "SH-E",
+                "ship_date": "2026-02-20",
+                "carrier": "UPS",
+                "promised_date": "2026-02-24",
+                "delivered_date": "",  # Undelivered, promised date passed
+            },
+        ]
+        late = shipments_module.find_late_shipments(rows, as_of="2026-03-05")
+        # Only SH-E is in the report (SH-D was delivered on 2026-03-01, not on 2026-03-05)
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-E"
+        # days_late = (Mar 05) - (Feb 24) = 9 days
+        assert late[0]["days_late"] == 9
