+"""Test structural requirements for all DAGs and their tasks."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+from airflow.models import DAG
+from airflow.models.baseoperator import BaseOperator
+
+
+def load_dag(dag_file: Path) -> DAG:
+    """Load a DAG from a Python file and return the DAG object."""
+    import importlib.util
+
+    spec = importlib.util.spec_from_file_location(dag_file.stem, dag_file)
+    assert spec is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+
+    # Find the DAG object in the module
+    dags = [obj for obj in vars(module).values() if isinstance(obj, DAG)]
+    assert len(dags) == 1, f"Expected exactly 1 DAG in {dag_file.name}, found {len(dags)}"
+    return dags[0]
+
+
+@pytest.fixture(params=["shipments_daily.py", "carrier_rates_weekly.py"])
+def dag_file(request, dags_dir: Path) -> Path:
+    """Parametrized fixture that yields each DAG file."""
+    return dags_dir / request.param
+
+
+@pytest.fixture
+def dag(dag_file: Path) -> DAG:
+    """Load the DAG from the file."""
+    return load_dag(dag_file)
+
+
+class TestRetries:
+    """Every task must have at least 2 retries."""
+
+    def test_all_tasks_have_min_retries(self, dag: DAG) -> None:
+        """Every task in the DAG must have retries >= 2."""
+        failures = []
+        for task in dag.tasks:
+            if task.retries < 2:
+                failures.append(
+                    f"Task '{task.task_id}' in '{dag.dag_id}' has {task.retries} retries "
+                    f"(minimum 2 required)"
+                )
+        assert not failures, "\n".join(failures)
+
+
+class TestShipmentsDailySchedule:
+    """Tests specific to the shipments_daily DAG."""
+
+    @pytest.fixture
+    def shipments_daily_dag(self, dags_dir: Path) -> DAG:
+        """Load the shipments_daily DAG."""
+        return load_dag(dags_dir / "shipments_daily.py")
+
+    def test_schedule_is_weekdays_0730_utc(self, shipments_daily_dag: DAG) -> None:
+        """shipments_daily must run at 07:30 UTC Mon-Fri (schedule='30 7 * * 1-5')."""
+        expected_schedule = "30 7 * * 1-5"
+        actual_schedule = shipments_daily_dag.schedule_interval
+        assert (
+            actual_schedule == expected_schedule
+        ), f"Expected schedule '{expected_schedule}', got '{actual_schedule}'"
+
+
+class TestShipmentsDailyDependencies:
+    """Test task dependencies in shipments_daily."""
+
+    @pytest.fixture
+    def shipments_daily_dag(self, dags_dir: Path) -> DAG:
+        """Load the shipments_daily DAG."""
+        return load_dag(dags_dir / "shipments_daily.py")
+
+    def test_report_depends_on_extract(self, shipments_daily_dag: DAG) -> None:
+        """The build_report task must depend on extract_shipments."""
+        report_task = shipments_daily_dag.get_task("build_report")
+        extract_task = shipments_daily_dag.get_task("extract_shipments")
+
+        # Get upstream dependencies of report
+        upstream_ids = {t.task_id for t in report_task.upstream_list}
+
+        assert (
+            "extract_shipments" in upstream_ids
+        ), (
+            f"build_report must depend on extract_shipments. "
+            f"Current upstream: {upstream_ids}"
+        )
