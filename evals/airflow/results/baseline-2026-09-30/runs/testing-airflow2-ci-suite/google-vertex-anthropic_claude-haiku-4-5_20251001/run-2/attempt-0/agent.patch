+"""Test that all DAG files import without errors."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+def test_all_dags_import(dags_dir: Path) -> None:
+    """Every Python file in dags/ must import without error."""
+    dag_files = sorted(dags_dir.glob("*.py"))
+    assert dag_files, f"No DAG files found in {dags_dir}"
+
+    errors = {}
+    for dag_file in dag_files:
+        try:
+            spec = importlib.util.spec_from_file_location(dag_file.stem, dag_file)
+            assert spec is not None, f"Could not create module spec for {dag_file}"
+            module = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(module)
+        except Exception as e:
+            errors[dag_file.name] = str(e)
+
+    assert not errors, (
+        f"Failed to import {len(errors)} DAG file(s):\n"
+        + "\n".join(f"  {name}: {err}" for name, err in errors.items())
+    )
