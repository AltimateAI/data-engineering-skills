+"""End-to-end integration test for shipments_daily DAG.
+
+Runs the DAG tasks against sample data for 2026-03-03 and validates the output.
+"""
+
+from __future__ import annotations
+
+import csv
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+
+def load_shipments_daily_module(dags_dir: Path):
+    """Load the shipments_daily module to access its functions."""
+    spec = importlib.util.spec_from_file_location(
+        "shipments_daily", dags_dir / "shipments_daily.py"
+    )
+    assert spec is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def shipments_module(dags_dir: Path):
+    """Fixture providing the shipments_daily module."""
+    return load_shipments_daily_module(dags_dir)
+
+
+class MockTaskInstance:
+    """Mock TaskInstance for xcom_pull calls."""
+
+    def __init__(self, data: list[dict]):
+        self.data = data
+
+    def xcom_pull(self, task_ids: str) -> list[dict]:
+        return self.data
+
+
+class TestShipmentsDailyE2E:
+    """End-to-end test of the shipments_daily DAG."""
+
+    RUN_DATE = "2026-03-03"
+
+    def test_end_to_end_with_sample_data(
+        self, shipments_module, data_dir: Path, tmp_path: Path
+    ) -> None:
+        """
+        Run shipments_daily end-to-end for 2026-03-03 with sample data.
+
+        Late shipments are:
+        1. Shipments delivered ON run_date (2026-03-03) AFTER their promised_date, or
+        2. Shipments undelivered with promised_date BEFORE run_date.
+
+        For 2026-03-03:
+        - SH-1001: Delivered 2026-03-03, promised 2026-03-02 → 1 day late ✓
+        - SH-1007: Delivered 2026-03-03, promised 2026-03-01 → 2 days late ✓
+        - SH-1008: Delivered 2026-03-03, promised 2026-03-04 → NOT LATE (delivered before promised)
+        - SH-1003: Undelivered, promised 2026-02-28 → 3 days late ✓
+        - SH-1005: Delivered 2026-03-02, promised 2026-02-24 → NOT IN REPORT (not delivered on 2026-03-03)
+        - SH-1009: Undelivered, promised 2026-02-26 → 5 days late ✓
+        """
+        # Override DATA_DIR and OUTPUT_DIR in the module
+        shipments_module.DATA_DIR = data_dir
+        shipments_module.OUTPUT_DIR = tmp_path / "output" / "late_shipments"
+
+        # Step 1: Extract shipments
+        rows = shipments_module.extract_shipments()
+        assert len(rows) > 0, "extract_shipments should return rows"
+
+        # Step 2: Build report
+        ti = MockTaskInstance(rows)
+        report_path = shipments_module.build_report(
+            ds=self.RUN_DATE, ti=ti, task_instance=ti
+        )
+        report_file = Path(report_path)
+        assert report_file.exists(), f"Report file should be created at {report_path}"
+
+        # Step 3: Validate report contents
+        with report_file.open(newline="") as fh:
+            reader = csv.DictReader(fh)
+            late_shipments = list(reader)
+
+        # Verify expected late shipments
+        expected_ids = {
+            "SH-1001",  # Delivered 2026-03-03, promised 2026-03-02 → 1 day late
+            "SH-1007",  # Delivered 2026-03-03, promised 2026-03-01 → 2 days late
+            "SH-1003",  # Undelivered, promised 2026-02-28 → 3 days late
+            "SH-1009",  # Undelivered, promised 2026-02-26 → 5 days late
+        }
+        actual_ids = {row["shipment_id"] for row in late_shipments}
+        assert actual_ids == expected_ids, (
+            f"Expected shipments {expected_ids}, got {actual_ids}. "
+            f"Full report: {late_shipments}"
+        )
+
+        # Verify days_late calculations
+        days_late_map = {row["shipment_id"]: int(row["days_late"]) for row in late_shipments}
+        assert days_late_map["SH-1001"] == 1  # Mar 03 - Mar 02 = 1 day
+        assert days_late_map["SH-1007"] == 2  # Mar 03 - Mar 01 = 2 days
+        assert days_late_map["SH-1003"] == 3  # Mar 03 - Feb 28 = 3 days
+        assert days_late_map["SH-1009"] == 5  # Mar 03 - Feb 26 = 5 days
+
+        # Verify sorting (worst first: highest days_late, then by shipment_id)
+        shipment_ids_in_order = [row["shipment_id"] for row in late_shipments]
+        # SH-1009 has 5 days (worst), then SH-1003 with 3 days, SH-1007 with 2, SH-1001 with 1
+        assert shipment_ids_in_order[0] == "SH-1009"  # 5 days
+        assert shipment_ids_in_order[1] == "SH-1003"  # 3 days
+        assert shipment_ids_in_order[2] == "SH-1007"  # 2 days
+        assert shipment_ids_in_order[3] == "SH-1001"  # 1 day
+
+        # Verify columns are as expected
+        expected_columns = {
+            "shipment_id",
+            "carrier",
+            "promised_date",
+            "delivered_date",
+            "days_late",
+        }
+        actual_columns = set(late_shipments[0].keys()) if late_shipments else set()
+        assert actual_columns == expected_columns, (
+            f"Expected columns {expected_columns}, got {actual_columns}"
+        )
