+"""Test that all DAG files import successfully."""
+
+import sys
+from pathlib import Path
+
+import pytest
+
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DAGS_DIR = PROJECT_ROOT / "dags"
+
+
+def test_all_dags_import():
+    """Verify every .py file in dags/ imports without error."""
+    dag_files = sorted(DAGS_DIR.glob("*.py"))
+    assert len(dag_files) > 0, f"No DAG files found in {DAGS_DIR}"
+
+    for dag_file in dag_files:
+        # Add dags directory to path if not already present
+        dags_str = str(DAGS_DIR)
+        if dags_str not in sys.path:
+            sys.path.insert(0, dags_str)
+
+        # Import the module
+        module_name = dag_file.stem
+        try:
+            __import__(module_name)
+        except Exception as e:
+            pytest.fail(f"DAG file {dag_file.name} failed to import: {e}")
