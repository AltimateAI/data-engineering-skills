+"""Test the late shipment detection logic."""
+
+import shipments_daily
+
+
+class TestLateShipmentDetection:
+    """Test the find_late_shipments business logic."""
+
+    def test_delivered_on_time(self):
+        """Shipment delivered on or before promised date is not late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-05",
+                "delivered_date": "2026-03-05",
+            }
+        ]
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-05")
+        assert late == [], f"On-time delivery should not be marked late, got {late}"
+
+    def test_delivered_early(self):
+        """Shipment delivered before promised date is not late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-05",
+                "delivered_date": "2026-03-03",
+            }
+        ]
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-05")
+        assert late == [], f"Early delivery should not be marked late, got {late}"
+
+    def test_delivered_late_on_run_date(self):
+        """Shipment delivered late on the run date is marked late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-05",
+            }
+        ]
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-05")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-001"
+        assert late[0]["days_late"] == 3  # (2026-03-05) - (2026-03-02) = 3 days
+
+    def test_delivered_late_but_not_on_run_date(self):
+        """Shipment delivered late but not on the run date is not included."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-05",
+            }
+        ]
+        # Only include if delivered ON the run date
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-06")
+        assert late == [], (
+            "Should not include deliveries from previous days, got {late}"
+        )
+
+    def test_undelivered_with_past_promised_date(self):
+        """Undelivered shipment with promised date before run date is marked late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "",
+            }
+        ]
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-05")
+        assert len(late) == 1
+        assert late[0]["shipment_id"] == "SH-001"
+        assert late[0]["days_late"] == 3  # (2026-03-05) - (2026-03-02) = 3 days
+
+    def test_undelivered_with_future_promised_date(self):
+        """Undelivered shipment with promised date on/after run date is not late."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-01",
+                "carrier": "DHL",
+                "promised_date": "2026-03-05",
+                "delivered_date": "",
+            }
+        ]
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-03")
+        assert late == [], (
+            f"Future promised date should not be marked late, got {late}"
+        )
+
+    def test_unshipped_before_run_date(self):
+        """Shipment not yet shipped (ship_date after run date) is ignored."""
+        rows = [
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-03-10",
+                "carrier": "DHL",
+                "promised_date": "2026-03-15",
+                "delivered_date": "",
+            }
+        ]
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-05")
+        assert late == [], f"Future shipments should be ignored, got {late}"
+
+    def test_sorting_by_days_late_desc_then_id(self):
+        """Results are sorted by days_late (descending) then shipment_id (asc)."""
+        rows = [
+            {
+                "shipment_id": "SH-003",
+                "ship_date": "2026-02-20",
+                "carrier": "FedEx",
+                "promised_date": "2026-02-25",
+                "delivered_date": "",
+            },
+            {
+                "shipment_id": "SH-001",
+                "ship_date": "2026-02-20",
+                "carrier": "DHL",
+                "promised_date": "2026-02-28",
+                "delivered_date": "",
+            },
+            {
+                "shipment_id": "SH-002",
+                "ship_date": "2026-02-20",
+                "carrier": "UPS",
+                "promised_date": "2026-02-28",
+                "delivered_date": "",
+            },
+        ]
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-05")
+        assert len(late) == 3
+        # SH-003: 8 days late (2026-03-05 - 2026-02-25)
+        assert late[0]["shipment_id"] == "SH-003"
+        assert late[0]["days_late"] == 8
+        # SH-001 and SH-002 both 5 days late (2026-03-05 - 2026-02-28)
+        # sorted by ID: SH-001 before SH-002
+        assert late[1]["shipment_id"] == "SH-001"
+        assert late[1]["days_late"] == 5
+        assert late[2]["shipment_id"] == "SH-002"
+        assert late[2]["days_late"] == 5
