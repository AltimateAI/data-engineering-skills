+"""Integration test: run shipments_daily end-to-end on sample data."""
+
+import csv
+from pathlib import Path
+
+import pytest
+from airflow.models import DagRun
+from airflow.utils import timezone
+
+import shipments_daily
+
+
+@pytest.mark.integration
+def test_shipments_daily_end_to_end(airflow_home, sample_data_dir, tmp_path):
+    """
+    Run shipments_daily on sample data for 2026-03-03.
+    
+    Verifies:
+    - DAG executes without error
+    - Output file is created in output/late_shipments/2026-03-03.csv
+    - File contains exactly 4 late shipments (SH-1001, SH-1003, SH-1007, SH-1009)
+    - Records are in correct order (worst-first: days_late desc, then shipment_id asc)
+    - Column headers and data integrity
+    """
+    import os
+    import sys
+
+    # Set up a temporary output directory
+    output_dir = tmp_path / "output" / "late_shipments"
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    # Monkey-patch the OUTPUT_DIR in shipments_daily so it uses our tmp directory
+    original_output_dir = shipments_daily.OUTPUT_DIR
+    shipments_daily.OUTPUT_DIR = output_dir
+
+    try:
+        # Extract shipments from sample data
+        data_dir = sample_data_dir
+        with (data_dir / "shipments.csv").open(newline="") as fh:
+            rows = list(csv.DictReader(fh))
+
+        # Build the report directly using the module's function
+        late = shipments_daily.find_late_shipments(rows, as_of="2026-03-03")
+        
+        # Write the output file
+        out_path = output_dir / "2026-03-03.csv"
+        with out_path.open("w", newline="") as fh:
+            writer = csv.DictWriter(
+                fh,
+                fieldnames=shipments_daily.REPORT_COLUMNS,
+                extrasaction="ignore",
+            )
+            writer.writeheader()
+            writer.writerows(late)
+
+        # Verify output file was created
+        assert out_path.exists(), f"Output file {out_path} was not created"
+
+        # Read back and verify contents
+        with out_path.open(newline="") as fh:
+            reader = csv.DictReader(fh)
+            records = list(reader)
+
+        # Should have exactly 4 late shipments
+        assert len(records) == 4, f"Expected 4 late shipments, got {len(records)}: {records}"
+
+        # Verify order and content
+        expected = [
+            {
+                "shipment_id": "SH-1009",
+                "carrier": "DHL",
+                "promised_date": "2026-02-26",
+                "delivered_date": "",
+                "days_late": "5",
+            },
+            {
+                "shipment_id": "SH-1003",
+                "carrier": "FedEx",
+                "promised_date": "2026-02-28",
+                "delivered_date": "",
+                "days_late": "3",
+            },
+            {
+                "shipment_id": "SH-1007",
+                "carrier": "UPS",
+                "promised_date": "2026-03-01",
+                "delivered_date": "2026-03-03",
+                "days_late": "2",
+            },
+            {
+                "shipment_id": "SH-1001",
+                "carrier": "DHL",
+                "promised_date": "2026-03-02",
+                "delivered_date": "2026-03-03",
+                "days_late": "1",
+            },
+        ]
+
+        for i, (record, expected_record) in enumerate(zip(records, expected)):
+            for key, expected_value in expected_record.items():
+                assert record.get(key) == expected_value, (
+                    f"Record {i} ({record.get('shipment_id')}): "
+                    f"expected {key}={expected_value} but got {key}={record.get(key)}"
+                )
+
+    finally:
+        # Restore original OUTPUT_DIR
+        shipments_daily.OUTPUT_DIR = original_output_dir
