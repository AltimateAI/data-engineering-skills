+"""Test DAG structure and configuration."""
+
+from pathlib import Path
+
+from airflow.models import DAG
+
+# Import DAGs to test them
+import carrier_rates_weekly
+import shipments_daily
+
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+
+
+class TestShipmentsDailyDAG:
+    """Tests for the shipments_daily DAG."""
+
+    def test_schedule_is_weekdays_0730(self):
+        """Verify shipments_daily runs at 07:30 UTC Monday-Friday only."""
+        dag = shipments_daily.dag
+        # Cron format: minute hour day month day-of-week
+        # "30 7 * * 1-5" = 30 min past hour 7, every day, every month, Mon(1)-Fri(5)
+        assert dag.schedule_interval == "30 7 * * 1-5", (
+            f"Expected schedule_interval '30 7 * * 1-5' but got '{dag.schedule_interval}'"
+        )
+
+    def test_extract_before_report(self):
+        """Verify build_report runs only after extract_shipments completes."""
+        dag = shipments_daily.dag
+        extract_task = dag.get_task("extract_shipments")
+        report_task = dag.get_task("build_report")
+
+        # Check that extract is upstream of report
+        assert extract_task in report_task.upstream_list, (
+            "extract_shipments must run before build_report"
+        )
+
+    def test_all_tasks_have_retries(self):
+        """Verify all tasks in shipments_daily have at least 2 retries."""
+        dag = shipments_daily.dag
+        for task in dag.tasks:
+            assert task.retries >= 2, (
+                f"Task {task.task_id} has {task.retries} retries, need >= 2"
+            )
+
+
+class TestCarrierRatesWeeklyDAG:
+    """Tests for the carrier_rates_weekly DAG."""
+
+    def test_all_tasks_have_retries(self):
+        """Verify all tasks in carrier_rates_weekly have at least 2 retries."""
+        dag = carrier_rates_weekly.dag
+        for task in dag.tasks:
+            assert task.retries >= 2, (
+                f"Task {task.task_id} has {task.retries} retries, need >= 2"
+            )
