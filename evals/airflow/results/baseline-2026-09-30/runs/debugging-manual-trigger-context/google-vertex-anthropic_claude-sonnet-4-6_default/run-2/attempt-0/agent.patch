+def _resolve_day(context: dict) -> str:
+    """Return the feed date as YYYY-MM-DD.
+
+    Scheduled runs and triggered runs with an explicit logical date use
+    that date.  Manual triggers without a logical date (logical_date is
+    None) fall back to today in UTC *at the moment the task executes*.
+    The value is stored in XCom so re-runs on a later calendar day still
+    reproduce the same feed.
+    """
+    logical_date = context.get("logical_date")
+    if logical_date is not None:
+        return logical_date.strftime("%Y-%m-%d")
+    # Manual trigger with no date: use UTC now so the feed covers the day
+    # the operator pressed the button.  Downstream tasks read this from
+    # XCom, so clearing and re-running tomorrow still produces today's feed.
+    return datetime.now(timezone.utc).strftime("%Y-%m-%d")
+
+
