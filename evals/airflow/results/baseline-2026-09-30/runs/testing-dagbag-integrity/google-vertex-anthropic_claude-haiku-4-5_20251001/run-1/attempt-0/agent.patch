+"""Test the structure and ordering of specific DAGs."""
+
+from __future__ import annotations
+
+import pytest
+from airflow.models import DAG
+
+
+class TestOrdersIngestStructure:
+    """Test the orders_ingest DAG has the correct task ordering."""
+
+    @pytest.fixture
+    def orders_ingest_dag(self, dagbag) -> DAG:
+        """Get the orders_ingest DAG."""
+        dag = dagbag.dags["orders_ingest"]
+        assert dag is not None, "orders_ingest DAG not found"
+        return dag
+
+    def test_orders_ingest_task_order(self, orders_ingest_dag: DAG):
+        """Verify the task execution order: extract -> validate -> load -> publish."""
+        dag = orders_ingest_dag
+
+        # Get task by name
+        task_ids = {task.task_id: task for task in dag.tasks}
+
+        required_tasks = [
+            "extract_orders",
+            "validate_orders",
+            "load_orders",
+            "publish_summary",
+        ]
+
+        for task_id in required_tasks:
+            assert task_id in task_ids, (
+                f"orders_ingest DAG is missing required task '{task_id}'"
+            )
+
+        extract = task_ids["extract_orders"]
+        validate = task_ids["validate_orders"]
+        load = task_ids["load_orders"]
+        publish = task_ids["publish_summary"]
+
+        # Validate downstream relationships
+        assert validate in extract.downstream_list, (
+            "extract_orders must flow directly to validate_orders"
+        )
+        assert load in validate.downstream_list, (
+            "validate_orders must flow directly to load_orders"
+        )
+        assert publish in load.downstream_list, (
+            "load_orders must flow directly to publish_summary"
+        )
+
+        # Ensure the chain is unbroken
+        assert len(extract.downstream_list) == 1, (
+            "extract_orders should have exactly one downstream task"
+        )
+        assert len(validate.downstream_list) == 1, (
+            "validate_orders should have exactly one downstream task"
+        )
+        assert len(load.downstream_list) == 1, (
+            "load_orders should have exactly one downstream task"
+        )
+        assert len(publish.upstream_list) == 1, (
+            "publish_summary should have exactly one upstream task"
+        )
