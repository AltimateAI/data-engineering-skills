+"""Test that all DAGs comply with organizational policies."""
+
+from __future__ import annotations
+
+import pytest
+from airflow.models import DAG
+
+
+class TestDAGTagPolicy:
+    """Test that all DAGs have required tags."""
+
+    def test_all_dags_have_tags(self, all_dags: list[DAG]):
+        """Every DAG must have at least one tag."""
+        for dag in all_dags:
+            assert dag.tags is not None and len(dag.tags) > 0, (
+                f"DAG '{dag.dag_id}' has no tags. "
+                "Every DAG must have at least one tag for organization and discovery."
+            )
+
+    def test_all_dags_have_valid_tags(self, all_dags: list[DAG]):
+        """Every tag must be a non-empty string."""
+        for dag in all_dags:
+            for tag in dag.tags:
+                assert isinstance(tag, str) and tag, (
+                    f"DAG '{dag.dag_id}' has an invalid tag: {tag!r}. "
+                    "Tags must be non-empty strings."
+                )
+
+
+class TestDAGCatchupPolicy:
+    """Test that all DAGs have catchup disabled."""
+
+    def test_all_dags_have_catchup_false(self, all_dags: list[DAG]):
+        """Every DAG must have catchup=False."""
+        for dag in all_dags:
+            assert dag.catchup is False, (
+                f"DAG '{dag.dag_id}' has catchup=True. "
+                "All DAGs must have catchup=False to prevent unexpected backfill runs."
+            )
+
+
+class TestTaskOwnerPolicy:
+    """Test that all tasks have a real owner (not the default 'airflow')."""
+
+    def test_all_tasks_have_real_owner(self, all_dags: list[DAG]):
+        """Every task must have an owner that is not the default 'airflow'."""
+        for dag in all_dags:
+            for task in dag.tasks:
+                assert task.owner and task.owner != "airflow", (
+                    f"DAG '{dag.dag_id}', task '{task.task_id}' has owner='{task.owner}'. "
+                    "All tasks must have a real owner (not the default 'airflow'). "
+                    "Set it via default_args or task_kwargs."
+                )
+
+
+class TestTaskRetryPolicy:
+    """Test that all tasks have at least 2 retries."""
+
+    def test_all_tasks_have_min_retries(self, all_dags: list[DAG]):
+        """Every task must have at least 2 retries configured."""
+        for dag in all_dags:
+            for task in dag.tasks:
+                assert task.retries >= 2, (
+                    f"DAG '{dag.dag_id}', task '{task.task_id}' has only {task.retries} retries. "
+                    "All tasks must have at least 2 retries to handle transient failures."
+                )
