+"""Test that all DAGs can be loaded without errors."""
+
+from __future__ import annotations
+
+import pytest
+from airflow.models import DagBag
+
+
+def test_dagbag_loads_without_errors():
+    """Fail if any DAG file has import errors or parsing issues."""
+    from pathlib import Path
+
+    dags_dir = Path(__file__).parent.parent / "dags"
+    dagbag = DagBag(dag_folder=str(dags_dir))
+
+    # Check that there are no import errors
+    if dagbag.import_errors:
+        error_msg = "\n".join(
+            [f"{filename}: {error}" for filename, error in dagbag.import_errors.items()]
+        )
+        pytest.fail(f"DAG import errors detected:\n{error_msg}")
+
+    # Ensure we have at least one DAG (proves the directory was parsed)
+    assert len(dagbag.dag_ids) > 0, "No DAGs found in dags/ directory"
+
+
+def test_all_dags_parse(dagbag):
+    """Verify all DAGs can be instantiated and their tasks are accessible."""
+    for dag_id in dagbag.dag_ids:
+        dag = dagbag.dags[dag_id]
+        assert dag is not None, f"DAG {dag_id} could not be retrieved"
+        assert hasattr(dag, "tasks"), f"DAG {dag_id} has no tasks attribute"
+        # Ensure we can iterate over tasks (catches some parsing issues)
+        task_count = len(dag.tasks)
+        assert task_count > 0, f"DAG {dag_id} has no tasks"
