+"""Pytest fixtures and configuration for DAG tests."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+from airflow.models import DAG, DagBag
+
+
+# Add dags directory to Python path so imports work
+DAGS_DIR = Path(__file__).parent.parent / "dags"
+sys.path.insert(0, str(DAGS_DIR.parent))
+
+
+@pytest.fixture(scope="session")
+def dagbag() -> DagBag:
+    """Load all DAGs from the dags/ directory."""
+    return DagBag(dag_folder=str(DAGS_DIR))
+
+
+@pytest.fixture
+def all_dag_ids(dagbag: DagBag) -> list[str]:
+    """Return all DAG IDs in the DAG bag."""
+    return list(dagbag.dag_ids)
+
+
+@pytest.fixture
+def all_dags(dagbag: DagBag) -> list[DAG]:
+    """Return all DAG objects in the DAG bag."""
+    return [dagbag.dags[dag_id] for dag_id in dagbag.dag_ids]
+
+
+@pytest.fixture
+def orders_ingest_dag(dagbag: DagBag) -> DAG:
+    """Return the orders_ingest DAG."""
+    return dagbag.dags["orders_ingest"]
