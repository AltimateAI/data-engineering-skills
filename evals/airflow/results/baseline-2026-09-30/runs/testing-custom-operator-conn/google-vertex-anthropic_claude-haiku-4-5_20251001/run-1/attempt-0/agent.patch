+class TestCsvPartitionToDuckDBOperator:
+    """Tests for the CsvPartitionToDuckDBOperator."""
+
+    def test_operator_loads_single_partition(
+        self, duckdb_connection: str, sample_csv_file: Path
+    ):
+        """Operator should load only rows matching the partition_date."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=str(sample_csv_file),
+            table="test_data",
+            partition_column="partition_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id=duckdb_connection,
+        )
+        
+        # Execute the operator
+        loaded_count = operator.execute(context={})
+        
+        # Should have loaded exactly 2 rows for 2026-03-01
+        assert loaded_count == 2
+        
+        # Verify the data is in the database
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        con = hook.get_conn()
+        try:
+            result = con.execute(
+                'SELECT COUNT(*) FROM "test_schema"."test_data"'
+            ).fetchone()
+            assert result[0] == 2
+            
+            # Verify the correct rows were loaded
+            rows = con.execute(
+                'SELECT id, name FROM "test_schema"."test_data" ORDER BY id'
+            ).fetchall()
+            assert rows == [("1", "Alice"), ("2", "Bob")]
+        finally:
+            con.close()
+
+    def test_operator_returns_row_count(
+        self, duckdb_connection: str, sample_csv_file: Path
+    ):
+        """Operator.execute() should return the number of rows loaded."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=str(sample_csv_file),
+            table="test_data",
+            partition_column="partition_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id=duckdb_connection,
+        )
+        
+        loaded_count = operator.execute(context={})
+        
+        # Should return 2 (the number of rows for 2026-03-02)
+        assert loaded_count == 2
+        assert isinstance(loaded_count, int)
+
+    def test_operator_creates_schema_if_not_exists(
+        self, duckdb_connection: str, sample_csv_file: Path
+    ):
+        """Operator should create the target schema if it doesn't exist."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=str(sample_csv_file),
+            table="test_data",
+            partition_column="partition_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id=duckdb_connection,
+        )
+        
+        operator.execute(context={})
+        
+        # Verify schema exists
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        con = hook.get_conn()
+        try:
+            # Query the information schema to check if schema exists
+            result = con.execute(
+                "SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name = 'test_schema'"
+            ).fetchone()
+            assert result[0] == 1
+        finally:
+            con.close()
+
+    def test_operator_creates_table_if_not_exists(
+        self, duckdb_connection: str, sample_csv_file: Path
+    ):
+        """Operator should create the target table with correct schema."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
