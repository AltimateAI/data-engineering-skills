+"""Unit tests for DuckDBWarehouseHook and CsvPartitionToDuckDBOperator.
+
+These tests exercise the real hook and operator against a temporary DuckDB file,
+without mocking DuckDB. Airflow connections are supplied programmatically so
+CI does not need any Airflow configuration.
+"""
+
+from __future__ import annotations
+
+import csv
+import tempfile
+from pathlib import Path
+from typing import Generator
+
+import duckdb
+import pytest
+from airflow.sdk.definitions.connection import Connection
+from airflow.sdk.execution_time.context import _preset_connections
+
+from dags.warehouse.hooks import DuckDBWarehouseHook
+from dags.warehouse.operators import CsvPartitionToDuckDBOperator
+
+
+@pytest.fixture
+def temp_duckdb_file() -> Generator[Path, None, None]:
+    """Create a temporary DuckDB file that is cleaned up after the test."""
+    with tempfile.NamedTemporaryFile(suffix=".duckdb", delete=False) as f:
+        db_path = Path(f.name)
+    
+    try:
+        yield db_path
+    finally:
+        # Clean up the file
+        if db_path.exists():
+            db_path.unlink()
+
+
+@pytest.fixture
+def sample_csv_file() -> Generator[Path, None, None]:
+    """Create a sample CSV file with multi-partition data for testing."""
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".csv", delete=False, newline="") as f:
+        csv_path = Path(f.name)
+        writer = csv.writer(f)
+        writer.writerow(["id", "partition_date", "name", "value"])
+        # Multiple rows for 2026-03-01
+        writer.writerow(["1", "2026-03-01", "Alice", "100"])
+        writer.writerow(["2", "2026-03-01", "Bob", "200"])
+        # Multiple rows for 2026-03-02
+        writer.writerow(["3", "2026-03-02", "Charlie", "300"])
+        writer.writerow(["4", "2026-03-02", "Diana", "400"])
+        # Row for 2026-03-03
+        writer.writerow(["5", "2026-03-03", "Eve", "500"])
+    
+    try:
+        yield csv_path
+    finally:
+        if csv_path.exists():
+            csv_path.unlink()
+
+
+@pytest.fixture
+def duckdb_connection(temp_duckdb_file: Path, preset_connection_context: dict) -> str:
+    """Create an Airflow connection pointing to the temporary DuckDB file.
+    
+    Returns the connection ID that can be used with the hook and operator.
+    This fixture uses the preset_connection_context from conftest.py to inject
+    the connection into Airflow's connection resolution system.
+    """
+    conn_id = "test_duckdb_warehouse"
+    
+    # Create the connection object
+    conn = Connection(
+        conn_id=conn_id,
+        conn_type="duckdb",
+        host=str(temp_duckdb_file),
+        schema="test_schema",
+    )
+    
+    # Add to the preset connections dict so Connection.get() can find it
+    preset_connection_context[conn_id] = conn
+    
+    yield conn_id
+    
+    # Clean up (optional, since the context will be reset)
+    if conn_id in preset_connection_context:
+        del preset_connection_context[conn_id]
+
+
+class TestDuckDBWarehouseHook:
+    """Tests for the DuckDBWarehouseHook."""
+
+    def test_hook_reads_database_path_from_connection(
+        self, duckdb_connection: str, temp_duckdb_file: Path
+    ):
+        """Hook should read the DuckDB file path from connection's host field."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        assert hook.database_path == str(temp_duckdb_file)
+
+    def test_hook_reads_schema_from_connection(self, duckdb_connection: str):
+        """Hook should read the target schema from connection's schema field."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        assert hook.target_schema == "test_schema"
+
+    def test_hook_defaults_to_main_schema_if_not_set(
+        self, temp_duckdb_file: Path
+    ):
+        """Hook should default to 'main' schema if connection schema is not set."""
+        session = Session()
+        conn_id = "test_duckdb_no_schema"
+        
+        session.query(Connection).filter(Connection.conn_id == conn_id).delete()
+        session.commit()
+        
+        conn = Connection(
+            conn_id=conn_id,
+            conn_type="duckdb",
+            host=str(temp_duckdb_file),
+            schema=None,
+        )
+        session.add(conn)
+        session.commit()
+        
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id=conn_id)
+            assert hook.target_schema == "main"
+        finally:
+            session.query(Connection).filter(Connection.conn_id == conn_id).delete()
+            session.commit()
+            session.close()
+
+    def test_hook_raises_if_no_host(self, temp_duckdb_file: Path):
+        """Hook should raise if connection host is not set."""
+        session = Session()
+        conn_id = "test_duckdb_no_host"
+        
+        session.query(Connection).filter(Connection.conn_id == conn_id).delete()
+        session.commit()
+        
+        conn = Connection(
+            conn_id=conn_id,
+            conn_type="duckdb",
+            host=None,
+            schema="test",
+        )
+        session.add(conn)
+        session.commit()
+        
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id=conn_id)
+            with pytest.raises(ValueError, match="has no host"):
+                _ = hook.database_path
+        finally:
+            session.query(Connection).filter(Connection.conn_id == conn_id).delete()
+            session.commit()
+            session.close()
+
+    def test_hook_get_conn_returns_duckdb_connection(
+        self, duckdb_connection: str
+    ):
+        """Hook.get_conn() should return a live DuckDB connection."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        conn = hook.get_conn()
+        
+        # Verify it's a real DuckDB connection by executing a query
+        result = conn.execute("SELECT 1 AS val").fetchall()
+        assert result == [(1,)]
+        
+        conn.close()
+
+    def test_hook_get_conn_respects_read_only_flag(
+        self, temp_duckdb_file: Path
+    ):
+        """Hook should open read-only connections when extra contains read_only=true."""
+        session = Session()
+        conn_id = "test_duckdb_readonly"
+        
+        session.query(Connection).filter(Connection.conn_id == conn_id).delete()
+        session.commit()
+        
+        conn = Connection(
+            conn_id=conn_id,
+            conn_type="duckdb",
+            host=str(temp_duckdb_file),
+            schema="main",
+            extra='{"read_only": true}',
+        )
+        session.add(conn)
+        session.commit()
+        
+        try:
+            hook = DuckDBWarehouseHook(duckdb_conn_id=conn_id)
+            db_conn = hook.get_conn()
+            
+            # Try to write; should fail with read-only error
+            with pytest.raises(Exception):  # DuckDB raises an exception for writes on read-only
+                db_conn.execute("CREATE TABLE test (id INT)")
+            
+            db_conn.close()
+        finally:
+            session.query(Connection).filter(Connection.conn_id == conn_id).delete()
+            session.commit()
+            session.close()
