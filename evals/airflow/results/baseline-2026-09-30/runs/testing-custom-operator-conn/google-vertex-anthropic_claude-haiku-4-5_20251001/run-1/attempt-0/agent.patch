+"""pytest configuration and fixtures for the test suite."""
+
+import sys
+from pathlib import Path
+from typing import Generator
+
+import pytest
+from airflow.sdk.definitions.connection import Connection
+from airflow.sdk.execution_time.context import _preset_connections
+
+# Add dags directory to sys.path so that imports like 'from warehouse.hooks' work
+dags_dir = Path(__file__).resolve().parent / "dags"
+sys.path.insert(0, str(dags_dir))
+
+
+@pytest.fixture(autouse=True)
+def preset_connection_context():
+    """Set up a context where we can preset connections for testing.
+    
+    This allows tests to programmatically create and inject Airflow connections
+    without requiring an external database or backend.
+    """
+    # Initialize an empty preset connections dict for this test
+    preset = {}
+    token = _preset_connections.set(preset)
+    
+    try:
+        yield preset
+    finally:
+        # Clean up the context var
+        _preset_connections.reset(token)
