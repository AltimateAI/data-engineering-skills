+
+    def test_operator_idempotent_same_partition_replaces_rows(
+        self, duckdb_connection: str, sample_csv_file: Path
+    ):
+        """Re-running the same partition should replace rows (idempotent), no duplicates."""
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=str(sample_csv_file),
+            table="test_data",
+            partition_column="partition_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id=duckdb_connection,
+        )
+        
+        # First load
+        loaded_count_1 = operator.execute(context={})
+        assert loaded_count_1 == 2
+        
+        # Second load of the same partition
+        loaded_count_2 = operator.execute(context={})
+        assert loaded_count_2 == 2
+        
+        # Verify no duplicates: total rows should still be 2, not 4
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        con = hook.get_conn()
+        try:
+            total_count = con.execute(
+                'SELECT COUNT(*) FROM "test_schema"."test_data"'
+            ).fetchone()[0]
+            assert total_count == 2
+            
+            # Verify the same 2 rows are present
+            rows = con.execute(
+                'SELECT id, name FROM "test_schema"."test_data" ORDER BY id'
+            ).fetchall()
+            assert rows == [("1", "Alice"), ("2", "Bob")]
+        finally:
+            con.close()
+
+    def test_operator_leaves_other_partitions_alone(
+        self, duckdb_connection: str, sample_csv_file: Path
+    ):
+        """Loading one partition should not affect other partitions."""
+        # Load 2026-03-01 first
+        operator_1 = CsvPartitionToDuckDBOperator(
+            task_id="test_load_1",
+            csv_path=str(sample_csv_file),
+            table="test_data",
+            partition_column="partition_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id=duckdb_connection,
+        )
+        operator_1.execute(context={})
+        
+        # Load 2026-03-02
+        operator_2 = CsvPartitionToDuckDBOperator(
+            task_id="test_load_2",
+            csv_path=str(sample_csv_file),
+            table="test_data",
+            partition_column="partition_date",
+            partition_date="2026-03-02",
+            duckdb_conn_id=duckdb_connection,
+        )
+        operator_2.execute(context={})
+        
+        # Verify both partitions exist and are correct
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        con = hook.get_conn()
+        try:
+            # Total rows: 2 (2026-03-01) + 2 (2026-03-02) = 4
+            total_count = con.execute(
+                'SELECT COUNT(*) FROM "test_schema"."test_data"'
+            ).fetchone()[0]
+            assert total_count == 4
+            
+            # Verify 2026-03-01 has 2 rows
+            count_mar01 = con.execute(
+                'SELECT COUNT(*) FROM "test_schema"."test_data" WHERE partition_date = \'2026-03-01\''
+            ).fetchone()[0]
+            assert count_mar01 == 2
+            
+            # Verify 2026-03-02 has 2 rows
+            count_mar02 = con.execute(
+                'SELECT COUNT(*) FROM "test_schema"."test_data" WHERE partition_date = \'2026-03-02\''
+            ).fetchone()[0]
+            assert count_mar02 == 2
+        finally:
+            con.close()
+
+    def test_operator_replaces_partition_without_affecting_others(
+        self, duckdb_connection: str, sample_csv_file: Path
+    ):
+        """Re-loading one partition should not affect other loaded partitions."""
+        # Load 2026-03-01 and 2026-03-02
+        for date in ["2026-03-01", "2026-03-02"]:
+            operator = CsvPartitionToDuckDBOperator(
+                task_id=f"test_load_{date}",
+                csv_path=str(sample_csv_file),
+                table="test_data",
+                partition_column="partition_date",
+                partition_date=date,
+                duckdb_conn_id=duckdb_connection,
+            )
+            operator.execute(context={})
+        
+        # Total should be 4 rows
+        hook = DuckDBWarehouseHook(duckdb_conn_id=duckdb_connection)
+        con = hook.get_conn()
+        total_before = con.execute(
+            'SELECT COUNT(*) FROM "test_schema"."test_data"'
+        ).fetchone()[0]
+        assert total_before == 4
+        con.close()
+        
+        # Re-load 2026-03-01 (should replace, not duplicate)
+        operator = CsvPartitionToDuckDBOperator(
+            task_id="test_load_reload",
+            csv_path=str(sample_csv_file),
+            table="test_data",
+            partition_column="partition_date",
+            partition_date="2026-03-01",
+            duckdb_conn_id=duckdb_connection,
+        )
+        operator.execute(context={})
+        
+        # Verify: total should still be 4 (2 from Mar 01 + 2 from Mar 02)
+        con = hook.get_conn()
+        try:
+            total_after = con.execute(
+                'SELECT COUNT(*) FROM "test_schema"."test_data"'
+            ).fetchone()[0]
+            assert total_after == 4
+            
+            # Verify Mar 02 is still intact
+            count_mar02 = con.execute(
+                'SELECT COUNT(*) FROM "test_schema"."test_data" WHERE partition_date = \'2026-03-02\''
+            ).fetchone()[0]
+            assert count_mar02 == 2
+        finally:
+            con.close()
