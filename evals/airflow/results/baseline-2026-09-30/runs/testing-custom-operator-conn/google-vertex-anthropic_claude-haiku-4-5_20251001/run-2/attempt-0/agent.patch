+"""Unit tests for CsvPartitionToDuckDBOperator."""
+
+from __future__ import annotations
+
+import csv
+import tempfile
+from pathlib import Path
+
+import duckdb
+import pytest
+from airflow.models import Connection
+from airflow.sdk import BaseHook
+
+from dags.warehouse.hooks import DuckDBWarehouseHook
+from dags.warehouse.operators import CsvPartitionToDuckDBOperator
+
+
+@pytest.fixture
+def temp_csv_file():
+    """Create a temporary CSV file with test data."""
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".csv", delete=False) as f:
+        writer = csv.DictWriter(f, fieldnames=["id", "date", "value"])
+        writer.writeheader()
+        # Write multiple partitions: 2026-03-01 and 2026-03-02
+        writer.writerow({"id": "1", "date": "2026-03-01", "value": "100"})
+        writer.writerow({"id": "2", "date": "2026-03-01", "value": "200"})
+        writer.writerow({"id": "3", "date": "2026-03-02", "value": "300"})
+        writer.writerow({"id": "4", "date": "2026-03-02", "value": "400"})
+        writer.writerow({"id": "5", "date": "2026-03-03", "value": "500"})
+        temp_path = f.name
+    yield temp_path
+    # Cleanup
+    Path(temp_path).unlink(missing_ok=True)
+
+
+class TestCsvPartitionToDuckDBOperator:
+    """Test suite for CsvPartitionToDuckDBOperator."""
+
+    def test_operator_initialization(self, temp_csv_file):
+        """Test operator initializes with required parameters."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+        )
+        assert op.task_id == "test_load"
+        assert op.csv_path == temp_csv_file
+        assert op.table == "test_table"
+        assert op.partition_column == "date"
+        assert op.partition_date == "2026-03-01"
+        assert op.duckdb_conn_id == DuckDBWarehouseHook.default_conn_name
+
+    def test_operator_initialization_with_custom_conn_id(self, temp_csv_file):
+        """Test operator initializes with custom connection ID."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="custom_warehouse",
+        )
+        assert op.duckdb_conn_id == "custom_warehouse"
+
+    def test_operator_template_fields(self, temp_csv_file):
+        """Test that csv_path and partition_date are template fields."""
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path="/path/{{ ds }}/data.csv",
+            table="test_table",
+            partition_column="date",
+            partition_date="{{ ds }}",
+        )
+        # Template fields should be marked for Airflow templating
+        assert "csv_path" in op.template_fields
+        assert "partition_date" in op.template_fields
+
+    def test_execute_creates_schema(self, mock_duckdb_connection, temp_csv_file):
+        """Test that execute() creates the target schema if it doesn't exist."""
+        _, temp_path = mock_duckdb_connection
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op.execute(context={})
+
+        # Verify schema was created
+        conn = duckdb.connect(temp_path)
+        schemas = conn.execute("SELECT schema_name FROM information_schema.schemata WHERE schema_name = 'raw'").fetchall()
+        assert len(schemas) > 0
+        conn.close()
+
+    def test_execute_creates_table_if_not_exists(self, mock_duckdb_connection, temp_csv_file):
+        """Test that execute() creates the table if it doesn't exist."""
+        _, temp_path = mock_duckdb_connection
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op.execute(context={})
+
+        # Verify table was created
+        conn = duckdb.connect(temp_path)
+        tables = conn.execute(
+            "SELECT table_name FROM information_schema.tables WHERE table_schema = 'raw' AND table_name = 'test_table'"
+        ).fetchall()
+        assert len(tables) > 0
+        conn.close()
+
+    def test_execute_loads_only_matching_partition(self, mock_duckdb_connection, temp_csv_file):
+        """Test that execute() loads only rows matching the partition_date."""
+        _, temp_path = mock_duckdb_connection
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        rows_loaded = op.execute(context={})
+
+        # Should load only 2 rows for 2026-03-01
+        assert rows_loaded == 2
+
+        # Verify data in table
+        conn = duckdb.connect(temp_path)
+        all_rows = conn.execute('SELECT * FROM "raw"."test_table"').fetchall()
+        # Should have exactly 2 rows
+        assert len(all_rows) == 2
+        # Both should have date = 2026-03-01
+        dates = conn.execute('SELECT DISTINCT date FROM "raw"."test_table" WHERE date = \'2026-03-01\'').fetchall()
+        assert len(dates) == 1
+        conn.close()
+
+    def test_execute_returns_row_count(self, mock_duckdb_connection, temp_csv_file):
+        """Test that execute() returns the number of rows loaded."""
+        _, _ = mock_duckdb_connection
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+        rows_loaded = op.execute(context={})
+        # 2026-03-02 has 2 rows
+        assert rows_loaded == 2
+        assert isinstance(rows_loaded, int)
+
+    def test_execute_idempotent_same_partition_replaces(
+        self, mock_duckdb_connection, temp_csv_file
+    ):
+        """Test that re-running the same partition replaces (not duplicates) rows."""
+        _, temp_path = mock_duckdb_connection
+        op = CsvPartitionToDuckDBOperator(
+            task_id="test_load",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        # First run
+        rows_first = op.execute(context={})
+        assert rows_first == 2
+
+        # Verify data after first run
+        conn = duckdb.connect(temp_path)
+        count_after_first = conn.execute(
+            'SELECT COUNT(*) FROM "raw"."test_table" WHERE date = \'2026-03-01\''
+        ).fetchone()[0]
+        assert count_after_first == 2
+        conn.close()
+
+        # Second run (same partition)
+        rows_second = op.execute(context={})
+        assert rows_second == 2
+
+        # Verify no duplicates: should still have 2 rows, not 4
+        conn = duckdb.connect(temp_path)
+        count_after_second = conn.execute(
+            'SELECT COUNT(*) FROM "raw"."test_table" WHERE date = \'2026-03-01\''
+        ).fetchone()[0]
+        assert count_after_second == 2
+        conn.close()
+
+    def test_execute_leaves_other_partitions_untouched(
+        self, mock_duckdb_connection, temp_csv_file
+    ):
+        """Test that loading one partition doesn't affect other partitions."""
+        _, temp_path = mock_duckdb_connection
+        op_date1 = CsvPartitionToDuckDBOperator(
+            task_id="test_load_1",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op_date2 = CsvPartitionToDuckDBOperator(
+            task_id="test_load_2",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        # Load both partitions
+        rows_date1 = op_date1.execute(context={})
+        rows_date2 = op_date2.execute(context={})
+
+        assert rows_date1 == 2  # 2 rows for 2026-03-01
+        assert rows_date2 == 2  # 2 rows for 2026-03-02
+
+        # Verify both partitions exist
+        conn = duckdb.connect(temp_path)
+        date1_count = conn.execute(
+            'SELECT COUNT(*) FROM "raw"."test_table" WHERE date = \'2026-03-01\''
+        ).fetchone()[0]
+        date2_count = conn.execute(
+            'SELECT COUNT(*) FROM "raw"."test_table" WHERE date = \'2026-03-02\''
+        ).fetchone()[0]
+        total_count = conn.execute('SELECT COUNT(*) FROM "raw"."test_table"').fetchone()[0]
+        conn.close()
+
+        assert date1_count == 2
+        assert date2_count == 2
+        assert total_count == 4
+
+    def test_execute_overwrites_partition_on_rerun(
+        self, mock_duckdb_connection, temp_csv_file
+    ):
+        """Test that re-running overwrites the partition and leaves others alone."""
+        _, temp_path = mock_duckdb_connection
+
+        # Load 2026-03-01 and 2026-03-02
+        op_date1 = CsvPartitionToDuckDBOperator(
+            task_id="test_load_1",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-01",
+            duckdb_conn_id="test_warehouse",
+        )
+        op_date2 = CsvPartitionToDuckDBOperator(
+            task_id="test_load_2",
+            csv_path=temp_csv_file,
+            table="test_table",
+            partition_column="date",
+            partition_date="2026-03-02",
+            duckdb_conn_id="test_warehouse",
+        )
+
+        op_date1.execute(context={})
+        op_date2.execute(context={})
+
+        # Verify initial state: 4 rows total
+        conn = duckdb.connect(temp_path)
+        total_before = conn.execute('SELECT COUNT(*) FROM "raw"."test_table"').fetchone()[0]
+        assert total_before == 4
+        conn.close()
+
+        # Re-run 2026-03-01
+        op_date1.execute(context={})
+
+        # Verify 2026-03-02 is untouched but 2026-03-01 is reloaded
+        conn = duckdb.connect(temp_path)
+        total_after = conn.execute('SELECT COUNT(*) FROM "raw"."test_table"').fetchone()[0]
+        date1_count = conn.execute(
+            'SELECT COUNT(*) FROM "raw"."test_table" WHERE date = \'2026-03-01\''
+        ).fetchone()[0]
+        date2_count = conn.execute(
+            'SELECT COUNT(*) FROM "raw"."test_table" WHERE date = \'2026-03-02\''
+        ).fetchone()[0]
+        conn.close()
+
+        # Should still be 4 rows (no duplicates), 2026-03-02 untouched
+        assert total_after == 4
+        assert date1_count == 2
+        assert date2_count == 2
+
+    def test_execute_handles_empty_partition(self, mock_duckdb_connection, temp_csv_file):
+        """Test execute() when partition_date has no matching rows."""
+        _, temp_path = mock_duckdb_connection
+        op = CsvPartitionToDuckDBOperator(
