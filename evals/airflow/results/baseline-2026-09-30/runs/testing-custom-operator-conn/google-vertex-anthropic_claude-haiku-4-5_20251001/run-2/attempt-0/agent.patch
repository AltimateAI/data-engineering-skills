+"""Pytest configuration and fixtures for warehouse tests."""
+
+from __future__ import annotations
+
+import sys
+import tempfile
+from pathlib import Path
+from unittest.mock import Mock
+
+import duckdb
+import pytest
+from airflow.models import Connection
+from airflow.sdk import BaseHook
+
+# Add dags directory to Python path so imports work like they do in Airflow
+dags_dir = Path(__file__).resolve().parent.parent / "dags"
+if str(dags_dir) not in sys.path:
+    sys.path.insert(0, str(dags_dir))
+
+
+@pytest.fixture
+def temp_duckdb_file():
+    """Create a temporary DuckDB file for testing."""
+    with tempfile.NamedTemporaryFile(suffix=".duckdb", delete=True) as f:
+        temp_path = f.name
+    
+    # The file is deleted by NamedTemporaryFile context manager, but we have the path.
+    # Let duckdb.connect() create it fresh as a proper database file.
+    conn = duckdb.connect(temp_path)
+    conn.close()
+    
+    yield temp_path
+    
+    # Cleanup
+    Path(temp_path).unlink(missing_ok=True)
+
+
+@pytest.fixture
+def mock_duckdb_connection(monkeypatch, temp_duckdb_file):
+    """Mock Airflow's connection system to return test DuckDB connections."""
+    connection_hook = Connection(
+        conn_id="test_duckdb_conn",
+        conn_type="duckdb",
+        host=temp_duckdb_file,
+        schema="test_schema",
+    )
+    
+    connection_operator = Connection(
+        conn_id="test_warehouse",
+        conn_type="duckdb",
+        host=temp_duckdb_file,
+        schema="raw",
+    )
+
+    def mock_get_connection(self, conn_id):
+        """Mock that accepts self and conn_id parameters."""
+        if conn_id == "test_duckdb_conn":
+            return connection_hook
+        elif conn_id == "test_warehouse":
+            return connection_operator
+        raise Exception(f"Connection {conn_id} not found")
+
+    monkeypatch.setattr(BaseHook, "get_connection", mock_get_connection)
+    # Return the hook connection (for backward compatibility with hook tests)
+    return connection_hook, temp_duckdb_file
+
+
+@pytest.fixture
+def warehouse_connection_mock(monkeypatch, temp_duckdb_file):
+    """Mock for test_warehouse operator tests."""
+    connection = Connection(
+        conn_id="test_warehouse",
+        conn_type="duckdb",
+        host=temp_duckdb_file,
+        schema="raw",
+    )
+
+    def mock_get_connection(self, conn_id):
+        """Mock that accepts self and conn_id parameters."""
+        if conn_id == "test_warehouse":
+            return connection
+        raise Exception(f"Connection {conn_id} not found")
+
+    monkeypatch.setattr(BaseHook, "get_connection", mock_get_connection)
+    return connection, temp_duckdb_file
+
+
+# Alias for backward compatibility with existing tests
+@pytest.fixture
+def mock_duckdb_connection_with_warehouse(warehouse_connection_mock):
+    """Alias for warehouse_connection_mock."""
+    return warehouse_connection_mock
