+"""Unit tests for DuckDBWarehouseHook."""
+
+from __future__ import annotations
+
+import duckdb
+import pytest
+from airflow.models import Connection
+from airflow.sdk import BaseHook
+
+from dags.warehouse.hooks import DuckDBWarehouseHook
+
+
+class TestDuckDBWarehouseHook:
+    """Test suite for DuckDBWarehouseHook."""
+
+    def test_hook_initialization_with_default_conn_id(self, mock_duckdb_connection):
+        """Test hook initializes with default connection ID."""
+        hook = DuckDBWarehouseHook()
+        assert hook.duckdb_conn_id == DuckDBWarehouseHook.default_conn_name
+
+    def test_hook_initialization_with_custom_conn_id(self, mock_duckdb_connection):
+        """Test hook initializes with custom connection ID."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_duckdb_conn")
+        assert hook.duckdb_conn_id == "test_duckdb_conn"
+
+    def test_database_path_from_connection_host(self, mock_duckdb_connection):
+        """Test that database_path property reads from connection host."""
+        _, temp_path = mock_duckdb_connection
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_duckdb_conn")
+        assert hook.database_path == temp_path
+
+    def test_database_path_raises_without_host(self, monkeypatch):
+        """Test that database_path raises ValueError if connection has no host."""
+        connection = Connection(
+            conn_id="no_host_conn",
+            conn_type="duckdb",
+            host=None,  # No host
+        )
+
+        def mock_get_connection(self_arg, conn_id):
+            return connection
+
+        monkeypatch.setattr(BaseHook, "get_connection", mock_get_connection)
+        hook = DuckDBWarehouseHook(duckdb_conn_id="no_host_conn")
+
+        with pytest.raises(ValueError, match="has no host"):
+            _ = hook.database_path
+
+    def test_target_schema_from_connection(self, mock_duckdb_connection):
+        """Test that target_schema property reads from connection schema."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_duckdb_conn")
+        assert hook.target_schema == "test_schema"
+
+    def test_target_schema_defaults_to_main(self, monkeypatch, temp_duckdb_file):
+        """Test that target_schema defaults to 'main' if connection has no schema."""
+        connection = Connection(
+            conn_id="no_schema_conn",
+            conn_type="duckdb",
+            host=temp_duckdb_file,
+            schema=None,  # No schema
+        )
+
+        def mock_get_connection(self_arg, conn_id):
+            return connection
+
+        monkeypatch.setattr(BaseHook, "get_connection", mock_get_connection)
+        hook = DuckDBWarehouseHook(duckdb_conn_id="no_schema_conn")
+        assert hook.target_schema == "main"
+
+    def test_get_conn_returns_duckdb_connection(self, mock_duckdb_connection):
+        """Test that get_conn() returns a real DuckDB connection."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_duckdb_conn")
+        conn = hook.get_conn()
+        assert conn is not None
+        # Verify it's a real DuckDB connection by executing a simple query
+        result = conn.execute("SELECT 1 as value").fetchall()
+        assert result == [(1,)]
+        conn.close()
+
+    def test_get_conn_opens_read_write_by_default(self, mock_duckdb_connection):
+        """Test that get_conn() opens database in read-write mode by default."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_duckdb_conn")
+        conn = hook.get_conn()
+        # Try to create a table (write operation)
+        conn.execute("CREATE TABLE test_rw (id INTEGER)")
+        result = conn.execute("SELECT * FROM test_rw").fetchall()
+        assert result == []
+        conn.close()
+
+    def test_get_conn_opens_read_only_when_specified(
+        self, monkeypatch, temp_duckdb_file
+    ):
+        """Test that get_conn() respects read_only in connection extra."""
+        # First, create and write some data to the file
+        setup_conn = duckdb.connect(temp_duckdb_file)
+        setup_conn.execute("CREATE TABLE test_table (id INTEGER)")
+        setup_conn.close()
+
+        # Now test with read_only=true
+        connection = Connection(
+            conn_id="readonly_conn",
+            conn_type="duckdb",
+            host=temp_duckdb_file,
+            schema="main",
+            extra='{"read_only": true}',
+        )
+
+        def mock_get_connection(self_arg, conn_id):
+            return connection
+
+        monkeypatch.setattr(BaseHook, "get_connection", mock_get_connection)
+        hook = DuckDBWarehouseHook(duckdb_conn_id="readonly_conn")
+        conn = hook.get_conn()
+        # Reading should work
+        result = conn.execute("SELECT * FROM test_table").fetchall()
+        assert result == []
+        # Writing should fail
+        with pytest.raises(Exception):
+            conn.execute("CREATE TABLE test_write (id INTEGER)")
+        conn.close()
+
+    def test_connection_property_caches_connection(self, mock_duckdb_connection):
+        """Test that connection property is cached (lazy loading)."""
+        hook = DuckDBWarehouseHook(duckdb_conn_id="test_duckdb_conn")
+        conn1 = hook.connection
+        conn2 = hook.connection
+        assert conn1 is conn2
