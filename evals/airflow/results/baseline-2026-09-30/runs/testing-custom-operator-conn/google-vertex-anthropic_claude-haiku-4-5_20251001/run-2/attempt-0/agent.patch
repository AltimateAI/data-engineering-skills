+
+    def test_execute_with_default_schema_main(
+        self, monkeypatch, temp_duckdb_file, temp_csv_file
+    ):
+        """Test execute() uses 'main' schema when connection has no schema."""
+        connection = Connection(
+            conn_id="no_schema_conn",
