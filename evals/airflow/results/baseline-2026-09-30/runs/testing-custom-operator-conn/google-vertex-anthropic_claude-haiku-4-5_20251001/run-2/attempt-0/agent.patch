+
+    def test_execute_multiple_tables_independent(
+        self, mock_duckdb_connection, temp_csv_file
+    ):
+        """Test that loading different tables is independent."""
+        _, temp_path = mock_duckdb_connection
+        op1 = CsvPartitionToDuckDBOperator(
+            task_id="load_table1",
+            csv_path=temp_csv_file,
