+# ---------------------------------------------------------------------------
+# 3. validate_totals
+# ---------------------------------------------------------------------------
+
+class TestValidateTotals:
+    """Finance requirement: validate_totals must refuse bad rows and pass good ones."""
+
+    def test_valid_rows_pass_through(self):
+        rows = [_make_enriched("S-1", "10.00")]
+        assert _validate(rows) == rows
+
+    def test_zero_amount_usd_is_valid(self):
+        """Zero USD is not negative — must not be rejected."""
+        rows = [_make_enriched("S-1", "0.00")]
+        result = _validate(rows)
+        assert len(result) == 1
+
+    def test_empty_customer_id_rejected(self):
+        rows = [_make_enriched("S-BAD", "10.00", customer_id="")]
+        with pytest.raises(ValueError, match="S-BAD"):
+            _validate(rows)
+
+    def test_negative_amount_usd_rejected(self):
+        rows = [_make_enriched("S-NEG", "-0.01")]
+        with pytest.raises(ValueError, match="S-NEG"):
+            _validate(rows)
+
+    def test_multiple_bad_rows_all_named_in_error(self):
+        """The error must list every offending order so finance can triage."""
+        rows = [
+            _make_enriched("OK-1", "5.00"),
+            _make_enriched("BAD-1", "-1.00"),
+            _make_enriched("BAD-2", "3.00", customer_id=""),
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            _validate(rows)
+        msg = str(exc_info.value)
+        assert "BAD-1" in msg
+        assert "BAD-2" in msg
+
+    def test_valid_rows_not_named_in_error(self):
+        rows = [
+            _make_enriched("OK-1", "5.00"),
+            _make_enriched("BAD-1", "-0.01"),
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            _validate(rows)
+        assert "OK-1" not in str(exc_info.value)
+
+    def test_empty_input_passes(self):
+        """No orders → nothing to validate; no exception."""
+        assert _validate([]) == []
+
+
+# ---------------------------------------------------------------------------
+# 4. Output gate: nothing written unless validate_totals passes
+# ---------------------------------------------------------------------------
+
+class TestOutputGate:
+    """Finance requirement: nothing gets written to output/ unless
+    validate_totals has passed.
+
+    Because load_enriched is called as load_enriched(validate_totals(enriched))
+    in the DAG, a ValueError from validate_totals propagates upward and
+    load_enriched is never invoked — verified here without touching the filesystem.
+    """
+
+    def test_bad_data_never_reaches_load_enriched(self, tmp_path, monkeypatch):
+        """When validate_totals raises, load_enriched must not be called."""
+        monkeypatch.setattr(_mod, "OUTPUT_DIR", tmp_path / "out")
+        bad_rows = [_make_enriched("S-BAD", "10.00", customer_id="")]
+
+        with pytest.raises(ValueError):
+            validated = _validate(bad_rows)          # raises here
+            _load_enriched(validated, "2026-03-02")  # must NOT be reached
+
+        # Confirm no file was written
+        assert not any(tmp_path.rglob("*.csv"))
+
+    def test_good_data_is_written_to_output(self, tmp_path, monkeypatch):
+        """Successful validation must allow the file to be written."""
+        monkeypatch.setattr(_mod, "OUTPUT_DIR", tmp_path / "out")
+        good_rows = [
+            {**_make_enriched("S-1", "10.00"), "updated_at": "T", "order_date": "2026-03-02"},
+        ]
+        validated = _validate(good_rows)
+        path = _load_enriched(validated, "2026-03-02")
+
+        assert Path(path).exists()
+        with open(path, newline="") as fh:
+            rows = list(csv.DictReader(fh))
+        assert len(rows) == 1
+        assert rows[0]["order_id"] == "S-1"
+
+    def test_output_contains_only_declared_columns(self, tmp_path, monkeypatch):
+        """load_enriched must write exactly OUTPUT_COLUMNS and strip internal fields."""
+        monkeypatch.setattr(_mod, "OUTPUT_DIR", tmp_path / "out")
+        row = {**_make_enriched("S-1", "10.00"), "updated_at": "T", "order_date": "2026-03-02"}
+        validated = _validate([row])
+        path = _load_enriched(validated, "2026-03-02")
+
+        with open(path, newline="") as fh:
+            reader = csv.DictReader(fh)
+            header = reader.fieldnames
+        assert header == _mod.OUTPUT_COLUMNS
+
+
+# ---------------------------------------------------------------------------
+# 5. DAG configuration
+# ---------------------------------------------------------------------------
+
+class TestDagConfig:
+    """Finance requirement: DAG runs once a day at 06:00 UTC."""
+
+    def _dag_kwargs(self) -> dict:
+        """Extract DAG kwargs from the decorated function's closure."""
+        fn = _mod.orders_enrichment
+        # The @dag wrapper stores kwargs in its closure; the dict is the only
+        # cell whose value is a dict.
+        for cell in fn.__closure__ or []:
+            try:
+                val = cell.cell_contents
+                if isinstance(val, dict) and "schedule" in val:
+                    return val
+            except ValueError:
+                pass
+        raise RuntimeError("Could not find DAG kwargs in closure — did Airflow change its internals?")
+
+    def test_schedule_is_daily_at_0600_utc(self):
+        """Cron '0 6 * * *' means 06:00 UTC every day."""
+        assert self._dag_kwargs()["schedule"] == "0 6 * * *"
+
+    def test_catchup_is_disabled(self):
+        """catchup=False prevents historical backfills from running automatically."""
+        assert self._dag_kwargs()["catchup"] is False
+
+    def test_max_active_runs_is_one(self):
+        """max_active_runs=1 prevents concurrent runs from creating double-exports."""
+        assert self._dag_kwargs()["max_active_runs"] == 1
+
+
+# ---------------------------------------------------------------------------
+# 6. End-to-end on sample data (data/orders.csv + data/fx_rates.csv)
+# ---------------------------------------------------------------------------
+
+class TestEndToEnd:
+    """One full pipeline run on the sample files for 2026-03-02.
+
+    2026-03-02 raw orders (6 rows, 2 dupes):
+        S-102: two exports → updated_at 08:05 and 11:47 → keep 11:47 (EUR 120.00)
+        S-103: two exports → updated_at 08:30 and 07:55 → keep 08:30 (GBP 40.50)
+        S-104: single row  (USD 9.99)
+        S-105: single row  (EUR 0.35)
+
+    FX rates on 2026-03-02:
+        EUR → 1.0850   GBP → 1.2700   USD → 1
+
+    Expected amount_usd (ROUND_HALF_UP to cents):
+        S-102: 120.00 × 1.0850 = 130.20
+        S-103: 40.50  × 1.2700 = 51.44  (51.435 → rounds up)
+        S-104: 9.99   × 1      = 9.99
+        S-105: 0.35   × 1.0850 = 0.38   (0.37975 → rounds up)
+    """
+
+    DS = "2026-03-02"
+
+    @pytest.fixture()
+    def pipeline_result(self):
+        """Run all transforms in order, return the validated rows."""
+        raw = _extract(self.DS)
+        rates = _load_fx(self.DS)
+        deduped = _dedupe(raw)
+        enriched = _convert(deduped, rates)
+        return _validate(enriched)
+
+    def test_dedup_reduces_to_four_orders(self, pipeline_result):
+        assert len(pipeline_result) == 4
+
+    def test_order_ids_present(self, pipeline_result):
+        ids = {r["order_id"] for r in pipeline_result}
+        assert ids == {"S-102", "S-103", "S-104", "S-105"}
+
+    def test_s102_uses_later_export(self, pipeline_result):
+        """S-102 had two exports; the later one (EUR 120.00 @ 11:47) must win."""
+        row = next(r for r in pipeline_result if r["order_id"] == "S-102")
+        assert row["amount"] == "120.00"
+        assert row["updated_at"] == "2026-03-02T11:47:00"
+
+    def test_s103_uses_later_export(self, pipeline_result):
+        """S-103 had two exports; 08:30 is later than 07:55."""
+        row = next(r for r in pipeline_result if r["order_id"] == "S-103")
+        assert row["amount"] == "40.50"
+        assert row["updated_at"] == "2026-03-02T08:30:00"
+
+    def test_s102_amount_usd(self, pipeline_result):
+        row = next(r for r in pipeline_result if r["order_id"] == "S-102")
+        assert row["amount_usd"] == "130.20"
+
+    def test_s103_amount_usd_rounds_half_up(self, pipeline_result):
+        """40.50 × 1.2700 = 51.435 → ROUND_HALF_UP → 51.44."""
+        row = next(r for r in pipeline_result if r["order_id"] == "S-103")
+        assert row["amount_usd"] == "51.44"
+
+    def test_s104_usd_identity(self, pipeline_result):
+        row = next(r for r in pipeline_result if r["order_id"] == "S-104")
+        assert row["amount_usd"] == "9.99"
+
+    def test_s105_amount_usd(self, pipeline_result):
+        """0.35 × 1.0850 = 0.37975 → ROUND_HALF_UP → 0.38."""
+        row = next(r for r in pipeline_result if r["order_id"] == "S-105")
+        assert row["amount_usd"] == "0.38"
+
+    def test_end_to_end_written_to_file(self, pipeline_result, tmp_path, monkeypatch):
+        """validate_totals passed → load_enriched must write a file."""
+        monkeypatch.setattr(_mod, "OUTPUT_DIR", tmp_path / "out")
+        out = _load_enriched(pipeline_result, self.DS)
+        assert Path(out).exists()
+
+        with open(out, newline="") as fh:
+            written = {r["order_id"]: r for r in csv.DictReader(fh)}
+
+        assert set(written) == {"S-102", "S-103", "S-104", "S-105"}
+        assert written["S-102"]["amount_usd"] == "130.20"
+        assert written["S-103"]["amount_usd"] == "51.44"
+        assert written["S-104"]["amount_usd"] == "9.99"
+        assert written["S-105"]["amount_usd"] == "0.38"
+
+    def test_no_missing_fx_rate_on_sample_data(self):
+        """All currencies in the sample data must have a rate on 2026-03-02;
+        this double-checks the sample files are consistent."""
+        raw = _extract(self.DS)
+        rates = _load_fx(self.DS)
+        currencies = {r["currency"] for r in raw}
+        missing = currencies - set(rates)
+        assert not missing, f"currencies without FX rate: {missing}"
