+# ===========================================================================
+# DAG structure / schedule
+# ===========================================================================
+
+class TestDagStructure:
+    """Sanity-check the DAG metadata so CI catches accidental schedule changes.
+
+    In Airflow 3's TaskFlow / SDK, the @dag decorator wraps the factory
+    function.  Calling that function (with no arguments) instantiates and
+    returns the DAG object with all its metadata populated.
+    """
+
+    @staticmethod
+    def _dag():
+        return dag_module.orders_enrichment()
+
+    def test_dag_schedule_is_0600_utc(self):
+        assert self._dag().schedule == "0 6 * * *"
+
+    def test_dag_has_expected_tags(self):
+        tags = self._dag().tags
+        assert "orders" in tags
+        assert "finance" in tags
+
+    def test_dag_catchup_is_disabled(self):
+        assert self._dag().catchup is False
+
+    def test_dag_max_active_runs_is_one(self):
+        assert self._dag().max_active_runs == 1
+
+
+# ===========================================================================
+# End-to-end  –  real sample data in data/
+# ===========================================================================
+
+class TestEndToEnd:
+    """Uses the actual CSV files in data/ to verify the full pipeline for the
+    date 2026-03-02 (the date that has duplicate order rows in the sample set)."""
+
+    DS = "2026-03-02"
+
+    def _run_pipeline(self, tmp_path):
+        monkeypatch = None  # we patch OUTPUT_DIR via the module attribute directly
+        original_output_dir = dag_module.OUTPUT_DIR
+        dag_module.OUTPUT_DIR = tmp_path
+        try:
+            raw = extract_orders_fn(ds=self.DS)
+            rates = load_fx_rates_fn(ds=self.DS)
+            deduped = dedupe_orders_fn(raw)
+            enriched = convert_to_usd_fn(deduped, rates)
+            validated = validate_totals_fn(enriched)
+            path = load_enriched_fn(validated, ds=self.DS)
+            return path, validated
+        finally:
+            dag_module.OUTPUT_DIR = original_output_dir
+
+    def test_output_file_is_written(self, tmp_path):
+        path, _ = self._run_pipeline(tmp_path)
+        assert Path(path).exists()
+
+    def test_correct_number_of_orders(self, tmp_path):
+        """2026-03-02 has 4 unique orders (S-102, S-103, S-104, S-105); dupes removed."""
+        _, rows = self._run_pipeline(tmp_path)
+        assert len(rows) == 4
+
+    def test_dedupe_kept_latest_s102(self, tmp_path):
+        """S-102 appears at 08:05 (amount=100) and 11:47 (amount=120); 11:47 must win."""
+        _, rows = self._run_pipeline(tmp_path)
+        by_id = {r["order_id"]: r for r in rows}
+        assert by_id["S-102"]["amount"] == "120.00"
+
+    def test_dedupe_kept_latest_s103(self, tmp_path):
+        """S-103 appears at 08:30 (amount=40.50) and 07:55 (amount=38.00); 08:30 must win."""
+        _, rows = self._run_pipeline(tmp_path)
+        by_id = {r["order_id"]: r for r in rows}
+        assert by_id["S-103"]["amount"] == "40.50"
+
+    def test_amount_usd_s102(self, tmp_path):
+        """S-102: 120.00 EUR × 1.0850 = 130.20"""
+        _, rows = self._run_pipeline(tmp_path)
+        by_id = {r["order_id"]: r for r in rows}
+        assert by_id["S-102"]["amount_usd"] == "130.20"
+
+    def test_amount_usd_s103_rounds_half_up(self, tmp_path):
+        """S-103: 40.50 GBP × 1.2700 = 51.435 → rounds HALF_UP to 51.44."""
+        _, rows = self._run_pipeline(tmp_path)
+        by_id = {r["order_id"]: r for r in rows}
+        assert by_id["S-103"]["amount_usd"] == "51.44"
+
+    def test_amount_usd_s104_usd(self, tmp_path):
+        """S-104: 9.99 USD × 1 = 9.99."""
+        _, rows = self._run_pipeline(tmp_path)
+        by_id = {r["order_id"]: r for r in rows}
+        assert by_id["S-104"]["amount_usd"] == "9.99"
+
+    def test_amount_usd_s105_small(self, tmp_path):
+        """S-105: 0.35 EUR × 1.0850 = 0.37975 → 0.38."""
+        _, rows = self._run_pipeline(tmp_path)
+        by_id = {r["order_id"]: r for r in rows}
+        assert by_id["S-105"]["amount_usd"] == "0.38"
+
+    def test_output_csv_columns_match_spec(self, tmp_path):
+        path, _ = self._run_pipeline(tmp_path)
+        with open(path) as fh:
+            reader = csv.DictReader(fh)
+            assert reader.fieldnames == OUTPUT_COLUMNS
+
+    def test_output_is_sorted_by_order_id(self, tmp_path):
+        path, _ = self._run_pipeline(tmp_path)
+        with open(path) as fh:
+            order_ids = [r["order_id"] for r in csv.DictReader(fh)]
+        assert order_ids == sorted(order_ids)
+
+    def test_no_output_written_when_validate_totals_would_fail(self, tmp_path):
+        """Simulate a bad batch: validate_totals raises, load_enriched is never reached."""
+        bad_rows = [
+            {**make_row(order_id="BAD-1", customer_id=""), "amount_usd": "10.00"},
+        ]
+        with pytest.raises(ValueError):
+            validate_totals_fn(bad_rows)
+        # load_enriched was never called → output directory is still empty
+        assert list(tmp_path.iterdir()) == []
