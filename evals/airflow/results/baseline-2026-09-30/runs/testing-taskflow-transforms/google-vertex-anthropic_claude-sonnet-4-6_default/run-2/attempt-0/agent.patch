+"""
+Pytest suite for the orders_enrichment DAG (Airflow 3.3 / TaskFlow API).
+
+Strategy
+--------
+The DAG's five @task-decorated functions are pure Python – no Airflow runtime
+needed.  Each one is extracted via its `.function` attribute and tested in
+isolation so failures point at the exact transform that broke.
+
+A single end-to-end test uses the real sample files in data/ and verifies that
+the full pipeline (extract → dedupe → FX → validate → write) produces the
+expected output CSV for 2026-03-02.
+
+Running
+-------
+    pytest tests/          # from the project root, no scheduler / webserver needed
+"""
+
+from __future__ import annotations
+
+import csv
+import importlib
+import sys
+from decimal import Decimal
+from pathlib import Path
+import tempfile
+
+import pytest
+
+# ---------------------------------------------------------------------------
+# Import the DAG module without triggering any Airflow scheduler machinery.
+# Airflow 3 registers DAGs at import-time via the @dag decorator; that's fine
+# for a plain pytest run – it just creates the DAG object in memory.
+# ---------------------------------------------------------------------------
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(PROJECT_ROOT / "dags"))
+
+dag_module = importlib.import_module("orders_enrichment")
+
+# Unwrap each TaskFlow task to get the plain Python callable.
+extract_orders_fn = dag_module.extract_orders.function
+load_fx_rates_fn = dag_module.load_fx_rates.function
+dedupe_orders_fn = dag_module.dedupe_orders.function
+convert_to_usd_fn = dag_module.convert_to_usd.function
+validate_totals_fn = dag_module.validate_totals.function
+load_enriched_fn = dag_module.load_enriched.function
+
+# Re-export the module-level path constants so tests can patch or reference them.
+DATA_DIR = dag_module.DATA_DIR
+OUTPUT_COLUMNS = dag_module.OUTPUT_COLUMNS
+
+
+# ===========================================================================
+# Helpers
+# ===========================================================================
+
+def make_row(**kwargs) -> dict:
+    """Minimal order row with sensible defaults; override with kwargs."""
+    base = {
+        "order_id": "X-001",
+        "order_date": "2026-03-02",
+        "updated_at": "2026-03-02T08:00:00",
+        "customer_id": "C-1",
+        "currency": "USD",
+        "amount": "10.00",
+    }
+    base.update(kwargs)
+    return base
+
+
+# ===========================================================================
+# dedupe_orders
+# ===========================================================================
+
+class TestDedupeOrders:
+    """When an order is exported more than once, only the latest version
+    (by updated_at) must survive."""
+
+    def test_single_row_is_kept(self):
+        rows = [make_row(order_id="A-1", updated_at="2026-03-02T09:00:00")]
+        result = dedupe_orders_fn(rows)
+        assert len(result) == 1
+        assert result[0]["order_id"] == "A-1"
+
+    def test_later_updated_at_wins(self):
+        rows = [
+            make_row(order_id="A-1", updated_at="2026-03-02T09:00:00", amount="10.00"),
+            make_row(order_id="A-1", updated_at="2026-03-02T11:30:00", amount="20.00"),
+        ]
+        result = dedupe_orders_fn(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "20.00"
+
+    def test_earlier_updated_at_loses(self):
+        """Ensure the earlier duplicate is dropped, not the later one."""
+        rows = [
+            make_row(order_id="B-1", updated_at="2026-03-02T07:00:00", amount="5.00"),
+            make_row(order_id="B-1", updated_at="2026-03-02T06:00:00", amount="3.00"),
+        ]
+        result = dedupe_orders_fn(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "5.00"
+
+    def test_three_versions_keeps_latest(self):
+        rows = [
+            make_row(order_id="C-1", updated_at="2026-03-02T08:00:00", amount="1.00"),
+            make_row(order_id="C-1", updated_at="2026-03-02T10:00:00", amount="2.00"),
+            make_row(order_id="C-1", updated_at="2026-03-02T09:00:00", amount="3.00"),
+        ]
+        result = dedupe_orders_fn(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "2.00"
+
+    def test_distinct_orders_all_kept(self):
+        rows = [
+            make_row(order_id="A-1"),
+            make_row(order_id="A-2"),
+            make_row(order_id="A-3"),
+        ]
+        result = dedupe_orders_fn(rows)
+        assert len(result) == 3
+
+    def test_output_sorted_by_order_id(self):
+        rows = [
+            make_row(order_id="Z-9"),
+            make_row(order_id="A-1"),
+            make_row(order_id="M-5"),
+        ]
+        result = dedupe_orders_fn(rows)
+        order_ids = [r["order_id"] for r in result]
+        assert order_ids == sorted(order_ids)
+
+    def test_empty_input_returns_empty_list(self):
+        assert dedupe_orders_fn([]) == []
+
+    def test_multiple_orders_each_with_duplicates(self):
+        """Realistic scenario: two orders each exported twice."""
+        rows = [
+            make_row(order_id="S-102", updated_at="2026-03-02T08:05:00", amount="100.00"),
+            make_row(order_id="S-103", updated_at="2026-03-02T08:30:00", amount="40.50"),
+            make_row(order_id="S-102", updated_at="2026-03-02T11:47:00", amount="120.00"),
+            make_row(order_id="S-103", updated_at="2026-03-02T07:55:00", amount="38.00"),
+        ]
+        result = dedupe_orders_fn(rows)
+        by_id = {r["order_id"]: r for r in result}
+        assert len(by_id) == 2
+        assert by_id["S-102"]["amount"] == "120.00"  # 11:47 wins over 08:05
+        assert by_id["S-103"]["amount"] == "40.50"   # 08:30 wins over 07:55
+
