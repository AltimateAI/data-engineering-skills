+# ===========================================================================
+# convert_to_usd  –  amount_usd = amount * usd_per_unit, ROUND_HALF_UP to cents
+# ===========================================================================
+
+class TestConvertToUsd:
+
+    def test_usd_passthrough(self):
+        """USD orders use rate 1 → amount_usd equals amount."""
+        rows = [make_row(currency="USD", amount="42.00")]
+        rates = {"USD": "1"}
+        result = convert_to_usd_fn(rows, rates)
+        assert result[0]["amount_usd"] == "42.00"
+
+    def test_eur_conversion(self):
+        rows = [make_row(currency="EUR", amount="20.00")]
+        rates = {"USD": "1", "EUR": "1.0812"}
+        result = convert_to_usd_fn(rows, rates)
+        # 20.00 × 1.0812 = 21.624 → rounds HALF_UP to 21.62
+        assert result[0]["amount_usd"] == "21.62"
+
+    def test_gbp_conversion_rounds_half_up(self):
+        """40.50 GBP × 1.2700 = 51.435 → half-up rounds to 51.44."""
+        rows = [make_row(currency="GBP", amount="40.50")]
+        rates = {"USD": "1", "GBP": "1.2700"}
+        result = convert_to_usd_fn(rows, rates)
+        assert result[0]["amount_usd"] == "51.44"
+
+    def test_small_amount_rounds_half_up(self):
+        """0.35 EUR × 1.0850 = 0.37975 → rounds to 0.38."""
+        rows = [make_row(currency="EUR", amount="0.35")]
+        rates = {"USD": "1", "EUR": "1.0850"}
+        result = convert_to_usd_fn(rows, rates)
+        assert result[0]["amount_usd"] == "0.38"
+
+    def test_exact_half_rounds_up(self):
+        """Explicit half-way case: 1.005 → 1.01 (not 1.00 as banker's rounding would give)."""
+        rows = [make_row(currency="EUR", amount="1.00")]
+        rates = {"EUR": "1.005"}
+        result = convert_to_usd_fn(rows, rates)
+        assert Decimal(result[0]["amount_usd"]) == Decimal("1.01")
+
+    def test_missing_currency_raises(self):
+        """An order in a currency with no FX rate for the day must FAIL, not be skipped."""
+        rows = [make_row(currency="JPY", amount="1000.00")]
+        rates = {"USD": "1", "EUR": "1.0850"}  # JPY absent
+        with pytest.raises(ValueError, match="JPY"):
+            convert_to_usd_fn(rows, rates)
+
+    def test_missing_currency_error_names_order(self):
+        """Error message should identify the offending order so ops can act fast."""
+        rows = [make_row(order_id="PROB-1", currency="CHF", amount="50.00")]
+        rates = {"USD": "1"}
+        with pytest.raises(ValueError, match="PROB-1"):
+            convert_to_usd_fn(rows, rates)
+
+    def test_usd_in_rates_is_not_required_for_usd_order(self):
+        """USD rate defaults to 1 inside load_fx_rates, but convert_to_usd itself
+        just looks up the dict – confirm it works when USD is present."""
+        rows = [make_row(currency="USD", amount="9.99")]
+        rates = {"USD": "1"}
+        result = convert_to_usd_fn(rows, rates)
+        assert result[0]["amount_usd"] == "9.99"
+
+    def test_multiple_currencies_in_one_batch(self):
+        rows = [
+            make_row(order_id="O-1", currency="USD", amount="10.00"),
+            make_row(order_id="O-2", currency="EUR", amount="10.00"),
+            make_row(order_id="O-3", currency="GBP", amount="10.00"),
+        ]
+        rates = {"USD": "1", "EUR": "1.0850", "GBP": "1.2700"}
+        result = convert_to_usd_fn(rows, rates)
+        by_id = {r["order_id"]: r for r in result}
+        assert by_id["O-1"]["amount_usd"] == "10.00"
+        assert by_id["O-2"]["amount_usd"] == "10.85"
+        assert by_id["O-3"]["amount_usd"] == "12.70"
+
+    def test_original_fields_are_preserved(self):
+        """convert_to_usd must not drop any existing fields."""
+        row = make_row(order_id="K-1", currency="USD", amount="5.00")
+        result = convert_to_usd_fn([row], {"USD": "1"})
+        for key in row:
+            assert key in result[0], f"field '{key}' was dropped"
+
+    def test_amount_usd_is_string(self):
+        """load_enriched writes via csv.DictWriter; amount_usd must be a string."""
+        rows = [make_row(currency="USD", amount="1.00")]
+        result = convert_to_usd_fn(rows, {"USD": "1"})
+        assert isinstance(result[0]["amount_usd"], str)
+
+
+# ===========================================================================
+# validate_totals
+# ===========================================================================
+
+class TestValidateTotals:
+
+    def _row_with_usd(self, order_id="V-1", customer_id="C-1", amount_usd="10.00"):
+        return {**make_row(order_id=order_id, customer_id=customer_id), "amount_usd": amount_usd}
+
+    def test_valid_rows_pass_through(self):
+        rows = [self._row_with_usd("V-1"), self._row_with_usd("V-2")]
+        result = validate_totals_fn(rows)
+        assert len(result) == 2
+
+    def test_returns_same_row_objects(self):
+        row = self._row_with_usd()
+        result = validate_totals_fn([row])
+        assert result[0] is row
+
+    def test_missing_customer_id_raises(self):
+        rows = [self._row_with_usd(customer_id="")]
+        with pytest.raises(ValueError):
+            validate_totals_fn(rows)
+
+    def test_negative_amount_usd_raises(self):
+        rows = [self._row_with_usd(amount_usd="-0.01")]
+        with pytest.raises(ValueError):
+            validate_totals_fn(rows)
+
+    def test_zero_amount_usd_is_allowed(self):
+        """Zero is not negative; a $0 order should be publishable."""
+        rows = [self._row_with_usd(amount_usd="0.00")]
+        result = validate_totals_fn(rows)
+        assert len(result) == 1
+
+    def test_error_names_bad_order_ids(self):
+        bad_row = self._row_with_usd(order_id="BAD-99", customer_id="")
+        with pytest.raises(ValueError, match="BAD-99"):
+            validate_totals_fn([bad_row])
+
+    def test_one_bad_row_fails_entire_batch(self):
+        rows = [
+            self._row_with_usd("OK-1"),
+            self._row_with_usd("BAD-2", customer_id=""),
+            self._row_with_usd("OK-3"),
+        ]
+        with pytest.raises(ValueError):
+            validate_totals_fn(rows)
+
+    def test_empty_list_passes(self):
+        result = validate_totals_fn([])
+        assert result == []
+
+
+# ===========================================================================
+# load_enriched  –  nothing written unless validate_totals has passed
+# ===========================================================================
+
+class TestLoadEnriched:
+    """Validates that load_enriched writes exactly the OUTPUT_COLUMNS and only
+    when explicitly called (i.e. the DAG wires it after validate_totals)."""
+
+    def _enriched_rows(self):
+        return [
+            {**make_row(order_id="W-1", customer_id="C-1", currency="USD", amount="10.00"),
+             "amount_usd": "10.00"},
+            {**make_row(order_id="W-2", customer_id="C-2", currency="EUR", amount="20.00"),
+             "amount_usd": "21.62"},
+        ]
+
+    def test_file_is_created(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(dag_module, "OUTPUT_DIR", tmp_path)
+        load_enriched_fn(self._enriched_rows(), ds="2026-03-01")
+        assert (tmp_path / "2026-03-01.csv").exists()
+
+    def test_csv_has_correct_header(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(dag_module, "OUTPUT_DIR", tmp_path)
+        load_enriched_fn(self._enriched_rows(), ds="2026-03-01")
+        with (tmp_path / "2026-03-01.csv").open() as fh:
+            reader = csv.DictReader(fh)
+            assert reader.fieldnames == OUTPUT_COLUMNS
+
+    def test_csv_row_count(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(dag_module, "OUTPUT_DIR", tmp_path)
+        rows = self._enriched_rows()
+        load_enriched_fn(rows, ds="2026-03-01")
+        with (tmp_path / "2026-03-01.csv").open() as fh:
+            data = list(csv.DictReader(fh))
+        assert len(data) == len(rows)
+
+    def test_no_file_without_explicit_call(self, tmp_path):
+        """Verify the output directory stays empty if load_enriched is never called.
+        This is the DAG-wiring guarantee: validate_totals must succeed first."""
+        assert list(tmp_path.iterdir()) == []
+
+    def test_extra_fields_are_excluded(self, tmp_path, monkeypatch):
+        """extrasaction='ignore' means internal fields like updated_at must not leak."""
+        monkeypatch.setattr(dag_module, "OUTPUT_DIR", tmp_path)
+        load_enriched_fn(self._enriched_rows(), ds="2026-03-01")
+        with (tmp_path / "2026-03-01.csv").open() as fh:
+            reader = csv.DictReader(fh)
+            for row in reader:
+                assert set(row.keys()) == set(OUTPUT_COLUMNS)
+
+    def test_returns_output_path_string(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(dag_module, "OUTPUT_DIR", tmp_path)
+        result = load_enriched_fn(self._enriched_rows(), ds="2026-03-02")
+        assert result == str(tmp_path / "2026-03-02.csv")
+
