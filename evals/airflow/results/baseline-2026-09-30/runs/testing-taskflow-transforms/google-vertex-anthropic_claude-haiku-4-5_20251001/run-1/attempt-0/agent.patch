+class TestConvertToUSD:
+    """Test USD conversion with proper rounding and FX rate validation."""
+
+    def test_usd_currency_no_conversion_needed(self):
+        """USD amounts are just converted to string with amount_usd = amount."""
+        rows = [{"order_id": "S-100", "currency": "USD", "amount": "15.00"}]
+        rates = {"USD": "1"}
+        result = convert_to_usd(rows, rates)
+        assert len(result) == 1
+        assert result[0]["amount_usd"] == "15.00"
+
+    def test_eur_conversion_with_half_up_rounding(self):
+        """EUR 20.00 * 1.0812 = 21.624 -> rounds half-up to 21.62."""
+        rows = [{"order_id": "S-101", "currency": "EUR", "amount": "20.00"}]
+        rates = {"EUR": "1.0812"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "21.62"
+
+    def test_gbp_conversion_rounding_up(self):
+        """GBP 40.50 * 1.2655 = 51.25275 -> rounds half-up to 51.25."""
+        rows = [{"order_id": "S-103", "currency": "GBP", "amount": "40.50"}]
+        rates = {"GBP": "1.2655"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "51.25"
+
+    def test_small_amount_conversion(self):
+        """Small amounts like 0.35 EUR * 1.0850 = 0.37975 -> 0.38 cents."""
+        rows = [{"order_id": "S-105", "currency": "EUR", "amount": "0.35"}]
+        rates = {"EUR": "1.0850"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "0.38"
+
+    def test_missing_fx_rate_raises_error(self):
+        """If currency has no FX rate, conversion raises ValueError."""
+        rows = [{"order_id": "S-200", "currency": "JPY", "amount": "1000"}]
+        rates = {"USD": "1", "EUR": "1.0850"}
+        with pytest.raises(ValueError, match="no FX rate for JPY"):
+            convert_to_usd(rows, rates)
+
+    def test_missing_fx_rate_includes_order_id(self):
+        """Error message includes the order_id for debugging."""
+        rows = [{"order_id": "S-999", "currency": "CAD", "amount": "50.00"}]
+        rates = {"USD": "1"}
+        with pytest.raises(ValueError, match="order S-999"):
+            convert_to_usd(rows, rates)
+
+    def test_multiple_currencies_mixed_with_missing_rate(self):
+        """Process some currencies OK, fail on missing rate."""
+        rows = [
+            {"order_id": "S-100", "currency": "USD", "amount": "15.00"},
+            {"order_id": "S-101", "currency": "EUR", "amount": "20.00"},
+            {"order_id": "S-200", "currency": "INR", "amount": "1000.00"},
+        ]
+        rates = {"USD": "1", "EUR": "1.0812"}
+        # Should fail on INR, before returning
+        with pytest.raises(ValueError, match="INR"):
+            convert_to_usd(rows, rates)
+
+    def test_preserves_other_columns(self):
+        """amount_usd is added; other columns are preserved."""
+        rows = [
+            {
+                "order_id": "S-100",
+                "customer_id": "C-7",
+                "currency": "EUR",
+                "amount": "20.00",
+                "order_date": "2026-03-01",
+            }
+        ]
+        rates = {"EUR": "1.0812"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["order_id"] == "S-100"
+        assert result[0]["customer_id"] == "C-7"
+        assert result[0]["amount_usd"] == "21.62"
+        assert "order_date" in result[0]
+
