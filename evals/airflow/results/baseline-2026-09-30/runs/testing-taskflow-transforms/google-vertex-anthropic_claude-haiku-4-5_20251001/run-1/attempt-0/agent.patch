+class TestRounding:
+    """Test rounding behavior (half-up to cents) in detail."""
+
+    def test_rounds_half_up_at_0_005(self):
+        """0.005 rounds up to 0.01 (half-up)."""
+        # Need a rate and amount that multiply to something.XX5
+        rows = [{"order_id": "S-1", "currency": "EUR", "amount": "0.01"}]
+        rates = {"EUR": "0.55"}  # 0.01 * 0.55 = 0.0055 -> rounds to 0.01
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "0.01"
+
+    def test_rounds_half_up_larger_example(self):
+        """Larger amount: 10.00 * 1.125 = 11.25 (exact, no rounding)."""
+        rows = [{"order_id": "S-1", "currency": "TEST", "amount": "10.00"}]
+        rates = {"TEST": "1.125"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["amount_usd"] == "11.25"
+
+    def test_rounding_with_many_decimals(self):
