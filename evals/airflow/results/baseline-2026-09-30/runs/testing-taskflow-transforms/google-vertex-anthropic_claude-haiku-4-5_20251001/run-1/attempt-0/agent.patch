+class TestDedupeOrders:
+    """Test that latest version of duplicated orders is kept."""
+
+    def test_single_order_no_duplication(self):
+        """Single order with no duplicates passes through."""
+        rows = [
+            {"order_id": "S-100", "updated_at": "2026-03-01T10:00:00", "customer_id": "C-7"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["order_id"] == "S-100"
+
+    def test_duplicate_orders_keeps_latest(self):
+        """When an order appears twice, only the latest (highest updated_at) is kept."""
+        rows = [
+            {"order_id": "S-102", "updated_at": "2026-03-02T08:05:00", "customer_id": "C-7", "amount": "100.00"},
+            {"order_id": "S-102", "updated_at": "2026-03-02T11:47:00", "customer_id": "C-7", "amount": "120.00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["updated_at"] == "2026-03-02T11:47:00"
+        assert result[0]["amount"] == "120.00"
+
+    def test_multiple_duplicates_sorted_by_order_id(self):
+        """Multiple orders with duplicates: keeps latest version and sorts by order_id."""
+        rows = [
+            {"order_id": "S-103", "updated_at": "2026-03-02T08:30:00"},
+            {"order_id": "S-101", "updated_at": "2026-03-01T10:40:00"},
+            {"order_id": "S-103", "updated_at": "2026-03-02T07:55:00"},
+            {"order_id": "S-102", "updated_at": "2026-03-02T08:05:00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 3
+        # Should be sorted by order_id
+        assert [r["order_id"] for r in result] == ["S-101", "S-102", "S-103"]
+        # S-103 should have the latest timestamp
+        assert result[2]["updated_at"] == "2026-03-02T08:30:00"
+
+    def test_three_versions_of_same_order(self):
+        """Three versions of same order: highest updated_at wins."""
+        rows = [
+            {"order_id": "S-200", "updated_at": "2026-03-02T10:00:00", "amount": "50.00"},
+            {"order_id": "S-200", "updated_at": "2026-03-02T12:00:00", "amount": "75.00"},
+            {"order_id": "S-200", "updated_at": "2026-03-02T11:00:00", "amount": "60.00"},
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "75.00"
+        assert result[0]["updated_at"] == "2026-03-02T12:00:00"
+
