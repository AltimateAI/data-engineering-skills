+class TestValidateTotals:
+    """Test that validation rejects invalid orders before output."""
+
+    def test_valid_orders_pass_through(self):
+        """Valid orders with positive USD and customer_id pass through."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-7", "amount_usd": "15.00"},
+            {"order_id": "S-101", "customer_id": "C-8", "amount_usd": "21.62"},
+        ]
+        result = validate_totals(rows)
+        assert len(result) == 2
+        assert result == rows
+
+    def test_missing_customer_id_fails(self):
+        """Order with empty customer_id is rejected."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-7", "amount_usd": "15.00"},
+            {"order_id": "S-101", "customer_id": "", "amount_usd": "21.62"},
+        ]
+        with pytest.raises(ValueError, match="invalid orders"):
+            validate_totals(rows)
+
+    def test_none_customer_id_fails(self):
+        """Order with None customer_id is rejected."""
+        rows = [
+            {"order_id": "S-200", "customer_id": None, "amount_usd": "50.00"},
+        ]
+        with pytest.raises(ValueError, match="invalid orders"):
+            validate_totals(rows)
+
+    def test_negative_usd_amount_fails(self):
+        """Order with negative USD amount is rejected."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-7", "amount_usd": "-15.00"},
+        ]
+        with pytest.raises(ValueError, match="invalid orders"):
+            validate_totals(rows)
+
+    def test_error_message_includes_order_ids(self):
+        """Error includes all invalid order IDs."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-7", "amount_usd": "15.00"},
+            {"order_id": "S-101", "customer_id": "", "amount_usd": "21.62"},
+            {"order_id": "S-102", "customer_id": "C-9", "amount_usd": "-10.00"},
+        ]
+        with pytest.raises(ValueError) as exc_info:
+            validate_totals(rows)
+        error_msg = str(exc_info.value)
+        assert "S-101" in error_msg
+        assert "S-102" in error_msg
+
+    def test_zero_usd_amount_passes(self):
+        """Zero USD amount is valid (only negative fails)."""
+        rows = [
+            {"order_id": "S-100", "customer_id": "C-7", "amount_usd": "0.00"},
+        ]
+        result = validate_totals(rows)
+        assert len(result) == 1
