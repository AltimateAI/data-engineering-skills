+                # Verify correct columns and values
+                assert rows[0]["order_id"] == "S-100"
+                assert rows[0]["amount_usd"] == "15.00"
+                assert rows[1]["order_id"] == "S-101"
+                assert rows[1]["amount_usd"] == "21.62"
