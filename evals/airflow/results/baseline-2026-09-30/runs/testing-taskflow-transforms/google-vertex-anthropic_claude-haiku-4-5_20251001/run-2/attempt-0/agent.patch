+class TestConvertToUsd:
+    """Test the convert_to_usd task: computes amount_usd with correct rounding."""
+
+    def test_convert_to_usd_basic(self):
+        """Basic conversion: amount * rate, rounded half-up to cents."""
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "USD",
+                "amount": "100",
+            }
+        ]
+        rates = {"USD": "1"}
+        result = convert_to_usd(rows, rates)
+        assert len(result) == 1
+        assert result[0]["amount_usd"] == "100.00"
+
+    def test_convert_to_usd_with_fx_rate(self):
+        """Conversion with a non-1 rate: amount * rate."""
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "EUR",
+                "amount": "100",
+            }
+        ]
+        rates = {"EUR": "1.1"}
+        result = convert_to_usd(rows, rates)
+        assert len(result) == 1
+        assert result[0]["amount_usd"] == "110.00"
+
+    def test_convert_to_usd_rounding_half_up(self):
+        """Rounding follows ROUND_HALF_UP (banker's rounding not used)."""
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "EUR",
+                "amount": "100.125",
+            }
+        ]
+        rates = {"EUR": "1"}
+        result = convert_to_usd(rows, rates)
+        # 100.125 should round to 100.13 (half-up)
+        assert result[0]["amount_usd"] == "100.13"
+
+    def test_convert_to_usd_missing_rate_raises(self):
+        """Missing FX rate raises ValueError; the run must fail."""
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "GBP",
+                "amount": "100",
+            }
+        ]
+        rates = {"USD": "1"}  # No GBP rate
+        with pytest.raises(ValueError, match="no FX rate for GBP"):
+            convert_to_usd(rows, rates)
+
+    def test_convert_to_usd_multiple_currencies(self):
+        """Multiple orders with different currencies convert correctly."""
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "USD",
+                "amount": "100",
+            },
+            {
+                "order_id": "O2",
+                "customer_id": "C2",
+                "currency": "EUR",
+                "amount": "100",
+            },
+        ]
+        rates = {"USD": "1", "EUR": "1.1"}
+        result = convert_to_usd(rows, rates)
+        assert len(result) == 2
+        assert result[0]["amount_usd"] == "100.00"
+        assert result[1]["amount_usd"] == "110.00"
+
+    def test_convert_to_usd_preserves_original_fields(self):
+        """Original row fields are preserved; amount_usd is added."""
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "USD",
+                "amount": "100",
+                "order_date": "2026-03-02",
+            }
+        ]
+        rates = {"USD": "1"}
+        result = convert_to_usd(rows, rates)
+        assert result[0]["order_id"] == "O1"
+        assert result[0]["customer_id"] == "C1"
+        assert result[0]["currency"] == "USD"
+        assert result[0]["amount"] == "100"
+        assert result[0]["order_date"] == "2026-03-02"
+        assert result[0]["amount_usd"] == "100.00"
