+class TestDedupeOrders:
+    """Test the dedupe_orders task: keeps only latest version of each order."""
+
+    def test_dedupe_orders_keeps_latest(self):
+        """When an order appears multiple times, keep only the one with highest updated_at."""
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "USD",
+                "amount": "100",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T10:00:00",
+            },
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "USD",
+                "amount": "105",
+                "order_date": "2026-03-02",
+                "updated_at": "2026-03-02T11:00:00",  # Later, so this wins
+            },
+        ]
+        result = dedupe_orders(rows)
+        assert len(result) == 1
+        assert result[0]["amount"] == "105"
+
+    def test_dedupe_orders_keeps_single_version(self):
+        """Orders with only one version are kept as-is."""
