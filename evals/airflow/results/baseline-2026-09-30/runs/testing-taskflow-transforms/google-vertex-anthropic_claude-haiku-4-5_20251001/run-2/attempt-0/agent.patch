+class TestEndToEnd:
+    """End-to-end tests using sample data from data/."""
+
+    def test_end_to_end_sample_data(self):
+        """Full pipeline on sample data: extract, dedupe, convert, validate, load."""
+        ds = "2026-03-02"
+        # Step 1: Extract
+        orders = extract_orders(ds=ds)
+        assert len(orders) > 0
+
+        # Step 2: Dedupe
+        deduped = dedupe_orders(orders)
+        # Should have fewer or same orders after deduping
+        assert len(deduped) <= len(orders)
+
+        # Step 3: Load FX rates
+        rates = load_fx_rates(ds=ds)
+        assert "USD" in rates
+
+        # Step 4: Convert to USD
+        converted = convert_to_usd(deduped, rates)
+        assert len(converted) == len(deduped)
+        # All should have amount_usd
+        for row in converted:
+            assert "amount_usd" in row
+            # amount_usd should be a valid decimal string
+            Decimal(row["amount_usd"])
+
+        # Step 5: Validate totals
+        validated = validate_totals(converted)
+        assert len(validated) == len(converted)
+
+    def test_end_to_end_sample_data_dedup_applied(self):
+        """Verify deduplication actually works on sample data."""
+        ds = "2026-03-02"
+        orders = extract_orders(ds=ds)
+        # Check if there are any duplicates in raw data
+        order_ids = [r["order_id"] for r in orders]
+        if len(order_ids) > len(set(order_ids)):
+            # There are duplicates
+            deduped = dedupe_orders(orders)
+            # After dedup, should have fewer orders
+            assert len(deduped) < len(orders)
+
+    def test_end_to_end_missing_fx_rate_fails(self):
+        """If an order currency has no FX rate, convert_to_usd should fail the run."""
+        # This is tested implicitly, but let's be explicit:
+        # Create an order with a currency that has no rate
+        rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "C1",
+                "currency": "XXX",  # Made-up currency
+                "amount": "100",
+            }
+        ]
+        rates = {"USD": "1"}
+        with pytest.raises(ValueError, match="no FX rate"):
+            convert_to_usd(rows, rates)
+
+    def test_end_to_end_nothing_written_if_validation_fails(self):
+        """If validate_totals fails, nothing should reach load_enriched."""
+        # This is implicit in the test design: if validate_totals raises,
+        # the DAG task fails and load_enriched never runs.
+        # Test it directly:
+        invalid_rows = [
+            {
+                "order_id": "O1",
+                "customer_id": "",  # Invalid
+                "currency": "USD",
+                "amount": "100",
+                "amount_usd": "100.00",
+            }
+        ]
+        with pytest.raises(ValueError):
+            validate_totals(invalid_rows)
+        # If we got here, validate_totals failed as expected.
+        # load_enriched was never called, so nothing was written.
