+"""Pytest suite for the orders_enrichment Airflow DAG.
+
+Tests the core finance requirements:
+1. When an order is exported more than once, only keep latest version (by updated_at)
+2. amount_usd = amount * that day's usd_per_unit, rounded half-up to cents
+3. An order with missing FX rate must fail the run (not get guessed)
+4. Nothing written to output/ unless validate_totals passes
+5. DAG runs once daily at 06:00 UTC
+
+Test strategy: Extract the underlying function logic using __wrapped__ attribute,
+which accesses the pure Python function before @task decoration.
+"""
+
+import csv
+import tempfile
+from decimal import Decimal
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+# Import the task decorators
+from dags.orders_enrichment import (
+    convert_to_usd as convert_to_usd_task,
+    dedupe_orders as dedupe_orders_task,
+    extract_orders as extract_orders_task,
+    load_enriched as load_enriched_task,
+    load_fx_rates as load_fx_rates_task,
+    validate_totals as validate_totals_task,
+)
+
+# Extract the underlying functions bypassing the @task decorator
+extract_orders = extract_orders_task.__wrapped__
+load_fx_rates = load_fx_rates_task.__wrapped__
+dedupe_orders = dedupe_orders_task.__wrapped__
+convert_to_usd = convert_to_usd_task.__wrapped__
+validate_totals = validate_totals_task.__wrapped__
+load_enriched = load_enriched_task.__wrapped__
+
+
+class TestExtractOrders:
+    """Test the extract_orders task: reads orders.csv filtered by date."""
+
+    def test_extract_orders_filters_by_date(self):
+        """Orders are filtered to the run date (ds parameter)."""
+        # Extract orders for 2026-03-02, which has duplicates
+        result = extract_orders(ds="2026-03-02")
+        assert isinstance(result, list)
+        assert len(result) > 0
+        # All rows should have order_date == 2026-03-02
+        for row in result:
+            assert row["order_date"] == "2026-03-02"
+
+    def test_extract_orders_no_match(self):
+        """Extract returns empty list if no orders match the date."""
+        result = extract_orders(ds="1999-01-01")
+        assert result == []
+
