+"""Wait for the daily vendor shipments file, load it into DuckDB, and publish the carrier report."""
+
+from __future__ import annotations
+
+from datetime import timedelta
+from pathlib import Path
+
+import pendulum
+from airflow.models import Variable
+from airflow.providers.standard.operators.bash import BashOperator
+from airflow.providers.standard.sensors.filesystem import FileSensor
+from airflow.sdk import dag, task
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+WAREHOUSE = PROJECT_ROOT / "warehouse" / "analytics.duckdb"
+
+# The file usually arrives before 09:00 UTC but may be late.
+# The DAG starts at 06:00 UTC; we allow up to 23:59 UTC (17 h 59 m = 64 740 s).
+_SENSOR_TIMEOUT_SECONDS = int(timedelta(hours=17, minutes=59).total_seconds())  # 64 740
+_SENSOR_POKE_INTERVAL_SECONDS = 5 * 60  # 5 minutes – keeps worker slots free between polls
+
+
+@dag(
+    schedule="0 6 * * *",
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=False,
+    default_args={
+        "owner": "logistics-analytics",
+        "retries": 2,
+        "retry_delay": timedelta(minutes=5),
+    },
+    tags=["shipments", "warehouse"],
+)
+def vendor_shipments():
+    # -------------------------------------------------------------------------
+    # 1. Wait for the day's file without occupying a worker slot.
+    #
+    # FileSensor with deferrable=True hands control to the Triggerer process
+    # while it polls, freeing the worker slot for other tasks.
+    #
+    # filepath is a Jinja template: at run-time Airflow resolves
+    #   {{ var.value.vendor_landing_dir }}  →  the Airflow Variable
+    #   {{ ds }}                            →  the logical date (YYYY-MM-DD)
+    #
+    # The fs_default connection must have an empty base path (the default) so
+    # that the absolute path produced by the template is used unchanged.
+    # -------------------------------------------------------------------------
+    wait_for_file = FileSensor(
+        task_id="wait_for_file",
+        filepath="{{ var.value.vendor_landing_dir }}/shipments_{{ ds }}.csv",
+        fs_conn_id="fs_default",
+        poke_interval=_SENSOR_POKE_INTERVAL_SECONDS,
+        timeout=_SENSOR_TIMEOUT_SECONDS,
+        mode="reschedule",          # belt-and-suspenders: free worker slot even if deferrable is off
+        deferrable=True,            # primary mechanism: use Triggerer, not a worker slot
+        soft_fail=False,            # hard-fail so on-call gets paged when the file is missing
+    )
+
+    # -------------------------------------------------------------------------
+    # 2. Load the file into the vendor_shipments table.
+    #
+    # Idempotent: DELETE the day's rows before re-inserting so reruns never
+    # produce duplicates.  The table is created on first use.
+    # The file's columns (shipment_id, carrier, destination, weight_kg,
+    # shipped_at) are loaded as-is; ship_date is added from the logical date.
+    # -------------------------------------------------------------------------
+    @task
+    def load_shipments(ds=None):
+        import duckdb
+
+        landing_dir = Variable.get("vendor_landing_dir")
+        csv_path = f"{landing_dir}/shipments_{ds}.csv"
+
+        WAREHOUSE.parent.mkdir(parents=True, exist_ok=True)
+        with duckdb.connect(str(WAREHOUSE)) as con:
+            con.execute(
+                """
+                CREATE TABLE IF NOT EXISTS vendor_shipments (
+                    shipment_id  VARCHAR,
+                    carrier      VARCHAR,
+                    destination  VARCHAR,
+                    weight_kg    DOUBLE,
+                    shipped_at   TIMESTAMP,
+                    ship_date    DATE
+                )
+                """
+            )
+            # Remove any existing rows for this date so reruns are safe.
+            con.execute(
+                "DELETE FROM vendor_shipments WHERE ship_date = CAST(? AS DATE)",
+                [ds],
+            )
+            con.execute(
+                """
+                INSERT INTO vendor_shipments
+                SELECT
+                    shipment_id,
+                    carrier,
+                    destination,
+                    CAST(weight_kg   AS DOUBLE),
+                    CAST(shipped_at  AS TIMESTAMP),
+                    CAST(? AS DATE) AS ship_date
+                FROM read_csv_auto(?)
+                """,
+                [ds, csv_path],
+            )
+            row_count = con.execute(
+                "SELECT count(*) FROM vendor_shipments WHERE ship_date = CAST(? AS DATE)",
+                [ds],
+            ).fetchone()[0]
+        return row_count
+
+    # -------------------------------------------------------------------------
+    # 3. Publish the carrier report for the loaded date.
+    # -------------------------------------------------------------------------
+    publish_report = BashOperator(
+        task_id="publish_report",
+        bash_command=f"{PROJECT_ROOT}/scripts/publish_shipments_report.sh {{{{ ds }}}}",
+    )
+
+    wait_for_file >> load_shipments() >> publish_report
+
+
+vendor_shipments()
