+"""Load the daily vendor shipments file and publish the carrier report."""
+
+from __future__ import annotations
+
+from datetime import timedelta
+from pathlib import Path
+
+import pendulum
+from airflow.models import Variable
+from airflow.providers.standard.operators.bash import BashOperator
+from airflow.providers.standard.sensors.filesystem import FileSensor
+from airflow.sdk import dag, task
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+WAREHOUSE = PROJECT_ROOT / "warehouse" / "analytics.duckdb"
+
+
+@dag(
+    schedule="0 6 * * *",
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=False,
+    default_args={"owner": "logistics-analytics", "retries": 2, "retry_delay": timedelta(minutes=5)},
+    tags=["vendor", "shipments", "warehouse"],
+)
+def vendor_shipments():
+    """
+    Load the daily vendor shipments file from the landing directory into the warehouse.
+    
+    The CSV file is expected to be named shipments_YYYY-MM-DD.csv and arrive in the
+    directory specified by the Airflow Variable 'vendor_landing_dir'. If the file is
+    not present by end of day, the task will fail and alert on-call.
+    """
+
+    # Wait for the shipments file. Use a sensor that doesn't tie up a worker slot.
+    # The file usually arrives before 9am UTC. If not present by end of day (23:59),
+    # poke_interval and timeout will cause failure.
+    # Use Jinja templating to defer Variable.get() to runtime.
+    wait_for_shipments_file = FileSensor(
+        task_id="wait_for_shipments_file",
+        filepath="{{ var.value.vendor_landing_dir }}/shipments_{{ ds }}.csv",
+        poke_interval=60,  # Check every minute
+        timeout=72000,  # 20 hours, to cover from 6am to midnight UTC
+        mode="poke",  # Default mode; worker will poll
+    )
+
+    @task
+    def load_vendor_shipments(ds=None):
+        """Load the vendor shipments CSV into the warehouse, deduplicating on rerun."""
+        import duckdb
+
+        landing_dir = Variable.get("vendor_landing_dir")
+        shipments_file = Path(landing_dir) / f"shipments_{ds}.csv"
+
+        WAREHOUSE.parent.mkdir(parents=True, exist_ok=True)
+        with duckdb.connect(str(WAREHOUSE)) as con:
+            # Create table if it doesn't exist. Infer schema from CSV.
+            con.execute(
+                "CREATE TABLE IF NOT EXISTS vendor_shipments AS "
+                "SELECT *, CAST(? AS DATE) AS ship_date "
+                "FROM read_csv_auto(?) "
+                "WHERE FALSE",
+                [ds, str(shipments_file)],
+            )
+            # Delete any existing rows for this date to handle reruns.
+            con.execute("DELETE FROM vendor_shipments WHERE ship_date = CAST(? AS DATE)", [ds])
+            # Insert today's rows with the ship_date column.
+            con.execute(
+                "INSERT INTO vendor_shipments "
+                "SELECT *, CAST(? AS DATE) AS ship_date "
+                "FROM read_csv_auto(?)",
+                [ds, str(shipments_file)],
+            )
+            row_count = con.execute(
+                "SELECT count(*) FROM vendor_shipments WHERE ship_date = CAST(? AS DATE)", [ds]
+            ).fetchone()[0]
+            return row_count
+
+    publish_shipments_report = BashOperator(
+        task_id="publish_shipments_report",
+        bash_command=f"{PROJECT_ROOT}/scripts/publish_shipments_report.sh {{{{ ds }}}}",
+    )
+
+    wait_for_shipments_file >> load_vendor_shipments() >> publish_shipments_report
+
+
+vendor_shipments()
