+"""Daily revenue report per store for the finance team.
+
+Runs every day at 03:00 UTC and reports on the previous calendar day
+(midnight-to-midnight UTC).  Late orders trickle in until ~02:00 UTC, so a
+03:00 run safely captures all orders for the preceding day.
+
+Output: output/daily_revenue/<YYYY-MM-DD>.csv
+Columns: store_id, orders, revenue  (revenue rounded to 2 d.p., sorted by store_id)
+
+Idempotent: writing to a fixed filename for the reporting date means re-runs
+overwrite the previous file with identical content.
+"""
+
+from __future__ import annotations
+
+import csv
+from datetime import timedelta
+from pathlib import Path
+
+import pendulum
+from airflow.sdk import dag, task
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+DATA_FILE = PROJECT_ROOT / "data" / "orders.csv"
+
+
+@dag(
+    schedule="0 3 * * *",
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=True,
+    tags=["finance", "revenue"],
+)
+def daily_revenue():
+    @task
+    def generate_report(logical_date=None) -> str:
+        """Aggregate orders for the previous calendar day and write the CSV."""
+        import duckdb
+
+        # The DAG runs at 03:00 on day D and reports on day D-1.
+        reporting_date = logical_date.date() - timedelta(days=1)
+        day_start = str(reporting_date)                        # YYYY-MM-DD 00:00:00
+        day_end = str(reporting_date + timedelta(days=1))      # next day 00:00:00
+
+        out_dir = PROJECT_ROOT / "output" / "daily_revenue"
+        out_dir.mkdir(parents=True, exist_ok=True)
+        out_file = out_dir / f"{reporting_date}.csv"
+
+        rows = duckdb.sql(
+            f"""
+            SELECT
+                store_id,
+                COUNT(*)                          AS orders,
+                ROUND(SUM(amount), 2)             AS revenue
+            FROM read_csv_auto('{DATA_FILE}', header = true)
+            WHERE order_ts >= TIMESTAMPTZ '{day_start}'
+              AND order_ts <  TIMESTAMPTZ '{day_end}'
+            GROUP BY store_id
+            ORDER BY store_id
+            """
+        ).fetchall()
+
+        with out_file.open("w", newline="") as fh:
+            writer = csv.writer(fh)
+            writer.writerow(["store_id", "orders", "revenue"])
+            writer.writerows(rows)
+
+        return str(out_file)
+
+    generate_report()
+
+
+daily_revenue()
