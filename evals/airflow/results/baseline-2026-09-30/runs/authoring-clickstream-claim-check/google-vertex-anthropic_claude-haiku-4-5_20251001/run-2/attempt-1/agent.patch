+"""Daily page-level statistics from clickstream exports."""
+
+from __future__ import annotations
+
+import csv
+import gzip
+from pathlib import Path
+
+import duckdb
+import pendulum
+from airflow.sdk import dag, task
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+
+
+@dag(
+    schedule="30 5 * * *",
+    start_date=pendulum.datetime(2026, 9, 1, tz="UTC"),
+    catchup=True,
+    tags=["analytics", "clickstream"],
+)
+def clickstream_page_stats():
+    """Extract, transform, and load daily page-level clickstream statistics.
+    
+    This DAG reads daily clickstream exports, filters out bot traffic and 
+    anonymous users, computes per-page statistics (views, unique users, 
+    average load time), and outputs a sorted CSV file.
+    """
+
+    @task
+    def extract(ds=None) -> str:
+        """Read that day's export and filter out bot traffic and anonymous hits.
+        
+        Args:
+            ds: Airflow execution date (YYYY-MM-DD format)
+            
+        Returns:
+            Path to the cleaned data parquet file
+        """
+        input_file = PROJECT_ROOT / "data" / "clickstream" / f"{ds}.csv.gz"
+        
+        if not input_file.exists():
+            raise FileNotFoundError(f"Clickstream export not found: {input_file}")
+        
+        # Use DuckDB for efficient filtering at scale
+        conn = duckdb.connect(":memory:")
+        
+        # Read the gzipped CSV directly
+        conn.execute(f"""
+            CREATE TABLE raw_events AS
+            SELECT *
+            FROM read_csv_auto('{input_file}', compression='gzip')
+        """)
+        
+        # Filter: exclude bot traffic (is_bot = 1) and anonymous hits (empty user_id)
+        conn.execute("""
+            CREATE TABLE cleaned_events AS
+            SELECT *
+            FROM raw_events
+            WHERE is_bot = 0
+              AND user_id IS NOT NULL
+              AND user_id != ''
+        """)
+        
+        # Store result in temporary parquet for next task
+        temp_file = PROJECT_ROOT / ".tmp" / f"{ds}_cleaned.parquet"
+        temp_file.parent.mkdir(parents=True, exist_ok=True)
+        
+        conn.execute(f"COPY cleaned_events TO '{temp_file}' (FORMAT PARQUET)")
+        conn.close()
+        
+        return str(temp_file)
+
+    @task
+    def transform(cleaned_data_path: str, ds=None) -> str:
+        """Compute per-page statistics: views, unique_users, avg_load_ms.
+        
+        Args:
+            cleaned_data_path: Path to cleaned events parquet file
+            ds: Airflow execution date (YYYY-MM-DD format)
+            
+        Returns:
+            Path to the aggregated statistics parquet file
+        """
+        conn = duckdb.connect(":memory:")
+        
+        # Load cleaned events
+        conn.execute(f"""
+            CREATE TABLE events AS
+            SELECT *
+            FROM read_parquet('{cleaned_data_path}')
+        """)
+        
+        # Compute page-level statistics
+        conn.execute("""
+            CREATE TABLE page_stats AS
+            SELECT
+                page,
+                COUNT(*) as views,
+                COUNT(DISTINCT user_id) as unique_users,
+                ROUND(AVG(load_ms), 1) as avg_load_ms
+            FROM events
+            GROUP BY page
+        """)
+        
+        # Store result in temporary parquet
+        temp_file = PROJECT_ROOT / ".tmp" / f"{ds}_stats.parquet"
+        temp_file.parent.mkdir(parents=True, exist_ok=True)
+        
+        conn.execute(f"COPY page_stats TO '{temp_file}' (FORMAT PARQUET)")
+        conn.close()
+        
+        return str(temp_file)
+
+    @task
+    def load(stats_path: str, ds=None) -> None:
+        """Write output CSV with columns: page, views, unique_users, avg_load_ms.
+        
+        Output is sorted by page. Reruns replace the day's file.
+        
+        Args:
+            stats_path: Path to aggregated statistics parquet file
+            ds: Airflow execution date (YYYY-MM-DD format)
+        """
+        conn = duckdb.connect(":memory:")
+        
+        # Load stats and sort by page
+        conn.execute(f"""
+            CREATE TABLE stats AS
+            SELECT *
+            FROM read_parquet('{stats_path}')
+            ORDER BY page
+        """)
+        
+        # Create output directory
+        output_dir = PROJECT_ROOT / "output" / "page_stats"
+        output_dir.mkdir(parents=True, exist_ok=True)
+        output_file = output_dir / f"{ds}.csv"
+        
+        # Export to CSV
+        result = conn.execute("SELECT * FROM stats").fetchall()
+        columns = ["page", "views", "unique_users", "avg_load_ms"]
+        
+        with output_file.open("w", newline="") as fh:
+            writer = csv.writer(fh)
+            writer.writerow(columns)
+            for row in result:
+                writer.writerow(row)
+        
+        conn.close()
+        
+        # Clean up temporary files
+        temp_dir = PROJECT_ROOT / ".tmp"
+        (temp_dir / f"{ds}_cleaned.parquet").unlink(missing_ok=True)
+        (temp_dir / f"{ds}_stats.parquet").unlink(missing_ok=True)
+
+    # Task orchestration: extract → transform → load
+    cleaned_data = extract()
+    stats_data = transform(cleaned_data)
+    load(stats_data)
+
+
+clickstream_page_stats()
