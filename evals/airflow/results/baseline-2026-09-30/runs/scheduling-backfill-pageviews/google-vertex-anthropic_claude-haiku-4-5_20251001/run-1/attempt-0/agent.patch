+#!/bin/bash
+# Quick reference for backfill operations on pageviews_daily DAG
+
+# ============================================================================
+# 1. UNPAUSE THE DAG AND START BACKFILL (First time only)
+# ============================================================================
+
+# Option A: Unpause in Airflow CLI
+airflow dags unpause pageviews_daily
+
+# Option B: Unpause in Airflow UI
+# Navigate to DAGs → pageviews_daily → Toggle "Paused" to OFF
+# Airflow will immediately create 30 task instances (Sept 1 through Sept 30)
+
+
+# ============================================================================
+# 2. MONITOR BACKFILL PROGRESS
+# ============================================================================
+
+# Check which dates are fully loaded
+sqlite3 warehouse/web.duckdb << EOF
+SELECT 
+    view_date,
+    COUNT(*) as page_count,
+    SUM(views) as total_views,
+    SUM(unique_visitors) as total_visitors
+FROM daily_pageviews
+GROUP BY view_date
+ORDER BY view_date;
+EOF
+
+# Check if any dates are missing
+sqlite3 warehouse/web.duckdb << EOF
+SELECT 
+    date(current_date - INTERVAL (row_number() OVER (ORDER BY view_date DESC)) DAY) as expected_date,
+    view_date,
+    CASE WHEN view_date IS NULL THEN 'MISSING' ELSE 'LOADED' END as status
+FROM (
+    SELECT DISTINCT view_date FROM daily_pageviews
+    UNION ALL
+    SELECT NULL as view_date
+)
+WHERE expected_date >= '2026-09-01'
+ORDER BY expected_date DESC;
+EOF
+
+
+# ============================================================================
+# 3. RELOAD A SPECIFIC DATE (if needed)
+# ============================================================================
+
+# Reload Sept 15 (delete old data, re-insert from CSV)
+airflow tasks clear pageviews_daily --start-date 2026-09-15 --end-date 2026-09-15 --downstream=False
+
+# Verify it reloaded
+sqlite3 warehouse/web.duckdb "SELECT COUNT(*) FROM daily_pageviews WHERE view_date = '2026-09-15';"
+
+
+# ============================================================================
+# 4. RELOAD A DATE RANGE
+# ============================================================================
+
+# Reload Sept 15–18 (in case of data quality issues)
+airflow dags backfill pageviews_daily --start-date 2026-09-15 --end-date 2026-09-18
+
+# Check results
+sqlite3 warehouse/web.duckdb "SELECT view_date, COUNT(*) FROM daily_pageviews WHERE view_date >= '2026-09-15' AND view_date <= '2026-09-18' GROUP BY view_date ORDER BY view_date;"
+
+
+# ============================================================================
+# 5. ADD A MISSING DATE LATER (e.g., web tier backfilled Aug 15)
+# ============================================================================
+
+# First, ensure the CSV file exists: data/pageviews/2026-08-15.csv
+
+# Then trigger a backfill for that specific day
+airflow dags backfill pageviews_daily --start-date 2026-08-15 --end-date 2026-08-15
+
+# Or if you want to manually reload all dates in a range from scratch
+airflow dags backfill pageviews_daily --start-date 2026-08-01 --end-date 2026-08-31
+
+
+# ============================================================================
+# 6. DAILY SCHEDULE AFTER BACKFILL
+# ============================================================================
+
+# After the backfill finishes (all 30 dates loaded), the DAG automatically
+# runs at 3 AM UTC daily, loading the previous day's pageviews.
+# 
+# No manual intervention needed — Airflow handles it via:
+#   schedule="0 3 * * *"
+#   catchup=True
+
+
+# ============================================================================
+# 7. EMERGENCY: CLEAR THE TABLE AND RE-BACKFILL FROM SCRATCH
+# ============================================================================
+
+# Drop and rebuild (WARNING: deletes all data)
+sqlite3 warehouse/web.duckdb "DROP TABLE IF EXISTS daily_pageviews;"
+
+# Then backfill all dates at once
+airflow dags backfill pageviews_daily --start-date 2026-09-01 --end-date 2026-09-30
+
+
+# ============================================================================
+# 8. TAIL LOGS FOR A SPECIFIC DATE
+# ============================================================================
+
+# Watch logs as Sept 15 loads
+airflow tasks logs pageviews_daily load_day 2026-09-15 -f
+
+# Or read final result
+airflow tasks logs pageviews_daily load_day 2026-09-15 | tail -20
