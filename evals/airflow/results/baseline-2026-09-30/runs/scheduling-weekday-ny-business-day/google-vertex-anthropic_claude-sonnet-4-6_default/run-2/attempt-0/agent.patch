+def _previous_business_day(dt: pendulum.DateTime) -> pendulum.Date:
+    """Return the previous business day (Mon-Fri) relative to *dt*.
+
+    *dt* is the logical date of the DAG run expressed in New York time.
+    Weekday integers: Monday=0 … Sunday=6.
+    """
+    ny_date = dt.in_timezone("America/New_York").date()
+    # Monday (0) -> step back 3 days to Friday; any other weekday -> 1 day.
+    days_back = 3 if ny_date.day_of_week == pendulum.MONDAY else 1
+    return ny_date.subtract(days=days_back)
+
+
