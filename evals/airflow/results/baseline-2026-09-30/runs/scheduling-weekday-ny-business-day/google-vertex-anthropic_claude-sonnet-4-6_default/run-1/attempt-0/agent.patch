+def prev_business_day(execution_date: pendulum.DateTime) -> str:
+    """Return the previous business day (YYYY-MM-DD) relative to *execution_date*.
+
+    Monday runs report Friday; Tuesday–Friday runs report the prior calendar day.
+    The calculation is performed in New York local time so that the day-of-week
+    reflects what the desk considers 'today'.
+    """
+    ny_date = execution_date.in_timezone("America/New_York")
+    dow = ny_date.day_of_week  # Monday=0 … Sunday=6 (pendulum convention)
+    days_back = 3 if dow == pendulum.MONDAY else 1
+    return ny_date.subtract(days=days_back).to_date_string()
+
+
