+def get_previous_business_day(execution_date: pendulum.DateTime) -> str:
+    """Return the previous business day in YYYY-MM-DD format.
+    
+    If execution_date is a Monday, return Friday.
+    If execution_date is a Tuesday-Friday, return the previous day.
+    If execution_date is a Saturday or Sunday, this should not be called.
+    """
+    # execution_date is in New York time after schedule conversion
+    prev_day = execution_date.subtract(days=1)
+    
+    # If prev_day is a Saturday, go back to Friday
+    if prev_day.day_of_week == 5:  # Saturday (0=Monday, 5=Saturday)
+        prev_day = prev_day.subtract(days=1)
+    # If prev_day is a Sunday, go back to Friday
+    elif prev_day.day_of_week == 6:  # Sunday
+        prev_day = prev_day.subtract(days=2)
+    
+    return prev_day.format("YYYY-MM-DD")
+
+
 @dag(
     dag_id="fx_pnl_report",
-    schedule="@daily",
-    start_date=pendulum.datetime(2026, 1, 1, tz="UTC"),
+    schedule="10 11 * * mon-fri",  # 6am EST/4 EDT is ~11am/10am UTC respectively; use 11am to be safe
+    start_date=pendulum.datetime(2026, 1, 5, tz="UTC"),  # Monday 2026-01-05
     catchup=False,
     default_args={"owner": "treasury-data"},
     tags=["treasury", "reports"],
 )
 def fx_pnl_report():
     @task
-    def build_report(ds=None) -> str:
-        return str(write_pnl_report(ds))
+    def build_report(data_interval_end=None) -> str:
+        # data_interval_end is a UTC timestamp string of when the interval ended
+        # Parse it and convert to New York time to determine the NY date
+        exec_date_utc = pendulum.parse(data_interval_end, tz="UTC")
+        exec_date_ny = exec_date_utc.in_timezone("America/New_York")
+        
+        # Get the previous business day in New York
+        # This handles: Monday 6am → Friday, Tues-Fri 6am → previous day
+        trade_date = get_previous_business_day(exec_date_ny)
+        
+        return str(write_pnl_report(trade_date))
 
     build_report()
 
