+    def build_report(ds=None, data_interval_start=None) -> str:
+        # ds is the execution date in UTC; we need the previous business day in NY time.
+        # data_interval_start is provided by Airflow for cleaner date logic.
+        if data_interval_start is None:
+            data_interval_start = ds
+        
+        # Convert execution datetime to New York time
+        exec_time_utc = pendulum.parse(data_interval_start, tz="UTC")
+        exec_time_ny = exec_time_utc.in_timezone("America/New_York")
+        
+        # Calculate the previous business day (in NY timezone)
+        # Today is the execution date in NY time; we want yesterday if today is weekday,
+        # or Friday if today is Monday.
+        report_date_ny = exec_time_ny.subtract(days=1)
+        
+        # If report_date_ny is Saturday or Sunday, back up to Friday
+        while report_date_ny.weekday() > 4:  # 5=Saturday, 6=Sunday
+            report_date_ny = report_date_ny.subtract(days=1)
+        
+        # Convert back to YYYY-MM-DD format for the report filename
+        trade_date_str = report_date_ny.format("YYYY-MM-DD")
+        
+        return str(write_pnl_report(trade_date_str))
 
     build_report()
 
