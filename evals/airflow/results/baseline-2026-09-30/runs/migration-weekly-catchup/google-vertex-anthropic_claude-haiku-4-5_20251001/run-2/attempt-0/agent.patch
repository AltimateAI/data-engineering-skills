+def notify_growth_oncall(**context) -> None:
+    """Page the on-call analyst when the weekly report SLA is missed.
+    
+    Called when the DAG's 3-hour SLA is exceeded. The growth team on-call
+    engineer should be paged to investigate delays in the weekly campaign report.
+    
+    Args:
+        **context: Airflow context dict with dag, task, execution_date, etc.
+    """
+    dag_id = context.get("dag").dag_id if context.get("dag") else "unknown"
+    execution_date = context.get("execution_date", "unknown")
+    print(f"⚠️  SLA missed for DAG {dag_id} (execution_date: {execution_date}). Paging growth on-call...")
 
 
 @dag(
-    schedule_interval="0 6 * * 1",
+    schedule="0 6 * * 1",  # Mondays at 06:00 UTC
     start_date=pendulum.datetime(2026, 1, 5, tz="UTC"),
     default_args={"owner": "growth-analytics", "retries": 1, "sla": timedelta(hours=3)},
     sla_miss_callback=notify_growth_oncall,
